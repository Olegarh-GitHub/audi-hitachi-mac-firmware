  D70E  B1 80 74   CMPA  $8074          ; greater than the counter?
  D711  25 07      BCS   loc_D71A       ; no — finish counting
  D713  B7 80 74   STAA  $8074          ; new value
  D716  27 07      BEQ   loc_D71F       ; zero — clear the flag
  D718  20 16      BRA   loc_D730       ; set the flag

loc_D71A:
  D71A  7A 80 74   DEC   $8074          ; counter - 1
  D71D  26 11      BNE   loc_D730       ; not zero — keep the flag

loc_D71F:
  D71F  B6 80 77   LDAA  $8077          ; mixture flags
  D722  85 40      BITA  #$40           ; enrichment ($8077.6)?
  D724  27 12      BEQ   loc_D738       ; no
  D726  84 BF      ANDA  #$BF           ; clear
  D728  B7 80 77   STAA  $8077          ; store
  D72B  7F 80 74   CLR   $8074          ; counter = 0
  D72E  20 08      BRA   loc_D738       ; continue

loc_D730:
  D730  86 40      LDAA  #$40           ; enrichment after the pressure rise ($8077.6)
  D732  BA 80 77   ORAA  $8077          ; set
  D735  B7 80 77   STAA  $8077          ; store

;------------------------------------------------------------------------------
; KNOCK: processing the measurements. For each of the 5 cylinders an 8-byte record
; from $80C0 (cylinder N — $80C0 + 8·N):
;  +0 bit 7 — a new measurement has arrived (set by the interrupt), bit 0 — sensor signal
;     too weak at the highest gain;
;  +1 gain (1, 2, 4, 8) that the interrupt sets on the amplifier;
;  +2 measurement (integrator over the knock window);
;  +3 measurement scaled to the common scale (× $80BD / 256);
;  +4/+5 background — slow average of the scaled measurements (16 bits);
;  +6 smoothed measurement (half old and half new, C917 = 128);
;  +7 new gain.
; Knock: the scaled measurement is f/32 times greater than the background, f — table C8C0
; (5 rows for the cylinders × 16 columns by engine speed, axis C8B0). f = 144 at
; low engine speeds (4.5 times), 80…107 at high speeds (2.5…3.3 times).
; Knock present — cylinder bit in $8054 (cylinder 1 = bit 7); the background is then not
; updated. No knock — the background steps towards the measurement by 0.5 (C915).
; Gain: background above 3 × the lower limit — gain halved,
; background below the limit — gain doubled (not more than 8).
;------------------------------------------------------------------------------
loc_D738:
  D738  86 80      LDAA  #$80           ; mask of the first cylinder (bit 7)
  D73A  B7 80 E9   STAA  $80E9          ; $80E9 = cylinder mask
  D73D  5F         CLRB                 ; record offset = 0

loc_D73E:
  D73E  F7 80 E8   STAB  $80E8          ; $80E8 = offset (8 per cylinder)
  D741  CE 80 C0   LDX   #$80C0         ; cylinder records
  D744  3A         ABX                  ; X -> cylinder record
  D745  A6 00      LDAA  $00,X          ; flags
  D747  2B 03      BMI   loc_D74C       ; new measurement present?
  D749  7E D8 7A   JMP   loc_D87A       ; no — to the next cylinder

loc_D74C:
  D74C  84 7F      ANDA  #$7F           ; clear "new measurement"
  D74E  A7 00      STAA  $00,X          ; store
  D750  A6 02      LDAA  $02,X          ; measurement
  D752  B1 80 BA   CMPA  $80BA          ; not below the lower limit $80BA?
  D755  24 03      BCC   loc_D75A       ; yes
  D757  B6 80 BA   LDAA  $80BA          ; raise to the limit

loc_D75A:
  D75A  F6 80 BD   LDAB  $80BD          ; scale $80BD
  D75D  3D         MUL                  ; measurement × scale
  D75E  C3 00 80   ADDD  #$0080         ; round
  D761  A7 03      STAA  $03,X          ; +3 = scaled measurement
  D763  E6 04      LDAB  $04,X          ; background
  D765  26 0B      BNE   loc_D772       ; already present?
  D767  A7 04      STAA  $04,X          ; first measurement: background = measurement
  D769  86 08      LDAA  #$08           ; gain 8
  D76B  A7 01      STAA  $01,X          ; current
  D76D  A7 07      STAA  $07,X          ; new
  D76F  7E D8 7A   JMP   loc_D87A       ; to the next cylinder

loc_D772:
  D772  3C         PSHX                 ; save X
  D773  B6 80 18   LDAA  $8018          ; engine speed
  D776  CE C8 B0   LDX   #$C8B0         ; engine speed axis C8B0
  D779  C6 10      LDAB  #$10           ; 16 points
  D77B  BD CA 5F   JSR   AXIS_UP        ; find the point
  D77E  CE C8 C0   LDX   #$C8C0         ; threshold table C8C0
  D781  3A         ABX                  ; + column
  D782  F6 80 E8   LDAB  $80E8          ; record offset (8·N)
  D785  58         ASLB                 ; × 2 = 16·N — cylinder row
  D786  3A         ABX                  ; X -> f
  D787  A6 00      LDAA  $00,X          ; f
  D789  F6 80 E8   LDAB  $80E8          ; offset
  D78C  54         LSRB                 ; / 8 = cylinder number
  D78D  54         LSRB                 ; (/ 8)
  D78E  54         LSRB                 ; (/ 8)
  D78F  CE 80 EF   LDX   #$80EF         ; $80EF + N
  D792  3A         ABX                  ; X -> cell
  D793  A7 00      STAA  $00,X          ; remember the cylinder's f
  D795  38         PULX                 ; restore X
  D796  36         PSHA                 ; f onto the stack
  D797  EC 04      LDD   $04,X          ; background
  D799  81 40      CMPA  #$40           ; background 64 or more?
  D79B  24 08      BCC   loc_D7A5       ; yes — threshold 255
  D79D  05         ASLD                 ; background × 4
  D79E  05         ASLD                 ; (× 4)
  D79F  33         PULB                 ; f
  D7A0  3D         MUL                  ; threshold = background × 4 × f / 256
  D7A1  89 00      ADCA  #$00           ; round
  D7A3  20 03      BRA   loc_D7A8       ; continue

loc_D7A5:
  D7A5  86 FF      LDAA  #$FF           ; threshold 255
  D7A7  33         PULB                 ; pop f

loc_D7A8:
  D7A8  E6 03      LDAB  $03,X          ; scaled measurement
  D7AA  54         LSRB                 ; / 2
  D7AB  C9 00      ADCB  #$00           ; round
  D7AD  11         CBA                  ; measurement / 2 greater than the threshold?
  D7AE  25 25      BCS   loc_D7D5       ; yes — knock
  D7B0  EC 04      LDD   $04,X          ; background
  D7B2  A1 03      CMPA  $03,X          ; compare with the measurement
  D7B4  27 13      BEQ   loc_D7C9       ; equal — no change
  D7B6  24 0A      BCC   loc_D7C2       ; background greater — decrease
  D7B8  F3 C9 15   ADDD  $C915          ; background + 0.5
  D7BB  24 0C      BCC   loc_D7C9       ; no overflow
  D7BD  CC FF 00   LDD   #$FF00         ; limit
  D7C0  20 07      BRA   loc_D7C9       ; continue

loc_D7C2:
  D7C2  B3 C9 15   SUBD  $C915          ; background - 0.5
  D7C5  24 02      BCC   loc_D7C9       ; did not go negative
  D7C7  4F         CLRA                 ; zero
  D7C8  5F         CLRB                 ; (D = 0)

loc_D7C9:
  D7C9  ED 04      STD   $04,X          ; store the background
  D7CB  B6 80 E9   LDAA  $80E9          ; cylinder mask
  D7CE  43         COMA                 ; invert
  D7CF  0F         SEI                  ; disable interrupts
  D7D0  B4 80 54   ANDA  $8054          ; clear the knock flag
  D7D3  20 07      BRA   loc_D7DC       ; continue

loc_D7D5:
  D7D5  B6 80 E9   LDAA  $80E9          ; cylinder mask
  D7D8  0F         SEI                  ; disable interrupts
  D7D9  BA 80 54   ORAA  $8054          ; knock in this cylinder

loc_D7DC:
  D7DC  B7 80 54   STAA  $8054          ; store $8054
  D7DF  0E         CLI                  ; enable interrupts
  D7E0  B4 80 E9   ANDA  $80E9          ; cylinder bit
  D7E3  26 00      BNE   loc_D7E5       ; branch to the next instruction (does nothing)

loc_D7E5:
  D7E5  E6 02      LDAB  $02,X          ; measurement
  D7E7  B6 C9 17   LDAA  $C917          ; weight of the new value C917 = 128
  D7EA  3D         MUL                  ; measurement × weight
  D7EB  FD 80 EA   STD   $80EA          ; save
  D7EE  B6 C9 17   LDAA  $C917          ; weight
  D7F1  40         NEGA                 ; 256 - weight
  D7F2  E6 06      LDAB  $06,X          ; smoothed
  D7F4  3D         MUL                  ; × (256 - weight)
  D7F5  F3 80 EA   ADDD  $80EA          ; + new
  D7F8  A7 06      STAA  $06,X          ; +6 = smoothed measurement
  D7FA  E6 01      LDAB  $01,X          ; gain (overwritten below)
  D7FC  B6 80 BA   LDAA  $80BA          ; lower limit
  D7FF  F6 80 BD   LDAB  $80BD          ; scale
  D802  3D         MUL                  ; limit × scale
  D803  C3 00 80   ADDD  #$0080         ; round
  D806  B7 80 BE   STAA  $80BE          ; $80BE = scaled lower limit
  D809  16         TAB                  ; copy
  D80A  58         ASLB                 ; × 2
  D80B  1B         ABA                  ; × 3
  D80C  B7 80 BF   STAA  $80BF          ; $80BF = 3 × limit
  D80F  A6 04      LDAA  $04,X          ; background
  D811  E6 01      LDAB  $01,X          ; current gain
  D813  B1 80 BF   CMPA  $80BF          ; background above 3 × limit?
  D816  23 0D      BLS   loc_D825       ; no
  D818  5D         TSTB                 ; gain already 0?
  D819  27 2C      BEQ   loc_D847       ; yes — leave it
  D81B  54         LSRB                 ; halve the gain
  D81C  37         PSHB                 ; save
  D81D  EC 04      LDD   $04,X          ; background
  D81F  04         LSRD                 ; halve
  D820  ED 04      STD   $04,X          ; store
  D822  33         PULB                 ; gain
  D823  20 20      BRA   loc_D845       ; continue

loc_D825:
  D825  B1 80 BE   CMPA  $80BE          ; background above the limit?
  D828  22 1D      BHI   loc_D847       ; yes — do not change the gain
  D82A  5D         TSTB                 ; gain 0?
  D82B  26 03      BNE   loc_D830       ; no
  D82D  0D         SEC                  ; 0 -> 1
  D82E  20 01      BRA   loc_D831       ; continue

loc_D830:
  D830  0C         CLC                  ; double

loc_D831:
  D831  59         ROLB                 ; shift
  D832  C1 09      CMPB  #$09           ; became more than 8?
  D834  25 04      BCS   loc_D83A       ; no
  D836  C6 08      LDAB  #$08           ; keep 8
  D838  20 0D      BRA   loc_D847       ; continue

loc_D83A:
  D83A  37         PSHB                 ; save
  D83B  EC 04      LDD   $04,X          ; background
  D83D  05         ASLD                 ; double
  D83E  ED 04      STD   $04,X          ; store
  D840  33         PULB                 ; gain
  D841  24 02      BCC   loc_D845       ; no overflow
  D843  86 FF      LDAA  #$FF           ; limit 255

loc_D845:
  D845  A7 04      STAA  $04,X          ; background, high byte

loc_D847:
  D847  E7 07      STAB  $07,X          ; +7 = new gain
  D849  86 08      LDAA  #$08           ; F60 faulty?
  D84B  B5 80 93   BITA  $8093          ; check
  D84E  26 0E      BNE   loc_D85E       ; yes — check the sensor
  D850  86 19      LDAA  #$19           ; chip register $19
  D852  0F         SEI                  ; disable interrupts
  D853  B7 01 00   STAA  $0100          ; select
  D856  B6 01 01   LDAA  $0101          ; read
  D859  0E         CLI                  ; enable interrupts
  D85A  85 20      BITA  #$20           ; throttle closed (F60)?
  D85C  26 19      BNE   loc_D877       ; yes — do not check

loc_D85E:
  D85E  B6 80 18   LDAA  $8018          ; engine speed
  D861  81 78      CMPA  #$78           ; below 120 units (≈2700 rpm)?
  D863  25 12      BCS   loc_D877       ; yes — do not check
  D865  E6 01      LDAB  $01,X          ; gain
  D867  C1 08      CMPB  #$08           ; highest (8)?
  D869  26 0F      BNE   loc_D87A       ; no — do not decide
  D86B  A6 06      LDAA  $06,X          ; smoothed measurement
  D86D  B1 80 BB   CMPA  $80BB          ; below threshold $80BB?
  D870  24 05      BCC   loc_D877       ; no — sensor OK
  D872  62 01 00   OIM   #$01,$00,X     ; weak signal: bit 0
  D875  20 03      BRA   loc_D87A       ; continue

loc_D877:
  D877  61 FE 00   AIM   #$FE,$00,X     ; clear bit 0

loc_D87A:
  D87A  74 80 E9   LSR   $80E9          ; next cylinder (mask right)
  D87D  F6 80 E8   LDAB  $80E8          ; offset
  D880  CB 08      ADDB  #$08           ; + 8
  D882  C1 28      CMPB  #$28           ; all 5 cylinders?
  D884  24 03      BCC   loc_D889       ; yes — continue
  D886  7E D7 3E   JMP   loc_D73E       ; to the next cylinder

;------------------------------------------------------------------------------
; 5-BAUD ADDRESS RECEPTION — over the L-line (pin 5, PORT5.6), not over K!
; Only at engine speed ≤ 80 units (C7A7). A falling edge on the line is the start bit:
; wait 30 ticks (middle of the first data bit), then 8 bits every
; 20 ticks (bit = 200 ms), least significant first, then the stop bit (line = 1).
; Address $01 (engine) received — open a session ($80F6.3).
; This gives the tick length: at 5 baud a bit = 200 ms = 20 ticks, so a tick ≈ 10 ms;
; reading in the middle of the bit tolerates an error of up to ≈ ±10 %.
; Cells: $80F6 — session state (bit 3 open, 2 — level of the L-line
; on the previous tick, bits 7-4 — phase of sending the sync bytes); $80F8 — how many
; bits are left; $80F9 — ticks until the next bit; $80FA — address being assembled.
;------------------------------------------------------------------------------
loc_D889:
  D889  CE 80 F6   LDX   #$80F6         ; X = $80F6 (session state)
  D88C  B6 80 18   LDAA  $8018          ; engine speed
  D88F  B1 C7 A7   CMPA  $C7A7          ; above 80 units (≈1780 rpm)?
  D892  22 52      BHI   loc_D8E6       ; yes — close the session
  D894  96 15      LDAA  PORT5          ; port 5
  D896  7D 80 F9   TST   $80F9          ; address reception in progress?
  D899  26 1F      BNE   loc_D8BA       ; yes — count the bits
  D89B  E6 00      LDAB  $00,X          ; line level on the previous tick
  D89D  62 04 00   OIM   #$04,$00,X     ; remember: line = 1
  D8A0  85 40      BITA  #$40           ; L-line (PORT5.6) high?
  D8A2  26 03      BNE   loc_D8A7       ; yes
  D8A4  61 FB 00   AIM   #$FB,$00,X     ; remember: line = 0

loc_D8A7:
  D8A7  C5 04      BITB  #$04           ; was it 1 on the previous tick?
  D8A9  27 3E      BEQ   loc_D8E9       ; no — wait
  D8AB  85 40      BITA  #$40           ; and 1 now as well?
  D8AD  26 3A      BNE   loc_D8E9       ; yes — no edge
  D8AF  CC 09 1E   LDD   #$091E         ; falling edge: 9 bits, first read after 30 ticks
  D8B2  B7 80 F8   STAA  $80F8          ; $80F8 = 9
  D8B5  F7 80 F9   STAB  $80F9          ; $80F9 = 30
  D8B8  20 2F      BRA   loc_D8E9       ; continue

loc_D8BA:
  D8BA  7A 80 F9   DEC   $80F9          ; ticks until the bit - 1
  D8BD  27 02      BEQ   loc_D8C1       ; time to read the bit
  D8BF  20 28      BRA   loc_D8E9       ; wait

loc_D8C1:
  D8C1  7A 80 F8   DEC   $80F8          ; bits left - 1
  D8C4  27 10      BEQ   loc_D8D6       ; all 8 read — stop bit
  D8C6  0D         SEC                  ; bit = 1
  D8C7  85 40      BITA  #$40           ; line high?
  D8C9  26 01      BNE   loc_D8CC       ; yes
  D8CB  0C         CLC                  ; bit = 0

loc_D8CC:
  D8CC  76 80 FA   ROR   $80FA          ; shift the bit into the address (least significant first)
  D8CF  C6 14      LDAB  #$14           ; next bit after 20 ticks (200 ms)
  D8D1  F7 80 F9   STAB  $80F9          ; timer
  D8D4  20 13      BRA   loc_D8E9       ; continue

loc_D8D6:
  D8D6  85 40      BITA  #$40           ; stop bit = 1?
  D8D8  27 0C      BEQ   loc_D8E6       ; no — error, close the session
  D8DA  B6 80 FA   LDAA  $80FA          ; received address
  D8DD  81 01      CMPA  #$01           ; $01 — engine?
  D8DF  26 05      BNE   loc_D8E6       ; no — not for us
  D8E1  62 08 00   OIM   #$08,$00,X     ; open the session ($80F6.3)
  D8E4  20 03      BRA   loc_D8E9       ; continue

loc_D8E6:
  D8E6  61 F7 00   AIM   #$F7,$00,X     ; session closed ($80F6.3 = 0)

;------------------------------------------------------------------------------
; KW1281 SESSION. After the address the unit sends the sync byte $55 (after 29 ticks),
; then the key words $01 (after 6) and $8A (after 2). The baud rate is set by
; RMCR = $06 at reset [?]. The partner acknowledges each byte with its
; inverted byte, except the last one ($03) in the block.
; $80F7: bit 7 — key words acknowledged; 6 — time to send a byte;
; 5 — receiving a tester block; 1 — waiting for acknowledgement of our own byte.
; $80FB — pause before sending (ticks), $80FC — last byte,
; $80FD — response timeout (ticks, $FF — none), $80FE — byte number in the block.
; Tester block: $8104 length, $8100 counter, $8185… title and data.
; Own block: $8103 length, $8100+1 counter, $8105… title and data.
;------------------------------------------------------------------------------
loc_D8E9:
  D8E9  6B 08 00   TIM   #$08,$00,X     ; session open?
  D8EC  26 03      BNE   loc_D8F1       ; yes
  D8EE  7E DC E6   JMP   loc_DCE6       ; no — end of task 0

loc_D8F1:
  D8F1  B6 80 F6   LDAA  $80F6          ; session state
  D8F4  2B 49      BMI   loc_D93F       ; sync bytes sent (bit 7)?
  D8F6  85 10      BITA  #$10           ; byte already waiting to be sent?
  D8F8  26 23      BNE   loc_D91D       ; yes — count down the pause

loc_D8FA:
  D8FA  85 F0      BITA  #$F0           ; phase 0?
  D8FC  26 06      BNE   loc_D904       ; no
  D8FE  86 1D      LDAA  #$1D           ; pause 29 ticks
  D900  C6 55      LDAB  #$55           ; sync byte $55
  D902  20 0E      BRA   loc_D912       ; continue

loc_D904:
  D904  85 40      BITA  #$40           ; phase 1?
  D906  26 06      BNE   loc_D90E       ; no
  D908  86 06      LDAA  #$06           ; pause 6 ticks
  D90A  C6 01      LDAB  #$01           ; key word $01
  D90C  20 04      BRA   loc_D912       ; continue

loc_D90E:
  D90E  86 02      LDAA  #$02           ; pause 2 ticks
  D910  C6 8A      LDAB  #$8A           ; key word $8A

loc_D912:
  D912  B7 80 FB   STAA  $80FB          ; $80FB = pause
  D915  F7 80 FC   STAB  $80FC          ; $80FC = byte
  D918  62 10 00   OIM   #$10,$00,X     ; byte waiting to be sent
  D91B  20 22      BRA   loc_D93F       ; continue

loc_D91D:
  D91D  7A 80 FB   DEC   $80FB          ; pause - 1
  D920  27 02      BEQ   loc_D924       ; expired
  D922  20 1B      BRA   loc_D93F       ; wait

loc_D924:
  D924  B6 80 FC   LDAA  $80FC          ; byte
  D927  97 13      STAA  TDR            ; send to SCI
  D929  0F         SEI                  ; disable interrupts
  D92A  B6 80 F6   LDAA  $80F6          ; state
  D92D  16         TAB                  ; copy
  D92E  84 0F      ANDA  #$0F           ; lower half
  D930  C4 F0      ANDB  #$F0           ; phase
  D932  58         ASLB                 ; next phase
  D933  1B         ABA                  ; combine
  D934  B7 80 F6   STAA  $80F6          ; store
  D937  0E         CLI                  ; enable interrupts
  D938  2A C0      BPL   loc_D8FA       ; not the last — next byte
  D93A  86 16      LDAA  #$16           ; wait for the response $75 (inverse of $8A) 22 ticks
  D93C  B7 80 FD   STAA  $80FD          ; timeout

loc_D93F:
  D93F  CE 80 F7   LDX   #$80F7         ; exchange flags
  D942  6B 40 00   TIM   #$40,$00,X     ; time to send a byte?
  D945  27 03      BEQ   loc_D94A       ; no
  D947  7E DA 59   JMP   loc_DA59       ; yes — sending

loc_D94A:
  D94A  7B 80 11   TIM   #$80,TRCSR1    ; byte received (RDRF)?
  D94D  26 5A      BNE   loc_D9A9       ; yes — parse

loc_D94F:
  D94F  B6 80 FD   LDAA  $80FD          ; timeout
  D952  81 FF      CMPA  #$FF           ; not running ($FF)?
  D954  27 51      BEQ   loc_D9A7       ; yes — continue
  D956  4D         TSTA                 ; expired?
  D957  27 05      BEQ   loc_D95E       ; yes
  D959  7A 80 FD   DEC   $80FD          ; - 1
  D95C  20 49      BRA   loc_D9A7       ; continue

loc_D95E:
  D95E  6B 80 00   TIM   #$80,$00,X     ; key words acknowledged?
  D961  26 17      BNE   loc_D97A       ; yes
  D963  7C 80 FE   INC   $80FE          ; attempts + 1
  D966  B6 80 FE   LDAA  $80FE          ; value
  D969  81 03      CMPA  #$03           ; greater than 3? (before the key words $80FE is usually 0, so almost always no)
  D96B  22 03      BHI   loc_D970       ; yes — restart the sync bytes

loc_D96D:
  D96D  7E DC E6   JMP   loc_DCE6       ; exchange reset — session closed (DCE6)

loc_D970:
  D970  CE 80 00   LDX   #$8000         ; X = $8000
  D973  61 0F F6   AIM   #$0F,$F6,X     ; sync byte phase to zero (the session stays open)
  D976  6A FD      DEC   $FD,X          ; timeout = $FF
  D978  20 6C      BRA   loc_D9E6       ; continue

loc_D97A:
  D97A  B6 80 FE   LDAA  $80FE          ; byte number
  D97D  6B 20 00   TIM   #$20,$00,X     ; receiving a tester block?
  D980  26 0D      BNE   loc_D98F       ; yes
  D982  4D         TSTA                 ; nothing sent?
  D983  27 E8      BEQ   loc_D96D       ; yes — exchange reset
  D985  62 40 00   OIM   #$40,$00,X     ; repeat the sending
  D988  86 05      LDAA  #$05           ; pause 5 ticks
  D98A  B7 80 FB   STAA  $80FB          ; store
  D98D  20 0D      BRA   loc_D99C       ; continue

loc_D98F:
  D98F  B1 81 04   CMPA  $8104          ; whole block received?
  D992  26 03      BNE   loc_D997       ; no
  D994  7E DA 44   JMP   loc_DA44       ; yes — parse the command

loc_D997:
  D997  86 0A      LDAA  #$0A           ; timeout 10 ticks
  D999  B7 80 FD   STAA  $80FD          ; store

loc_D99C:
  D99C  7F 80 FE   CLR   $80FE          ; byte number = 0
  D99F  6B 02 00   TIM   #$02,$00,X     ; already waited for acknowledgement?
  D9A2  26 C9      BNE   loc_D96D       ; yes — exchange reset
  D9A4  62 02 00   OIM   #$02,$00,X     ; waiting

loc_D9A7:
  D9A7  20 3D      BRA   loc_D9E6       ; continue

loc_D9A9:
  D9A9  7B 40 11   TIM   #$40,TRCSR1    ; receive error (overrun/framing)?
  D9AC  27 06      BEQ   loc_D9B4       ; no
  D9AE  96 11      LDAA  TRCSR1         ; reset the error
  D9B0  96 12      LDAA  RDR            ; discard the byte
  D9B2  20 9B      BRA   loc_D94F       ; continue

loc_D9B4:
  D9B4  96 11      LDAA  TRCSR1         ; read the status
  D9B6  96 12      LDAA  RDR            ; byte
  D9B8  B7 80 FF   STAA  $80FF          ; $80FF = received byte
  D9BB  61 FD 00   AIM   #$FD,$00,X     ; acknowledgement received
  D9BE  6B 20 00   TIM   #$20,$00,X     ; receiving a tester block?
  D9C1  26 26      BNE   loc_D9E9       ; yes — save the byte
  D9C3  73 80 FC   COM   $80FC          ; expected response = inverse of our own byte
  D9C6  B1 80 FC   CMPA  $80FC          ; matched?
  D9C9  26 84      BNE   loc_D94F       ; no — keep waiting
  D9CB  6B 80 00   TIM   #$80,$00,X     ; key words already acknowledged?
  D9CE  26 10      BNE   loc_D9E0       ; yes
  D9D0  62 80 00   OIM   #$80,$00,X     ; acknowledged
  D9D3  86 05      LDAA  #$05           ; pause 5 ticks
  D9D5  B7 80 FB   STAA  $80FB          ; store
  D9D8  7F 80 FE   CLR   $80FE          ; byte number = 0
  D9DB  3C         PSHX                 ; save X
  D9DC  BD DA FF   JSR   KW_IDENT       ; first block — unit identification
  D9DF  38         PULX                 ; restore X

loc_D9E0:
  D9E0  62 40 00   OIM   #$40,$00,X     ; time to send
  D9E3  72 10 11   OIM   #$10,TRCSR1    ; enable the SCI receive interrupt

loc_D9E6:
  D9E6  7E DD 03   JMP   loc_DD03       ; to the end of task 0

loc_D9E9:
  D9E9  B6 80 FF   LDAA  $80FF          ; received byte
  D9EC  F6 80 FE   LDAB  $80FE          ; byte number
  D9EF  26 05      BNE   loc_D9F6       ; not the first
  D9F1  B7 81 04   STAA  $8104          ; first — block length
  D9F4  20 07      BRA   loc_D9FD       ; continue

