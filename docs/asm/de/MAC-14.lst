  DEC8  25 03      BCS   loc_DECD       ; ja — Leerlauf
  DECA  7E DF C6   JMP   loc_DFC6       ; nein — Zündkennfeld

;------------------------------------------------------------------------------
; Leerlauf: Zündwinkelkorrektur $800F nach Höhe und Kühlmitteltemperatur —
; Tabelle C2D0 4×4 (Zeile — Höhe 0…3, Spalte — G62 auf Achse C2CC = 197 189 180 158).
; Werte 0…8, größer bei Kälte und auf Meereshöhe.
; Winkeleinheit [Vermutung]: Wert v -> $8022 = (v + 40) × 0,75 - 30 Halbzähne
; (1 Halbzahn = 1,333°), also 1 Einh. ≈ 1°. Größeres v — spätere Zündung.
;------------------------------------------------------------------------------
loc_DECD:
  DECD  B6 80 04   LDAA  $8004          ; Luftdruck
  DED0  CE C2 B0   LDX   #$C2B0         ; Achse C2B0
  DED3  C6 04      LDAB  #$04           ; 4 Stützstellen
  DED5  BD CA 6B   JSR   AXIS_DN        ; Höhenindex
  DED8  86 04      LDAA  #$04           ; × 4
  DEDA  3D         MUL                  ; Tabellenzeile
  DEDB  F7 80 0F   STAB  $800F          ; sichern
  DEDE  CE C2 CC   LDX   #$C2CC         ; Temperaturachse C2CC
  DEE1  B6 80 1B   LDAA  $801B          ; G62
  DEE4  C6 04      LDAB  #$04           ; 4 Stützstellen
  DEE6  BD CA 6B   JSR   AXIS_DN        ; Intervall suchen
  DEE9  37         PSHB                 ; Index
  DEEA  BD CA 10   JSR   FRAC_DN        ; Anteil
  DEED  17         TBA                  ; A = Anteil
  DEEE  33         PULB                 ; B = Index
  DEEF  FB 80 0F   ADDB  $800F          ; + Zeile
  DEF2  CE C2 D0   LDX   #$C2D0         ; Tabelle C2D0
  DEF5  3A         ABX                  ; X -> Wert
  DEF6  16         TAB                  ; B = Anteil
  DEF7  BD CA 41   JSR   INTERP         ; Interpolation
  DEFA  B7 80 0F   STAA  $800F          ; $800F = Leerlaufkorrektur
  DEFD  B6 80 18   LDAA  $8018          ; Drehzahl
  DF00  B1 C2 10   CMPA  $C210          ; unter 40 Einh. (≈890 U/min)?
  DF03  25 09      BCS   loc_DF0E       ; ja — DLS
