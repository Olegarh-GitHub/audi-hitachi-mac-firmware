;------------------------------------------------------------------------------
; IS_IDLE — дроссель закрыт (концевик ХХ F60)?
; Выход: C = 1 — закрыт. Если обороты не ниже первой точки оси C210
; (40 ед. ≈ 890 об/мин) и концевик ХХ признан неисправным ($8093.3),
; ответ всегда «не закрыт».
;------------------------------------------------------------------------------
IS_IDLE:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  D1E5  B6 80 18   LDAA  $8018          ; обороты
  D1E8  B1 C2 10   CMPA  $C210          ; ниже 40 ед. (≈890 об/мин)?
  D1EB  25 07      BCS   loc_D1F4       ; да — верить концевику
  D1ED  86 08      LDAA  #$08           ; бит неисправности концевика ХХ
  D1EF  B5 80 93   BITA  $8093          ; концевик ХХ неисправен?
  D1F2  26 08      BNE   loc_D1FC       ; да — считать, что дроссель открыт

loc_D1F4:
  D1F4  8D 1F      BSR   RD_INPUTS      ; прочитать дискретные входы (рег. $19 чипа)
  D1F6  85 20      BITA  #$20           ; бит 5 — концевик ХХ F60
  D1F8  27 02      BEQ   loc_D1FC       ; разомкнут? да — дроссель открыт
  D1FA  0D         SEC                  ; замкнут: C = 1
  D1FB  39         RTS

loc_D1FC:
  D1FC  0C         CLC                  ; C = 0: дроссель открыт
  D1FD  39         RTS

;------------------------------------------------------------------------------
; MAP_BAD_LOAD — G71 неисправен и мотор под нагрузкой?
; Выход: C = 1, если есть ошибка давления ($8091 & $72), обороты не ниже
; 40 ед. и дроссель не закрыт. Тогда вместо замера давления берут
; подстановку $C79E.
;------------------------------------------------------------------------------
MAP_BAD_LOAD:                           ; вызов из: TASK1, TASK3
  D1FE  86 72      LDAA  #$72           ; биты ошибок давления
  D200  B5 80 91   BITA  $8091          ; ошибки давления есть?
  D203  27 0E      BEQ   loc_D213       ; нет — C = 0
  D205  B6 80 18   LDAA  $8018          ; обороты
  D208  B1 C2 10   CMPA  $C210          ; ниже 40 ед. (≈890 об/мин)?
  D20B  25 06      BCS   loc_D213       ; да — C = 0
  D20D  8D D6      BSR   IS_IDLE        ; дроссель закрыт?
  D20F  25 02      BCS   loc_D213       ; да — C = 0
  D211  0D         SEC                  ; C = 1: брать подстановку давления
  D212  39         RTS

loc_D213:
  D213  0C         CLC                  ; C = 0
  D214  39         RTS

;------------------------------------------------------------------------------
; RD_INPUTS — прочитать регистр $19 чипа: дискретные входы.
; Бит 5 — F60 (ХХ), бит 4 — F81 (полный газ), бит 3 — стоп-сигнал,
; бит 2 — читается назад выход N115. 1 = контакт замкнут [Пр по логике].
;------------------------------------------------------------------------------
RD_INPUTS:                              ; вызов из: TASK0, TASK1, TASK2, TASK3
  D215  86 19      LDAA  #$19           ; номер регистра $19

;------------------------------------------------------------------------------
; CHIP_RD — прочитать регистр чипа $0100: A = номер, на выходе A = данные.
; Прерывания запрещены, чтобы IRQ не сбил номер регистра между записью и чтением.
;------------------------------------------------------------------------------
CHIP_RD:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  D217  0F         SEI                  ; запрет прерываний
  D218  B7 01 00   STAA  $0100          ; номер регистра
  D21B  B6 01 01   LDAA  $0101          ; данные
  D21E  0E         CLI                  ; разрешить прерывания
  D21F  39         RTS

;------------------------------------------------------------------------------
; ЗАДАЧА 0 — каждый тик (≈10 мс).
; 1) PORT6.7 переключается: сигнал внешней схеме, что программа работает.
; 2) PORT2.5 [?] = 1 при оборотах ≥ 20 ед. (≈440-480 об/мин), только после синхронизации.
; 3) Опрос АЦП чипа: каналы 0-5 -> $8019-$801E, 7 -> $8020. Канал 6 (детонация)
;   здесь не читается. Канал 4 ($801D) читается один раз — в первый тик после
;   синхронизации ($8075.0).
;------------------------------------------------------------------------------
