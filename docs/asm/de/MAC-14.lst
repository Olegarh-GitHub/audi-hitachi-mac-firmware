  D31A  B1 80 7B   CMPA  $807B          ; kälter als bisher?
  D31D  25 03      BCS   loc_D322       ; nein
  D31F  B7 80 7B   STAA  $807B          ; $807B = neue niedrigste Temperatur

;------------------------------------------------------------------------------
; DREHZAHL. Der Chip zählt je Tick die Zähne des Zahnkranzes (G28), Register $0C/$0D -> $8026/$8027.
; $8018 — Drehzahl in Einh. (≈22…24 U/min je Einh. [Vermutung]). Ab 31 Einh. —
; Zählwert des letzten Ticks direkt; unter 31 — Mittelwert über 8 Ticks (beim Anlassen
; ist der Zählwert klein und springt). Mehr als 255 — 255.
; $8098 sammelt Zähne zwischen G4-Marken: 540 ohne Marke — Verdacht
; und Fehler G4 (2112). Die Marke wird vom Interrupt verarbeitet (CC83).
;------------------------------------------------------------------------------
loc_D322:
  D322  C6 0C      LDAB  #$0C           ; Register $0C — Zahnzählung, High-Byte
  D324  CE 01 00   LDX   #$0100         ; X -> Chip
  D327  0F         SEI                  ; Interrupts sperren
  D328  E7 00      STAB  $00,X          ; Register auswählen
  D32A  A6 01      LDAA  $01,X          ; High-Byte
  D32C  5C         INCB                 ; Register $0D
  D32D  E7 00      STAB  $00,X          ; auswählen
  D32F  E6 01      LDAB  $01,X          ; Low-Byte
  D331  0E         CLI                  ; Interrupts freigeben
  D332  FD 80 26   STD   $8026          ; $8026/$8027 = Zähne je Tick
  D335  CE 80 00   LDX   #$8000         ; X = $8000
  D338  4D         TSTA                 ; Zähne vorhanden?
  D339  26 03      BNE   loc_D33E       ; ja
  D33B  5D         TSTB                 ; Low-Byte
  D33C  27 09      BEQ   loc_D347       ; nein — es gab keine Zähne

loc_D33E:
  D33E  62 08 95   OIM   #$08,$95,X     ; Zähne vorhanden ($8095.3)
  D341  62 40 03   OIM   #$40,$03,X     ; „Zähne schon erkannt“ ($8003.6)
  D344  BD F7 26   JSR   TEST_EXIT      ; Stellglieddiagnose verlassen: der Motor dreht

loc_D347:
  D347  F3 80 98   ADDD  $8098          ; Zähne zwischen G4-Marken sammeln
  D34A  FD 80 98   STD   $8098          ; speichern
  D34D  83 02 1C   SUBD  #$021C         ; 540 erreicht?
  D350  25 17      BCS   loc_D369       ; nein
  D352  86 10      LDAA  #$10           ; gab es in dieser Zeit eine G4-Marke ($8095.4)?
  D354  B5 80 95   BITA  $8095          ; prüfen
  D357  26 05      BNE   loc_D35E       ; ja — zurücksetzen
  D359  62 30 94   OIM   #$30,$94,X     ; keine Marke: Fehler G4 (2112) und Verdacht
  D35C  20 0B      BRA   loc_D369       ; weiter

loc_D35E:
  D35E  61 DF 94   AIM   #$DF,$94,X     ; Verdacht löschen
  D361  4F         CLRA                 ; D = 0
  D362  5F         CLRB                 ; (D = 0)
  D363  FD 80 98   STD   $8098          ; Zählung ab null
  D366  61 EF 95   AIM   #$EF,$95,X     ; Merker „Marke war da“ löschen

loc_D369:
  D369  F6 80 27   LDAB  $8027          ; Zähne, Low-Byte
  D36C  7D 80 26   TST   $8026          ; High-Byte nicht null?
  D36F  27 02      BEQ   loc_D373       ; nein
  D371  C6 FF      LDAB  #$FF           ; mehr als 255 — 255

loc_D373:
  D373  CE 80 00   LDX   #$8000         ; X = $8000
  D376  C1 1F      CMPB  #$1F           ; 31 oder mehr?
  D378  24 13      BCC   loc_D38D       ; ja — direkt übernehmen
  D37A  A6 83      LDAA  $83,X          ; gesammelte Ticks
  D37C  81 08      CMPA  #$08           ; schon 8?
  D37E  24 08      BCC   loc_D388       ; ja — Mittelwert
  D380  EB 84      ADDB  $84,X          ; Summe
  D382  E7 84      STAB  $84,X          ; speichern
  D384  6C 83      INC   $83,X          ; Ticks + 1
  D386  20 0B      BRA   loc_D393       ; $8018 vorerst nicht ändern

loc_D388:
  D388  E6 84      LDAB  $84,X          ; Summe über 8 Ticks
  D38A  54         LSRB                 ; / 8
  D38B  54         LSRB                 ; (/ 8)
  D38C  54         LSRB                 ; (/ 8)

loc_D38D:
  D38D  6F 83      CLR   $83,X          ; Ticks = 0
  D38F  6F 84      CLR   $84,X          ; Summe = 0
  D391  E7 18      STAB  $18,X          ; $8018 = Drehzahl

loc_D393:
  D393  6B 20 03   TIM   #$20,$03,X     ; Atmosphärendruck schon erfasst ($8003.5)?
  D396  26 0C      BNE   loc_D3A4       ; ja
  D398  A6 19      LDAA  $19,X          ; Druck G71 im ersten Tick nach dem Einschalten
  D39A  5D         TSTB                 ; Rest von altem Code (ändert nichts)
  D39B  20 02      BRA   loc_D39F       ; weiter

; Tabelle $D39D, 2 Bytes: tote Bytes von altem Code
  D39D  db 86 80

loc_D39F:
  D39F  A7 04      STAA  $04,X          ; $8004 = Atmosphärendruck
  D3A1  62 20 03   OIM   #$20,$03,X     ; erfasst

loc_D3A4:
  D3A4  A6 04      LDAA  $04,X          ; Atmosphärendruck

;------------------------------------------------------------------------------
; N17 — KALTSTARTVENTIL. Alle Zeiten in Ticks (≈10 ms).
; Höhe: $802D = Stützstellenindex für den Atmosphärendruck $8004 auf der Achse C2B0
; (128 122 109 102): 0 — auf Meereshöhe (> 122), 3 — große Höhe (≤ 102).
; Betriebsarten (wirken erst nach der ersten Synchronisation, $8075.0):
; 1) Test 4443: 2 Ticks offen, 98 geschlossen, insgesamt 1000 Ticks (10 s).
; 2) Start des kalten Motors (kälter als ≈ +37 °C, $8075.4 = 0), bis die
;   Verzögerung nach dem Start abgelaufen ist: Dauer nach der niedrigsten Temperatur $807B —
;   C664 (120 50 10 0) × 10 Ticks über die Achse C660 (216 205 169 90), verringert
;   im Verhältnis ($8079 - $801D) / $8079, wobei $8079 aus C66C (214 154 79 29) stammt.
;   Impulse nach Höhe: offen C2B4 / geschlossen C2B8 = 255/0 (auf Meereshöhe —
;   durchgehend), 20/5, 10/10, 5/10.
; 3) Nach dem Start (kälter als ≈ +4 °C, $8075.3 = 0): C674 (30 20 10 0) × 10 Ticks
;   über die Achse C670 (211 205 189 169), Impulse 5 offen / 10 geschlossen.
; 4) Heißstart (heißer als ≈ 100 °C, $8075.2 = 1): 200 Ticks warten, dann
;   10 offen / 30 geschlossen, bis 400 Ticks abgelaufen sind (C6C3, C6C5, C6C6, C6C8).
; 5) Druckanstieg (nach den Betriebsarten 2-4, Motor kälter als ≈ 65 °C, Drosselklappe nicht
;   geschlossen): Druckzunahme in 40 ms ($8073) -> Öffnungszeit aus C678/C680,
;   gewichtet nach Temperatur (C690 -> C694). Der zweite Ausgang ($8077.6) ist der Merker
;   „Anreicherung erfolgt“ für das Gemisch.
; Merker: $8075.7 — Startbetrieb läuft, .6 — Startbetrieb beendet,
; .5 — Nachstartbetrieb beendet; $8076.7 — Ventil offen (Betriebsart 4),
; .5 und .3 — Betriebsarten 2-4 durchlaufen. $80AA — wie viele Ticks übrig sind, $80AC — Timer
; der Impulsphase.
; Anmerkung: Bits 0 und 1 von $8076 (D3F5-D430) vergleichen den Höhenindex 0…3 mit
; den Schwellen 28 und 26, werden deshalb immer gelöscht; die davon abhängigen Zweige laufen nie.
; Nachweis (per Skript über den gesamten Code geprüft, 2026-11-18):
; - D3F5 wird nur von D3B6 (B = Höhenindex aus AXIS_DN, 0…3) und
;   durchlaufend von D3ED (B = 0) erreicht; D3F5-D430 wird vor jedem D475 durchlaufen;
; - $8076 wird nur von D3FE-D42E, D447, D627, D648 geschrieben; D627/D648 schreiben A,
;   das bei D475 aus $8076 geholt wurde, und die Bits 0/1 werden unterwegs nicht gesetzt;
; - indizierte Schreibzugriffe mit Offset $76 und 16-Bit-Schreibzugriffe auf $8075 gibt es nirgends.
; Bit 2 wird nur bei D63B gesetzt, das nur mit Bit 1 erreicht wird — also ebenfalls nie (siehe Kopf).
; Der Zweig D5A8-D5B5 läuft wegen der Kalibrierung C78F = 0 nicht (in einer anderen Software evtl. doch).
; Einzige Einschränkung: Wenn ein Tester über die K-Leitung ins RAM schreiben kann, könnte er
; diese Bits von Hand setzen (die KW1281-Befehle sind noch nicht analysiert).
;------------------------------------------------------------------------------
  D3A6  CE C2 B0   LDX   #$C2B0         ; Achse des Atmosphärendrucks C2B0
  D3A9  C6 04      LDAB  #$04           ; 4 Stützstellen
  D3AB  BD CA 6B   JSR   AXIS_DN        ; Stützstellenindex (A = $8004)
  D3AE  F7 80 2D   STAB  $802D          ; $802D = Höhe 0…3
  D3B1  B6 80 03   LDAA  $8003          ; Flags $8003
  D3B4  85 10      BITA  #$10           ; Motor hat gedreht oder Test beendet ($8003.4)?
  D3B6  26 3D      BNE   loc_D3F5       ; ja — normaler Betrieb
  D3B8  86 10      LDAA  #$10           ; Testschritt N17?
  D3BA  B5 80 AF   BITA  $80AF          ; prüfen
  D3BD  27 2E      BEQ   loc_D3ED       ; nein — Zähler auf null
  D3BF  FE 80 AA   LDX   $80AA          ; Testzeit
  D3C2  8C 03 E8   CPX   #$03E8         ; 1000 Ticks (10 s) vergangen?
  D3C5  24 1C      BCC   loc_D3E3       ; ja — schließen
  D3C7  08         INX                  ; + 1
  D3C8  FF 80 AA   STX   $80AA          ; speichern
  D3CB  B6 80 AC   LDAA  $80AC          ; Phasentimer
  D3CE  27 03      BEQ   loc_D3D3       ; null — umschalten
  D3D0  4A         DECA                 ; - 1
