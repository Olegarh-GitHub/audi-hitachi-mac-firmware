  DDDC  F7 80 0C   STAB  $800C          ; $800C = номер
  DDDF  BD CA 05   JSR   FRAC_UP        ; доля
  DDE2  F7 80 0D   STAB  $800D          ; $800D = доля
  DDE5  F6 80 0C   LDAB  $800C          ; номер
  DDE8  CE C2 30   LDX   #$C230         ; таблица C230 (11 … 80)
  DDEB  3A         ABX                  ; X -> значение
  DDEC  F6 80 0D   LDAB  $800D          ; доля
