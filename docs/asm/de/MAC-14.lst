;------------------------------------------------------------------------------
; EMPFANG DER 5-BAUD-ADRESSE — über die L-Leitung (Kontakt 5, PORT5.6), nicht über K!
; Nur bei Drehzahl ≤ 80 Einh. (C7A7). Eine fallende Flanke auf der Leitung ist das Startbit:
; 30 Ticks warten (Mitte des ersten Datenbits), dann 8 Bits im Abstand von
; 20 Ticks (Bit = 200 ms), niederwertigstes zuerst, dann das Stoppbit (Leitung = 1).
; Adresse $01 (Motor) empfangen — Sitzung eröffnen ($80F6.3).
; Daraus ergibt sich die Ticklänge: bei 5 Baud ist ein Bit = 200 ms = 20 Ticks, also Tick ≈ 10 ms;
; das Lesen in der Bitmitte toleriert einen Fehler von bis zu ≈ ±10 %.
; Zellen: $80F6 — Sitzungszustand (Bit 3 offen, 2 — Pegel der L-Leitung
; im vorigen Tick, Bits 7-4 — Phase beim Senden der Synchronbytes); $80F8 — wie viele
; Bits übrig sind; $80F9 — Ticks bis zum nächsten Bit; $80FA — die zusammengesetzte Adresse.
;------------------------------------------------------------------------------
loc_D889:
  D889  CE 80 F6   LDX   #$80F6         ; X = $80F6 (Sitzungszustand)
  D88C  B6 80 18   LDAA  $8018          ; Drehzahl
  D88F  B1 C7 A7   CMPA  $C7A7          ; über 80 Einh. (≈1780 U/min)?
  D892  22 52      BHI   loc_D8E6       ; ja — Sitzung schließen
  D894  96 15      LDAA  PORT5          ; Port 5
  D896  7D 80 F9   TST   $80F9          ; Adressempfang läuft?
  D899  26 1F      BNE   loc_D8BA       ; ja — Bits zählen
  D89B  E6 00      LDAB  $00,X          ; Leitungspegel im vorigen Tick
  D89D  62 04 00   OIM   #$04,$00,X     ; merken: Leitung = 1
  D8A0  85 40      BITA  #$40           ; L-Leitung (PORT5.6) high?
  D8A2  26 03      BNE   loc_D8A7       ; ja
  D8A4  61 FB 00   AIM   #$FB,$00,X     ; merken: Leitung = 0

loc_D8A7:
  D8A7  C5 04      BITB  #$04           ; war sie im vorigen Tick 1?
  D8A9  27 3E      BEQ   loc_D8E9       ; nein — warten
  D8AB  85 40      BITA  #$40           ; und jetzt auch 1?
  D8AD  26 3A      BNE   loc_D8E9       ; ja — keine Flanke
  D8AF  CC 09 1E   LDD   #$091E         ; fallende Flanke: 9 Bits, erstes Lesen nach 30 Ticks
  D8B2  B7 80 F8   STAA  $80F8          ; $80F8 = 9
  D8B5  F7 80 F9   STAB  $80F9          ; $80F9 = 30
  D8B8  20 2F      BRA   loc_D8E9       ; weiter

loc_D8BA:
  D8BA  7A 80 F9   DEC   $80F9          ; Ticks bis zum Bit - 1
  D8BD  27 02      BEQ   loc_D8C1       ; Zeit, das Bit zu lesen
  D8BF  20 28      BRA   loc_D8E9       ; warten

loc_D8C1:
  D8C1  7A 80 F8   DEC   $80F8          ; verbleibende Bits - 1
  D8C4  27 10      BEQ   loc_D8D6       ; alle 8 gelesen — Stoppbit
  D8C6  0D         SEC                  ; Bit = 1
  D8C7  85 40      BITA  #$40           ; Leitung high?
  D8C9  26 01      BNE   loc_D8CC       ; ja
  D8CB  0C         CLC                  ; Bit = 0

loc_D8CC:
  D8CC  76 80 FA   ROR   $80FA          ; Bit in die Adresse schieben (niederwertigstes zuerst)
  D8CF  C6 14      LDAB  #$14           ; nächstes Bit nach 20 Ticks (200 ms)
  D8D1  F7 80 F9   STAB  $80F9          ; Timer
  D8D4  20 13      BRA   loc_D8E9       ; weiter

loc_D8D6:
  D8D6  85 40      BITA  #$40           ; Stoppbit = 1?
  D8D8  27 0C      BEQ   loc_D8E6       ; nein — Fehler, Sitzung schließen
  D8DA  B6 80 FA   LDAA  $80FA          ; empfangene Adresse
  D8DD  81 01      CMPA  #$01           ; $01 — Motor?
  D8DF  26 05      BNE   loc_D8E6       ; nein — nicht für uns
  D8E1  62 08 00   OIM   #$08,$00,X     ; Sitzung eröffnen ($80F6.3)
  D8E4  20 03      BRA   loc_D8E9       ; weiter

loc_D8E6:
  D8E6  61 F7 00   AIM   #$F7,$00,X     ; Sitzung geschlossen ($80F6.3 = 0)

;------------------------------------------------------------------------------
; KW1281-SITZUNG. Nach der Adresse sendet das Steuergerät das Synchronbyte $55 (nach 29 Ticks),
; dann die Schlüsselwörter $01 (nach 6) und $8A (nach 2). Die Baudrate legt
; RMCR = $06 beim Reset fest [?]. Jedes Byte bestätigt der Partner mit seinem
; invertierten Byte, außer dem letzten ($03) im Block.
; $80F7: Bit 7 — Schlüsselwörter bestätigt; 6 — Zeit, ein Byte zu senden;
; 5 — Block des Testers wird empfangen; 1 — warten auf Bestätigung des eigenen Bytes.
; $80FB — Pause vor dem Senden (Ticks), $80FC — letztes Byte,
; $80FD — Antwort-Timeout (Ticks, $FF — keins), $80FE — Bytenummer im Block.
; Block des Testers: $8104 Länge, $8100 Zähler, $8185… Titel und Daten.
; Eigener Block: $8103 Länge, $8100+1 Zähler, $8105… Titel und Daten.
;------------------------------------------------------------------------------
loc_D8E9:
  D8E9  6B 08 00   TIM   #$08,$00,X     ; Sitzung offen?
  D8EC  26 03      BNE   loc_D8F1       ; ja
  D8EE  7E DC E6   JMP   loc_DCE6       ; nein — Ende von Task 0

loc_D8F1:
  D8F1  B6 80 F6   LDAA  $80F6          ; Sitzungszustand
  D8F4  2B 49      BMI   loc_D93F       ; Synchronbytes gesendet (Bit 7)?
  D8F6  85 10      BITA  #$10           ; wartet schon ein Byte auf das Senden?
  D8F8  26 23      BNE   loc_D91D       ; ja — Pause abzählen

loc_D8FA:
  D8FA  85 F0      BITA  #$F0           ; Phase 0?
  D8FC  26 06      BNE   loc_D904       ; nein
  D8FE  86 1D      LDAA  #$1D           ; Pause 29 Ticks
  D900  C6 55      LDAB  #$55           ; Synchronbyte $55
  D902  20 0E      BRA   loc_D912       ; weiter

loc_D904:
  D904  85 40      BITA  #$40           ; Phase 1?
  D906  26 06      BNE   loc_D90E       ; nein
  D908  86 06      LDAA  #$06           ; Pause 6 Ticks
  D90A  C6 01      LDAB  #$01           ; Schlüsselwort $01
  D90C  20 04      BRA   loc_D912       ; weiter

loc_D90E:
  D90E  86 02      LDAA  #$02           ; Pause 2 Ticks
  D910  C6 8A      LDAB  #$8A           ; Schlüsselwort $8A

loc_D912:
  D912  B7 80 FB   STAA  $80FB          ; $80FB = Pause
  D915  F7 80 FC   STAB  $80FC          ; $80FC = Byte
  D918  62 10 00   OIM   #$10,$00,X     ; Byte wartet auf das Senden
  D91B  20 22      BRA   loc_D93F       ; weiter

loc_D91D:
  D91D  7A 80 FB   DEC   $80FB          ; Pause - 1
  D920  27 02      BEQ   loc_D924       ; abgelaufen
  D922  20 1B      BRA   loc_D93F       ; warten

loc_D924:
  D924  B6 80 FC   LDAA  $80FC          ; Byte
  D927  97 13      STAA  TDR            ; an SCI senden
  D929  0F         SEI                  ; Interrupts sperren
  D92A  B6 80 F6   LDAA  $80F6          ; Zustand
  D92D  16         TAB                  ; Kopie
  D92E  84 0F      ANDA  #$0F           ; untere Hälfte
  D930  C4 F0      ANDB  #$F0           ; Phase
  D932  58         ASLB                 ; nächste Phase
  D933  1B         ABA                  ; zusammensetzen
  D934  B7 80 F6   STAA  $80F6          ; schreiben
  D937  0E         CLI                  ; Interrupts freigeben
  D938  2A C0      BPL   loc_D8FA       ; nicht das letzte — nächstes Byte
  D93A  86 16      LDAA  #$16           ; auf Antwort $75 (Inversion von $8A) 22 Ticks warten
  D93C  B7 80 FD   STAA  $80FD          ; Timeout

loc_D93F:
  D93F  CE 80 F7   LDX   #$80F7         ; Austauschflags
  D942  6B 40 00   TIM   #$40,$00,X     ; Zeit, ein Byte zu senden?
  D945  27 03      BEQ   loc_D94A       ; nein
  D947  7E DA 59   JMP   loc_DA59       ; ja — Senden

loc_D94A:
  D94A  7B 80 11   TIM   #$80,TRCSR1    ; Byte empfangen (RDRF)?
  D94D  26 5A      BNE   loc_D9A9       ; ja — auswerten

loc_D94F:
  D94F  B6 80 FD   LDAA  $80FD          ; Timeout
  D952  81 FF      CMPA  #$FF           ; läuft nicht ($FF)?
  D954  27 51      BEQ   loc_D9A7       ; ja — weiter
  D956  4D         TSTA                 ; abgelaufen?
  D957  27 05      BEQ   loc_D95E       ; ja
  D959  7A 80 FD   DEC   $80FD          ; - 1
  D95C  20 49      BRA   loc_D9A7       ; weiter

loc_D95E:
  D95E  6B 80 00   TIM   #$80,$00,X     ; Schlüsselwörter bestätigt?
  D961  26 17      BNE   loc_D97A       ; ja
  D963  7C 80 FE   INC   $80FE          ; Versuche + 1
  D966  B6 80 FE   LDAA  $80FE          ; Wert
