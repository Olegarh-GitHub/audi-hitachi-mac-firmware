  F8AC  db FF FF FF FF

;------------------------------------------------------------------------------
; Patch: solange ein Code per Blinkcode ausgegeben wird ($80A9.3), ist der SCI-Sender
; abgeschaltet und P24 (TX, Kontakt 28) auf 0 gehalten. Sonst wird der Sender eingeschaltet.
; Offenbar zeigt die K-Leitung in dieser Zeit ebenfalls den Code [Vermutung].
;------------------------------------------------------------------------------
loc_F8B0:
  F8B0  6B 08 A9   TIM   #$08,$A9,X     ; Codeausgabe läuft?
  F8B3  27 08      BEQ   loc_F8BD       ; nein
  F8B5  71 FD 11   AIM   #$FD,TRCSR1    ; SCI-Sender abschalten
  F8B8  71 EF 03   AIM   #$EF,PORT2     ; P24 = 0
  F8BB  20 0B      BRA   loc_F8C8       ; weiter

loc_F8BD:
  F8BD  7B 02 11   TIM   #$02,TRCSR1    ; Sender eingeschaltet?
  F8C0  26 06      BNE   loc_F8C8       ; ja
  F8C2  72 10 03   OIM   #$10,PORT2     ; P24 = 1
  F8C5  72 02 11   OIM   #$02,TRCSR1    ; Sender einschalten

loc_F8C8:
  F8C8  7E D1 D1   JMP   loc_D1D1       ; Ende von Task 3 — zum Dispatcher

; Tabelle $F8CB, 5 Bytes: leer
  F8CB  db FF FF FF FF FF

;------------------------------------------------------------------------------
; Patch zu F308: $80A9.3 löschen; wenn $806E.3 = 0 — $806E.4 setzen [?].
;------------------------------------------------------------------------------
loc_F8D0:
  F8D0  CE 80 00   LDX   #$8000         ; X = $8000
  F8D3  61 F7 A9   AIM   #$F7,$A9,X     ; $80A9.3 löschen
  F8D6  6B 08 6E   TIM   #$08,$6E,X     ; $806E.3?
  F8D9  26 03      BNE   loc_F8DE       ; gesetzt — nicht verändern
  F8DB  62 10 6E   OIM   #$10,$6E,X     ; $806E.4

loc_F8DE:
  F8DE  7E F3 B6   JMP   loc_F3B6       ; zurück

; Tabelle $F8E1, 15 Bytes: leer
  F8E1  db FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF

;------------------------------------------------------------------------------
; Patch zu F315: bei $806E.3 [?] wird der nächste Code sofort gewählt.
;------------------------------------------------------------------------------
loc_F8F0:
  F8F0  86 08      LDAA  #$08           ; $806E.3?
  F8F2  B5 80 6E   BITA  $806E          ; prüfen
  F8F5  27 06      BEQ   loc_F8FD       ; nein — normaler Weg
  F8F7  B6 80 A4   LDAA  $80A4          ; Timer
  F8FA  7E F3 18   JMP   loc_F318       ; zur Codeauswahl

loc_F8FD:
