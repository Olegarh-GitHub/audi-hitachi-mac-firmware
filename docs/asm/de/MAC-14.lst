;------------------------------------------------------------------------------
; $8021 = Drehzahl × 256 / 255 (≈ Drehzahl) — für die Korrektur der Zündverzögerung [?].
; SCHLIESSWINKEL DER ZÜNDSPULE. Unter 16 Drehzahl-Einh. (oder unter 12 bis zum ersten
; Erreichen von 16, $8092.0) — konstant $8024 = 88. Sonst Schließzeit T nach
; Spannung: Achse C918 = 80 90 100 110 120 140 160 200 (≈8…20 V [Vermutung]) ->
; C920 = 90 70 55 46 40 32 27 19. Schließwinkel = T × Drehzahl / 69 Halbzähne;
; $8024 = 108 - Winkel (Beginn der Schließzeit ab Zylindermarke), mindestens 27.
; 108 Halbzähne = 144° = Abstand zwischen den Zylindern. Nach der Drehzahlskalierung
; T ≈ 7 × Zeit in ms [Vermutung]: bei 14 V (T = 32) ≈ 4,6 ms.
;------------------------------------------------------------------------------
loc_E179:
  E179  C6 FF      LDAB  #$FF           ; 255
  E17B  BD CA 1B   JSR   DIV8           ; A × 256 / 255
  E17E  86 01      LDAA  #$01           ; × 1
  E180  3D         MUL                  ; runden
  E181  58         ASLB                 ; (runden)
  E182  89 00      ADCA  #$00           ; (runden)
  E184  B7 80 21   STAA  $8021          ; $8021
  E187  F6 80 92   LDAB  $8092          ; Temperatur-Flags
  E18A  B6 80 18   LDAA  $8018          ; Drehzahl
  E18D  81 10      CMPA  #$10           ; 16 und darüber?
  E18F  24 13      BCC   loc_E1A4       ; ja — nach Spannung
  E191  81 0C      CMPA  #$0C           ; unter 12?
  E193  25 04      BCS   loc_E199       ; ja — konstant
  E195  C5 01      BITB  #$01           ; schon einmal 16 erreicht?
  E197  26 0B      BNE   loc_E1A4       ; ja — nach Spannung

loc_E199:
