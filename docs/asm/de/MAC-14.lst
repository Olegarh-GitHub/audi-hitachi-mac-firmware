;------------------------------------------------------------------------------
; N7_TO_TICKS: $805D = D × 214 / 256, wobei D = A:B das Tastverhältnis von N7 in Prozent ist
; (A ganze Prozent, B Bruchteil). 100 % = 21400 Takte = die ganze Periode bei 71,8 Hz.
; X zeigt auf eine Zwischenzelle.
;------------------------------------------------------------------------------
N7_TO_TICKS:                            ; aufgerufen von: TASK2
  DD06  36         PSHA                 ; ganze Prozent
  DD07  86 D6      LDAA  #$D6           ; 214
  DD09  3D         MUL                  ; Bruchteil × 214
  DD0A  A7 00      STAA  $00,X          ; High-Byte in die Zwischenzelle
  DD0C  86 D6      LDAA  #$D6           ; 214
  DD0E  33         PULB                 ; B = ganze Prozent
  DD0F  3D         MUL                  ; ganze Prozent × 214
  DD10  EB 00      ADDB  $00,X          ; + Bruchteil
  DD12  89 00      ADCA  #$00           ; Übertrag
  DD14  FD 80 5D   STD   $805D          ; $805D = N7-Zeit in Takten
  DD17  39         RTS                  ; Rücksprung

;------------------------------------------------------------------------------
; AUFGABE 1: alle 2 Ticks (≈20 ms).
; Zustandsbits $8050:
;  5 betriebswarm: G62 unter C6DE = 39 (≈70 °C [Vermutung]; laut SSP arbeitet die Klopfregelung ab 70 °C),
;      gelöscht ab 42;
;  6 Last: Saugrohrdruck über C6DF = 90 (≈0,7 bar abs. [Vermutung]), gelöscht unter 87;
;  4 Spannung in Ordnung: gesetzt bei 95…149, gelöscht unter 90 oder ab 155;
;  7 Klopfregelung aktiv: betriebswarm und Last, kein Start,
;      Drosselklappe nicht geschlossen, keine Blinkcode-Ausgabe.
;------------------------------------------------------------------------------
TASK1:                                  ; aufgerufen von: TASK1
  DD18  B6 C6 DE   LDAA  $C6DE          ; Warmlaufschwelle C6DE = 39
  DD1B  F6 80 1B   LDAB  $801B          ; Kühlmitteltemperatur
  DD1E  11         CBA                  ; wärmer als die Schwelle?
  DD1F  23 0A      BLS   loc_DD2B       ; nein
  DD21  36         PSHA                 ; sichern
  DD22  86 20      LDAA  #$20           ; Bit 5: betriebswarm
  DD24  BA 80 50   ORAA  $8050          ; setzen
  DD27  B7 80 50   STAA  $8050          ; speichern
  DD2A  32         PULA                 ; zurückholen

loc_DD2B:
  DD2B  8B 03      ADDA  #$03           ; Hysterese 3
  DD2D  11         CBA                  ; kälter als 42?
  DD2E  22 08      BHI   loc_DD38       ; nein: belassen
  DD30  86 DF      LDAA  #$DF           ; ja: Bit 5 löschen
  DD32  B4 80 50   ANDA  $8050          ; löschen
  DD35  B7 80 50   STAA  $8050          ; speichern

loc_DD38:
  DD38  F6 80 19   LDAB  $8019          ; Saugrohrdruck
  DD3B  BD D1 FE   JSR   MAP_BAD_LOAD   ; G71 unter Last defekt?
  DD3E  24 03      BCC   loc_DD43       ; nein
  DD40  F6 C7 9E   LDAB  $C79E          ; Ersatzwert 192

loc_DD43:
  DD43  B6 C6 DF   LDAA  $C6DF          ; Lastschwelle C6DF = 90
  DD46  11         CBA                  ; Druck darüber?
  DD47  24 0A      BCC   loc_DD53       ; nein
  DD49  36         PSHA                 ; sichern
  DD4A  86 40      LDAA  #$40           ; Bit 6: Last
  DD4C  BA 80 50   ORAA  $8050          ; setzen
  DD4F  B7 80 50   STAA  $8050          ; speichern
  DD52  32         PULA                 ; zurückholen

loc_DD53:
  DD53  80 03      SUBA  #$03           ; Hysterese 3
  DD55  11         CBA                  ; Druck über 87?
  DD56  25 08      BCS   loc_DD60       ; ja: belassen
  DD58  86 BF      LDAA  #$BF           ; Bit 6 löschen
  DD5A  B4 80 50   ANDA  $8050          ; löschen
  DD5D  B7 80 50   STAA  $8050          ; speichern

loc_DD60:
  DD60  F6 80 1A   LDAB  $801A          ; Spannung
  DD63  C1 5A      CMPB  #$5A           ; unter 90?
  DD65  25 0C      BCS   loc_DD73       ; ja: löschen
  DD67  C1 5F      CMPB  #$5F           ; unter 95?
  DD69  25 1A      BCS   loc_DD85       ; ja: nicht ändern
  DD6B  C1 96      CMPB  #$96           ; unter 150?
  DD6D  25 0E      BCS   loc_DD7D       ; ja: setzen
  DD6F  C1 9B      CMPB  #$9B           ; unter 155?
  DD71  25 12      BCS   loc_DD85       ; ja: nicht ändern

loc_DD73:
  DD73  86 EF      LDAA  #$EF           ; Bit 4 löschen: Spannung außerhalb des Bereichs
  DD75  B4 80 50   ANDA  $8050          ; löschen
  DD78  B7 80 50   STAA  $8050          ; speichern
  DD7B  20 08      BRA   loc_DD85       ; weiter

loc_DD7D:
  DD7D  86 10      LDAA  #$10           ; Bit 4: Spannung in Ordnung
  DD7F  BA 80 50   ORAA  $8050          ; setzen
  DD82  B7 80 50   STAA  $8050          ; speichern

loc_DD85:
  DD85  86 80      LDAA  #$80           ; Blinkcode-Liste beendet?
