;------------------------------------------------------------------------------
; Patch zu F381: ganzen Code merken ($80A7) und $80A9.3 setzen
; „Code wird ausgegeben“ (danach schaltet F8B0 während der Blinkcodes den Sender der K-Leitung ab).
;------------------------------------------------------------------------------
loc_F8A0:
  F8A0  FF 80 A7   STX   $80A7          ; $80A7 = Code
  F8A3  CE 80 00   LDX   #$8000         ; X = $8000
  F8A6  62 08 A9   OIM   #$08,$A9,X     ; Code wird ausgegeben
  F8A9  7E F3 84   JMP   loc_F384       ; zurück

