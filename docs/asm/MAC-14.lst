;------------------------------------------------------------------------------
; N80 — продувка адсорбера. Скважность $8064 = 0…31 из 32 шагов
; медленного ШИМ (шаг 5,09 мс, период 163 мс, выход в прерывании OCF, F5FA).
; Первые 255 вызовов (25,5 с) после синхронизации продувки нет (C795).
; Дальше — карта 8×8: строки по давлению (ось C7B0 = 116 103 90 77 71 64 58 51),
; столбцы по оборотам (ось C7B8 = 40 53 67 80 93 107 120 160).
; Карта C7C0 обычная, C800 — при $8066.1 [?]. На холостом ходу —
; постоянное значение C7AE = 8 (или C845 = 4 при $8066.1).
;------------------------------------------------------------------------------
loc_EA60:
  EA60  B6 80 63   LDAA  $8063          ; счётчик времени после синхронизации
  EA63  B1 C7 95   CMPA  $C795          ; дошёл до C795 = 255 (25,5 с)?
  EA66  24 07      BCC   loc_EA6F       ; да — продувка по карте
  EA68  4C         INCA                 ; + 1
  EA69  B7 80 63   STAA  $8063          ; сохранить
