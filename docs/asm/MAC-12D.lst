  E5C9  db 44 33 44 41 44 42 44 43 43 43

;------------------------------------------------------------------------------
; FRAC_UP — доля между точками возрастающей оси: B = (A - ось[i]) × 256 / ширина.
;------------------------------------------------------------------------------
FRAC_UP:                                ; вызов из: TASK1, TASK2, TASK3
  E5D3  5F         CLRB                 ; B = 0 на случай точного попадания
  E5D4  A0 00      SUBA  $00,X          ; A = величина - левая точка
  E5D6  27 36      BEQ   loc_E60E       ; ровно в точке? да — доля 0
  E5D8  E6 01      LDAB  $01,X          ; B = ширина интервала
  E5DA  E0 00      SUBB  $00,X
  E5DC  20 0B      BRA   DIV8           ; делить

;------------------------------------------------------------------------------
; FRAC_DN — то же для убывающей оси.
;------------------------------------------------------------------------------
FRAC_DN:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  E5DE  5F         CLRB                 ; B = 0 на случай точного попадания
  E5DF  A0 00      SUBA  $00,X          ; A = левая точка - величина
  E5E1  40         NEGA
  E5E2  27 2A      BEQ   loc_E60E       ; ровно в точке? да — доля 0
  E5E4  E6 01      LDAB  $01,X          ; B = ширина интервала (со знаком плюс)
  E5E6  E0 00      SUBB  $00,X
  E5E8  50         NEGB

;------------------------------------------------------------------------------
; DIV8 — B = A × 256 / B (A < B), деление столбиком.
;------------------------------------------------------------------------------
DIV8:                                   ; вызов из: TASK0, TASK1, TASK2, TASK3
  E5E9  37         PSHB                 ; делитель в стек
  E5EA  36         PSHA                 ; делимое в стек
  E5EB  34         DES                  ; место под счётчик шагов
  E5EC  30         TSX
  E5ED  86 08      LDAA  #$08           ; 8 шагов
  E5EF  A7 00      STAA  $00,X          ; счётчик
  E5F1  A6 01      LDAA  $01,X          ; A = делимое (остаток)
  E5F3  C6 FF      LDAB  #$FF           ; частное: начальное значение FF (биты инвертированы)
  E5F5  E7 01      STAB  $01,X          ; сохранить
  E5F7  5F         CLRB                 ; B — старший разряд остатка

loc_E5F8:
  E5F8  48         ASLA                 ; сдвинуть остаток влево
  E5F9  59         ROLB                 ; перенос в B
  E5FA  A0 02      SUBA  $02,X          ; вычесть делитель
  E5FC  C2 00      SBCB  #$00           ; учесть заём
  E5FE  24 04      BCC   loc_E604       ; не ушли в минус? да — бит частного 1 (здесь пишется 0, он инвертирован)
  E600  AB 02      ADDA  $02,X          ; ушли в минус — вернуть делитель назад
  E602  C9 00      ADCB  #$00           ; перенос = 1 (бит частного 0, записывается инвертированным)

loc_E604:
  E604  69 01      ROL   $01,X          ; бит частного в результат
  E606  6A 00      DEC   $00,X          ; следующий шаг
  E608  26 EE      BNE   loc_E5F8       ; шаги остались? да — повторить
  E60A  32         PULA                 ; снять счётчик
  E60B  33         PULB                 ; B = инвертированное частное
  E60C  31         INS                  ; убрать делитель
  E60D  53         COMB                 ; B = частное (доля 0...255)

loc_E60E:
  E60E  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; INTERP — линейная интерполяция: A = т[i] + (т[i+1] - т[i]) × B / 256.
;------------------------------------------------------------------------------
INTERP:                                 ; вызов из: TASK0, TASK1, TASK2, TASK3
  E60F  A6 00      LDAA  $00,X          ; т[i]
  E611  36         PSHA                 ; в стек
  E612  A6 01      LDAA  $01,X          ; т[i+1]
  E614  36         PSHA                 ; в стек
  E615  30         TSX                  ; X -> т[i+1] в стеке, за ним т[i]
  E616  A6 00      LDAA  $00,X          ; A = т[i+1]; на его место ляжет знак
  E618  6F 00      CLR   $00,X          ; знак = 0 (рост)
  E61A  A0 01      SUBA  $01,X          ; A = т[i+1] - т[i]
  E61C  24 03      BCC   loc_E621       ; таблица растёт? да — разность уже положительная
  E61E  40         NEGA                 ; убывает: модуль разности
  E61F  63 00      COM   $00,X          ; знак = FF (спад)

loc_E621:
  E621  3D         MUL                  ; разность * доля
  E622  58         ASLB                 ; округление: старший бит младшего байта
  E623  89 00      ADCA  #$00           ; прибавить его
  E625  33         PULB                 ; B = знак
  E626  5D         TSTB                 ; таблица растёт?
  E627  27 01      BEQ   loc_E62A       ; да — прибавлять
  E629  40         NEGA                 ; нет — вычитать

loc_E62A:
  E62A  33         PULB                 ; B = т[i]
  E62B  1B         ABA                  ; A = т[i] + поправка
  E62C  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; AXIS_UP — интервал на возрастающей оси: X -> левая точка, B = номер.
;------------------------------------------------------------------------------
AXIS_UP:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  E62D  36         PSHA                 ; сохранить величину
  E62E  37         PSHB                 ; сохранить число точек

loc_E62F:
  E62F  A1 00      CMPA  $00,X          ; величина меньше этой точки?
  E631  25 17      BCS   loc_E64A       ; да — интервал найден
  E633  08         INX                  ; следующая точка
  E634  5A         DECB                 ; точек осталось?
  E635  27 0C      BEQ   loc_E643       ; нет — вышли за конец оси
  E637  20 F6      BRA   loc_E62F       ; к следующей

;------------------------------------------------------------------------------
; AXIS_DN — то же для убывающей оси.
;------------------------------------------------------------------------------
AXIS_DN:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  E639  36         PSHA                 ; сохранить величину
  E63A  37         PSHB                 ; сохранить число точек

loc_E63B:
  E63B  A1 00      CMPA  $00,X          ; величина больше этой точки?
  E63D  22 0B      BHI   loc_E64A       ; да — интервал найден
  E63F  08         INX                  ; следующая точка
  E640  5A         DECB                 ; точек осталось?
  E641  26 F8      BNE   loc_E63B       ; да — дальше

loc_E643:
  E643  33         PULB                 ; вышли за конец: B = число точек
  E644  32         PULA                 ; A = величина
  E645  5A         DECB                 ; номер последней точки
  E646  09         DEX                  ; X -> последняя точка

loc_E647:
  E647  A6 00      LDAA  $00,X          ; A = значение точки (доля будет 0)
  E649  39         RTS                  ; возврат

loc_E64A:
  E64A  32         PULA                 ; A = число точек
  E64B  10         SBA                  ; A = номер найденной точки
  E64C  16         TAB                  ; в B
  E64D  27 04      BEQ   loc_E653       ; это первая точка (величина за началом оси)?
  E64F  5A         DECB                 ; нет — левая точка = предыдущая
  E650  09         DEX                  ; X -> левая точка
  E651  32         PULA                 ; A = величина
  E652  39         RTS                  ; возврат

loc_E653:
  E653  32         PULA                 ; снять величину; A = первая точка
  E654  20 F1      BRA   loc_E647       ; к общему выходу

;------------------------------------------------------------------------------
; СБРОС. Стек $00FF. Внешнего ОЗУ нет — всё во внутреннем ОЗУ процессора $40-$FF,
; и оно целиком проверяется и очищается при каждом сбросе. Поэтому коды ошибок
; при выключении зажигания стираются (в отличие от MAC-14, где их хранит
; внутреннее ОЗУ на постоянном плюсе).
; Отличия от MAC-14: RMCR = $07, TCSR1 = $10, SCI не настраивается (K-линии нет),
; PORT2 = $08, P6DDR = $E0 (выходы только P65-P67), TCSR2 не пишется.
;------------------------------------------------------------------------------
RESET:                                  ; вызов из: NMI, RES, SWI, TRAP
  E656  8E 00 FF   LDS   #$00FF         ; стек
  E659  CE 00 40   LDX   #$0040         ; проверка ОЗУ с $0040

loc_E65C:
  E65C  86 07      LDAA  #$07           ; RMCR
  E65E  97 10      STAA  RMCR           ; скорость SCI
  E660  86 C1      LDAA  #$C1           ; RP5CR = $C1
  E662  97 14      STAA  RP5CR          ; записать
  E664  86 10      LDAA  #$10           ; TCSR1 = $10 (прерывание захвата [Пр])
  E666  97 08      STAA  TCSR1          ; записать
  E668  86 08      LDAA  #$08           ; PORT2 = $08 [?]
  E66A  97 03      STAA  PORT2          ; записать
  E66C  86 20      LDAA  #$20           ; PORT6.5 = 1, остальные 0
  E66E  97 17      STAA  PORT6          ; записать
  E670  86 02      LDAA  #$02           ; P21-P27 — выходы
  E672  97 01      STAA  P2DDR          ; записать
  E674  86 E0      LDAA  #$E0           ; P65-P67 — выходы, P60-P64 — входы
  E676  97 16      STAA  P6DDR          ; записать
  E678  3C         PSHX                 ; сохранить начало проверки
  E679  CE E6 EE   LDX   #$E6EE         ; таблица настройки чипа E6EE (пары номер/значение)

loc_E67C:
  E67C  EC 00      LDD   $00,X          ; пара
  E67E  FD 01 00   STD   $0100          ; записать в чип
  E681  08         INX                  ; следующая
  E682  08         INX                  ; (+2)
  E683  8C E7 0A   CPX   #$E70A         ; все 14?
  E686  26 F4      BNE   loc_E67C       ; нет
  E688  38         PULX                 ; начало
  E689  CC 55 AA   LDD   #$55AA         ; образцы $55 и $AA

loc_E68C:
  E68C  A7 00      STAA  $00,X          ; записать $55
  E68E  A1 00      CMPA  $00,X          ; прочиталось?
  E690  26 10      BNE   loc_E6A2       ; нет — ОЗУ неисправно
  E692  E7 00      STAB  $00,X          ; записать $AA
  E694  E1 00      CMPB  $00,X          ; прочиталось?
  E696  26 0A      BNE   loc_E6A2       ; нет — неисправно
  E698  6F 00      CLR   $00,X          ; очистить
  E69A  08         INX                  ; следующий
  E69B  8C 01 00   CPX   #$0100         ; до $0100
  E69E  26 EC      BNE   loc_E68C       ; повторить
  E6A0  20 04      BRA   loc_E6A6       ; готово

loc_E6A2:
  E6A2  86 80      LDAA  #$80           ; ОЗУ неисправно: ошибка ЭБУ
  E6A4  97 BC      STAA  $BC            ; записать $BC

loc_E6A6:
  E6A6  86 A8      LDAA  #$A8           ; режим: пуск ($A8)
  E6A8  97 68      STAA  $68            ; $68 = режимные флаги
  E6AA  B6 E3 98   LDAA  $E398          ; угол пуска E398 = 47
  E6AD  C6 C0      LDAB  #$C0           ; × 0,75
  E6AF  3D         MUL                  ; (× 0,75)
  E6B0  58         ASLB                 ; округлить
  E6B1  89 00      ADCA  #$00           ; (округлить)
  E6B3  97 62      STAA  $62            ; $62 = выдаваемый угол
  E6B5  86 FF      LDAA  #$FF           ; $FF
  E6B7  97 AD      STAA  $AD            ; $AD = $FF [?]
  E6B9  86 6C      LDAA  #$6C           ; предел угла 108
  E6BB  97 B5      STAA  $B5            ; $B5 = предел
  E6BD  CE 01 00   LDX   #$0100         ; чип
  E6C0  86 1F      LDAA  #$1F           ; регистр состояния $1F
  E6C2  A7 00      STAA  $00,X          ; выбрать

loc_E6C4:
  E6C4  E6 01      LDAB  $01,X          ; состояние
  E6C6  C5 20      BITB  #$20           ; чип готов (бит 5)?
  E6C8  27 FA      BEQ   loc_E6C4       ; нет — ждать
  E6CA  CC 1D A0   LDD   #$1DA0         ; маска событий: цилиндр и тик
  E6CD  D7 45      STAB  $45            ; $45 = маска
  E6CF  ED 00      STD   $00,X          ; записать
  E6D1  CC 1C 25   LDD   #$1C25         ; режим чипа $25 (поиск синхронизации)
  E6D4  ED 00      STD   $00,X          ; записать
  E6D6  CC 1E FF   LDD   #$1EFF         ; снять все события
  E6D9  ED 00      STD   $00,X          ; записать
  E6DB  0E         CLI                  ; разрешить прерывания

;------------------------------------------------------------------------------
; ФОНОВЫЙ ЦИКЛ — контрольная сумма ПЗУ $E000-$FFFF должна быть 0,
; иначе ошибка ЭБУ ($BC.6). Сумма образа проверена: 0.
;------------------------------------------------------------------------------
BG_LOOP:
  E6DC  CE E0 00   LDX   #$E000         ; начало ПЗУ
  E6DF  4F         CLRA                 ; сумма = 0

loc_E6E0:
  E6E0  AB 00      ADDA  $00,X          ; + байт
  E6E2  08         INX                  ; следующий
  E6E3  26 FB      BNE   loc_E6E0       ; до $FFFF
  E6E5  4D         TSTA                 ; сумма 0?
  E6E6  27 F4      BEQ   BG_LOOP        ; да — заново
  E6E8  72 40 BC   OIM   #$40,$BC       ; ошибка ПЗУ
  E6EB  20 EF      BRA   BG_LOOP        ; заново

; таблица $E6ED, 1 байт: байт $AE без ссылок — вероятно, подгонка контрольной суммы [Пр] (у MAC-14 такой же байт в CB90)
  E6ED  db AE

; таблица $E6EE, 28 байт: настройка чипа $0100 (номер, значение): 00 FF, 01 6C (144°), 02 2D, 03 1B, 05 00, 06 05, 07 DF, 09 C8, 0A FF, 0B 00, 0C 22, 0D 4F, 18 00, 1F 00
  E6EE  db 00 FF 01 6C 02 2D 03 1B 05 00 06 05 07 DF 09 C8
  E6FE  db 0A FF 0B 00 0C 22 0D 4F 18 00 1F 00

;------------------------------------------------------------------------------
; IRQ1 — события чипа (регистр $1E, маска $45). Порядок проверки иной, чем в MAC-14:
;  бит 5 — тик (≈10 мс) -> EACE;  бит 7 — событие цилиндра (E762);
;  бит 6 — окно детонации (E72D);  бит 2 — начало накопления катушки (E755).
; ДЕТОНАЦИЯ устроена иначе, чем в MAC-14: один датчик G61, замер — счёт таймера 2
; (T2CNT, внешний счётный вход P27 [Пр]) за окно, копится в $6A и сравнивается
; с порогом цилиндра (таблица E4EE). АЦП для детонации не используется.
;------------------------------------------------------------------------------
IRQ1:                                   ; вызов из: IRQ1
  E70A  CE 01 00   LDX   #$0100         ; X -> чип
  E70D  86 1E      LDAA  #$1E           ; регистр событий $1E
  E70F  A7 00      STAA  $00,X          ; выбрать
  E711  E6 01      LDAB  $01,X          ; события
  E713  D4 45      ANDB  $45            ; только разрешённые ($45)
  E715  C5 20      BITB  #$20           ; тик?
  E717  26 0C      BNE   loc_E725       ; да
  E719  5D         TSTB                 ; событие цилиндра (бит 7)?
  E71A  2B 46      BMI   loc_E762       ; да
  E71C  C5 40      BITB  #$40           ; окно детонации?
  E71E  26 0D      BNE   loc_E72D       ; да
  E720  C5 04      BITB  #$04           ; накопление катушки?
  E722  26 31      BNE   loc_E755       ; да
  E724  3B         RTI                  ; ничего — выйти

loc_E725:
  E725  C6 20      LDAB  #$20           ; снять событие тика
  E727  E7 01      STAB  $01,X          ; записать
  E729  0E         CLI                  ; разрешить вложенные прерывания
  E72A  7E EA CE   JMP   loc_EACE       ; обработка тика

;------------------------------------------------------------------------------
; Окно детонации [Пр]: прочитать регистр $00 чипа (положение окна?), записать $62
; в регистр $01, забрать счёт таймера 2 и обнулить его. Если регистр $00 < $60 —
; $6A = старший бит счёта (0 или 1), иначе $6A += округлённый счёт × 255 / 256.
; Точный смысл двух ветвей — [?].
;------------------------------------------------------------------------------
loc_E72D:
  E72D  C6 40      LDAB  #$40           ; снять событие
  E72F  E7 01      STAB  $01,X          ; записать
  E731  86 00      LDAA  #$00           ; регистр $00
  E733  A7 00      STAA  $00,X          ; выбрать
  E735  E6 01      LDAB  $01,X          ; значение [?]
  E737  86 62      LDAA  #$62           ; $62 [?]
  E739  A7 01      STAA  $01,X          ; в регистр $01 чипа
  E73B  96 1D      LDAA  T2CNT          ; счёт таймера 2
  E73D  7F 00 1D   CLR   T2CNT          ; обнулить
  E740  C1 60      CMPB  #$60           ; значение регистра $00 меньше $60?
  E742  24 08      BCC   loc_E74C       ; нет
  E744  C6 01      LDAB  #$01           ; × 1
  E746  3D         MUL                  ; (MUL)
  E747  58         ASLB                 ; старший бит младшего байта
  E748  89 00      ADCA  #$00           ; A = 0 или 1
  E74A  20 06      BRA   loc_E752       ; дальше

loc_E74C:
  E74C  C6 FF      LDAB  #$FF           ; × 255
  E74E  3D         MUL                  ; (MUL)
  E74F  58         ASLB                 ; округлить
  E750  99 6A      ADCA  $6A            ; + накопленное

loc_E752:
  E752  97 6A      STAA  $6A            ; $6A = накопленный счёт детонации
  E754  3B         RTI                  ; выйти

loc_E755:
  E755  C6 04      LDAB  #$04           ; снять событие
  E757  E7 01      STAB  $01,X          ; записать
  E759  86 03      LDAA  #$03           ; регистр $03
  E75B  D6 63      LDAB  $63            ; начало накопления $63
  E75D  DB 85      ADDB  $85            ; + поправка $85
  E75F  ED 00      STD   $00,X          ; записать
  E761  3B         RTI                  ; выйти

;------------------------------------------------------------------------------
; СОБЫТИЕ ЦИЛИНДРА — синхронизация как в MAC-14: метка G4 при низком Холле.
; 11 событий без метки — ошибка G4 ($BB биты 5, 4); 4 метки при высоком Холле — ошибка
; Холла ($BB биты 3, 2). При синхронизации ($BC.5): PORT6.6 = 1 (реле J17),
; чип в режим $27, маска $E4, таймер 2: TCSR3 = $13.
;------------------------------------------------------------------------------
loc_E762:
  E762  C6 80      LDAB  #$80           ; снять событие
  E764  E7 01      STAB  $01,X          ; записать
  E766  96 17      LDAA  PORT6          ; порт 6 (Холл — бит 1)
  E768  7B 20 BC   TIM   #$20,$BC       ; синхронизация есть ($BC.5)?
  E76B  26 5C      BNE   loc_E7C9       ; да
  E76D  C6 02      LDAB  #$02           ; метка G4?
  E76F  E5 01      BITB  $01,X          ; проверить
  E771  26 13      BNE   loc_E786       ; да
  E773  D6 59      LDAB  $59            ; обороты
  E775  C0 01      SUBB  #$01           ; ноль?
  E777  25 28      BCS   loc_E7A1       ; да — выйти
  E779  7C 00 BD   INC   $00BD          ; событий без метки + 1
  E77C  D6 BD      LDAB  $BD            ; значение
  E77E  C0 0B      SUBB  #$0B           ; 11?
  E780  25 1F      BCS   loc_E7A1       ; нет — выйти
  E782  72 30 BB   OIM   #$30,$BB       ; ошибка G4
  E785  3B         RTI                  ; выйти

loc_E786:
  E786  E7 01      STAB  $01,X          ; снять метку
  E788  7F 00 BD   CLR   $00BD          ; счётчик цилиндров = 0
  E78B  D6 59      LDAB  $59            ; обороты
  E78D  C0 01      SUBB  #$01           ; ноль?
  E78F  25 10      BCS   loc_E7A1       ; да — выйти
  E791  85 02      BITA  #$02           ; Холл высокий?
  E793  27 0D      BEQ   loc_E7A2       ; нет — синхронизация
  E795  7C 00 BE   INC   $00BE          ; метка при высоком Холле + 1
  E798  D6 BE      LDAB  $BE            ; значение
  E79A  C0 04      SUBB  #$04           ; 4?
  E79C  25 03      BCS   loc_E7A1       ; нет — выйти
  E79E  72 0C BB   OIM   #$0C,$BB       ; ошибка Холла

loc_E7A1:
  E7A1  3B         RTI                  ; выйти

loc_E7A2:
  E7A2  72 20 BC   OIM   #$20,$BC       ; СИНХРОНИЗАЦИЯ ЕСТЬ ($BC.5)
  E7A5  71 57 BB   AIM   #$57,$BB       ; снять подозрения
  E7A8  72 40 17   OIM   #$40,PORT6     ; PORT6.6 = 1: реле насоса J17 [Пр]
  E7AB  5F         CLRB                 ; 0
  E7AC  D7 BD      STAB  $BD            ; цилиндр 0
  E7AE  D7 BE      STAB  $BE            ; счётчик Холла 0
  E7B0  BD FE FA   JSR   TEST_EXIT      ; выйти из теста исполнителей
  E7B3  CC 1C 27   LDD   #$1C27         ; чип: регистр $1C = $27 (режим по цилиндрам)
  E7B6  ED 00      STD   $00,X          ; записать
  E7B8  CC 1D E4   LDD   #$1DE4         ; регистр $1D = $E4 (маска событий)
  E7BB  D7 45      STAB  $45            ; та же маска у себя
  E7BD  ED 00      STD   $00,X          ; записать
  E7BF  CC 06 32   LDD   #$0632         ; регистр $06 = $32 [?]
  E7C2  ED 00      STD   $00,X          ; записать
  E7C4  86 13      LDAA  #$13           ; таймер 2: TCSR3 = $13 [?]
  E7C6  97 1B      STAA  TCSR3          ; записать
  E7C8  3B         RTI                  ; выйти

loc_E7C9:
  E7C9  C6 02      LDAB  #$02           ; метка G4?
  E7CB  E5 01      BITB  $01,X          ; проверить
  E7CD  27 06      BEQ   loc_E7D5       ; нет
  E7CF  E7 01      STAB  $01,X          ; снять метку
  E7D1  85 02      BITA  #$02           ; Холл высокий?
  E7D3  27 05      BEQ   loc_E7DA       ; нет — цилиндр 0

loc_E7D5:
  E7D5  D6 BD      LDAB  $BD            ; цилиндр
  E7D7  5C         INCB                 ; + 1 (без ограничения 5, в отличие от MAC-14)
  E7D8  20 01      BRA   loc_E7DB       ; дальше

loc_E7DA:
  E7DA  5F         CLRB                 ; 0

loc_E7DB:
  E7DB  D7 BD      STAB  $BD            ; $BD = цилиндр
  E7DD  7B 80 68   TIM   #$80,$68       ; пуск?
  E7E0  27 1D      BEQ   loc_E7FF       ; нет
  E7E2  D6 BD      LDAB  $BD            ; цилиндр 0?
  E7E4  27 16      BEQ   loc_E7FC       ; да — норма
  E7E6  85 02      BITA  #$02           ; Холл высокий?
  E7E8  26 12      BNE   loc_E7FC       ; да — норма
  E7EA  7C 00 BE   INC   $00BE          ; расхождение + 1
  E7ED  D6 BE      LDAB  $BE            ; значение
  E7EF  C1 02      CMPB  #$02           ; 2?
  E7F1  25 0C      BCS   loc_E7FF       ; нет
  E7F3  72 03 BB   OIM   #$03,$BB       ; ошибка Холла
  E7F6  CC 1C 21   LDD   #$1C21         ; чип: регистр $1C = $21 (аварийный режим [Пр])
  E7F9  ED 00      STD   $00,X          ; записать
  E7FB  3B         RTI                  ; выйти

loc_E7FC:
  E7FC  7F 00 BE   CLR   $00BE          ; расхождений 0

loc_E7FF:
  E7FF  5F         CLRB                 ; регистр $14, канал 0
  E800  86 14      LDAA  #$14           ; (то же)
  E802  ED 00      STD   $00,X          ; запуск АЦП давления
  E804  D7 69      STAB  $69            ; АЦП занят прерыванием
  E806  D7 64      STAB  $64            ; счёт остановки = 0

;------------------------------------------------------------------------------
; Окно детонации по цилиндрам [Пр]: регистр $00 чипа = $40 для цилиндров 1 и 2
; (номера 1 и ≥ 3 при $8A.0) или $38 для остальных. Смысл $8A.0 — [?].
;------------------------------------------------------------------------------
  E808  86 00      LDAA  #$00           ; регистр $00
  E80A  7B 01 8A   TIM   #$01,$8A       ; $8A.0?
  E80D  27 0E      BEQ   loc_E81D       ; нет — $38
  E80F  D6 BD      LDAB  $BD            ; цилиндр
  E811  C1 01      CMPB  #$01           ; 1?
  E813  27 04      BEQ   loc_E819       ; да — $40
  E815  C1 03      CMPB  #$03           ; меньше 3?
  E817  25 04      BCS   loc_E81D       ; да — $38

loc_E819:
  E819  C6 40      LDAB  #$40           ; $40
  E81B  20 02      BRA   loc_E81F       ; дальше

loc_E81D:
  E81D  C6 38      LDAB  #$38           ; $38

loc_E81F:
  E81F  ED 00      STD   $00,X          ; записать
