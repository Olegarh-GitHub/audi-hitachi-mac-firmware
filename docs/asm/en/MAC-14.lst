  D5B7  85 40      BITA  #$40           ; bit 6?
  D5B9  27 04      BEQ   loc_D5BF       ; no
  D5BB  85 02      BITA  #$02           ; bit 1 (always 0)
  D5BD  27 11      BEQ   loc_D5D0       ; no —

loc_D5BF:
