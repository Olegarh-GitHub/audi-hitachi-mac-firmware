;------------------------------------------------------------------------------
; Возврат с карты 2 на карту 1. Если включена карта 2 ($807A.7) и нет ошибок
; регулирования детонации ($8051 биты 1, 0): счётчик $8086 (вызовы по 20 мс).
; Когда его старший байт (шаг 5,12 с) дошёл до порога по оборотам (ось C6E0 =
; 40 80 120 160 -> C6E4 = 12 20 27 35, то есть ≈ 61…179 с) и отвод по детонации
; во всех цилиндрах ($802F-$8033) нулевой — вернуться на карту 1.
;------------------------------------------------------------------------------
  E1F6  CE 80 00   LDX   #$8000         ; X = $8000
  E1F9  A6 7A      LDAA  $7A,X          ; $807A
  E1FB  85 80      BITA  #$80           ; карта 2 включена?
  E1FD  27 39      BEQ   loc_E238       ; нет — счётчик в ноль
  E1FF  6B 03 51   TIM   #$03,$51,X     ; ошибки регулирования детонации?
  E202  26 34      BNE   loc_E238       ; есть — счётчик в ноль
  E204  EE 86      LDX   $86,X          ; счётчик
  E206  08         INX                  ; + 1
  E207  27 03      BEQ   loc_E20C       ; переполнился — не сохранять
  E209  FF 80 86   STX   $8086          ; записать

