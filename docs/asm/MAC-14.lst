  F14E  B6 80 A9   LDAA  $80A9          ; флаги выдачи
  F151  6B 08 F7   TIM   #$08,$F7,X     ; запуск с тестера по K-линии ($80F7.3)?
  F154  27 05      BEQ   loc_F15B       ; нет — смотреть контакт 5
  F156  61 F7 F7   AIM   #$F7,$F7,X     ; снять запрос тестера
  F159  20 1B      BRA   loc_F176       ; запустить выдачу

