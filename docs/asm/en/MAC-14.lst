;------------------------------------------------------------------------------
; N17_RISE — time from the pressure increase: table [X + B] × weight A / 128,
; up to 255. For the first 500 calls of task 1 (10 s) after start, on AT it is
; additionally multiplied by the altitude factor $802D (4…1).
;------------------------------------------------------------------------------
N17_RISE:                               ; called from: TASK0
  D655  3A         ABX                  ; X -> value
  D656  E6 00      LDAB  $00,X          ; value
  D658  3D         MUL                  ; × weight
  D659  05         ASLD                 ; × 2
  D65A  25 1C      BCS   loc_D678       ; overflow — 255
  D65C  58         ASLB                 ; round
  D65D  89 00      ADCA  #$00           ; + rounding bit
  D65F  25 17      BCS   loc_D678       ; overflow — 255
  D661  FE 80 8C   LDX   $808C          ; engine running time
  D664  8C 01 F4   CPX   #$01F4         ; less than 500 (10 s)?
  D667  7B 04 17   TIM   #$04,PORT6     ; coding: HS? (TIM does not change C)
  D66A  26 0E      BNE   loc_D67A       ; HS — without the factor
  D66C  24 0C      BCC   loc_D67A       ; 10 s elapsed — without the factor
  D66E  F6 80 2D   LDAB  $802D          ; altitude factor
  D671  3D         MUL                  ; ×
  D672  4D         TSTA                 ; overflow?
  D673  26 03      BNE   loc_D678       ; yes — 255
  D675  17         TBA                  ; result
  D676  20 02      BRA   loc_D67A       ; return

loc_D678:
  D678  86 FF      LDAA  #$FF           ; 255

loc_D67A:
  D67A  39         RTS                  ; return

loc_D67B:
  D67B  CE C2 BC   LDX   #$C2BC         ; altitude factor C2BC = 4 3 2 1
  D67E  F6 80 2D   LDAB  $802D          ; by altitude
  D681  3A         ABX                  ; X -> value
  D682  E6 00      LDAB  $00,X          ; value
  D684  F7 80 2D   STAB  $802D          ; $802D = factor (the altitude index is no longer needed)
  D687  86 02      LDAA  #$02           ; warm ≈ 65 °C ($8075.1)?
  D689  B5 80 75   BITA  $8075          ; check
  D68C  26 6D      BNE   loc_D6FB       ; yes — close N17
  D68E  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  D691  25 68      BCS   loc_D6FB       ; yes — close N17
  D693  B6 80 1B   LDAA  $801B          ; coolant temperature
  D696  CE C6 90   LDX   #$C690         ; axis C690 = 205 147 100 44
  D699  A1 03      CMPA  $03,X          ; hotter than the last point?
  D69B  24 02      BCC   loc_D69F       ; no
  D69D  A6 03      LDAA  $03,X          ; take the last one (44)

loc_D69F:
  D69F  C6 04      LDAB  #$04           ; 4 points
  D6A1  BD CA 6B   JSR   AXIS_DN        ; find the interval
  D6A4  37         PSHB                 ; index
  D6A5  BD CA 10   JSR   FRAC_DN        ; fraction
  D6A8  17         TBA                  ; A = fraction
  D6A9  33         PULB                 ; B = index
  D6AA  CE C6 94   LDX   #$C694         ; weight 1: C694
  D6AD  3A         ABX                  ; X -> value
  D6AE  FD 80 1E   STD   $801E          ; save address and fraction
  D6B1  16         TAB                  ; B = fraction
  D6B2  BD CA 41   JSR   INTERP         ; weight 1 = 255 154 32 0
  D6B5  FE 80 1E   LDX   $801E          ; address
  D6B8  B7 80 1E   STAA  $801E          ; $801E = weight 1 (temporarily)
  D6BB  18         XGDX                 ; B = fraction
  D6BC  CE C6 98   LDX   #$C698         ; weight 2: C698
  D6BF  3A         ABX                  ; X -> value
  D6C0  16         TAB                  ; B = fraction
  D6C1  BD CA 41   JSR   INTERP         ; weight 2 = 255 154 192 64
  D6C4  B7 80 1F   STAA  $801F          ; $801F = weight 2 (temporarily)
  D6C7  B6 80 73   LDAA  $8073          ; pressure increase over 40 ms
  D6CA  7F 80 73   CLR   $8073          ; fetch
  D6CD  C6 08      LDAB  #$08           ; 8 points
  D6CF  CE C6 78   LDX   #$C678         ; increase axis C678 = 0 4 11 17 30 43 56 68
  D6D2  BD CA 5F   JSR   AXIS_UP        ; find the point
  D6D5  37         PSHB                 ; index
  D6D6  CE C6 88   LDX   #$C688         ; table 2: C688 = 0 30 50 60 150 200 200 200
  D6D9  B6 80 1F   LDAA  $801F          ; weight 2
  D6DC  BD D6 55   JSR   N17_RISE       ; enrichment flag for the mixture
  D6DF  B7 80 1F   STAA  $801F          ; $801F
  D6E2  33         PULB                 ; index
  D6E3  CE C6 80   LDX   #$C680         ; table 1: C680 = 0 20 25 30 35 40 50 50
  D6E6  B6 80 1E   LDAA  $801E          ; weight 1
  D6E9  BD D6 55   JSR   N17_RISE       ; N17 opening time
  D6EC  B1 80 AC   CMPA  $80AC          ; greater than what is left?
  D6EF  25 12      BCS   loc_D703       ; no — finish counting the old one
  D6F1  B7 80 AC   STAA  $80AC          ; new time
  D6F4  27 12      BEQ   loc_D708       ; zero — close
  D6F6  71 DF 17   AIM   #$DF,PORT6     ; open N17
  D6F9  20 10      BRA   loc_D70B       ; continue

loc_D6FB:
  D6FB  7F 80 AC   CLR   $80AC          ; timer = 0
  D6FE  72 20 17   OIM   #$20,PORT6     ; close N17
  D701  20 1C      BRA   loc_D71F       ; clear the flag

loc_D703:
  D703  7A 80 AC   DEC   $80AC          ; timer - 1
  D706  26 03      BNE   loc_D70B       ; not zero — open

loc_D708:
