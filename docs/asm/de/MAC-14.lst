  D97D  6B 20 00   TIM   #$20,$00,X     ; Block des Testers wird empfangen?
  D980  26 0D      BNE   loc_D98F       ; ja
  D982  4D         TSTA                 ; nichts gesendet?
  D983  27 E8      BEQ   loc_D96D       ; ja — Austausch zurücksetzen
  D985  62 40 00   OIM   #$40,$00,X     ; Senden wiederholen
  D988  86 05      LDAA  #$05           ; Pause 5 Ticks
  D98A  B7 80 FB   STAA  $80FB          ; schreiben
  D98D  20 0D      BRA   loc_D99C       ; weiter

