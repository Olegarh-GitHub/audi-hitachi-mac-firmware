;------------------------------------------------------------------------------
; Холостой ход: поправка угла $800F по высоте и температуре ОЖ —
; таблица C2D0 4×4 (строка — высота 0…3, столбец — G62 по оси C2CC = 197 189 180 158).
; Значения 0…8, больше — на холоде и у моря.
; Ед. угла [Пр]: значение v -> $8022 = (v + 40) × 0,75 - 30 полузубьев
; (1 полузуб = 1,333°), то есть 1 ед. ≈ 1°. Больше v — искра позже.
;------------------------------------------------------------------------------
loc_DECD:
  DECD  B6 80 04   LDAA  $8004          ; атмосферное давление
  DED0  CE C2 B0   LDX   #$C2B0         ; ось C2B0
  DED3  C6 04      LDAB  #$04           ; 4 точки
  DED5  BD CA 6B   JSR   AXIS_DN        ; номер высоты
  DED8  86 04      LDAA  #$04           ; × 4
  DEDA  3D         MUL                  ; строка таблицы
  DEDB  F7 80 0F   STAB  $800F          ; сохранить
  DEDE  CE C2 CC   LDX   #$C2CC         ; ось температуры C2CC
  DEE1  B6 80 1B   LDAA  $801B          ; G62
  DEE4  C6 04      LDAB  #$04           ; 4 точки
  DEE6  BD CA 6B   JSR   AXIS_DN        ; найти интервал
  DEE9  37         PSHB                 ; номер
  DEEA  BD CA 10   JSR   FRAC_DN        ; доля
  DEED  17         TBA                  ; A = доля
  DEEE  33         PULB                 ; B = номер
  DEEF  FB 80 0F   ADDB  $800F          ; + строка
  DEF2  CE C2 D0   LDX   #$C2D0         ; таблица C2D0
  DEF5  3A         ABX                  ; X -> значение
  DEF6  16         TAB                  ; B = доля
  DEF7  BD CA 41   JSR   INTERP         ; интерполяция
  DEFA  B7 80 0F   STAA  $800F          ; $800F = поправка холостого хода
  DEFD  B6 80 18   LDAA  $8018          ; обороты
  DF00  B1 C2 10   CMPA  $C210          ; ниже 40 ед. (≈890 об/мин)?
  DF03  25 09      BCS   loc_DF0E       ; да — DLS
  DF05  CE C2 50   LDX   #$C250         ; холостой ход выше 890 об/мин: ось C250 / угол C260
  DF08  C6 10      LDAB  #$10           ; 16 точек
  DF0A  8D 47      BSR   TAB16_RPM      ; угол = 45 48 50 52 55 55 55 52 50 45 40 35 30 24 20 20
  DF0C  20 39      BRA   loc_DF47       ; в пересчёт (без поправки $800F)

;------------------------------------------------------------------------------
; DLS — стабилизация холостого хода углом ниже 40 ед. (≈890 об/мин).
; Пороги AT C6D0 / HS C6D3 = 16 28 30 ед. (одинаковы):
;  ниже 16 (≈350 об/мин) — угол пуска C6CB = 50;
;  30 и выше — C6D8 = 51;
;  между ними, если мотор завёлся ($8029.6) — по таблице C6D6 = 45 45 51
;  (чем ниже обороты, тем раньше искра — мотор подхватывает);
;  иначе (ещё не завёлся) — C6CC = 50 ниже 28, C6CD = 48 от 28.
; К результату прибавляется поправка $800F.
;------------------------------------------------------------------------------
loc_DF0E:
  DF0E  CE C6 D6   LDX   #$C6D6         ; таблица DLS C6D6
  DF11  FF 80 0C   STX   $800C          ; указатель
  DF14  CE C6 D0   LDX   #$C6D0         ; пороги AT
  DF17  7B 04 17   TIM   #$04,PORT6     ; кодировка: HS?
  DF1A  27 03      BEQ   loc_DF1F       ; нет
  DF1C  CE C6 D3   LDX   #$C6D3         ; пороги HS

loc_DF1F:
  DF1F  A1 00      CMPA  $00,X          ; ниже 16?
  DF21  24 05      BCC   loc_DF28       ; нет
  DF23  B6 C6 CB   LDAA  $C6CB          ; угол пуска 50
  DF26  20 1C      BRA   loc_DF44       ; дальше

loc_DF28:
  DF28  A1 02      CMPA  $02,X          ; 30 и выше?
  DF2A  25 05      BCS   loc_DF31       ; нет
  DF2C  B6 C6 D8   LDAA  $C6D8          ; 51
  DF2F  20 13      BRA   loc_DF44       ; дальше

loc_DF31:
  DF31  C6 40      LDAB  #$40           ; мотор завёлся?
  DF33  F5 80 29   BITB  $8029          ; проверить
  DF36  26 12      BNE   loc_DF4A       ; да — по таблице
  DF38  A1 01      CMPA  $01,X          ; ниже 28?
  DF3A  25 05      BCS   loc_DF41       ; да
  DF3C  B6 C6 CD   LDAA  $C6CD          ; 48
  DF3F  20 03      BRA   loc_DF44       ; дальше

loc_DF41:
  DF41  B6 C6 CC   LDAA  $C6CC          ; 50

loc_DF44:
  DF44  BB 80 0F   ADDA  $800F          ; + поправка холостого хода

