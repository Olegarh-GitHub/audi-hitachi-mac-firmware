  F58F  3A         ABX                  ; (адрес)
  F590  F6 80 16   LDAB  $8016          ; доля по оборотам
  F593  BD CA 41   JSR   INTERP         ; значение в следующей строке
  F596  B7 80 15   STAA  $8015          ; $8015
  F599  CE 80 14   LDX   #$8014         ; два значения подряд
  F59C  F6 80 17   LDAB  $8017          ; доля по давлению
  F59F  BD CA 41   JSR   INTERP         ; между строками
  F5A2  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; NMI — срабатывает при падении питания (выключение зажигания) [Пр].
; Байты кодов $8000-$8002 и счётчики $802B, $802C копируются во внутреннее
; ОЗУ процессора $41-$45, в $40 — их сумма. Это ОЗУ питается от
; постоянного плюса (контакт 33) и хранит ошибки при выключенном зажигании.
; При следующем включении копия проверяется по сумме и возвращается (D13C).
;------------------------------------------------------------------------------
sub_F5A3:                               ; вызов из: NMI
  F5A3  7B 40 14   TIM   #$40,RP5CR     ; внутреннее ОЗУ уже включено (идёт работа с копией)?
  F5A6  27 01      BEQ   loc_F5A9       ; нет — сохранять
  F5A8  3B         RTI                  ; да — выйти

loc_F5A9:
  F5A9  72 40 14   OIM   #$40,RP5CR     ; включить внутреннее ОЗУ
  F5AC  4F         CLRA                 ; сумма = 0
  F5AD  F6 80 00   LDAB  $8000          ; байт кодов 1
  F5B0  1B         ABA                  ; в сумму
  F5B1  D7 41      STAB  $41            ; копия
  F5B3  F6 80 01   LDAB  $8001          ; байт кодов 2
  F5B6  1B         ABA                  ; в сумму
  F5B7  D7 42      STAB  $42            ; копия
  F5B9  F6 80 02   LDAB  $8002          ; байт кодов 3
  F5BC  1B         ABA                  ; в сумму
  F5BD  D7 43      STAB  $43            ; копия
  F5BF  F6 80 2B   LDAB  $802B          ; счётчик пусков без изменений
  F5C2  1B         ABA                  ; в сумму
  F5C3  D7 44      STAB  $44            ; копия
  F5C5  F6 80 2C   LDAB  $802C          ; $802C (бит 7 — коды показаны до конца)
  F5C8  1B         ABA                  ; в сумму
  F5C9  D7 45      STAB  $45            ; копия
  F5CB  97 40      STAA  $40            ; $40 = сумма
  F5CD  71 BF 14   AIM   #$BF,RP5CR     ; внутреннее ОЗУ выключить (защита от записи)
  F5D0  72 80 14   OIM   #$80,RP5CR     ; признак «питание ОЗУ было» = 1
  F5D3  86 08      LDAA  #$08           ; копия сделана ($8003.3)
  F5D5  BA 80 03   ORAA  $8003          ; поставить
  F5D8  B7 80 03   STAA  $8003          ; записать
  F5DB  3B         RTI                  ; возврат

;------------------------------------------------------------------------------
; OCF — сравнение таймера 1.
; OC1: ШИМ N7 на выводе P21 (контакт 8). Период 21400 тактов E (1,536 МГц) =
; 71,8 Гц. Включено $805D тактов, выключено 21400 - $805D; уровень выхода
; переключается сам (OLVL1).
; OC2: каждые 7812 тактов (5,09 мс) — шаг медленного ШИМ N80: 32 шага = 163 мс,
; первые $8064 шагов регистр $0B чипа = FF (N80 открыт), остальные — 00.
;------------------------------------------------------------------------------
OCF:                                    ; вызов из: OCF
  F5DC  96 0F      LDAA  TCSR2          ; состояние таймера, часть 2
  F5DE  85 20      BITA  #$20           ; сравнение 2?
  F5E0  26 18      BNE   loc_F5FA       ; да — N80
  F5E2  96 08      LDAA  TCSR1          ; прочитать (снять флаг OC1)
  F5E4  FC 80 5D   LDD   $805D          ; время «включено»
  F5E7  7B 01 08   TIM   #$01,TCSR1     ; сейчас уровень 1?
  F5EA  26 06      BNE   loc_F5F2       ; да — следующий фронт через «включено»
  F5EC  CC 53 98   LDD   #$5398         ; период 21400
  F5EF  B3 80 5D   SUBD  $805D          ; - «включено» = «выключено»

loc_F5F2:
  F5F2  75 01 08   EIM   #$01,TCSR1     ; переключить уровень на следующем совпадении
  F5F5  D3 0B      ADDD  OCR1H          ; + к моменту совпадения
  F5F7  DD 0B      STD   OCR1H          ; новый момент
  F5F9  3B         RTI                  ; выйти

loc_F5FA:
  F5FA  DC 09      LDD   FRCH           ; счётчик таймера
  F5FC  C3 1E 84   ADDD  #$1E84         ; + 7812 (5,09 мс)
  F5FF  DD 19      STD   OCR2H          ; следующее совпадение 2
  F601  B6 80 65   LDAA  $8065          ; шаг ШИМ N80
  F604  81 20      CMPA  #$20           ; 32?
  F606  27 09      BEQ   loc_F611       ; да — с начала
  F608  B1 80 64   CMPA  $8064          ; меньше скважности?
  F60B  25 0A      BCS   loc_F617       ; да — открыт

loc_F60D:
  F60D  C6 00      LDAB  #$00           ; закрыт: 00
  F60F  20 08      BRA   loc_F619       ; дальше

loc_F611:
  F611  4F         CLRA                 ; шаг 0
  F612  F6 80 64   LDAB  $8064          ; скважность
  F615  27 F6      BEQ   loc_F60D       ; ноль — закрыт

loc_F617:
  F617  C6 FF      LDAB  #$FF           ; открыт: FF

loc_F619:
  F619  4C         INCA                 ; шаг + 1
  F61A  B7 80 65   STAA  $8065          ; записать
  F61D  86 20      LDAA  #$20           ; синхронизация?
  F61F  B5 80 95   BITA  $8095          ; проверить
  F622  27 05      BEQ   loc_F629       ; нет — не трогать
  F624  86 0B      LDAA  #$0B           ; регистр $0B чипа (N80)
  F626  FD 01 00   STD   $0100          ; записать

loc_F629:
  F629  3B         RTI                  ; выйти

;------------------------------------------------------------------------------
; CMI — совпадение таймера 2: программный ШИМ N75 на PORT2.6 (контакт 19).
; Фаза «включено» длится $8067 отсчётов таймера 2, «выключено» — 255 - $8067.
; 0 — всегда выключен, 255 — всегда включён. Частота зависит от делителя таймера 2
; (TCSR3, E760) [?].
