  EB39  B8 80 91   EORA  $8091          ; mit dem alten vergleichen
  EB3C  85 01      BITA  #$01           ; hat F60 umgeschaltet?
  EB3E  27 0D      BEQ   loc_EB4D       ; nein: Kennzeichen „gerade geschlossen“ löschen
  EB40  C4 7F      ANDB  #$7F           ; umgeschaltet: Verdachtszählung neu beginnen
  EB42  C5 01      BITB  #$01           ; ist F60 jetzt geschlossen?
  EB44  27 07      BEQ   loc_EB4D       ; nein: Kennzeichen löschen
  EB46  86 80      LDAA  #$80           ; $8093.7: F60 hat gerade geschlossen
  EB48  BA 80 93   ORAA  $8093          ; setzen
  EB4B  20 05      BRA   loc_EB52       ; schreiben

