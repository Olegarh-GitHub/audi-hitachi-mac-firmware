;------------------------------------------------------------------------------
; Команда $00 / начало сеанса: опознание. 3 блока ASCII (заголовок $F6, 11 букв)
; из $C9C3: «447905383L », «Motor      », затем вариант по кодировке:
; «PMC AT/CAL.», «PMC AT/BUND», «PMC HS/CAL.», «PMC HS/BUND».
; Следующий блок отправляется на подтверждение тестера ($09, DC90).
;------------------------------------------------------------------------------
KW_IDENT:                               ; вызов из: KW_IDENT, TASK0
  DAFF  C6 03      LDAB  #$03           ; блоков опознания 3
  DB01  F7 81 01   STAB  $8101          ; $8101 = осталось

loc_DB04:
  DB04  86 03      LDAA  #$03           ; 3
  DB06  10         SBA                  ; - осталось = номер блока 0…2
  DB07  16         TAB                  ; в B
  DB08  C1 02      CMPB  #$02           ; блок 2 (вариант)?
  DB0A  26 0D      BNE   loc_DB19       ; нет
  DB0C  7B 04 17   TIM   #$04,PORT6     ; кодировка: PORT6.2 = 1 — HS
  DB0F  27 02      BEQ   loc_DB13       ; AT — +0
  DB11  5C         INCB                 ; HS — +2
  DB12  5C         INCB                 ; (+2)

loc_DB13:
  DB13  7B 10 15   TIM   #$10,PORT5     ; кодировка: PORT5.4 = 1 — BUND
  DB16  27 01      BEQ   loc_DB19       ; CAL — +0
  DB18  5C         INCB                 ; BUND — +1

loc_DB19:
  DB19  86 0B      LDAA  #$0B           ; 11 букв на строку
  DB1B  3D         MUL                  ; × номер
  DB1C  CE C9 C3   LDX   #$C9C3         ; строки опознания
  DB1F  3A         ABX                  ; X -> строка
  DB20  FF 81 87   STX   $8187          ; адрес для отправки
  DB23  C6 0E      LDAB  #$0E           ; длина блока 14
  DB25  86 F6      LDAA  #$F6           ; заголовок $F6 (ASCII)
  DB27  7E DB FC   JMP   loc_DBFC       ; записать

;------------------------------------------------------------------------------
; Команды $01 (чтение ОЗУ) и $03 (чтение ПЗУ). Блок тестера: число байт ($8186),
; адрес ($8187/$8188). Разрешено: ОЗУ $8000-$8290; ПЗУ только $C000-$CA04
; (таблицы и калибровка) и $FFE6-$FFE9 (4 байта перед векторами). Сам код
; программы прочитать нельзя. Ответ блоками по 16 байт: заголовок $FE (ОЗУ)
; или $FD (ПЗУ); продолжение — на подтверждение тестера. Нарушение — «не понял».
;------------------------------------------------------------------------------
KW_READMEM:                             ; вызов из: KW_READMEM
  DB2A  B6 81 86   LDAA  $8186          ; сколько байт
  DB2D  27 7A      BEQ   KW_NAK         ; ноль — «не понял»
  DB2F  81 FF      CMPA  #$FF           ; больше 255 — никогда (оставлено)
  DB31  22 76      BHI   KW_NAK         ; (не бывает: байт не больше 255)
  DB33  FE 81 87   LDX   $8187          ; адрес
  DB36  F6 81 86   LDAB  $8186          ; число
  DB39  5A         DECB                 ; - 1
  DB3A  B6 81 85   LDAA  $8185          ; команда
  DB3D  81 01      CMPA  #$01           ; чтение ОЗУ?
  DB3F  27 1A      BEQ   loc_DB5B       ; да
  DB41  8C C0 00   CPX   #$C000         ; ПЗУ: адрес ниже $C000?
  DB44  25 63      BCS   KW_NAK         ; да — нельзя
  DB46  8C FF E6   CPX   #$FFE6         ; адрес в $FFE6 и выше?
  DB49  24 08      BCC   loc_DB53       ; да — проверить хвост
  DB4B  3A         ABX                  ; конец
  DB4C  8C CA 05   CPX   #$CA05         ; дальше $CA04?
  DB4F  24 58      BCC   KW_NAK         ; да — нельзя
  DB51  20 06      BRA   loc_DB59       ; можно

loc_DB53:
  DB53  3A         ABX                  ; конец
  DB54  8C FF E9   CPX   #$FFE9         ; дальше $FFE9?
  DB57  22 50      BHI   KW_NAK         ; да — нельзя

loc_DB59:
  DB59  20 0B      BRA   loc_DB66       ; можно

loc_DB5B:
  DB5B  8C 80 00   CPX   #$8000         ; ОЗУ: ниже $8000?
  DB5E  25 49      BCS   KW_NAK         ; да — нельзя
  DB60  3A         ABX                  ; конец
  DB61  8C 82 90   CPX   #$8290         ; дальше $8290?
  DB64  22 43      BHI   KW_NAK         ; да — нельзя

loc_DB66:
  DB66  B7 82 0C   STAA  $820C          ; запомнить команду
  DB69  5C         INCB                 ; число байт
  DB6A  F7 82 0D   STAB  $820D          ; осталось отправить
  DB6D  FE 81 87   LDX   $8187          ; адрес
  DB70  FF 82 0E   STX   $820E          ; запомнить

loc_DB73:
  DB73  FE 82 0E   LDX   $820E          ; адрес очередного куска
  DB76  FF 81 87   STX   $8187          ; для отправки
  DB79  B6 82 0D   LDAA  $820D          ; осталось
  DB7C  C6 10      LDAB  #$10           ; кусок 16
  DB7E  11         CBA                  ; осталось больше 16?
  DB7F  22 08      BHI   loc_DB89       ; да
  DB81  B7 81 86   STAA  $8186          ; последний кусок
  DB84  7F 82 0D   CLR   $820D          ; больше не осталось
  DB87  20 0B      BRA   loc_DB94       ; дальше

loc_DB89:
  DB89  F7 81 86   STAB  $8186          ; кусок 16
  DB8C  10         SBA                  ; осталось - 16
  DB8D  B7 82 0D   STAA  $820D          ; записать
  DB90  3A         ABX                  ; адрес следующего куска
  DB91  FF 82 0E   STX   $820E          ; записать

loc_DB94:
  DB94  F6 82 0C   LDAB  $820C          ; команда
  DB97  F7 81 85   STAB  $8185          ; восстановить
  DB9A  86 FE      LDAA  #$FE           ; заголовок $FE (ОЗУ)
  DB9C  C1 01      CMPB  #$01           ; ОЗУ?
  DB9E  27 02      BEQ   loc_DBA2       ; да
  DBA0  86 FD      LDAA  #$FD           ; $FD (ПЗУ)

loc_DBA2:
  DBA2  F6 81 86   LDAB  $8186          ; число байт
  DBA5  CB 03      ADDB  #$03           ; + 3 = длина блока
  DBA7  20 53      BRA   loc_DBFC       ; записать

;------------------------------------------------------------------------------
; «Не понял» — блок с заголовком $0A и номером блока тестера.
;------------------------------------------------------------------------------
KW_NAK:                                 ; вызов из: KW_NAK, KW_READING, KW_READMEM
  DBA9  B6 81 00   LDAA  $8100          ; номер блока
  DBAC  B7 81 06   STAA  $8106          ; в данные
  DBAF  86 0A      LDAA  #$0A           ; заголовок $0A
  DBB1  C6 04      LDAB  #$04           ; длина 4
  DBB3  20 47      BRA   loc_DBFC       ; записать

;------------------------------------------------------------------------------
; Команда $04: тест исполнителей с тестера. Только пока мотор не крутился.
; Каждая команда — следующий шаг (как размыкание контакта 5). Ответ $F5 —
; номер исполнителя по таблице C9AE: 01259, 01261, 01262, 01263, 01247,
; 01241, 00767 (по биту шага $80AF; что какому исполнителю — [Пр]).
;------------------------------------------------------------------------------
KW_ACTTEST:                             ; вызов из: KW_ACTTEST
  DBB5  CE 80 00   LDX   #$8000         ; X = $8000
  DBB8  6B 40 03   TIM   #$40,$03,X     ; зубья уже были?
  DBBB  26 12      BNE   loc_DBCF       ; да — только подтверждение
  DBBD  6B 10 F7   TIM   #$10,$F7,X     ; тест уже закончен?
  DBC0  26 0D      BNE   loc_DBCF       ; да — только подтверждение
  DBC2  F6 80 AF   LDAB  $80AF          ; шаг
  DBC5  C1 04      CMPB  #$04           ; последний (N115)?
  DBC7  26 08      BNE   loc_DBD1       ; нет
  DBC9  62 10 F7   OIM   #$10,$F7,X     ; тест закончен
  DBCC  BD F7 26   JSR   TEST_EXIT      ; выйти из теста

loc_DBCF:
  DBCF  20 47      BRA   loc_DC18       ; подтверждение

loc_DBD1:
  DBD1  61 EF 03   AIM   #$EF,$03,X     ; разрешить тест
  DBD4  86 40      LDAA  #$40           ; запрос следующего шага
  DBD6  BA 80 A9   ORAA  $80A9          ; поставить
  DBD9  B7 80 A9   STAA  $80A9          ; записать
  DBDC  62 08 F7   OIM   #$08,$F7,X     ; запуск с тестера
  DBDF  B6 80 AF   LDAA  $80AF          ; шаг
  DBE2  C6 01      LDAB  #$01           ; номер = 1

loc_DBE4:
  DBE4  48         ASLA                 ; бит шага
  DBE5  25 06      BCS   loc_DBED       ; нашли
  DBE7  5C         INCB                 ; + 1
  DBE8  C1 07      CMPB  #$07           ; меньше 7?
  DBEA  25 F8      BCS   loc_DBE4       ; да
  DBEC  5F         CLRB                 ; нет шага — 0

loc_DBED:
  DBED  CE C9 AE   LDX   #$C9AE         ; таблица C9AE
  DBF0  3A         ABX                  ; + номер
  DBF1  58         ASLB                 ; × 3
  DBF2  3A         ABX                  ; X -> запись
  DBF3  EC 00      LDD   $00,X          ; номер исполнителя (2 байта)
  DBF5  FD 81 06   STD   $8106          ; в данные
  DBF8  86 F5      LDAA  #$F5           ; заголовок $F5
  DBFA  C6 05      LDAB  #$05           ; длина 5

loc_DBFC:
  DBFC  B7 81 05   STAA  $8105          ; заголовок своего блока
  DBFF  F7 81 03   STAB  $8103          ; длина
  DC02  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; Команды $05 (стереть) и $07 (прочитать коды). Пока память ошибок не
; подтверждена после восстановления ($8003.3) — ответа нет.
; $07: для каждого бита $8000-$8002 (23 кода) — 3 байта из C966: номер
; VAG и признак. Заголовок $FC. Номера: 1111 → 65535, 2111 → 00513,
; 2112 → 00514, 2113 → 00515, 2222 → 00519, 2221 → 00519, 2142 → 00524,
; 2144 → 00540, 2141 → 00535, 2143 → 00536, 2123 → 00517, 2121 → 00516,
; 2322 → 00523, 2312 → 00522, 2342 → 00525, 2214 → 00543, 2224 → 00544.
;------------------------------------------------------------------------------
KW_ERRORS:                              ; вызов из: KW_ERRORS
  DC03  86 08      LDAA  #$08           ; память восстановлена и не подтверждена?
  DC05  B5 80 03   BITA  $8003          ; проверить
  DC08  27 01      BEQ   loc_DC0B       ; нет
  DC0A  39         RTS                  ; да — без ответа

loc_DC0B:
  DC0B  CE 80 00   LDX   #$8000         ; X = $8000
  DC0E  B6 81 85   LDAA  $8185          ; команда
  DC11  81 07      CMPA  #$07           ; $07 — чтение?
  DC13  27 06      BEQ   loc_DC1B       ; да
  DC15  62 02 92   OIM   #$02,$92,X     ; $05: запрос на стирание

loc_DC18:
  DC18  7E DC A6   JMP   loc_DCA6       ; подтверждение

loc_DC1B:
  DC1B  7F 81 02   CLR   $8102          ; длина данных = 0
  DC1E  86 80      LDAA  #$80           ; маска бита 7
  DC20  C6 00      LDAB  #$00           ; номер кода 0

loc_DC22:
  DC22  A5 00      BITA  $00,X          ; бит стоит?
  DC24  27 29      BEQ   loc_DC4F       ; нет
  DC26  36         PSHA                 ; сохранить
  DC27  37         PSHB                 ; (сохранить)
  DC28  3C         PSHX                 ; (сохранить)
  DC29  CE C9 66   LDX   #$C966         ; таблица C966
  DC2C  3A         ABX                  ; + номер
  DC2D  58         ASLB                 ; × 3
  DC2E  3A         ABX                  ; X -> запись
  DC2F  EC 00      LDD   $00,X          ; номер VAG
  DC31  FD 80 1E   STD   $801E          ; временно
  DC34  A6 02      LDAA  $02,X          ; признак
  DC36  F6 81 02   LDAB  $8102          ; смещение в блоке
  DC39  CE 81 06   LDX   #$8106         ; данные
  DC3C  3A         ABX                  ; X -> место
  DC3D  A7 02      STAA  $02,X          ; признак
  DC3F  FC 80 1E   LDD   $801E          ; номер
  DC42  ED 00      STD   $00,X          ; записать
  DC44  B6 81 02   LDAA  $8102          ; смещение
  DC47  8B 03      ADDA  #$03           ; + 3
  DC49  B7 81 02   STAA  $8102          ; записать
  DC4C  38         PULX                 ; вернуть
  DC4D  33         PULB                 ; (вернуть)
  DC4E  32         PULA                 ; (вернуть)

loc_DC4F:
  DC4F  5C         INCB                 ; номер + 1
  DC50  C1 17      CMPB  #$17           ; все 23?
  DC52  27 08      BEQ   loc_DC5C       ; да
  DC54  44         LSRA                 ; следующий бит
  DC55  24 CB      BCC   loc_DC22       ; ещё в байте
  DC57  08         INX                  ; следующий байт
  DC58  86 80      LDAA  #$80           ; маска бита 7
  DC5A  20 C6      BRA   loc_DC22       ; дальше

loc_DC5C:
  DC5C  F6 81 02   LDAB  $8102          ; длина данных
  DC5F  CB 03      ADDB  #$03           ; + 3
  DC61  86 FC      LDAA  #$FC           ; заголовок $FC

loc_DC63:
  DC63  20 97      BRA   loc_DBFC       ; записать

;------------------------------------------------------------------------------
; Команда $08: одно значение АЦП. Номер канала 0…7 ($8186) -> ячейка $8019+N:
; 0 давление, 1 напряжение, 2 G62, 3 лямбда (10 бит, 2 байта), 4 $801D [?],
; 5 сигнал отсечки (J142), 6 $801F (временная ячейка N17), 7 G42.
; Ответ $FB, 2 байта. Больше 7 — «не понял».
;------------------------------------------------------------------------------
KW_READING:                             ; вызов из: KW_READING
  DC65  CE 80 19   LDX   #$8019         ; ячейки АЦП
  DC68  F6 81 86   LDAB  $8186          ; номер канала
  DC6B  3A         ABX                  ; X -> ячейка
  DC6C  E6 00      LDAB  $00,X          ; значение
  DC6E  B6 81 86   LDAA  $8186          ; номер канала
  DC71  81 07      CMPA  #$07           ; не больше 7?
  DC73  23 03      BLS   loc_DC78       ; да
  DC75  7E DB A9   JMP   KW_NAK         ; «не понял»

loc_DC78:
  DC78  81 03      CMPA  #$03           ; лямбда (3)?
  DC7A  27 03      BEQ   loc_DC7F       ; да
  DC7C  4F         CLRA                 ; старший = 0
  DC7D  20 08      BRA   loc_DC87       ; дальше

loc_DC7F:
  DC7F  FC 80 B3   LDD   $80B3          ; 10 бит лямбды
  DC82  05         ASLD                 ; выровнять
  DC83  16         TAB                  ; младший
  DC84  49         ROLA                 ; старший
  DC85  84 01      ANDA  #$01           ; два бита

loc_DC87:
  DC87  FD 81 06   STD   $8106          ; в данные
  DC8A  86 FB      LDAA  #$FB           ; заголовок $FB
  DC8C  C6 05      LDAB  #$05           ; длина 5
  DC8E  20 D3      BRA   loc_DC63       ; записать

;------------------------------------------------------------------------------
; Команда $09 (подтверждение): следующий блок опознания, или следующий кусок
; памяти, или своё подтверждение.
;------------------------------------------------------------------------------
KW_ACK:                                 ; вызов из: KW_ACK
  DC90  F6 81 01   LDAB  $8101          ; блоки опознания остались?
  DC93  27 09      BEQ   loc_DC9E       ; нет
  DC95  5A         DECB                 ; - 1
  DC96  F7 81 01   STAB  $8101          ; записать
  DC99  27 03      BEQ   loc_DC9E       ; кончились
  DC9B  7E DB 04   JMP   loc_DB04       ; следующий блок опознания

loc_DC9E:
  DC9E  7D 82 0D   TST   $820D          ; куски памяти остались?
  DCA1  27 03      BEQ   loc_DCA6       ; нет
  DCA3  7E DB 73   JMP   loc_DB73       ; следующий кусок

loc_DCA6:
  DCA6  86 09      LDAA  #$09           ; заголовок $09 — подтверждение
  DCA8  C6 03      LDAB  #$03           ; длина 3
  DCAA  20 B7      BRA   loc_DC63       ; записать

;------------------------------------------------------------------------------
; Команда $11: поставить $8077.5 [?] (снимается любым блоком тестера, кроме $09).
;------------------------------------------------------------------------------
KW_CMD11:                               ; вызов из: KW_CMD11
  DCAC  CE 80 00   LDX   #$8000         ; X = $8000
  DCAF  62 20 77   OIM   #$20,$77,X     ; $8077.5
  DCB2  20 F2      BRA   loc_DCA6       ; подтверждение

;------------------------------------------------------------------------------
; Команда $1B (заводская): параметр $8186 = 9 — снять $80F7.0;
; 0, 1, 2, 4, 8 — $8205 = параметр и $80F7.0 = 1 (используется в IRQ1, CC5E) [?].
;------------------------------------------------------------------------------
KW_CMD1B:                               ; вызов из: KW_CMD1B
  DCB4  CE 80 00   LDX   #$8000         ; X = $8000
  DCB7  B6 81 86   LDAA  $8186          ; параметр
  DCBA  81 09      CMPA  #$09           ; 9?
  DCBC  26 05      BNE   loc_DCC3       ; нет
  DCBE  61 FE F7   AIM   #$FE,$F7,X     ; снять режим
  DCC1  20 1A      BRA   loc_DCDD       ; подтверждение

loc_DCC3:
  DCC3  81 00      CMPA  #$00           ; 0?
  DCC5  27 10      BEQ   loc_DCD7       ; да
  DCC7  81 01      CMPA  #$01           ; 1?
  DCC9  27 0C      BEQ   loc_DCD7       ; да
  DCCB  81 02      CMPA  #$02           ; 2?
  DCCD  27 08      BEQ   loc_DCD7       ; да
  DCCF  81 04      CMPA  #$04           ; 4?
  DCD1  27 04      BEQ   loc_DCD7       ; да
  DCD3  81 08      CMPA  #$08           ; 8?
  DCD5  26 06      BNE   loc_DCDD       ; нет — только подтверждение

loc_DCD7:
  DCD7  B7 82 05   STAA  $8205          ; $8205 = параметр
  DCDA  62 01 F7   OIM   #$01,$F7,X     ; включить режим

loc_DCDD:
  DCDD  20 C7      BRA   loc_DCA6       ; подтверждение

;------------------------------------------------------------------------------
; Команда $06: конец сеанса. $0A — повторить последний блок (DCE5, ничего не делает).
;------------------------------------------------------------------------------
KW_END:                                 ; вызов из: KW_END
  DCDF  CE 80 00   LDX   #$8000         ; X = $8000
  DCE2  61 F7 F6   AIM   #$F7,$F6,X     ; сеанс закрыть

sub_DCE5:                               ; вызов из: DCE5, KW_END
  DCE5  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; Сброс состояния обмена (нет сеанса или сбой).
;------------------------------------------------------------------------------
loc_DCE6:
  DCE6  CE 80 00   LDX   #$8000         ; X = $8000
  DCE9  61 04 F6   AIM   #$04,$F6,X     ; оставить только уровень линии L
  DCEC  72 10 11   OIM   #$10,TRCSR1    ; разрешить прерывание приёма SCI
  DCEF  4F         CLRA                 ; A = 0
  DCF0  01         NOP                  ; пусто
  DCF1  01         NOP                  ; пусто
  DCF2  B7 81 00   STAA  $8100          ; счётчик блоков = 0
  DCF5  A7 FE      STAA  $FE,X          ; номер байта = 0
  DCF7  B7 81 01   STAA  $8101          ; блоки опознания = 0
  DCFA  B7 82 0D   STAA  $820D          ; куски памяти = 0
  DCFD  4A         DECA                 ; $FF
  DCFE  A7 FD      STAA  $FD,X          ; таймаут не идёт
  DD00  61 10 F7   AIM   #$10,$F7,X     ; в $80F7 оставить только бит 4

loc_DD03:
  DD03  7E D1 D1   JMP   loc_D1D1       ; конец задачи 0 — к диспетчеру

;------------------------------------------------------------------------------
; N7_TO_TICKS — $805D = D × 214 / 256, где D = A:B — скважность N7 в процентах
; (A — целые, B — доли). 100 % = 21400 тактов = весь период 71,8 Гц.
; X указывает на временную ячейку.
;------------------------------------------------------------------------------
N7_TO_TICKS:                            ; вызов из: TASK2
  DD06  36         PSHA                 ; целые проценты
  DD07  86 D6      LDAA  #$D6           ; 214
  DD09  3D         MUL                  ; доли × 214
  DD0A  A7 00      STAA  $00,X          ; старший байт — во временную
  DD0C  86 D6      LDAA  #$D6           ; 214
  DD0E  33         PULB                 ; B = целые
  DD0F  3D         MUL                  ; целые × 214
  DD10  EB 00      ADDB  $00,X          ; + доли
  DD12  89 00      ADCA  #$00           ; перенос
  DD14  FD 80 5D   STD   $805D          ; $805D = время N7 в тактах
  DD17  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; ЗАДАЧА 1 — раз в 2 тика (≈20 мс).
; Режимные биты $8050:
;  5 — прогрет: G62 ниже C6DE = 39 (≈70 °C [Пр], по SSP с 70 °C работает детонация),
;      снимается от 42;
;  6 — нагрузка: давление выше C6DF = 90 (≈0,7 бар абс. [Пр]), снимается ниже 87;
;  4 — напряжение в норме: ставится при 95…149, снимается ниже 90 или от 155;
;  7 — регулирование детонации включено: прогрет и нагрузка, не пуск,
;      дроссель не закрыт, не идёт выдача блинков.
;------------------------------------------------------------------------------
TASK1:                                  ; вызов из: TASK1
  DD18  B6 C6 DE   LDAA  $C6DE          ; порог прогрева C6DE = 39
  DD1B  F6 80 1B   LDAB  $801B          ; температура ОЖ
