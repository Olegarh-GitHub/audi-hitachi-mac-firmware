;------------------------------------------------------------------------------
; Prüfung der Drosselklappenschalter anhand des Drucks G71. Flags in $8093:
;  Bit 0: F60 geschlossen (Kopie des Eingangs beim vorigen Aufruf);
;  Bit 3: F60 defekt: zusammen mit F81 geschlossen bei Druck > 141
;          länger als 15 Aufrufe (1,5 s). Gelöscht, wenn F60 offen,
;          F81 geschlossen und Druck > 141 ist (Code 2121 [Vermutung]);
;  Bit 4: Verdachtszählung für F60 läuft (Zähler $809B);
;  Bit 1: F81 defekt: F81 geschlossen bei Druck < 77
;          (starker Unterdruck) länger als 15 Aufrufe (Zähler $809D) (Code 2123 [Vermutung]).
; Solange keine Synchronisation besteht oder ein G71-Fehler vorliegt, wird nicht geprüft.
; Schwelle C7A8 = 0, daher sind zwei Prüfzweige in dieser Kalibrierung wirkungslos.
;------------------------------------------------------------------------------
loc_EC62:
  EC62  86 20      LDAA  #$20           ; Synchronisation vorhanden ($8095.5)?
  EC64  B5 80 95   BITA  $8095          ; prüfen
  EC67  26 03      BNE   loc_EC6C       ; ja: prüfen
  EC69  7E ED 20   JMP   loc_ED20       ; nein: Prüfungen überspringen

loc_EC6C:
  EC6C  F6 80 93   LDAB  $8093          ; Schalterflags
  EC6F  86 72      LDAA  #$72           ; G71-Fehler
  EC71  B5 80 91   BITA  $8091          ; vorhanden?
  EC74  26 6D      BNE   loc_ECE3       ; ja: Verdacht auf F60 zurücksetzen
  EC76  C4 FE      ANDB  #$FE           ; zuerst Bit 0 löschen
  EC78  BD D2 15   JSR   RD_INPUTS      ; digitale Eingänge
  EC7B  85 20      BITA  #$20           ; Bit 5 ist F60
  EC7D  27 02      BEQ   loc_EC81       ; offen? ja: Bit 0 = 0
  EC7F  CA 01      ORAB  #$01           ; Bit 0 = 1: F60 geschlossen

loc_EC81:
  EC81  17         TBA                  ; neuer Zustand
  EC82  B8 80 93   EORA  $8093          ; mit dem alten vergleichen
  EC85  85 01      BITA  #$01           ; hat F60 umgeschaltet?
  EC87  27 05      BEQ   loc_EC8E       ; nein: weiter
  EC89  C4 EF      ANDB  #$EF           ; umgeschaltet: Verdachtszählung neu beginnen
  EC8B  7F 80 9B   CLR   $809B          ; Zähler = 0

loc_EC8E:
  EC8E  B6 80 19   LDAA  $8019          ; Druck
  EC91  C5 01      BITB  #$01           ; F60 geschlossen?
  EC93  27 29      BEQ   loc_ECBE       ; nein: Zweig „F60 offen“
