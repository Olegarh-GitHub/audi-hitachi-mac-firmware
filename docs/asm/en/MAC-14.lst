;------------------------------------------------------------------------------
; SCI - K-line receive interrupt [?]. If it is time to transmit ($80F7.6), clear it;
; otherwise, if the sync bytes have been sent and no byte is waiting yet, mark it ($80F6.4).
; Then disable this interrupt and discard the received byte (its own echo on
; the single-wire K-line [assumed]). Main reception is by polling in task 0.
;------------------------------------------------------------------------------
SCI:                                    ; called from: SCI
  F6FD  7B 80 11   TIM   #$80,TRCSR1    ; byte received?
  F700  27 1F      BEQ   loc_F721       ; no
  F702  B6 80 F7   LDAA  $80F7          ; communication flags
  F705  85 40      BITA  #$40           ; time to transmit?
  F707  26 10      BNE   loc_F719       ; yes
  F709  B6 80 F6   LDAA  $80F6          ; session state
  F70C  2A 13      BPL   loc_F721       ; sync bytes not sent - discard
  F70E  85 10      BITA  #$10           ; byte already waiting?
  F710  26 13      BNE   loc_F725       ; yes - exit
  F712  8A 10      ORAA  #$10           ; mark
  F714  B7 80 F6   STAA  $80F6          ; store
  F717  20 05      BRA   loc_F71E       ; continue

loc_F719:
  F719  84 BF      ANDA  #$BF           ; clear "time to transmit"
  F71B  B7 80 F7   STAA  $80F7          ; store

loc_F71E:
  F71E  71 EF 11   AIM   #$EF,TRCSR1    ; disable the receive interrupt

loc_F721:
  F721  96 11      LDAA  TRCSR1         ; read the status
  F723  96 12      LDAA  RDR            ; discard the byte

loc_F725:
  F725  3B         RTI                  ; exit

;------------------------------------------------------------------------------
; TEST_EXIT - the engine is turning (or the test is over): set $8003.4 once
; and reset the blink code and actuator test state.
;------------------------------------------------------------------------------
TEST_EXIT:                              ; called from: ICF, IRQ1, KW_ACTTEST, TASK0, TASK3
  F726  3C         PSHX                 ; save X
  F727  CE 80 00   LDX   #$8000         ; X = $8000
  F72A  6B 10 03   TIM   #$10,$03,X     ; already?
  F72D  26 11      BNE   loc_F740       ; yes
  F72F  62 10 03   OIM   #$10,$03,X     ; $8003.4
  F732  4F         CLRA                 ; 0
  F733  5F         CLRB                 ; 0
  F734  A7 A0      STAA  $A0,X          ; output state
  F736  A7 A4      STAA  $A4,X          ; timer
  F738  E7 AF      STAB  $AF,X          ; test step
  F73A  ED AA      STD   $AA,X          ; N17 counters
  F73C  ED AC      STD   $AC,X          ; phase timer, test divider
  F73E  E7 AE      STAB  $AE,X          ; contact 5 closed time

loc_F740:
  F740  38         PULX                 ; restore X
  F741  39         RTS                  ; return

; table $F742, 14 bytes: empty (FF)
  F742  db FF FF FF FF FF FF FF FF FF FF FF FF FF FF

