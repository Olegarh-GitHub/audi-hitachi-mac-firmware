  DCBA  81 09      CMPA  #$09           ; 9?
  DCBC  26 05      BNE   loc_DCC3       ; nein
  DCBE  61 FE F7   AIM   #$FE,$F7,X     ; Modus abschalten
  DCC1  20 1A      BRA   loc_DCDD       ; Quittung

loc_DCC3:
