loc_D598:
  D598  8A 08      ORAA  #$08           ; first part completed (bit 3)
  D59A  20 31      BRA   loc_D5CD       ; store the timer

loc_D59C:
  D59C  85 08      BITA  #$08           ; first part completed?
  D59E  26 30      BNE   loc_D5D0       ; yes — main part
  D5A0  5D         TSTB                 ; timer
  D5A1  27 14      BEQ   loc_D5B7       ; zero
  D5A3  5A         DECB                 ; - 1
  D5A4  85 01      BITA  #$01           ; bit 0 (always 0)
  D5A6  26 25      BNE   loc_D5CD       ; set —
  D5A8  F6 C7 8F   LDAB  $C78F          ; C78F = 0
  D5AB  27 EB      BEQ   loc_D598       ; zero — completed at once (part disabled)
  D5AD  F7 80 AD   STAB  $80AD          ; (not executed with C78F = 0)
  D5B0  8A 10      ORAA  #$10           ; (not executed) start pulse
  D5B2  71 DF 17   AIM   #$DF,PORT6     ; (not executed) open N17
  D5B5  20 19      BRA   loc_D5D0       ; (not executed)

