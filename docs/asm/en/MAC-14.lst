loc_E6F3:
  E6F3  F3 80 10   ADDD  $8010          ; lean - up
  E6F6  81 BE      CMPA  #$BE           ; above $BE00?
  E6F8  25 03      BCS   loc_E6FD       ; no
  E6FA  CC BE 00   LDD   #$BE00         ; limit

loc_E6FD:
  E6FD  FD 80 59   STD   $8059          ; $8059 = integrator
  E700  83 5F 00   SUBD  #$5F00         ; - middle
  E703  24 23      BCC   loc_E728       ; up - add
  E705  50         NEGB                 ; down - absolute value
  E706  27 01      BEQ   loc_E709       ; (same)
  E708  4C         INCA                 ; (same)

loc_E709:
  E709  40         NEGA                 ; (same)
  E70A  FD 80 10   STD   $8010          ; correction
  E70D  5F         CLRB                 ; (same)
  E70E  B6 80 57   LDAA  $8057          ; base
  E711  B3 80 10   SUBD  $8010          ; - correction
  E714  24 02      BCC   loc_E718       ; not below zero
  E716  4F         CLRA                 ; 0
  E717  5F         CLRB                 ; (same)

loc_E718:
  E718  81 05      CMPA  #$05           ; not below 5 %?
  E71A  24 0A      BCC   loc_E726       ; yes
  E71C  86 64      LDAA  #$64           ; pull back the integrator: 100 - base
  E71E  B0 80 57   SUBA  $8057          ; (same)
  E721  5F         CLRB                 ; (same)
  E722  FD 80 59   STD   $8059          ; store
