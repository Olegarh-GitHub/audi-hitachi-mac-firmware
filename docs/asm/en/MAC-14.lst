  DA1B  27 08      BEQ   loc_DA25       ; yes
  DA1D  C6 DF      LDAB  #$DF           ; otherwise clear $8077.5 [?]
  DA1F  F4 80 77   ANDB  $8077          ; clear
  DA22  F7 80 77   STAB  $8077          ; store

loc_DA25:
  DA25  81 03      CMPA  #$03           ; last byte $03?
  DA27  26 1B      BNE   loc_DA44       ; no — error
  DA29  F6 81 85   LDAB  $8185          ; title
  DA2C  C1 0B      CMPB  #$0B           ; less than $0B?
  DA2E  25 16      BCS   loc_DA46       ; yes — number = title
  DA30  C1 1B      CMPB  #$1B           ; $1B?
  DA32  26 04      BNE   loc_DA38       ; no
  DA34  C6 0F      LDAB  #$0F           ; number $0F
  DA36  20 0E      BRA   loc_DA46       ; continue

loc_DA38:
  DA38  C1 10      CMPB  #$10           ; less than $10?
  DA3A  25 08      BCS   loc_DA44       ; yes — unknown
  DA3C  C1 13      CMPB  #$13           ; $13 or more?
  DA3E  24 04      BCC   loc_DA44       ; yes — unknown
  DA40  C0 05      SUBB  #$05           ; $10-$12 -> $0B-$0D
  DA42  20 02      BRA   loc_DA46       ; continue

loc_DA44:
  DA44  C6 0E      LDAB  #$0E           ; unknown command -> $0E

loc_DA46:
  DA46  58         ASLB                 ; × 2
  DA47  3C         PSHX                 ; save X
  DA48  CE DA DF   LDX   #$DADF         ; command table $DADF
  DA4B  3A         ABX                  ; X -> address
  DA4C  EE 00      LDX   $00,X          ; handler address
