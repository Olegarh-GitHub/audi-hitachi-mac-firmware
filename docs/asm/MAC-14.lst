;------------------------------------------------------------------------------
; ДЕТОНАЦИЯ: обработка замеров. Для каждого из 5 цилиндров запись 8 байт
; с $80C0 (цилиндр N — $80C0 + 8·N):
;  +0 бит 7 — пришёл новый замер (ставит прерывание), бит 0 — сигнал датчика
;     слишком слабый при наибольшем усилении;
;  +1 усиление (1, 2, 4, 8), которое прерывание выставляет усилителю;
;  +2 замер (интегратор за окно детонации);
;  +3 замер, приведённый к общему масштабу (× $80BD / 256);
;  +4/+5 фон — медленное среднее приведённых замеров (16 бит);
;  +6 сглаженный замер (пополам старое и новое, C917 = 128);
;  +7 новое усиление.
; Стук: приведённый замер больше фона в f/32 раз, f — таблица C8C0
; (5 строк по цилиндрам × 16 столбцов по оборотам, ось C8B0). f = 144 на
; низких оборотах (в 4,5 раза), 80…107 на высоких (в 2,5…3,3 раза).
; Есть стук — бит цилиндра в $8054 (цилиндр 1 = бит 7); фон при этом не
; обновляется. Нет — фон шагает к замеру на 0,5 (C915).
; Усиление: фон выше 3 × нижнего предела — усиление вдвое меньше,
; фон ниже предела — вдвое больше (не больше 8).
;------------------------------------------------------------------------------
loc_D738:
  D738  86 80      LDAA  #$80           ; маска первого цилиндра (бит 7)
  D73A  B7 80 E9   STAA  $80E9          ; $80E9 = маска цилиндра
  D73D  5F         CLRB                 ; смещение записи = 0

loc_D73E:
