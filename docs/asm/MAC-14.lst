  D741  CE 80 C0   LDX   #$80C0         ; записи цилиндров
  D744  3A         ABX                  ; X -> запись цилиндра
  D745  A6 00      LDAA  $00,X          ; флаги
  D747  2B 03      BMI   loc_D74C       ; новый замер есть?
  D749  7E D8 7A   JMP   loc_D87A       ; нет — к следующему цилиндру

loc_D74C:
