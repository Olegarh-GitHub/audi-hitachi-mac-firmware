  DFD0  C6 10      LDAB  #$10           ; 16 Stützstellen
  DFD2  8D B6      BSR   RPM_COL        ; Spalte, B = Zelle
  DFD4  86 20      LDAA  #$20           ; warm?
  DFD6  B5 80 50   BITA  $8050          ; prüfen
  DFD9  27 10      BEQ   loc_DFEB       ; nein — Kennfeld 2
