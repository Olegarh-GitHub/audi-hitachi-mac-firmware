;------------------------------------------------------------------------------
; Klopfparameter nach Drehzahl (ohne Interpolation, nächstniedriger Punkt
; der Achse C850 = 10 14 20 30 50 70 90 110 130 150 170 190 210 230 250 255):
; $80B7/$80B8: Messfenster (C860, C870) [Vermutung]; $80BA: untere Messgrenze
; (C880); $80BB: Schwelle „Sensor stumm" (C890 = 5); $80BD: Skalierung (C8A0).
;------------------------------------------------------------------------------
  DDB0  B6 80 18   LDAA  $8018          ; Drehzahl
  DDB3  CE C8 50   LDX   #$C850         ; Achse C850
  DDB6  C6 10      LDAB  #$10           ; 16 Punkte
  DDB8  BD CA 5F   JSR   AXIS_UP        ; Punkt suchen
  DDBB  A6 10      LDAA  $10,X          ; C860
  DDBD  E6 20      LDAB  $20,X          ; C870
  DDBF  FD 80 B7   STD   $80B7          ; $80B7/$80B8
  DDC2  A6 30      LDAA  $30,X          ; C880
  DDC4  B7 80 BA   STAA  $80BA          ; $80BA: untere Grenze
  DDC7  A6 40      LDAA  $40,X          ; C890
  DDC9  B7 80 BB   STAA  $80BB          ; $80BB: Schwelle „stumm"
  DDCC  A6 50      LDAA  $50,X          ; C8A0
  DDCE  B7 80 BD   STAA  $80BD          ; $80BD: Skalierung
  DDD1  CE C2 10   LDX   #$C210         ; Drehzahlachse C210
  DDD4  B6 80 18   LDAA  $8018          ; Drehzahl
  DDD7  C6 10      LDAB  #$10           ; 16 Punkte
  DDD9  BD CA 5F   JSR   AXIS_UP        ; Intervall suchen
  DDDC  F7 80 0C   STAB  $800C          ; $800C = Nummer
  DDDF  BD CA 05   JSR   FRAC_UP        ; Bruchteil
  DDE2  F7 80 0D   STAB  $800D          ; $800D = Bruchteil
  DDE5  F6 80 0C   LDAB  $800C          ; Nummer
  DDE8  CE C2 30   LDX   #$C230         ; Tabelle C230 (11 … 80)
  DDEB  3A         ABX                  ; X -> Wert
  DDEC  F6 80 0D   LDAB  $800D          ; Bruchteil
  DDEF  BD CA 41   JSR   INTERP         ; Interpolation
  DDF2  B7 80 4F   STAA  $804F          ; $804F [?]
  DDF5  F6 80 0C   LDAB  $800C          ; Nummer
  DDF8  CE C2 40   LDX   #$C240         ; Tabelle C240 (16 … 100)
  DDFB  3A         ABX                  ; X -> Wert
  DDFC  F6 80 0D   LDAB  $800D          ; Bruchteil
  DDFF  BD CA 41   JSR   INTERP         ; Interpolation
  DE02  B7 80 4E   STAA  $804E          ; $804E [?]

;------------------------------------------------------------------------------
; Prüfung der Klopfsensoren. Zylinder 1-2 an G61, 3-5 an G66 (Tabelle C914,
; C910-C913: 0 = G61, FF = G66; stimmt mit dem Stromlaufplan überein). Haben alle Zylinder
; einer Gruppe die Kennung „Sensor stumm", wird gezählt; 150 Aufrufe in Folge (3 s) ergeben einen Fehler:
; G61 setzt $80B6 Bits 7 und 6 (2142), G66 Bits 5 und 4 (2144). Bits 3/2: Gruppe
; wurde geprüft.
;------------------------------------------------------------------------------
  DE05  CE C9 0F   LDX   #$C90F         ; Gruppentabelle
