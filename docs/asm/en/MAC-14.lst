  DAC1  3A         ABX                  ; X -> byte
  DAC2  A6 00      LDAA  $00,X          ; byte

loc_DAC4:
  DAC4  97 13      STAA  TDR            ; to SCI
  DAC6  B7 80 FC   STAA  $80FC          ; remember for checking the response
  DAC9  7C 80 FE   INC   $80FE          ; number + 1
  DACC  86 06      LDAA  #$06           ; wait for a response 6 ticks

loc_DACE:
  DACE  38         PULX                 ; restore X
  DACF  B7 80 FD   STAA  $80FD          ; timeout
  DAD2  6B 02 00   TIM   #$02,$00,X     ; previous byte never acknowledged?
  DAD5  27 03      BEQ   loc_DADA       ; no
  DAD7  7E DC E6   JMP   loc_DCE6       ; yes — to the end (exchange failure)

loc_DADA:
  DADA  62 02 00   OIM   #$02,$00,X     ; waiting for acknowledgement
  DADD  20 82      BRA   loc_DA61       ; to the end

; table $DADF, 32 bytes: KW1281 command table (16 addresses): $00 DAFF, $01 DB2A, $02 DBA9, $03 DB2A, $04 DBB5, $05 DC03, $06 DCDF, $07 DC03, $08 DC65, $09 DC90, $0A DCE5, $10 DBA9, $11 DCAC, $12 DBA9, others DBA9, $1B DCB4
  DADF  db DA FF DB 2A DB A9 DB 2A DB B5 DC 03 DC DF DC 03
  DAEF  db DC 65 DC 90 DC E5 DB A9 DC AC DB A9 DB A9 DC B4

;------------------------------------------------------------------------------
; Command $00 / start of session: identification. 3 ASCII blocks (header $F6, 11 characters)
; from $C9C3: "447905383L ", "Motor      ", then a variant depending on coding:
; "PMC AT/CAL.", "PMC AT/BUND", "PMC HS/CAL.", "PMC HS/BUND".
; The next block is sent on the tester's acknowledgement ($09, DC90).
;------------------------------------------------------------------------------
KW_IDENT:                               ; called from: KW_IDENT, TASK0
  DAFF  C6 03      LDAB  #$03           ; identification blocks: 3
  DB01  F7 81 01   STAB  $8101          ; $8101 = remaining

loc_DB04:
  DB04  86 03      LDAA  #$03           ; 3
  DB06  10         SBA                  ; - remaining = block number 0…2
  DB07  16         TAB                  ; into B
  DB08  C1 02      CMPB  #$02           ; block 2 (variant)?
  DB0A  26 0D      BNE   loc_DB19       ; no
  DB0C  7B 04 17   TIM   #$04,PORT6     ; coding: PORT6.2 = 1 means HS
  DB0F  27 02      BEQ   loc_DB13       ; AT: +0
  DB11  5C         INCB                 ; HS: +2
  DB12  5C         INCB                 ; (+2)

loc_DB13:
  DB13  7B 10 15   TIM   #$10,PORT5     ; coding: PORT5.4 = 1 means BUND
  DB16  27 01      BEQ   loc_DB19       ; CAL: +0
  DB18  5C         INCB                 ; BUND: +1

loc_DB19:
  DB19  86 0B      LDAA  #$0B           ; 11 characters per string
  DB1B  3D         MUL                  ; × number
  DB1C  CE C9 C3   LDX   #$C9C3         ; identification strings
  DB1F  3A         ABX                  ; X -> string
  DB20  FF 81 87   STX   $8187          ; address to send from
  DB23  C6 0E      LDAB  #$0E           ; block length 14
  DB25  86 F6      LDAA  #$F6           ; header $F6 (ASCII)
  DB27  7E DB FC   JMP   loc_DBFC       ; store

;------------------------------------------------------------------------------
; Commands $01 (read RAM) and $03 (read ROM). Tester block: byte count ($8186),
; address ($8187/$8188). Allowed: RAM $8000-$8290; ROM only $C000-$CA04
; (tables and calibration) and $FFE6-$FFE9 (4 bytes before the vectors). The program
; code itself cannot be read. Reply in 16-byte blocks: header $FE (RAM)
; or $FD (ROM); continuation on the tester's acknowledgement. Violation gives "not understood".
;------------------------------------------------------------------------------
KW_READMEM:                             ; called from: KW_READMEM
  DB2A  B6 81 86   LDAA  $8186          ; how many bytes
  DB2D  27 7A      BEQ   KW_NAK         ; zero gives "not understood"
  DB2F  81 FF      CMPA  #$FF           ; more than 255: never happens (left in)
  DB31  22 76      BHI   KW_NAK         ; (cannot happen: a byte is not more than 255)
  DB33  FE 81 87   LDX   $8187          ; address
  DB36  F6 81 86   LDAB  $8186          ; count
  DB39  5A         DECB                 ; - 1
  DB3A  B6 81 85   LDAA  $8185          ; command
  DB3D  81 01      CMPA  #$01           ; read RAM?
  DB3F  27 1A      BEQ   loc_DB5B       ; yes
  DB41  8C C0 00   CPX   #$C000         ; ROM: address below $C000?
  DB44  25 63      BCS   KW_NAK         ; yes: not allowed
  DB46  8C FF E6   CPX   #$FFE6         ; address at $FFE6 or above?
  DB49  24 08      BCC   loc_DB53       ; yes: check the tail
  DB4B  3A         ABX                  ; end
  DB4C  8C CA 05   CPX   #$CA05         ; beyond $CA04?
  DB4F  24 58      BCC   KW_NAK         ; yes: not allowed
  DB51  20 06      BRA   loc_DB59       ; allowed

loc_DB53:
  DB53  3A         ABX                  ; end
  DB54  8C FF E9   CPX   #$FFE9         ; beyond $FFE9?
  DB57  22 50      BHI   KW_NAK         ; yes: not allowed

loc_DB59:
  DB59  20 0B      BRA   loc_DB66       ; allowed

loc_DB5B:
  DB5B  8C 80 00   CPX   #$8000         ; RAM: below $8000?
  DB5E  25 49      BCS   KW_NAK         ; yes: not allowed
  DB60  3A         ABX                  ; end
  DB61  8C 82 90   CPX   #$8290         ; beyond $8290?
  DB64  22 43      BHI   KW_NAK         ; yes: not allowed

loc_DB66:
  DB66  B7 82 0C   STAA  $820C          ; remember the command
  DB69  5C         INCB                 ; byte count
  DB6A  F7 82 0D   STAB  $820D          ; remaining to send
  DB6D  FE 81 87   LDX   $8187          ; address
  DB70  FF 82 0E   STX   $820E          ; remember

loc_DB73:
  DB73  FE 82 0E   LDX   $820E          ; address of the next chunk
  DB76  FF 81 87   STX   $8187          ; for sending
  DB79  B6 82 0D   LDAA  $820D          ; remaining
  DB7C  C6 10      LDAB  #$10           ; chunk of 16
  DB7E  11         CBA                  ; more than 16 remaining?
  DB7F  22 08      BHI   loc_DB89       ; yes
  DB81  B7 81 86   STAA  $8186          ; last chunk
  DB84  7F 82 0D   CLR   $820D          ; nothing more remaining
  DB87  20 0B      BRA   loc_DB94       ; continue

loc_DB89:
  DB89  F7 81 86   STAB  $8186          ; chunk of 16
  DB8C  10         SBA                  ; remaining - 16
  DB8D  B7 82 0D   STAA  $820D          ; store
  DB90  3A         ABX                  ; address of the next chunk
  DB91  FF 82 0E   STX   $820E          ; store

loc_DB94:
  DB94  F6 82 0C   LDAB  $820C          ; command
  DB97  F7 81 85   STAB  $8185          ; restore
  DB9A  86 FE      LDAA  #$FE           ; header $FE (RAM)
  DB9C  C1 01      CMPB  #$01           ; RAM?
  DB9E  27 02      BEQ   loc_DBA2       ; yes
  DBA0  86 FD      LDAA  #$FD           ; $FD (ROM)

loc_DBA2:
  DBA2  F6 81 86   LDAB  $8186          ; byte count
  DBA5  CB 03      ADDB  #$03           ; + 3 = block length
  DBA7  20 53      BRA   loc_DBFC       ; store

;------------------------------------------------------------------------------
; "Not understood": block with header $0A and the tester's block number.
;------------------------------------------------------------------------------
KW_NAK:                                 ; called from: KW_NAK, KW_READING, KW_READMEM
  DBA9  B6 81 00   LDAA  $8100          ; block number
  DBAC  B7 81 06   STAA  $8106          ; into data
  DBAF  86 0A      LDAA  #$0A           ; header $0A
  DBB1  C6 04      LDAB  #$04           ; length 4
  DBB3  20 47      BRA   loc_DBFC       ; store

;------------------------------------------------------------------------------
; Command $04: actuator test from the tester. Only while the engine has not turned.
; Each command is the next step (like opening contact 5). Reply $F5 is the
; actuator number from table C9AE: 01259, 01261, 01262, 01263, 01247,
; 01241, 00767 (by the step bit $80AF; which number belongs to which actuator is [assumed]).
;------------------------------------------------------------------------------
KW_ACTTEST:                             ; called from: KW_ACTTEST
  DBB5  CE 80 00   LDX   #$8000         ; X = $8000
  DBB8  6B 40 03   TIM   #$40,$03,X     ; teeth already seen?
  DBBB  26 12      BNE   loc_DBCF       ; yes: acknowledgement only
  DBBD  6B 10 F7   TIM   #$10,$F7,X     ; test already finished?
  DBC0  26 0D      BNE   loc_DBCF       ; yes: acknowledgement only
  DBC2  F6 80 AF   LDAB  $80AF          ; step
  DBC5  C1 04      CMPB  #$04           ; last one (N115)?
  DBC7  26 08      BNE   loc_DBD1       ; no
  DBC9  62 10 F7   OIM   #$10,$F7,X     ; test finished
  DBCC  BD F7 26   JSR   TEST_EXIT      ; leave the test

loc_DBCF:
  DBCF  20 47      BRA   loc_DC18       ; acknowledgement

loc_DBD1:
  DBD1  61 EF 03   AIM   #$EF,$03,X     ; enable the test
  DBD4  86 40      LDAA  #$40           ; request for the next step
  DBD6  BA 80 A9   ORAA  $80A9          ; set
  DBD9  B7 80 A9   STAA  $80A9          ; store
  DBDC  62 08 F7   OIM   #$08,$F7,X     ; start from the tester
  DBDF  B6 80 AF   LDAA  $80AF          ; step
  DBE2  C6 01      LDAB  #$01           ; number = 1

loc_DBE4:
  DBE4  48         ASLA                 ; step bit
  DBE5  25 06      BCS   loc_DBED       ; found
  DBE7  5C         INCB                 ; + 1
  DBE8  C1 07      CMPB  #$07           ; less than 7?
  DBEA  25 F8      BCS   loc_DBE4       ; yes
  DBEC  5F         CLRB                 ; no step: 0

loc_DBED:
  DBED  CE C9 AE   LDX   #$C9AE         ; table C9AE
  DBF0  3A         ABX                  ; + number
  DBF1  58         ASLB                 ; × 3
  DBF2  3A         ABX                  ; X -> entry
  DBF3  EC 00      LDD   $00,X          ; actuator number (2 bytes)
  DBF5  FD 81 06   STD   $8106          ; into data
  DBF8  86 F5      LDAA  #$F5           ; header $F5
  DBFA  C6 05      LDAB  #$05           ; length 5

loc_DBFC:
  DBFC  B7 81 05   STAA  $8105          ; header of own block
  DBFF  F7 81 03   STAB  $8103          ; length
  DC02  39         RTS                  ; return

;------------------------------------------------------------------------------
; Commands $05 (erase) and $07 (read codes). As long as the fault memory has not
; been confirmed after restoration ($8003.3), there is no reply.
; $07: for each bit of $8000-$8002 (23 codes), 3 bytes from C966: VAG
; number and flag. Header $FC. Numbers: 1111 → 65535, 2111 → 00513,
; 2112 → 00514, 2113 → 00515, 2222 → 00519, 2221 → 00519, 2142 → 00524,
; 2144 → 00540, 2141 → 00535, 2143 → 00536, 2123 → 00517, 2121 → 00516,
; 2322 → 00523, 2312 → 00522, 2342 → 00525, 2214 → 00543, 2224 → 00544.
;------------------------------------------------------------------------------
KW_ERRORS:                              ; called from: KW_ERRORS
  DC03  86 08      LDAA  #$08           ; memory restored and not confirmed?
  DC05  B5 80 03   BITA  $8003          ; check
  DC08  27 01      BEQ   loc_DC0B       ; no
  DC0A  39         RTS                  ; yes: no reply

loc_DC0B:
  DC0B  CE 80 00   LDX   #$8000         ; X = $8000
  DC0E  B6 81 85   LDAA  $8185          ; command
  DC11  81 07      CMPA  #$07           ; $07: read?
  DC13  27 06      BEQ   loc_DC1B       ; yes
  DC15  62 02 92   OIM   #$02,$92,X     ; $05: erase request

loc_DC18:
  DC18  7E DC A6   JMP   loc_DCA6       ; acknowledgement

loc_DC1B:
  DC1B  7F 81 02   CLR   $8102          ; data length = 0
  DC1E  86 80      LDAA  #$80           ; bit 7 mask
  DC20  C6 00      LDAB  #$00           ; code number 0

loc_DC22:
  DC22  A5 00      BITA  $00,X          ; bit set?
  DC24  27 29      BEQ   loc_DC4F       ; no
  DC26  36         PSHA                 ; save
  DC27  37         PSHB                 ; (save)
  DC28  3C         PSHX                 ; (save)
  DC29  CE C9 66   LDX   #$C966         ; table C966
  DC2C  3A         ABX                  ; + number
  DC2D  58         ASLB                 ; × 3
  DC2E  3A         ABX                  ; X -> entry
  DC2F  EC 00      LDD   $00,X          ; VAG number
  DC31  FD 80 1E   STD   $801E          ; temporary
  DC34  A6 02      LDAA  $02,X          ; flag
  DC36  F6 81 02   LDAB  $8102          ; offset in the block
  DC39  CE 81 06   LDX   #$8106         ; data
  DC3C  3A         ABX                  ; X -> position
  DC3D  A7 02      STAA  $02,X          ; flag
  DC3F  FC 80 1E   LDD   $801E          ; number
  DC42  ED 00      STD   $00,X          ; store
  DC44  B6 81 02   LDAA  $8102          ; offset
  DC47  8B 03      ADDA  #$03           ; + 3
  DC49  B7 81 02   STAA  $8102          ; store
  DC4C  38         PULX                 ; restore
  DC4D  33         PULB                 ; (restore)
  DC4E  32         PULA                 ; (restore)

loc_DC4F:
  DC4F  5C         INCB                 ; number + 1
  DC50  C1 17      CMPB  #$17           ; all 23?
  DC52  27 08      BEQ   loc_DC5C       ; yes
  DC54  44         LSRA                 ; next bit
  DC55  24 CB      BCC   loc_DC22       ; more in this byte
  DC57  08         INX                  ; next byte
  DC58  86 80      LDAA  #$80           ; bit 7 mask
  DC5A  20 C6      BRA   loc_DC22       ; continue

loc_DC5C:
  DC5C  F6 81 02   LDAB  $8102          ; data length
  DC5F  CB 03      ADDB  #$03           ; + 3
  DC61  86 FC      LDAA  #$FC           ; header $FC

loc_DC63:
  DC63  20 97      BRA   loc_DBFC       ; store

;------------------------------------------------------------------------------
; Command $08: one ADC value. Channel number 0…7 ($8186) -> cell $8019+N:
; 0 pressure, 1 voltage, 2 G62, 3 lambda (10 bits, 2 bytes), 4 $801D [?],
; 5 cut-off signal (J142), 6 $801F (temporary cell for N17), 7 G42.
; Reply $FB, 2 bytes. Above 7 gives "not understood".
;------------------------------------------------------------------------------
KW_READING:                             ; called from: KW_READING
  DC65  CE 80 19   LDX   #$8019         ; ADC cells
  DC68  F6 81 86   LDAB  $8186          ; channel number
  DC6B  3A         ABX                  ; X -> cell
  DC6C  E6 00      LDAB  $00,X          ; value
  DC6E  B6 81 86   LDAA  $8186          ; channel number
  DC71  81 07      CMPA  #$07           ; not above 7?
  DC73  23 03      BLS   loc_DC78       ; yes
  DC75  7E DB A9   JMP   KW_NAK         ; "not understood"

loc_DC78:
  DC78  81 03      CMPA  #$03           ; lambda (3)?
  DC7A  27 03      BEQ   loc_DC7F       ; yes
  DC7C  4F         CLRA                 ; high byte = 0
  DC7D  20 08      BRA   loc_DC87       ; continue

loc_DC7F:
  DC7F  FC 80 B3   LDD   $80B3          ; 10 bits of lambda
  DC82  05         ASLD                 ; align
  DC83  16         TAB                  ; low byte
  DC84  49         ROLA                 ; high byte
  DC85  84 01      ANDA  #$01           ; two bits

loc_DC87:
  DC87  FD 81 06   STD   $8106          ; into data
  DC8A  86 FB      LDAA  #$FB           ; header $FB
  DC8C  C6 05      LDAB  #$05           ; length 5
  DC8E  20 D3      BRA   loc_DC63       ; store

;------------------------------------------------------------------------------
; Command $09 (acknowledgement): next identification block, or next memory
; chunk, or own acknowledgement.
;------------------------------------------------------------------------------
KW_ACK:                                 ; called from: KW_ACK
  DC90  F6 81 01   LDAB  $8101          ; identification blocks remaining?
  DC93  27 09      BEQ   loc_DC9E       ; no
  DC95  5A         DECB                 ; - 1
  DC96  F7 81 01   STAB  $8101          ; store
  DC99  27 03      BEQ   loc_DC9E       ; finished
  DC9B  7E DB 04   JMP   loc_DB04       ; next identification block

loc_DC9E:
  DC9E  7D 82 0D   TST   $820D          ; memory chunks remaining?
  DCA1  27 03      BEQ   loc_DCA6       ; no
  DCA3  7E DB 73   JMP   loc_DB73       ; next chunk

loc_DCA6:
  DCA6  86 09      LDAA  #$09           ; header $09: acknowledgement
  DCA8  C6 03      LDAB  #$03           ; length 3
  DCAA  20 B7      BRA   loc_DC63       ; store

;------------------------------------------------------------------------------
; Command $11: set $8077.5 [?] (cleared by any tester block except $09).
;------------------------------------------------------------------------------
KW_CMD11:                               ; called from: KW_CMD11
  DCAC  CE 80 00   LDX   #$8000         ; X = $8000
  DCAF  62 20 77   OIM   #$20,$77,X     ; $8077.5
  DCB2  20 F2      BRA   loc_DCA6       ; acknowledgement

;------------------------------------------------------------------------------
; Command $1B (factory): parameter $8186 = 9 clears $80F7.0;
; 0, 1, 2, 4, 8 set $8205 = parameter and $80F7.0 = 1 (used in IRQ1, CC5E) [?].
;------------------------------------------------------------------------------
KW_CMD1B:                               ; called from: KW_CMD1B
  DCB4  CE 80 00   LDX   #$8000         ; X = $8000
  DCB7  B6 81 86   LDAA  $8186          ; parameter
  DCBA  81 09      CMPA  #$09           ; 9?
  DCBC  26 05      BNE   loc_DCC3       ; no
  DCBE  61 FE F7   AIM   #$FE,$F7,X     ; clear the mode
  DCC1  20 1A      BRA   loc_DCDD       ; acknowledgement

loc_DCC3:
  DCC3  81 00      CMPA  #$00           ; 0?
  DCC5  27 10      BEQ   loc_DCD7       ; yes
  DCC7  81 01      CMPA  #$01           ; 1?
  DCC9  27 0C      BEQ   loc_DCD7       ; yes
  DCCB  81 02      CMPA  #$02           ; 2?
  DCCD  27 08      BEQ   loc_DCD7       ; yes
  DCCF  81 04      CMPA  #$04           ; 4?
  DCD1  27 04      BEQ   loc_DCD7       ; yes
  DCD3  81 08      CMPA  #$08           ; 8?
  DCD5  26 06      BNE   loc_DCDD       ; no: acknowledgement only

loc_DCD7:
  DCD7  B7 82 05   STAA  $8205          ; $8205 = parameter
  DCDA  62 01 F7   OIM   #$01,$F7,X     ; enable the mode

loc_DCDD:
  DCDD  20 C7      BRA   loc_DCA6       ; acknowledgement

;------------------------------------------------------------------------------
; Command $06: end of session. $0A: repeat the last block (DCE5, does nothing).
;------------------------------------------------------------------------------
KW_END:                                 ; called from: KW_END
  DCDF  CE 80 00   LDX   #$8000         ; X = $8000
  DCE2  61 F7 F6   AIM   #$F7,$F6,X     ; close the session

sub_DCE5:                               ; called from: DCE5, KW_END
  DCE5  39         RTS                  ; return

;------------------------------------------------------------------------------
; Reset of the communication state (no session or a fault).
;------------------------------------------------------------------------------
loc_DCE6:
  DCE6  CE 80 00   LDX   #$8000         ; X = $8000
  DCE9  61 04 F6   AIM   #$04,$F6,X     ; keep only the L line level
  DCEC  72 10 11   OIM   #$10,TRCSR1    ; enable the SCI receive interrupt
  DCEF  4F         CLRA                 ; A = 0
  DCF0  01         NOP                  ; empty
  DCF1  01         NOP                  ; empty
  DCF2  B7 81 00   STAA  $8100          ; block counter = 0
  DCF5  A7 FE      STAA  $FE,X          ; byte number = 0
  DCF7  B7 81 01   STAA  $8101          ; identification blocks = 0
  DCFA  B7 82 0D   STAA  $820D          ; memory chunks = 0
  DCFD  4A         DECA                 ; $FF
  DCFE  A7 FD      STAA  $FD,X          ; timeout not running
  DD00  61 10 F7   AIM   #$10,$F7,X     ; in $80F7 keep only bit 4

loc_DD03:
  DD03  7E D1 D1   JMP   loc_D1D1       ; end of task 0 - to the dispatcher

;------------------------------------------------------------------------------
; N7_TO_TICKS: $805D = D × 214 / 256, where D = A:B is the N7 duty cycle in percent
; (A whole part, B fraction). 100 % = 21400 ticks = the whole period at 71.8 Hz.
; X points to a temporary cell.
;------------------------------------------------------------------------------
N7_TO_TICKS:                            ; called from: TASK2
  DD06  36         PSHA                 ; whole percent
  DD07  86 D6      LDAA  #$D6           ; 214
  DD09  3D         MUL                  ; fraction × 214
  DD0A  A7 00      STAA  $00,X          ; high byte into the temporary cell
  DD0C  86 D6      LDAA  #$D6           ; 214
  DD0E  33         PULB                 ; B = whole part
  DD0F  3D         MUL                  ; whole part × 214
  DD10  EB 00      ADDB  $00,X          ; + fraction
  DD12  89 00      ADCA  #$00           ; carry
  DD14  FD 80 5D   STD   $805D          ; $805D = N7 time in ticks
  DD17  39         RTS                  ; return

;------------------------------------------------------------------------------
; TASK 1: every 2 ticks (≈20 ms).
; Mode bits $8050:
;  5 warm: G62 below C6DE = 39 (≈70 °C [assumed]; per SSP knock control works from 70 °C),
;      cleared from 42;
;  6 load: pressure above C6DF = 90 (≈0.7 bar abs. [assumed]), cleared below 87;
;  4 voltage OK: set at 95…149, cleared below 90 or from 155;
;  7 knock control enabled: warm and load, not cranking,
;      throttle not closed, no blink code output in progress.
;------------------------------------------------------------------------------
TASK1:                                  ; called from: TASK1
  DD18  B6 C6 DE   LDAA  $C6DE          ; warm-up threshold C6DE = 39
  DD1B  F6 80 1B   LDAB  $801B          ; coolant temperature
  DD1E  11         CBA                  ; warmer than the threshold?
  DD1F  23 0A      BLS   loc_DD2B       ; no
  DD21  36         PSHA                 ; save
  DD22  86 20      LDAA  #$20           ; bit 5: warm
  DD24  BA 80 50   ORAA  $8050          ; set
  DD27  B7 80 50   STAA  $8050          ; store
  DD2A  32         PULA                 ; restore

loc_DD2B:
  DD2B  8B 03      ADDA  #$03           ; hysteresis 3
  DD2D  11         CBA                  ; colder than 42?
  DD2E  22 08      BHI   loc_DD38       ; no: leave it
  DD30  86 DF      LDAA  #$DF           ; yes: clear bit 5
  DD32  B4 80 50   ANDA  $8050          ; clear
  DD35  B7 80 50   STAA  $8050          ; store

loc_DD38:
  DD38  F6 80 19   LDAB  $8019          ; pressure
  DD3B  BD D1 FE   JSR   MAP_BAD_LOAD   ; G71 faulty under load?
  DD3E  24 03      BCC   loc_DD43       ; no
  DD40  F6 C7 9E   LDAB  $C79E          ; substitute value 192

loc_DD43:
  DD43  B6 C6 DF   LDAA  $C6DF          ; load threshold C6DF = 90
  DD46  11         CBA                  ; pressure above?
  DD47  24 0A      BCC   loc_DD53       ; no
  DD49  36         PSHA                 ; save
  DD4A  86 40      LDAA  #$40           ; bit 6: load
  DD4C  BA 80 50   ORAA  $8050          ; set
  DD4F  B7 80 50   STAA  $8050          ; store
  DD52  32         PULA                 ; restore

loc_DD53:
  DD53  80 03      SUBA  #$03           ; hysteresis 3
  DD55  11         CBA                  ; pressure above 87?
  DD56  25 08      BCS   loc_DD60       ; yes: leave it
  DD58  86 BF      LDAA  #$BF           ; clear bit 6
  DD5A  B4 80 50   ANDA  $8050          ; clear
  DD5D  B7 80 50   STAA  $8050          ; store

loc_DD60:
  DD60  F6 80 1A   LDAB  $801A          ; voltage
  DD63  C1 5A      CMPB  #$5A           ; below 90?
  DD65  25 0C      BCS   loc_DD73       ; yes: clear
  DD67  C1 5F      CMPB  #$5F           ; below 95?
  DD69  25 1A      BCS   loc_DD85       ; yes: no change
  DD6B  C1 96      CMPB  #$96           ; below 150?
  DD6D  25 0E      BCS   loc_DD7D       ; yes: set
  DD6F  C1 9B      CMPB  #$9B           ; below 155?
  DD71  25 12      BCS   loc_DD85       ; yes: no change

loc_DD73:
  DD73  86 EF      LDAA  #$EF           ; clear bit 4: voltage out of range
  DD75  B4 80 50   ANDA  $8050          ; clear
  DD78  B7 80 50   STAA  $8050          ; store
  DD7B  20 08      BRA   loc_DD85       ; continue

loc_DD7D:
  DD7D  86 10      LDAA  #$10           ; bit 4: voltage OK
  DD7F  BA 80 50   ORAA  $8050          ; set
  DD82  B7 80 50   STAA  $8050          ; store

loc_DD85:
  DD85  86 80      LDAA  #$80           ; blink code list finished?
  DD87  B5 80 9F   BITA  $809F          ; check
  DD8A  26 07      BNE   loc_DD93       ; yes: decide by mode
  DD8C  86 80      LDAA  #$80           ; blink code output in progress?
  DD8E  B5 80 A0   BITA  $80A0          ; check
  DD91  26 18      BNE   loc_DDAB       ; yes: no knock control

loc_DD93:
  DD93  F6 80 29   LDAB  $8029          ; mode flags
  DD96  2B 13      BMI   loc_DDAB       ; cranking: no control
  DD98  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  DD9B  25 0E      BCS   loc_DDAB       ; yes: no control
  DD9D  F6 80 50   LDAB  $8050          ; mode
  DDA0  17         TBA                  ; copy
  DDA1  C8 60      EORB  #$60           ; invert bits 6, 5
  DDA3  C5 60      BITB  #$60           ; warm and load?
  DDA5  26 04      BNE   loc_DDAB       ; no: no control
  DDA7  8A 80      ORAA  #$80           ; bit 7: knock control enabled
  DDA9  20 02      BRA   loc_DDAD       ; continue

loc_DDAB:
  DDAB  84 7F      ANDA  #$7F           ; clear bit 7

loc_DDAD:
  DDAD  B7 80 50   STAA  $8050          ; store $8050

;------------------------------------------------------------------------------
; Knock parameters by engine speed (no interpolation, nearest lower point
; of axis C850 = 10 14 20 30 50 70 90 110 130 150 170 190 210 230 250 255):
; $80B7/$80B8: measurement window (C860, C870) [assumed]; $80BA: lower measurement limit
; (C880); $80BB: "sensor silent" threshold (C890 = 5); $80BD: scale (C8A0).
;------------------------------------------------------------------------------
  DDB0  B6 80 18   LDAA  $8018          ; engine speed
  DDB3  CE C8 50   LDX   #$C850         ; axis C850
  DDB6  C6 10      LDAB  #$10           ; 16 points
  DDB8  BD CA 5F   JSR   AXIS_UP        ; find the point
  DDBB  A6 10      LDAA  $10,X          ; C860
  DDBD  E6 20      LDAB  $20,X          ; C870
  DDBF  FD 80 B7   STD   $80B7          ; $80B7/$80B8
  DDC2  A6 30      LDAA  $30,X          ; C880
  DDC4  B7 80 BA   STAA  $80BA          ; $80BA: lower limit
  DDC7  A6 40      LDAA  $40,X          ; C890
  DDC9  B7 80 BB   STAA  $80BB          ; $80BB: "silent" threshold
  DDCC  A6 50      LDAA  $50,X          ; C8A0
  DDCE  B7 80 BD   STAA  $80BD          ; $80BD: scale
  DDD1  CE C2 10   LDX   #$C210         ; engine speed axis C210
  DDD4  B6 80 18   LDAA  $8018          ; engine speed
  DDD7  C6 10      LDAB  #$10           ; 16 points
  DDD9  BD CA 5F   JSR   AXIS_UP        ; find the interval
  DDDC  F7 80 0C   STAB  $800C          ; $800C = number
  DDDF  BD CA 05   JSR   FRAC_UP        ; fraction
  DDE2  F7 80 0D   STAB  $800D          ; $800D = fraction
  DDE5  F6 80 0C   LDAB  $800C          ; number
  DDE8  CE C2 30   LDX   #$C230         ; table C230 (11 … 80)
  DDEB  3A         ABX                  ; X -> value
  DDEC  F6 80 0D   LDAB  $800D          ; fraction
  DDEF  BD CA 41   JSR   INTERP         ; interpolation
  DDF2  B7 80 4F   STAA  $804F          ; $804F [?]
  DDF5  F6 80 0C   LDAB  $800C          ; number
  DDF8  CE C2 40   LDX   #$C240         ; table C240 (16 … 100)
  DDFB  3A         ABX                  ; X -> value
  DDFC  F6 80 0D   LDAB  $800D          ; fraction
  DDFF  BD CA 41   JSR   INTERP         ; interpolation
  DE02  B7 80 4E   STAA  $804E          ; $804E [?]

;------------------------------------------------------------------------------
; Knock sensor check. Cylinders 1-2 use G61, 3-5 use G66 (table C914,
; C910-C913: 0 = G61, FF = G66; matches the wiring diagram). If all cylinders of a
; group have the "sensor silent" flag, count; 150 calls in a row (3 s) set a fault:
; G61 sets $80B6 bits 7 and 6 (2142), G66 sets bits 5 and 4 (2144). Bits 3/2: the group
; has been checked.
;------------------------------------------------------------------------------
  DE05  CE C9 0F   LDX   #$C90F         ; group table
  DE08  FF 80 0E   STX   $800E          ; pointer
  DE0B  CE 80 C0   LDX   #$80C0         ; entry of the first cylinder
  DE0E  FF 80 0C   STX   $800C          ; pointer
  DE11  CE C9 14   LDX   #$C914         ; group of cylinder 1 (C914)
  DE14  86 01      LDAA  #$01           ; G61 flag = 1
  DE16  16         TAB                  ; G66 flag = 1

loc_DE17:
  DE17  6D 00      TST   $00,X          ; group G66?
  DE19  26 0A      BNE   loc_DE25       ; yes
  DE1B  FE 80 0C   LDX   $800C          ; cylinder entry
  DE1E  A4 00      ANDA  $00,X          ; AND "silent" into group G61
  DE20  36         PSHA                 ; save
  DE21  86 08      LDAA  #$08           ; group G61 was checked
  DE23  20 08      BRA   loc_DE2D       ; continue

loc_DE25:
  DE25  FE 80 0C   LDX   $800C          ; cylinder record
  DE28  E4 00      ANDB  $00,X          ; AND "silent" into group G66
  DE2A  36         PSHA                 ; save
  DE2B  86 04      LDAA  #$04           ; group G66 was checked

loc_DE2D:
  DE2D  BA 80 B6   ORAA  $80B6          ; set
  DE30  B7 80 B6   STAA  $80B6          ; store
  DE33  32         PULA                 ; restore
  DE34  37         PSHB                 ; save
  DE35  C6 08      LDAB  #$08           ; next record (+8)
  DE37  3A         ABX                  ; X
  DE38  33         PULB                 ; restore
  DE39  FF 80 0C   STX   $800C          ; store
  DE3C  FE 80 0E   LDX   $800E          ; group pointer
  DE3F  8C C9 13   CPX   #$C913         ; last cylinder?
  DE42  27 06      BEQ   loc_DE4A       ; yes
  DE44  08         INX                  ; next
  DE45  FF 80 0E   STX   $800E          ; store
  DE48  20 CD      BRA   loc_DE17       ; to the next cylinder

loc_DE4A:
  DE4A  36         PSHA                 ; save
  DE4B  B6 80 B6   LDAA  $80B6          ; G61 checked?
  DE4E  85 08      BITA  #$08           ; test
  DE50  26 03      BNE   loc_DE55       ; yes
  DE52  32         PULA                 ; no — G61 flag = 0
  DE53  4F         CLRA                 ; (A = 0)
  DE54  36         PSHA                 ; (save)

loc_DE55:
  DE55  B6 80 B6   LDAA  $80B6          ; G66 checked?
  DE58  85 04      BITA  #$04           ; test
  DE5A  26 01      BNE   loc_DE5D       ; yes
  DE5C  5F         CLRB                 ; no — G66 flag = 0

loc_DE5D:
  DE5D  32         PULA                 ; G61 flag
  DE5E  4D         TSTA                 ; silent?
  DE5F  27 17      BEQ   loc_DE78       ; no
  DE61  B6 80 ED   LDAA  $80ED          ; G61 counter
  DE64  81 96      CMPA  #$96           ; 150 (3 s)?
  DE66  24 06      BCC   loc_DE6E       ; yes — fault
  DE68  4C         INCA                 ; + 1
  DE69  B7 80 ED   STAA  $80ED          ; store
  DE6C  20 08      BRA   loc_DE76       ; continue

loc_DE6E:
  DE6E  86 C0      LDAA  #$C0           ; G61 faulty (2142)
  DE70  BA 80 B6   ORAA  $80B6          ; set
  DE73  B7 80 B6   STAA  $80B6          ; store

loc_DE76:
  DE76  20 0B      BRA   loc_DE83       ; continue

loc_DE78:
  DE78  7F 80 ED   CLR   $80ED          ; counter = 0
  DE7B  86 7F      LDAA  #$7F           ; clear "present now"
  DE7D  B4 80 B6   ANDA  $80B6          ; clear
  DE80  B7 80 B6   STAA  $80B6          ; store

loc_DE83:
  DE83  5D         TSTB                 ; G66 silent?
  DE84  27 17      BEQ   loc_DE9D       ; no
  DE86  B6 80 EE   LDAA  $80EE          ; G66 counter
  DE89  81 96      CMPA  #$96           ; 150?
  DE8B  24 06      BCC   loc_DE93       ; yes — fault
  DE8D  4C         INCA                 ; + 1
  DE8E  B7 80 EE   STAA  $80EE          ; store
  DE91  20 08      BRA   loc_DE9B       ; continue

loc_DE93:
  DE93  86 30      LDAA  #$30           ; G66 faulty (2144)
  DE95  BA 80 B6   ORAA  $80B6          ; set
  DE98  B7 80 B6   STAA  $80B6          ; store

loc_DE9B:
  DE9B  20 0B      BRA   loc_DEA8       ; continue

loc_DE9D:
  DE9D  7F 80 EE   CLR   $80EE          ; counter = 0
  DEA0  86 DF      LDAA  #$DF           ; clear "present now"
  DEA2  B4 80 B6   ANDA  $80B6          ; clear
  DEA5  B7 80 B6   STAA  $80B6          ; store

;------------------------------------------------------------------------------
; IGNITION: mode selection. $8088.2 = throttle closed (copy of F60).
; Cranking — fixed timing C6CB (E081). Throttle open — map (DFC6).
; Idle — timing by altitude and temperature ($800F, table C2D0) + DLS.
;------------------------------------------------------------------------------
loc_DEA8:
  DEA8  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  DEAB  CE 80 00   LDX   #$8000         ; X = $8000
  DEAE  85 20      BITA  #$20           ; F60 closed?
  DEB0  27 05      BEQ   loc_DEB7       ; no
  DEB2  62 04 88   OIM   #$04,$88,X     ; $8088.2 = 1
  DEB5  20 03      BRA   loc_DEBA       ; continue

loc_DEB7:
  DEB7  61 FB 88   AIM   #$FB,$88,X     ; $8088.2 = 0

loc_DEBA:
  DEBA  B6 C6 CB   LDAA  $C6CB          ; cranking timing C6CB
  DEBD  F6 80 29   LDAB  $8029          ; mode flags
  DEC0  2A 03      BPL   loc_DEC5       ; not cranking
  DEC2  7E E0 81   JMP   loc_E081       ; cranking — timing C6CB

loc_DEC5:
  DEC5  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  DEC8  25 03      BCS   loc_DECD       ; yes — idle
  DECA  7E DF C6   JMP   loc_DFC6       ; no — ignition map

;------------------------------------------------------------------------------
; Idle: timing correction $800F by altitude and coolant temperature —
; table C2D0 4×4 (row — altitude 0…3, column — G62 on axis C2CC = 197 189 180 158).
; Values 0…8, larger when cold and at sea level.
; Timing units [assumed]: value v -> $8022 = (v + 40) × 0.75 - 30 half-teeth
; (1 half-tooth = 1.333°), so 1 unit ≈ 1°. Larger v — later spark.
;------------------------------------------------------------------------------
loc_DECD:
  DECD  B6 80 04   LDAA  $8004          ; barometric pressure
  DED0  CE C2 B0   LDX   #$C2B0         ; axis C2B0
  DED3  C6 04      LDAB  #$04           ; 4 points
  DED5  BD CA 6B   JSR   AXIS_DN        ; altitude index
  DED8  86 04      LDAA  #$04           ; × 4
  DEDA  3D         MUL                  ; table row
  DEDB  F7 80 0F   STAB  $800F          ; save
  DEDE  CE C2 CC   LDX   #$C2CC         ; temperature axis C2CC
  DEE1  B6 80 1B   LDAA  $801B          ; G62
  DEE4  C6 04      LDAB  #$04           ; 4 points
  DEE6  BD CA 6B   JSR   AXIS_DN        ; find interval
  DEE9  37         PSHB                 ; index
  DEEA  BD CA 10   JSR   FRAC_DN        ; fraction
  DEED  17         TBA                  ; A = fraction
  DEEE  33         PULB                 ; B = index
  DEEF  FB 80 0F   ADDB  $800F          ; + row
  DEF2  CE C2 D0   LDX   #$C2D0         ; table C2D0
  DEF5  3A         ABX                  ; X -> value
  DEF6  16         TAB                  ; B = fraction
  DEF7  BD CA 41   JSR   INTERP         ; interpolation
  DEFA  B7 80 0F   STAA  $800F          ; $800F = idle correction
  DEFD  B6 80 18   LDAA  $8018          ; engine speed
  DF00  B1 C2 10   CMPA  $C210          ; below 40 units (≈890 rpm)?
  DF03  25 09      BCS   loc_DF0E       ; yes — DLS
  DF05  CE C2 50   LDX   #$C250         ; idle above 890 rpm: axis C250 / timing C260
  DF08  C6 10      LDAB  #$10           ; 16 points
  DF0A  8D 47      BSR   TAB16_RPM      ; timing = 45 48 50 52 55 55 55 52 50 45 40 35 30 24 20 20
  DF0C  20 39      BRA   loc_DF47       ; to conversion (without correction $800F)

;------------------------------------------------------------------------------
; DLS — idle stabilisation via timing below 40 units (≈890 rpm).
; Thresholds AT C6D0 / HS C6D3 = 16 28 30 units (identical):
;  below 16 (≈350 rpm) — cranking timing C6CB = 50;
;  30 and above — C6D8 = 51;
;  in between, if the engine has started ($8029.6) — from table C6D6 = 45 45 51
;  (the lower the speed, the earlier the spark — the engine picks up);
;  otherwise (not started yet) — C6CC = 50 below 28, C6CD = 48 from 28.
; The correction $800F is added to the result.
;------------------------------------------------------------------------------
loc_DF0E:
  DF0E  CE C6 D6   LDX   #$C6D6         ; DLS table C6D6
  DF11  FF 80 0C   STX   $800C          ; pointer
  DF14  CE C6 D0   LDX   #$C6D0         ; AT thresholds
  DF17  7B 04 17   TIM   #$04,PORT6     ; coding: HS?
  DF1A  27 03      BEQ   loc_DF1F       ; no
  DF1C  CE C6 D3   LDX   #$C6D3         ; HS thresholds

loc_DF1F:
  DF1F  A1 00      CMPA  $00,X          ; below 16?
  DF21  24 05      BCC   loc_DF28       ; no
  DF23  B6 C6 CB   LDAA  $C6CB          ; cranking timing 50
  DF26  20 1C      BRA   loc_DF44       ; continue

loc_DF28:
  DF28  A1 02      CMPA  $02,X          ; 30 and above?
  DF2A  25 05      BCS   loc_DF31       ; no
  DF2C  B6 C6 D8   LDAA  $C6D8          ; 51
  DF2F  20 13      BRA   loc_DF44       ; continue

loc_DF31:
  DF31  C6 40      LDAB  #$40           ; engine started?
  DF33  F5 80 29   BITB  $8029          ; test
  DF36  26 12      BNE   loc_DF4A       ; yes — from the table
  DF38  A1 01      CMPA  $01,X          ; below 28?
  DF3A  25 05      BCS   loc_DF41       ; yes
  DF3C  B6 C6 CD   LDAA  $C6CD          ; 48
  DF3F  20 03      BRA   loc_DF44       ; continue

loc_DF41:
  DF41  B6 C6 CC   LDAA  $C6CC          ; 50

loc_DF44:
  DF44  BB 80 0F   ADDA  $800F          ; + idle correction

loc_DF47:
  DF47  7E E0 81   JMP   loc_E081       ; to timing conversion

loc_DF4A:
  DF4A  C6 03      LDAB  #$03           ; 3 points
  DF4C  BD CA 5F   JSR   AXIS_UP        ; find interval
  DF4F  8D 0E      BSR   TAB_INTERP     ; timing from table C6D6
  DF51  20 F1      BRA   loc_DF44       ; continue

;------------------------------------------------------------------------------
; TAB16_RPM — axis X (B points) followed by the table; value by engine speed.
;------------------------------------------------------------------------------
TAB16_RPM:                              ; called from: TASK1
  DF53  FF 80 0C   STX   $800C          ; axis address
  DF56  F7 80 0E   STAB  $800E          ; number of points
  DF59  BD CA 5F   JSR   AXIS_UP        ; find interval for A
  DF5C  FB 80 0E   ADDB  $800E          ; index + axis length = index in the table

;------------------------------------------------------------------------------
; TAB_INTERP — interpolation of table [$800C] by index B and fraction (A = value).
;------------------------------------------------------------------------------
TAB_INTERP:                             ; called from: TASK1
  DF5F  37         PSHB                 ; index
  DF60  BD CA 05   JSR   FRAC_UP        ; fraction
  DF63  17         TBA                  ; A = fraction
  DF64  33         PULB                 ; B = index
  DF65  FE 80 0C   LDX   $800C          ; address
  DF68  3A         ABX                  ; X -> value
  DF69  16         TAB                  ; B = fraction
  DF6A  BD CA 41   JSR   INTERP         ; interpolation
  DF6D  39         RTS                  ; return

;------------------------------------------------------------------------------
; MAP_ROW — map row by pressure (axis X, descending): $800D = index,
; $800F = fraction. On a G71 fault the substitute value 192 is used.
;------------------------------------------------------------------------------
MAP_ROW:                                ; called from: TASK1, TASK2
  DF6E  37         PSHB                 ; number of points
  DF6F  B6 80 19   LDAA  $8019          ; pressure
  DF72  C6 72      LDAB  #$72           ; G71 faults
  DF74  F5 80 91   BITB  $8091          ; test
  DF77  27 03      BEQ   loc_DF7C       ; none
  DF79  B6 C7 9E   LDAA  $C79E          ; substitute value

loc_DF7C:
  DF7C  33         PULB                 ; number of points

ROW_DN:                                 ; called from: TASK1, TASK2
  DF7D  BD CA 6B   JSR   AXIS_DN        ; find interval
  DF80  F7 80 0D   STAB  $800D          ; $800D = row
  DF83  BD CA 10   JSR   FRAC_DN        ; fraction
  DF86  F7 80 0F   STAB  $800F          ; $800F = fraction
  DF89  39         RTS                  ; return

;------------------------------------------------------------------------------
; RPM_COL — column by engine speed (axis X): $800C = index, $800E = fraction.
; Output: B = row × 16 + column.
;------------------------------------------------------------------------------
RPM_COL:                                ; called from: TASK1, TASK2
  DF8A  B6 80 18   LDAA  $8018          ; engine speed
  DF8D  BD CA 5F   JSR   AXIS_UP        ; find interval
  DF90  F7 80 0C   STAB  $800C          ; $800C
  DF93  BD CA 05   JSR   FRAC_UP        ; fraction
  DF96  F7 80 0E   STAB  $800E          ; $800E
  DF99  F6 80 0D   LDAB  $800D          ; row
  DF9C  58         ASLB                 ; × 16
  DF9D  58         ASLB                 ; (× 16)
  DF9E  58         ASLB                 ; (× 16)
  DF9F  58         ASLB                 ; (× 16)
  DFA0  FB 80 0C   ADDB  $800C          ; + column
  DFA3  39         RTS                  ; return

;------------------------------------------------------------------------------
; MAP16 — bilinear interpolation in a 16×16 map (X = map, B = cell).
;------------------------------------------------------------------------------
MAP16:                                  ; called from: TASK1, TASK2
  DFA4  3A         ABX                  ; X -> cell
  DFA5  3C         PSHX                 ; save
  DFA6  F6 80 0E   LDAB  $800E          ; engine speed fraction
  DFA9  BD CA 41   JSR   INTERP         ; within its own row
  DFAC  B7 80 0C   STAA  $800C          ; $800C
  DFAF  C6 10      LDAB  #$10           ; next row (+16)
  DFB1  38         PULX                 ; X
  DFB2  3A         ABX                  ; X -> cell
  DFB3  F6 80 0E   LDAB  $800E          ; engine speed fraction
  DFB6  BD CA 41   JSR   INTERP         ; in the next row
  DFB9  B7 80 0D   STAA  $800D          ; $800D
  DFBC  CE 80 0C   LDX   #$800C         ; two values
  DFBF  F6 80 0F   LDAB  $800F          ; pressure fraction
  DFC2  BD CA 41   JSR   INTERP         ; between rows
  DFC5  39         RTS                  ; return

;------------------------------------------------------------------------------
; MAIN IGNITION MAP 16×16: rows — pressure (axis C200 = 192 … 51),
; columns — engine speed (axis C210). Map C000 (map 1, for Super) — with a warm
; engine ($8050.5); C100 (map 2) — when cold or when flag $807A.7 is set
; (frequent knock, then also $8051.5) [assumed from SSP: map 2 for low octane].
;------------------------------------------------------------------------------
loc_DFC6:
  DFC6  CE C2 00   LDX   #$C200         ; pressure axis C200
  DFC9  C6 10      LDAB  #$10           ; 16 points
  DFCB  8D A1      BSR   MAP_ROW        ; row
  DFCD  CE C2 10   LDX   #$C210         ; speed axis C210
  DFD0  C6 10      LDAB  #$10           ; 16 points
  DFD2  8D B6      BSR   RPM_COL        ; column, B = cell
  DFD4  86 20      LDAA  #$20           ; warm?
  DFD6  B5 80 50   BITA  $8050          ; test
  DFD9  27 10      BEQ   loc_DFEB       ; no — map 2
  DFDB  CE C0 00   LDX   #$C000         ; map 1 (C000)
  DFDE  86 80      LDAA  #$80           ; $807A.7?
  DFE0  B5 80 7A   BITA  $807A          ; test
  DFE3  27 09      BEQ   loc_DFEE       ; no — map 1
  DFE5  CE 80 00   LDX   #$8000         ; X = $8000
  DFE8  62 20 51   OIM   #$20,$51,X     ; mark $8051.5 and take map 2

loc_DFEB:
  DFEB  CE C1 00   LDX   #$C100         ; map 2 (C100)

loc_DFEE:
  DFEE  8D B4      BSR   MAP16          ; timing from the map
  DFF0  B7 80 0C   STAA  $800C          ; $800C = timing

;------------------------------------------------------------------------------
; Timing correction by engine running time (table C2C4 = 10 8 8 0 on axis C2C0 =
; 24 28 35 47 in units of 5.12 s, i.e. ≈ 123…241 s). The decision is made once, when
; $8060.0 appears [?]: if that happened 10-20 s or 41-56 s after start —
; the correction is active ($807A.2), otherwise — never ($807A.1). Only at engine speed
; below 120 units and pressure below 128. Purpose — [?].
;------------------------------------------------------------------------------
  DFF3  CE 80 00   LDX   #$8000         ; X = $8000
  DFF6  6B 01 60   TIM   #$01,$60,X     ; $8060.0?
  DFF9  27 57      BEQ   loc_E052       ; no — without correction
  DFFB  E6 7A      LDAB  $7A,X          ; flags $807A
  DFFD  C5 02      BITB  #$02           ; decided "never"?
  DFFF  26 51      BNE   loc_E052       ; yes
  E001  C5 04      BITB  #$04           ; decided "active"?
  E003  26 1D      BNE   loc_E022       ; yes
  E005  B6 80 8C   LDAA  $808C          ; running time, high byte (in 5.12 s steps)
  E008  27 48      BEQ   loc_E052       ; zero — too early
  E00A  81 02      CMPA  #$02           ; less than 2?
  E00C  25 0C      BCS   loc_E01A       ; yes — never
  E00E  81 04      CMPA  #$04           ; less than 4?
  E010  25 0D      BCS   loc_E01F       ; yes — active
  E012  81 08      CMPA  #$08           ; less than 8?
  E014  25 04      BCS   loc_E01A       ; yes — never
  E016  81 0B      CMPA  #$0B           ; less than 11?
  E018  25 05      BCS   loc_E01F       ; yes — active

loc_E01A:
  E01A  62 02 7A   OIM   #$02,$7A,X     ; never ($807A.1)
  E01D  20 33      BRA   loc_E052       ; continue

loc_E01F:
  E01F  62 04 7A   OIM   #$04,$7A,X     ; active ($807A.2)

loc_E022:
  E022  E6 18      LDAB  $18,X          ; engine speed
  E024  F1 C5 54   CMPB  $C554          ; not below C554 = 120?
  E027  24 29      BCC   loc_E052       ; yes — without correction
  E029  E6 19      LDAB  $19,X          ; pressure
  E02B  6B 72 91   TIM   #$72,$91,X     ; G71 faults?
  E02E  27 03      BEQ   loc_E033       ; none
  E030  F6 C7 9E   LDAB  $C79E          ; substitute value

loc_E033:
  E033  F1 C5 55   CMPB  $C555          ; not below C555 = 128?
  E036  24 1A      BCC   loc_E052       ; yes — without correction
  E038  A6 8C      LDAA  $8C,X          ; running time
  E03A  C6 04      LDAB  #$04           ; 4 points
  E03C  CE C2 C0   LDX   #$C2C0         ; axis C2C0
  E03F  BD CA 5F   JSR   AXIS_UP        ; find interval
  E042  37         PSHB                 ; index
  E043  BD CA 05   JSR   FRAC_UP        ; fraction
  E046  17         TBA                  ; A = fraction
  E047  33         PULB                 ; B = index
  E048  CE C2 C4   LDX   #$C2C4         ; table C2C4
  E04B  3A         ABX                  ; X -> value
  E04C  16         TAB                  ; B = fraction
  E04D  BD CA 41   JSR   INTERP         ; correction
  E050  20 01      BRA   loc_E053       ; continue

loc_E052:
  E052  4F         CLRA                 ; correction 0

loc_E053:
  E053  BB 80 0C   ADDA  $800C          ; + timing
  E056  C6 04      LDAB  #$04           ; Hall sender fault ($8094.2)?
  E058  F5 80 94   BITB  $8094          ; test
  E05B  27 03      BEQ   loc_E060       ; no
  E05D  BB C5 57   ADDA  $C557          ; + C557 = 4 (later)

loc_E060:
  E060  B7 80 0C   STAA  $800C          ; $800C
  E063  F6 80 19   LDAB  $8019          ; pressure
  E066  C1 66      CMPB  #$66           ; below 102 (≈0.8 bar abs.)?
  E068  25 17      BCS   loc_E081       ; yes — without air correction
  E06A  CE C6 9C   LDX   #$C69C         ; G42 axis C69C = 204 156 128 109
  E06D  B6 80 20   LDAA  $8020          ; intake air temperature
  E070  C6 04      LDAB  #$04           ; 4 points
  E072  BD CA 6B   JSR   AXIS_DN        ; point (without interpolation)
  E075  CE C6 A0   LDX   #$C6A0         ; table C6A0 = 60 60 61 62
  E078  3A         ABX                  ; X -> value
  E079  A6 00      LDAA  $00,X          ; value
  E07B  80 3C      SUBA  #$3C           ; - 60: correction 0…+2 (warmer — later)
  E07D  F6 80 0C   LDAB  $800C          ; timing
  E080  1B         ABA                  ; + correction

;------------------------------------------------------------------------------
; Conversion of timing to half-teeth: $8022 = (timing + 40) × 192 / 256 - 30.
; $800C = how much earlier the timing became compared to the previous one (for smoothing).
; During cranking a copy goes to $8023, at idle — to $808F.
;------------------------------------------------------------------------------
loc_E081:
  E081  8B 28      ADDA  #$28           ; + 40
  E083  C6 C0      LDAB  #$C0           ; × 0.75
  E085  3D         MUL                  ; (× 0.75)
  E086  58         ASLB                 ; round
  E087  89 00      ADCA  #$00           ; (round)
  E089  80 1E      SUBA  #$1E           ; - 30
  E08B  16         TAB                  ; B = new timing
  E08C  B6 80 22   LDAA  $8022          ; old timing
  E08F  F7 80 22   STAB  $8022          ; $8022 = new timing (half-teeth)
  E092  10         SBA                  ; old - new
  E093  24 01      BCC   loc_E096       ; not below zero
  E095  4F         CLRA                 ; 0

loc_E096:
  E096  B7 80 0C   STAA  $800C          ; $800C = advance step
  E099  B6 80 29   LDAA  $8029          ; cranking?
  E09C  2A 03      BPL   loc_E0A1       ; no
  E09E  F7 80 23   STAB  $8023          ; $8023 = cranking timing

loc_E0A1:
  E0A1  86 04      LDAA  #$04           ; throttle closed ($8088.2)?
  E0A3  B5 80 88   BITA  $8088          ; test
  E0A6  27 07      BEQ   loc_E0AF       ; no
  E0A8  F7 80 8F   STAB  $808F          ; $808F = idle timing
  E0AB  4F         CLRA                 ; step = 0
  E0AC  B7 80 0C   STAA  $800C          ; store

loc_E0AF:
  E0AF  B6 80 89   LDAA  $8089          ; counter $8089
  E0B2  27 01      BEQ   loc_E0B5       ; zero
  E0B4  4A         DECA                 ; - 1

loc_E0B5:
  E0B5  B7 80 89   STAA  $8089          ; store

;------------------------------------------------------------------------------
; Softening the jerk when the throttle opens after idle — manual gearbox (HS) only [assumed].
; Conditions: warm ($8088.4: G62 ≤ 39, cleared above 42), throttle switch F60 OK,
; engine running longer than 30 s ($8029.2). Throttle was closed for ≥ 25 calls (0.5 s) —
; "armed" ($8088.5). On opening: strength k = (closed time - 25) × 5 (up to 255),
; by engine speed (axis C270): $8089 = C280 × k / 256 — addition to N7 (decreases by 1 per
; call), $808A = C290 × k / 256 — timing retard, $808B = C2A0 — timing return step
; (executed by the interrupt, CE03). $8088.7 — mode active.
;------------------------------------------------------------------------------
  E0B8  CE 80 00   LDX   #$8000         ; X = $8000
  E0BB  7B 04 17   TIM   #$04,PORT6     ; coding: HS?
  E0BE  27 5C      BEQ   loc_E11C       ; AT — not needed
  E0C0  F6 80 1B   LDAB  $801B          ; G62
  E0C3  C1 2A      CMPB  #$2A           ; colder than 42?
  E0C5  22 09      BHI   loc_E0D0       ; yes — clear "warm"
  E0C7  C1 27      CMPB  #$27           ; colder than 39?
  E0C9  22 08      BHI   loc_E0D3       ; yes — leave unchanged
  E0CB  62 10 88   OIM   #$10,$88,X     ; $8088.4: warm
  E0CE  20 03      BRA   loc_E0D3       ; continue

loc_E0D0:
  E0D0  61 EF 88   AIM   #$EF,$88,X     ; clear $8088.4

loc_E0D3:
  E0D3  F6 80 93   LDAB  $8093          ; F60 faults
  E0D6  C5 0C      BITB  #$0C           ; present?
  E0D8  26 42      BNE   loc_E11C       ; yes — do not run
  E0DA  6B 10 88   TIM   #$10,$88,X     ; warm?
  E0DD  27 3D      BEQ   loc_E11C       ; no — do not run
  E0DF  F6 80 29   LDAB  $8029          ; engine running longer than 30 s?
  E0E2  C5 04      BITB  #$04           ; test
  E0E4  27 36      BEQ   loc_E11C       ; no — do not run
  E0E6  F6 80 7E   LDAB  $807E          ; throttle closed time
  E0E9  6B 04 88   TIM   #$04,$88,X     ; throttle closed?
  E0EC  27 10      BEQ   loc_E0FE       ; no — it was opened
  E0EE  5C         INCB                 ; + 1
  E0EF  26 01      BNE   loc_E0F2       ; no overflow
  E0F1  5A         DECB                 ; 255

loc_E0F2:
  E0F2  F7 80 7E   STAB  $807E          ; store
  E0F5  C1 19      CMPB  #$19           ; less than 25 (0.5 s)?
  E0F7  25 26      BCS   loc_E11F       ; yes — wait
  E0F9  62 20 88   OIM   #$20,$88,X     ; armed ($8088.5)
  E0FC  20 21      BRA   loc_E11F       ; continue

loc_E0FE:
  E0FE  7F 80 7E   CLR   $807E          ; time = 0
  E101  6B 20 88   TIM   #$20,$88,X     ; was it armed?
  E104  27 54      BEQ   loc_E15A       ; no
  E106  86 80      LDAA  #$80           ; blink code output active?
  E108  B5 80 A0   BITA  $80A0          ; test
  E10B  26 4D      BNE   loc_E15A       ; yes — do not run
  E10D  C0 19      SUBB  #$19           ; time - 25
  E10F  86 05      LDAA  #$05           ; × 5
  E111  3D         MUL                  ; (× 5)
  E112  4D         TSTA                 ; above 255?
  E113  27 02      BEQ   loc_E117       ; no
  E115  C6 FF      LDAB  #$FF           ; 255

loc_E117:
  E117  F7 80 0D   STAB  $800D          ; $800D = strength k
  E11A  20 08      BRA   loc_E124       ; calculate

loc_E11C:
  E11C  61 DF 88   AIM   #$DF,$88,X     ; clear "armed"

loc_E11F:
  E11F  61 7F 88   AIM   #$7F,$88,X     ; clear "mode active"
  E122  20 52      BRA   loc_E176       ; continue

loc_E124:
  E124  B6 80 18   LDAA  $8018          ; engine speed
  E127  C6 10      LDAB  #$10           ; 16 points
  E129  CE C2 70   LDX   #$C270         ; axis C270
  E12C  BD CA 5F   JSR   AXIS_UP        ; find point
  E12F  CE C2 80   LDX   #$C280         ; table C280 (N7 addition)
  E132  3A         ABX                  ; X -> value
  E133  A6 00      LDAA  $00,X          ; value
  E135  F6 80 0D   LDAB  $800D          ; × k
  E138  3D         MUL                  ; (× k)
  E139  58         ASLB                 ; round
  E13A  89 00      ADCA  #$00           ; (round)
  E13C  B7 80 89   STAA  $8089          ; $8089 = addition to N7
  E13F  A6 10      LDAA  $10,X          ; C290 (timing retard)
  E141  F6 80 0D   LDAB  $800D          ; × k
  E144  3D         MUL                  ; (× k)
  E145  58         ASLB                 ; round
  E146  89 00      ADCA  #$00           ; (round)
  E148  B7 80 8A   STAA  $808A          ; $808A = retard
  E14B  E6 20      LDAB  $20,X          ; C2A0 (return step)
  E14D  F7 80 8B   STAB  $808B          ; $808B
  E150  CE 80 00   LDX   #$8000         ; X = $8000
  E153  61 DF 88   AIM   #$DF,$88,X     ; clear "armed"
  E156  0F         SEI                  ; disable interrupts
  E157  62 88 88   OIM   #$88,$88,X     ; mode active ($8088.7, .3)

loc_E15A:
  E15A  6B 80 88   TIM   #$80,$88,X     ; mode active?
  E15D  0E         CLI                  ; enable interrupts
  E15E  27 16      BEQ   loc_E176       ; no
  E160  F6 80 22   LDAB  $8022          ; timing
  E163  FB 80 0C   ADDB  $800C          ; + step
  E166  F1 80 8F   CMPB  $808F          ; not earlier than idle timing?
  E169  24 03      BCC   loc_E16E       ; yes
  E16B  F6 80 8F   LDAB  $808F          ; idle timing

loc_E16E:
  E16E  FB 80 8A   ADDB  $808A          ; + retard
  E171  CB 00      ADDB  #$00           ; (+0)
  E173  F7 80 8E   STAB  $808E          ; $808E = initial retarded timing

loc_E176:
  E176  7E F8 00   JMP   loc_F800       ; patch: retard on sudden throttle opening

;------------------------------------------------------------------------------
; $8021 = speed × 256 / 255 (≈ speed) — for spark delay correction [?].
; COIL DWELL. Below 16 speed units (or below 12 until speed first
; reaches 16, $8092.0) — constant $8024 = 88. Otherwise dwell time T from battery
; voltage: axis C918 = 80 90 100 110 120 140 160 200 (≈8…20 V [assumed]) ->
; C920 = 90 70 55 46 40 32 27 19. Dwell angle = T × speed / 69 half-teeth;
; $8024 = 108 - angle (dwell start point from the cylinder mark), at least 27.
; 108 half-teeth = 144° = spacing between cylinders. Given the speed scaling,
; T ≈ 7 × time in ms [assumed]: at 14 V (T = 32) ≈ 4.6 ms.
;------------------------------------------------------------------------------
loc_E179:
  E179  C6 FF      LDAB  #$FF           ; 255
  E17B  BD CA 1B   JSR   DIV8           ; A × 256 / 255
  E17E  86 01      LDAA  #$01           ; × 1
  E180  3D         MUL                  ; round
  E181  58         ASLB                 ; (round)
  E182  89 00      ADCA  #$00           ; (round)
  E184  B7 80 21   STAA  $8021          ; $8021
  E187  F6 80 92   LDAB  $8092          ; temperature flags
  E18A  B6 80 18   LDAA  $8018          ; engine speed
  E18D  81 10      CMPA  #$10           ; 16 or above?
  E18F  24 13      BCC   loc_E1A4       ; yes — from voltage
  E191  81 0C      CMPA  #$0C           ; below 12?
  E193  25 04      BCS   loc_E199       ; yes — constant
  E195  C5 01      BITB  #$01           ; already reached 16 before?
  E197  26 0B      BNE   loc_E1A4       ; yes — from voltage

loc_E199:
  E199  0F         SEI                  ; disable interrupts
  E19A  C4 FE      ANDB  #$FE           ; clear "reached"
  E19C  F7 80 92   STAB  $8092          ; write
  E19F  0E         CLI                  ; enable interrupts
  E1A0  86 58      LDAA  #$58           ; constant 88
  E1A2  20 4F      BRA   loc_E1F3       ; write

loc_E1A4:
  E1A4  0F         SEI                  ; disable interrupts
  E1A5  CA 01      ORAB  #$01           ; "reached 16" ($8092.0)
  E1A7  F7 80 92   STAB  $8092          ; write
  E1AA  0E         CLI                  ; enable interrupts
  E1AB  CE C9 18   LDX   #$C918         ; voltage axis C918
  E1AE  B6 80 1A   LDAA  $801A          ; voltage
  E1B1  C6 08      LDAB  #$08           ; 8 points
  E1B3  BD DF 53   JSR   TAB16_RPM      ; T from table C920
  E1B6  C6 45      LDAB  #$45           ; divisor 69
  E1B8  7F 80 0D   CLR   $800D          ; integer part = 0

loc_E1BB:
  E1BB  10         SBA                  ; - 69
  E1BC  25 05      BCS   loc_E1C3       ; below zero — done
  E1BE  7C 80 0D   INC   $800D          ; integer + 1
  E1C1  20 F8      BRA   loc_E1BB       ; repeat

loc_E1C3:
  E1C3  1B         ABA                  ; remainder
  E1C4  BD CA 1B   JSR   DIV8           ; remainder × 256 / 69
  E1C7  B7 80 0E   STAA  $800E          ; $800E = fractional part of T / 69
  E1CA  B6 80 18   LDAA  $8018          ; engine speed
  E1CD  B7 80 0C   STAA  $800C          ; temporary
  E1D0  3D         MUL                  ; fraction × speed
  E1D1  58         ASLB                 ; round
  E1D2  89 00      ADCA  #$00           ; (round)
  E1D4  B7 80 0F   STAA  $800F          ; $800F
  E1D7  B6 80 0D   LDAA  $800D          ; integer part
  E1DA  F6 80 0C   LDAB  $800C          ; engine speed
  E1DD  3D         MUL                  ; integer × speed
  E1DE  FB 80 0F   ADDB  $800F          ; + fraction
  E1E1  B9 80 0E   ADCA  $800E          ; + carry
  E1E4  25 0B      BCS   loc_E1F1       ; overflow — minimum
  E1E6  26 09      BNE   loc_E1F1       ; above 255 — minimum
  E1E8  86 6C      LDAA  #$6C           ; 108
  E1EA  10         SBA                  ; - dwell angle
  E1EB  25 04      BCS   loc_E1F1       ; below zero — minimum
  E1ED  81 1B      CMPA  #$1B           ; at least 27?
  E1EF  24 02      BCC   loc_E1F3       ; yes

loc_E1F1:
  E1F1  86 1B      LDAA  #$1B           ; minimum 27

loc_E1F3:
  E1F3  B7 80 24   STAA  $8024          ; $8024 = dwell start

;------------------------------------------------------------------------------
; Return from map 2 to map 1. If map 2 is active ($807A.7) and there are no knock
; control faults ($8051 bits 1, 0): counter $8086 (calls every 20 ms).
; When its high byte (step 5.12 s) reaches the speed-dependent threshold (axis C6E0 =
; 40 80 120 160 -> C6E4 = 12 20 27 35, i.e. ≈ 61…179 s) and the knock retard
; in all cylinders ($802F-$8033) is zero — return to map 1.
;------------------------------------------------------------------------------
  E1F6  CE 80 00   LDX   #$8000         ; X = $8000
  E1F9  A6 7A      LDAA  $7A,X          ; $807A
  E1FB  85 80      BITA  #$80           ; map 2 active?
  E1FD  27 39      BEQ   loc_E238       ; no — counter to zero
  E1FF  6B 03 51   TIM   #$03,$51,X     ; knock control faults?
  E202  26 34      BNE   loc_E238       ; yes — counter to zero
  E204  EE 86      LDX   $86,X          ; counter
  E206  08         INX                  ; + 1
  E207  27 03      BEQ   loc_E20C       ; overflow — do not store
  E209  FF 80 86   STX   $8086          ; write

loc_E20C:
  E20C  CE C6 E0   LDX   #$C6E0         ; speed axis C6E0
  E20F  B6 80 18   LDAA  $8018          ; engine speed
  E212  C6 04      LDAB  #$04           ; 4 points
  E214  BD CA 5F   JSR   AXIS_UP        ; find point
  E217  CE C6 E4   LDX   #$C6E4         ; threshold C6E4
  E21A  3A         ABX                  ; X -> threshold
  E21B  A6 00      LDAA  $00,X          ; threshold
  E21D  B1 80 86   CMPA  $8086          ; has the counter high byte reached the threshold?
  E220  22 1C      BHI   loc_E23E       ; no — wait
  E222  CE 80 00   LDX   #$8000         ; X = $8000
  E225  EC 2F      LDD   $2F,X          ; retard of cylinders 1 and 2
  E227  E3 31      ADDD  $31,X          ; + 3 and 4
  E229  AB 33      ADDA  $33,X          ; + 5
  E22B  1B         ABA                  ; + sum
  E22C  81 01      CMPA  #$01           ; any retard anywhere?
  E22E  24 0E      BCC   loc_E23E       ; yes — wait
  E230  0F         SEI                  ; disable interrupts
  E231  61 CF 51   AIM   #$CF,$51,X     ; clear $8051 bits 5, 4
  E234  61 7F 7A   AIM   #$7F,$7A,X     ; return to map 1
  E237  0E         CLI                  ; enable interrupts

loc_E238:
  E238  CE 00 00   LDX   #$0000         ; counter = 0
  E23B  FF 80 86   STX   $8086          ; write

;------------------------------------------------------------------------------
; Switch to map 2 and faults 2141/2143 on prolonged knock [assumed from context].
; While $8051.7 is set (knock at the retard limit [assumed], set by the interrupt), counter
; $807C increases once every 2 calls (40 ms):
;  above C7AF = 137 (≈5.5 s) — map 2 ($807A.7);
;  then above C781 = 125 (≈5 s) — $807A bits 6, 5;
;  then above C782 = 125 — faults: cylinders on G61 ($8053 bits 7, 6) — $8051 bits
;  3, 1 (2141), cylinders on G66 ($8053 bits 5-3) — bits 2, 0 (2143); $807A.4 — lamp.
; Without $8051.7, bits 6-3 of $807A are cleared.
;------------------------------------------------------------------------------
loc_E23E:
  E23E  CE 80 00   LDX   #$8000         ; X = $8000
  E241  A6 7A      LDAA  $7A,X          ; $807A
  E243  6B 80 51   TIM   #$80,$51,X     ; knock at limit ($8051.7)?
  E246  26 04      BNE   loc_E24C       ; yes
  E248  84 87      ANDA  #$87           ; no — clear bits 6-3
  E24A  20 43      BRA   loc_E28F       ; reset counter

loc_E24C:
  E24C  88 08      EORA  #$08           ; toggle bit 3 (divide by 2)
  E24E  A7 7A      STAA  $7A,X          ; write
  E250  E6 7C      LDAB  $7C,X          ; counter
  E252  85 08      BITA  #$08           ; bit 3 = 1?
  E254  26 06      BNE   loc_E25C       ; yes — do not count
  E256  5C         INCB                 ; + 1
  E257  26 01      BNE   loc_E25A       ; no overflow
  E259  5A         DECB                 ; 255

loc_E25A:
  E25A  E7 7C      STAB  $7C,X          ; write

loc_E25C:
  E25C  85 80      BITA  #$80           ; map 2 already active?
  E25E  27 28      BEQ   loc_E288       ; no
  E260  85 40      BITA  #$40           ; bits 6, 5 already set?
  E262  27 1B      BEQ   loc_E27F       ; no
  E264  F1 C7 82   CMPB  $C782          ; above 125?
  E267  23 2A      BLS   loc_E293       ; no — wait
  E269  6B C0 53   TIM   #$C0,$53,X     ; cylinders on G61 ($8053 bits 7, 6)?
  E26C  27 05      BEQ   loc_E273       ; no
  E26E  62 0A 51   OIM   #$0A,$51,X     ; fault 2141
  E271  8A 10      ORAA  #$10           ; lamp ($807A.4)

loc_E273:
  E273  6B 38 53   TIM   #$38,$53,X     ; cylinders on G66 ($8053 bits 5-3)?
  E276  27 19      BEQ   loc_E291       ; no
  E278  62 05 51   OIM   #$05,$51,X     ; fault 2143
  E27B  8A 10      ORAA  #$10           ; lamp
  E27D  20 12      BRA   loc_E291       ; write

loc_E27F:
  E27F  F1 C7 81   CMPB  $C781          ; above 125?
  E282  23 0F      BLS   loc_E293       ; no — wait
  E284  8A 60      ORAA  #$60           ; bits 6, 5
  E286  20 07      BRA   loc_E28F       ; reset counter

loc_E288:
  E288  F1 C7 AF   CMPB  $C7AF          ; above 137?
  E28B  23 06      BLS   loc_E293       ; no — wait
  E28D  8A 80      ORAA  #$80           ; map 2

loc_E28F:
  E28F  6F 7C      CLR   $7C,X          ; counter = 0

loc_E291:
  E291  A7 7A      STAA  $7A,X          ; write $807A

;------------------------------------------------------------------------------
; Knock retard "floor" ($8043+N), task 1. $804D counts 0…50 (≈1 s).
; $803E+N — time (20 ms calls) while the cylinder's retard is 2 or more above the "floor"
; (reset by the interrupt, CFFE). Reaching 254 (≈5 s) — "floor" + 2 (up to 2 on map 1,
; up to 4 on map 2). Otherwise once every ≈10 s "floor" - 2. This way the ECU remembers a cylinder
; that knocks constantly.
;------------------------------------------------------------------------------
loc_E293:
  E293  B6 80 4D   LDAA  $804D          ; second counter
  E296  4C         INCA                 ; + 1
  E297  81 33      CMPA  #$33           ; 51?
  E299  25 01      BCS   loc_E29C       ; no
  E29B  4F         CLRA                 ; 0

loc_E29C:
  E29C  B7 80 4D   STAA  $804D          ; store
  E29F  CE 80 3E   LDX   #$803E         ; cylinder 0

loc_E2A2:
  E2A2  6C 00      INC   $00,X          ; time above "floor" + 1
  E2A4  26 02      BNE   loc_E2A8       ; no overflow
  E2A6  6A 00      DEC   $00,X          ; stay at 255

loc_E2A8:
  E2A8  A6 00      LDAA  $00,X          ; time
  E2AA  6D 05      TST   $05,X          ; "floor" zero?
  E2AC  26 02      BNE   loc_E2B0       ; no
  E2AE  6F 0A      CLR   $0A,X          ; yes — "floor" decay timer = 0

loc_E2B0:
  E2B0  B1 C7 80   CMPA  $C780          ; less than C780 = 254?
  E2B3  25 1C      BCS   loc_E2D1       ; yes — "floor" decay
  E2B5  A6 05      LDAA  $05,X          ; "floor"
  E2B7  C6 80      LDAB  #$80           ; map 2?
  E2B9  F5 80 7A   BITB  $807A          ; check
  E2BC  27 0D      BEQ   loc_E2CB       ; no
  E2BE  81 04      CMPA  #$04           ; not less than 4?
  E2C0  24 2C      BCC   loc_E2EE       ; yes — do not grow

loc_E2C2:
  E2C2  8B 02      ADDA  #$02           ; + 2
  E2C4  5F         CLRB                 ; 0
  E2C5  E7 0A      STAB  $0A,X          ; decay timer = 0
  E2C7  E7 00      STAB  $00,X          ; time = 0
  E2C9  20 21      BRA   loc_E2EC       ; store "floor"

loc_E2CB:
  E2CB  81 02      CMPA  #$02           ; less than 2?
  E2CD  25 F3      BCS   loc_E2C2       ; yes — + 2
  E2CF  20 1D      BRA   loc_E2EE       ; do not grow

loc_E2D1:
  E2D1  B6 80 4D   LDAA  $804D          ; second counter
  E2D4  81 32      CMPA  #$32           ; reached 50?
  E2D6  25 02      BCS   loc_E2DA       ; no
  E2D8  6C 0A      INC   $0A,X          ; decay timer + 1 (once per second)

loc_E2DA:
  E2DA  A6 0A      LDAA  $0A,X          ; timer
  E2DC  81 0A      CMPA  #$0A           ; less than 10?
  E2DE  25 0E      BCS   loc_E2EE       ; yes — wait
  E2E0  4F         CLRA                 ; 0
  E2E1  A7 0A      STAA  $0A,X          ; timer = 0
  E2E3  A6 05      LDAA  $05,X          ; "floor"
  E2E5  27 07      BEQ   loc_E2EE       ; zero — nothing
  E2E7  80 02      SUBA  #$02           ; - 2
  E2E9  24 01      BCC   loc_E2EC       ; not below zero
  E2EB  4F         CLRA                 ; 0

loc_E2EC:
  E2EC  A7 05      STAA  $05,X          ; store "floor"

loc_E2EE:
  E2EE  08         INX                  ; next cylinder
  E2EF  8C 80 43   CPX   #$8043         ; all 5?
  E2F2  25 AE      BCS   loc_E2A2       ; no

;------------------------------------------------------------------------------
; $808C — engine running time (task 1 calls of 20 ms) while rpm ≥ 16 units;
; stops at 65535; below 16 units — zero.
;------------------------------------------------------------------------------
  E2F4  CE 00 00   LDX   #$0000         ; 0
  E2F7  B6 80 18   LDAA  $8018          ; rpm
  E2FA  81 10      CMPA  #$10           ; below 16?
  E2FC  25 06      BCS   loc_E304       ; yes — reset
  E2FE  FE 80 8C   LDX   $808C          ; time
  E301  08         INX                  ; + 1
  E302  27 03      BEQ   loc_E307       ; overflowed — do not store

loc_E304:
  E304  FF 80 8C   STX   $808C          ; store

loc_E307:
  E307  7E D1 D1   JMP   loc_D1D1       ; end of task — back to dispatcher

;------------------------------------------------------------------------------
; TASK 2 - every 4 ticks (≈40 ms).
; Start state (once, $8060.2): G62 < 127 means a warm start ($8060.3);
; 104 ≤ G62 < 127 also sets $8060.0 (semi-warm) [assumed].
; $8066.1 - signal G39 ≥ 239 (open circuit in the sensor wire [assumed]).
; N7 = 50 % constantly: test 4441; tester command $11 ($8077.5);
; contact 5 closed longer than 2.5 s with the engine running (CO adjustment [assumed]).
;------------------------------------------------------------------------------
TASK2:                                  ; called from: TASK2
  E30A  CE 80 00   LDX   #$8000         ; X = $8000
  E30D  E6 60      LDAB  $60,X          ; lambda flags
  E30F  C5 04      BITB  #$04           ; start state already stored?
  E311  26 10      BNE   loc_E323       ; yes
  E313  CA 04      ORAB  #$04           ; stored
  E315  A6 1B      LDAA  $1B,X          ; G62
  E317  81 7F      CMPA  #$7F           ; 127 and above (cold)?
  E319  24 08      BCC   loc_E323       ; yes
  E31B  CA 08      ORAB  #$08           ; warm start
  E31D  81 68      CMPA  #$68           ; below 104?
  E31F  25 02      BCS   loc_E323       ; yes
  E321  CA 01      ORAB  #$01           ; semi-warm

loc_E323:
  E323  E7 60      STAB  $60,X          ; store $8060
  E325  61 FD 66   AIM   #$FD,$66,X     ; clear "sensor open circuit"
  E328  A6 1C      LDAA  $1C,X          ; G39
  E32A  81 EF      CMPA  #$EF           ; 239 and above?
  E32C  25 03      BCS   loc_E331       ; no
  E32E  62 02 66   OIM   #$02,$66,X     ; sensor open circuit ($8066.1)

loc_E331:
  E331  6B 20 77   TIM   #$20,$77,X     ; tester command $11?
  E334  26 0A      BNE   loc_E340       ; yes - 50 %
  E336  6B 10 03   TIM   #$10,$03,X     ; engine was turning?
  E339  26 0A      BNE   loc_E345       ; yes - check contact 5
  E33B  6B 40 AF   TIM   #$40,$AF,X     ; test: N7 step?
  E33E  27 1A      BEQ   loc_E35A       ; no - normal operation

loc_E340:
  E340  86 32      LDAA  #$32           ; N7 = 50 %

loc_E342:
  E342  7E E7 3A   JMP   loc_E73A       ; output

loc_E345:
  E345  6B 02 03   TIM   #$02,$03,X     ; $8003.1 [?]
  E348  26 10      BNE   loc_E35A       ; set - normal operation
  E34A  6B 80 9F   TIM   #$80,$9F,X     ; blink code list finished?
  E34D  26 0B      BNE   loc_E35A       ; yes - normal operation
  E34F  A6 A4      LDAA  $A4,X          ; contact 5 closed time
  E351  81 19      CMPA  #$19           ; below 25 (2.5 s)?
  E353  25 05      BCS   loc_E35A       ; yes - normal operation
  E355  7B 40 15   TIM   #$40,PORT5     ; contact 5 still closed?
  E358  27 E6      BEQ   loc_E340       ; yes - 50 %

loc_E35A:
  E35A  7E FA 00   JMP   loc_FA00       ; patch: limit of lambda steps ($8214)

loc_E35D:
  E35D  C6 10      LDAB  #$10           ; 16 points
  E35F  CE C2 10   LDX   #$C210         ; rpm axis C210
  E362  BD CA 5F   JSR   AXIS_UP        ; find the point
  E365  F7 80 57   STAB  $8057          ; temporarily
  E368  CE C2 F0   LDX   #$C2F0         ; table C2F0 = 23 21 19 18 17 17 12 8 5 …
  E36B  3A         ABX                  ; X -> value
  E36C  A6 00      LDAA  $00,X          ; N7 addition after pressure rise
  E36E  B7 80 5B   STAA  $805B          ; $805B
  E371  86 40      LDAA  #$40           ; enrichment after pressure rise ($8077.6)?
  E373  B5 80 77   BITA  $8077          ; check
  E376  27 03      BEQ   loc_E37B       ; no
  E378  7E E4 5B   JMP   loc_E45B       ; yes - without lambda

loc_E37B:
  E37B  5F         CLRB                 ; 0
  E37C  7B 10 15   TIM   #$10,PORT5     ; coding: PORT5.4 = 1 means BUND
  E37F  26 02      BNE   loc_E383       ; BUND - 0
  E381  C6 80      LDAB  #$80           ; CAL - $80

loc_E383:
  E383  F7 80 58   STAB  $8058          ; $8058 = market (for lambda tables)
  E386  4F         CLRA                 ; N7 = 0 %
  E387  C6 20      LDAB  #$20           ; synchronised?
  E389  F5 80 95   BITB  $8095          ; check
  E38C  27 B4      BEQ   loc_E342       ; no - N7 0 %
  E38E  FE 80 AF   LDX   $80AF          ; time since synchronisation ($80AF/$80B0, calls of 40 ms)
  E391  08         INX                  ; + 1
  E392  27 03      BEQ   loc_E397       ; overflowed
  E394  FF 80 AF   STX   $80AF          ; store

loc_E397:
  E397  B6 80 66   LDAA  $8066          ; sensor open circuit?
  E39A  85 02      BITA  #$02           ; check
  E39C  27 03      BEQ   loc_E3A1       ; yes - without lambda
  E39E  7E E4 5B   JMP   loc_E45B       ; sensor open circuit - without lambda

;------------------------------------------------------------------------------
; SENSOR READINESS. The sensor is "alive" if the signal leaves the band 32…58
; (C6B8 / C6B7): ≥ 58 means rich ($8066.3 = 1, $8060.7 = 1), < 32 means lean.
; 15 calls outside the band (C6BC, 0.6 s) and the sensor is ready: $8060.4 and $8066.2.
; In closed loop ($8060.6), 50 calls (2 s, C6BA/C6BB) inside the band mean
; the sensor has "gone silent": clear $8060.6 and $8060.4 (open loop).
;------------------------------------------------------------------------------
loc_E3A1:
  E3A1  B6 80 5C   LDAA  $805C          ; counter
  E3A4  36         PSHA                 ; push
  E3A5  CE 80 00   LDX   #$8000         ; X = $8000
  E3A8  F6 80 1C   LDAB  $801C          ; G39
  E3AB  F1 C6 B7   CMPB  $C6B7          ; 58 and above?
  E3AE  24 19      BCC   loc_E3C9       ; yes - rich
  E3B0  F1 C6 B8   CMPB  $C6B8          ; 32 and above?
  E3B3  24 3D      BCC   loc_E3F2       ; yes - inside the band
  E3B5  61 F7 66   AIM   #$F7,$66,X     ; lean: $8066.3 = 0
  E3B8  86 40      LDAA  #$40           ; closed loop?
  E3BA  B5 80 60   BITA  $8060          ; check
  E3BD  26 30      BNE   loc_E3EF       ; yes - leave the counter alone
  E3BF  86 7F      LDAA  #$7F           ; side: lean
  E3C1  B4 80 60   ANDA  $8060          ; clear
  E3C4  B7 80 60   STAA  $8060          ; store
  E3C7  20 12      BRA   loc_E3DB       ; count

loc_E3C9:
  E3C9  62 08 66   OIM   #$08,$66,X     ; rich: $8066.3 = 1
  E3CC  86 40      LDAA  #$40           ; closed loop?
  E3CE  B5 80 60   BITA  $8060          ; check
  E3D1  26 1C      BNE   loc_E3EF       ; yes
  E3D3  86 80      LDAA  #$80           ; side: rich
  E3D5  BA 80 60   ORAA  $8060          ; set
  E3D8  B7 80 60   STAA  $8060          ; store

loc_E3DB:
  E3DB  32         PULA                 ; counter
  E3DC  4C         INCA                 ; + 1
  E3DD  B1 C6 BC   CMPA  $C6BC          ; below 15?
  E3E0  25 34      BCS   loc_E416       ; yes
  E3E2  86 10      LDAA  #$10           ; sensor ready ($8060.4)
  E3E4  BA 80 60   ORAA  $8060          ; set
  E3E7  B7 80 60   STAA  $8060          ; store
  E3EA  62 04 66   OIM   #$04,$66,X     ; first step after readiness ($8066.2)
  E3ED  20 26      BRA   loc_E415       ; counter = 0

loc_E3EF:
  E3EF  32         PULA                 ; clear
  E3F0  20 23      BRA   loc_E415       ; continue

loc_E3F2:
  E3F2  86 40      LDAA  #$40           ; closed loop?
  E3F4  B5 80 60   BITA  $8060          ; check
  E3F7  27 F6      BEQ   loc_E3EF       ; no - do not count
  E3F9  32         PULA                 ; counter
  E3FA  4C         INCA                 ; + 1
  E3FB  C6 08      LDAB  #$08           ; was it rich?
  E3FD  F5 80 66   BITB  $8066          ; check
  E400  26 05      BNE   loc_E407       ; yes
  E402  F6 C6 BB   LDAB  $C6BB          ; C6BB = 50
  E405  20 03      BRA   loc_E40A       ; continue

loc_E407:
  E407  F6 C6 BA   LDAB  $C6BA          ; C6BA = 50

loc_E40A:
  E40A  11         CBA                  ; reached?
  E40B  25 09      BCS   loc_E416       ; no
  E40D  86 AF      LDAA  #$AF           ; sensor went silent: clear $8060.6 and .4
  E40F  B4 80 60   ANDA  $8060          ; clear
  E412  B7 80 60   STAA  $8060          ; store

loc_E415:
  E415  4F         CLRA                 ; counter = 0

loc_E416:
  E416  B7 80 5C   STAA  $805C          ; store

;------------------------------------------------------------------------------
; FAULT 2342 (lambda control). Part throttle, throttle not closed,
; signal G39 near the middle 40 ± 6 for 125 consecutive calls (5 s): the sensor is "stuck":
; clear readiness; if ≥ 7500 calls (300 s) have passed since synchronisation
; and the engine is hot (G62 ≤ 30, ≈80 °C), fault 2342 ($8060.1).
; Per SSP: implausible G39 for more than 5 s on a warm engine.
;------------------------------------------------------------------------------
  E419  86 02      LDAA  #$02           ; F81 faulty?
  E41B  B5 80 93   BITA  $8093          ; check
  E41E  26 07      BNE   loc_E427       ; yes - do not check F81
  E420  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  E423  85 10      BITA  #$10           ; full load (F81)?
  E425  26 30      BNE   loc_E457       ; yes - counter to zero

loc_E427:
  E427  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  E42A  25 2B      BCS   loc_E457       ; yes - counter to zero
  E42C  C0 28      SUBB  #$28           ; G39 - 40
  E42E  24 01      BCC   loc_E431       ; positive
  E430  50         NEGB                 ; absolute value

loc_E431:
  E431  F1 C6 B9   CMPB  $C6B9          ; further than 6 from the middle?
  E434  22 21      BHI   loc_E457       ; yes - sensor is working, counter to zero
  E436  F6 80 AE   LDAB  $80AE          ; "stuck" counter
  E439  5C         INCB                 ; + 1
  E43A  C1 7D      CMPB  #$7D           ; below 125 (5 s)?
  E43C  25 1A      BCS   loc_E458       ; yes - store
  E43E  F6 80 60   LDAB  $8060          ; flags
  E441  C4 AF      ANDB  #$AF           ; clear readiness and closed loop
  E443  FE 80 AF   LDX   $80AF          ; time since synchronisation
  E446  8C 1D 4C   CPX   #$1D4C         ; below 7500 (300 s)?
  E449  25 09      BCS   loc_E454       ; yes - no fault
  E44B  B6 80 1B   LDAA  $801B          ; G62
  E44E  81 1E      CMPA  #$1E           ; colder than 30?
  E450  22 02      BHI   loc_E454       ; yes - no fault
  E452  CA 02      ORAB  #$02           ; fault 2342

loc_E454:
  E454  F7 80 60   STAB  $8060          ; store

loc_E457:
  E457  5F         CLRB                 ; counter = 0

loc_E458:
  E458  F7 80 AE   STAB  $80AE          ; store

;------------------------------------------------------------------------------
; N7 in special modes: start (rpm < 16 units) - 80 % with G62 > 189
; (colder than ≈ −4 °C [assumed]), otherwise 50 %; fuel cut-off (J142, $8077.0)
; with the pump running and not during start - 40 %.
;------------------------------------------------------------------------------
loc_E45B:
  E45B  F6 80 29   LDAB  $8029          ; rpm flags
  E45E  C5 08      BITB  #$08           ; start (below 16 units)?
  E460  27 11      BEQ   loc_E473       ; no
  E462  B6 C6 B3   LDAA  $C6B3          ; 80 % (C6B3)
  E465  F6 80 1B   LDAB  $801B          ; G62
  E468  F1 C6 B2   CMPB  $C6B2          ; colder than 189?
  E46B  22 03      BHI   loc_E470       ; yes - 80 %
  E46D  B6 C6 B4   LDAA  $C6B4          ; 50 % (C6B4)

loc_E470:
  E470  7E E7 3A   JMP   loc_E73A       ; output

loc_E473:
  E473  C5 20      BITB  #$20           ; bit 5 (rpm below 24 units)?
  E475  26 13      BNE   loc_E48A       ; yes - normal calculation
  E477  96 17      LDAA  PORT6          ; port 6
  E479  85 40      BITA  #$40           ; pump on?
  E47B  27 0D      BEQ   loc_E48A       ; no - normal calculation
  E47D  86 01      LDAA  #$01           ; cut-off?
  E47F  B5 80 77   BITA  $8077          ; check
  E482  27 06      BEQ   loc_E48A       ; no
  E484  B6 C6 B5   LDAA  $C6B5          ; N65 cut-off: N7 = 40 % (C6B5)
  E487  7E E5 79   JMP   loc_E579       ; output

;------------------------------------------------------------------------------
; BASE MAP N7 16×16, in %: rows are pressure (axis C500 = 255 173 169 … 38 0),
; columns are rpm (axis C510). Full load (F81) is the top row, idle is
; the bottom row. Map C300 is normal, C400 is used with a sensor open circuit ($8066.1).
; $8010 - altitude factor C550 = 255 229 204 191 by atmospheric pressure.
; $8011 - coolant temperature correction (128 = no correction): C540 (cold start),
; C520 (warm start), C530 (warm start and sensor open circuit); axis is the first 8 bytes, values the next 8.
;------------------------------------------------------------------------------
loc_E48A:
  E48A  CE C5 00   LDX   #$C500         ; pressure axis C500
  E48D  C6 10      LDAB  #$10           ; 16 points
  E48F  86 02      LDAA  #$02           ; F81 faulty?
  E491  B5 80 93   BITA  $8093          ; check
  E494  26 0B      BNE   loc_E4A1       ; yes
  E496  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  E499  85 10      BITA  #$10           ; full load?
  E49B  27 04      BEQ   loc_E4A1       ; no
  E49D  86 FF      LDAA  #$FF           ; top row
  E49F  20 06      BRA   loc_E4A7       ; continue

loc_E4A1:
  E4A1  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  E4A4  24 06      BCC   loc_E4AC       ; no - by pressure
  E4A6  4F         CLRA                 ; bottom row

loc_E4A7:
  E4A7  BD DF 7D   JSR   ROW_DN         ; row
  E4AA  20 03      BRA   loc_E4AF       ; continue

loc_E4AC:
  E4AC  BD DF 6E   JSR   MAP_ROW        ; row by pressure

loc_E4AF:
  E4AF  CE C5 10   LDX   #$C510         ; rpm axis C510
  E4B2  C6 10      LDAB  #$10           ; 16 points
  E4B4  BD DF 8A   JSR   RPM_COL        ; column
  E4B7  CE C3 00   LDX   #$C300         ; map C300
  E4BA  36         PSHA                 ; save
  E4BB  86 02      LDAA  #$02           ; sensor open circuit?
  E4BD  B5 80 66   BITA  $8066          ; check
  E4C0  27 03      BEQ   loc_E4C5       ; no
  E4C2  CE C4 00   LDX   #$C400         ; map C400

loc_E4C5:
  E4C5  32         PULA                 ; restore
  E4C6  BD DF A4   JSR   MAP16          ; N7 from the map
  E4C9  B7 80 57   STAA  $8057          ; $8057 = base N7
  E4CC  CE C2 B0   LDX   #$C2B0         ; altitude axis C2B0
  E4CF  C6 04      LDAB  #$04           ; 4 points
  E4D1  B6 80 04   LDAA  $8004          ; atmospheric pressure
  E4D4  BD CA 6B   JSR   AXIS_DN        ; find the interval
  E4D7  37         PSHB                 ; index
  E4D8  BD CA 10   JSR   FRAC_DN        ; fraction
  E4DB  17         TBA                  ; A = fraction
  E4DC  33         PULB                 ; B = index
  E4DD  CE C5 50   LDX   #$C550         ; table C550
  E4E0  3A         ABX                  ; X -> value
  E4E1  16         TAB                  ; B = fraction
  E4E2  BD CA 41   JSR   INTERP         ; interpolation
  E4E5  B7 80 10   STAA  $8010          ; $8010 = altitude factor
  E4E8  B6 80 57   LDAA  $8057          ; base N7
  E4EB  C6 40      LDAB  #$40           ; enrichment after pressure rise?
  E4ED  F5 80 77   BITB  $8077          ; check
  E4F0  27 09      BEQ   loc_E4FB       ; no
  E4F2  BB 80 5B   ADDA  $805B          ; + rpm-dependent addition
  E4F5  81 64      CMPA  #$64           ; above 100 %?
  E4F7  25 02      BCS   loc_E4FB       ; no
  E4F9  86 64      LDAA  #$64           ; 100 %

loc_E4FB:
  E4FB  B7 80 57   STAA  $8057          ; $8057
  E4FE  CE 80 00   LDX   #$8000         ; X = $8000
  E501  CC C5 20   LDD   #$C520         ; table C520 (warm start)
  E504  6B 08 60   TIM   #$08,$60,X     ; warm start?
  E507  27 0A      BEQ   loc_E513       ; no - C540
  E509  6B 02 66   TIM   #$02,$66,X     ; sensor open circuit?
  E50C  27 08      BEQ   loc_E516       ; no - C520
  E50E  CC C5 30   LDD   #$C530         ; C530
  E511  20 03      BRA   loc_E516       ; continue

loc_E513:
  E513  CC C5 40   LDD   #$C540         ; C540 (cold start)

loc_E516:
  E516  ED 11      STD   $11,X          ; $8011 = table address
  E518  18         XGDX                 ; X = table
  E519  B6 80 1B   LDAA  $801B          ; G62
  E51C  C6 08      LDAB  #$08           ; 8 points
  E51E  BD CA 6B   JSR   AXIS_DN        ; find the interval
  E521  37         PSHB                 ; index
  E522  BD CA 10   JSR   FRAC_DN        ; fraction
  E525  17         TBA                  ; A = fraction
  E526  33         PULB                 ; B = index
  E527  FE 80 11   LDX   $8011          ; table
  E52A  CB 08      ADDB  #$08           ; values after the axis (+8)
  E52C  3A         ABX                  ; X -> value
  E52D  16         TAB                  ; B = fraction
  E52E  BD CA 41   JSR   INTERP         ; interpolation
  E531  B7 80 11   STAA  $8011          ; $8011 = temperature correction
  E534  86 20      LDAA  #$20           ; rpm below 24 units ($8029.5)?
  E536  B5 80 29   BITA  $8029          ; check
  E539  26 55      BNE   loc_E590       ; yes - open loop
  E53B  7B 40 17   TIM   #$40,PORT6     ; pump on?
  E53E  27 50      BEQ   loc_E590       ; no - open loop
  E540  86 02      LDAA  #$02           ; F81 faulty?
  E542  B5 80 93   BITA  $8093          ; check
  E545  26 07      BNE   loc_E54E       ; yes - by pressure
  E547  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  E54A  85 10      BITA  #$10           ; full load?
  E54C  26 07      BNE   loc_E555       ; yes - full load

loc_E54E:
  E54E  86 10      LDAA  #$10           ; pressure above curve C2E0 ($8028.4)?
  E550  B5 80 28   BITA  $8028          ; check
  E553  27 2D      BEQ   loc_E582       ; no - part load

;------------------------------------------------------------------------------
; FULL LOAD (F81 or pressure above curve C2E0): open loop.
; On a cold start N7 is at least ($8011 - 68). With a knock sensor fault or
; prolonged knock ($807A.5), another + 5 % (C556, patch F750). Integrator = middle.
;------------------------------------------------------------------------------
loc_E555:
  E555  B6 80 57   LDAA  $8057          ; base N7
  E558  C6 08      LDAB  #$08           ; warm start?
  E55A  F5 80 60   BITB  $8060          ; check
  E55D  26 0C      BNE   loc_E56B       ; yes
  E55F  F6 80 11   LDAB  $8011          ; temperature correction
  E562  C0 44      SUBB  #$44           ; - 68
  E564  11         CBA                  ; base smaller?
  E565  25 03      BCS   loc_E56A       ; yes - take the correction
  E567  F6 80 57   LDAB  $8057          ; base

loc_E56A:
  E56A  17         TBA                  ; A = N7

loc_E56B:
  E56B  C6 20      LDAB  #$20           ; mask
  E56D  7E F7 50   JMP   loc_F750       ; patch: enrichment on knock

loc_E570:
  E570  27 07      BEQ   loc_E579       ; knock sensors OK? yes - no addition

loc_E572:
  E572  BB C5 56   ADDA  $C556          ; + 5 % (C556)
  E575  24 02      BCC   loc_E579       ; no overflow
  E577  86 64      LDAA  #$64           ; 100 %

loc_E579:
  E579  CE 5F 00   LDX   #$5F00         ; lambda integrator = middle ($5F00)
  E57C  FF 80 59   STX   $8059          ; store
  E57F  7E E7 3A   JMP   loc_E73A       ; output (fraction = B = $A0 from patch F750: +0.6 % to the table, verified with the emulator)

loc_E582:
  E582  B6 80 66   LDAA  $8066          ; sensor open circuit?
  E585  85 02      BITA  #$02           ; check
  E587  26 07      BNE   loc_E590       ; yes - open loop
  E589  F6 80 60   LDAB  $8060          ; closed loop?
  E58C  C5 40      BITB  #$40           ; check
  E58E  26 65      BNE   loc_E5F5       ; yes

;------------------------------------------------------------------------------
; OPEN LOOP (warm-up, sensor open circuit, sensor not ready): integrator =
; middle; N7 = base + temperature correction. On a cold start, in addition to the correction,
; a share of the altitude factor is added (higher in the mountains means less).
; Closed loop is enabled ($8060.6, clears the current 2342) when G62 is below
; C547 = 63 (C527 = 95 on a warm start), there is no open circuit and the sensor is ready.
;------------------------------------------------------------------------------
loc_E590:
  E590  CE 5F 00   LDX   #$5F00         ; middle
  E593  FF 80 59   STX   $8059          ; integrator
  E596  B6 80 57   LDAA  $8057          ; base
  E599  F6 80 11   LDAB  $8011          ; correction
  E59C  C0 80      SUBB  #$80           ; - 128
  E59E  24 07      BCC   loc_E5A7       ; above zero - enrich
  E5A0  50         NEGB                 ; lean out: absolute value
  E5A1  10         SBA                  ; base - correction
  E5A2  24 23      BCC   loc_E5C7       ; not below zero
  E5A4  4F         CLRA                 ; 0
  E5A5  20 20      BRA   loc_E5C7       ; continue

loc_E5A7:
  E5A7  36         PSHA                 ; save
  E5A8  86 08      LDAA  #$08           ; warm start?
  E5AA  B5 80 60   BITA  $8060          ; check
  E5AD  27 03      BEQ   loc_E5B2       ; no
  E5AF  32         PULA                 ; base
  E5B0  20 0E      BRA   loc_E5C0       ; + correction

loc_E5B2:
  E5B2  32         PULA                 ; base
  E5B3  37         PSHB                 ; push correction
  E5B4  B6 80 10   LDAA  $8010          ; altitude factor
  E5B7  3D         MUL                  ; × correction
  E5B8  18         XGDX                 ; X = product
  E5B9  33         PULB                 ; correction
  E5BA  3A         ABX                  ; + correction
  E5BB  18         XGDX                 ; D
  E5BC  16         TAB                  ; B = high byte: correction × (altitude + 1) / 256
  E5BD  B6 80 57   LDAA  $8057          ; base

loc_E5C0:
  E5C0  1B         ABA                  ; + correction
  E5C1  81 64      CMPA  #$64           ; above 100 %?
  E5C3  25 02      BCS   loc_E5C7       ; no
  E5C5  86 64      LDAA  #$64           ; 100 %

loc_E5C7:
  E5C7  B7 80 57   STAA  $8057          ; $8057 = N7
  E5CA  F6 80 60   LDAB  $8060          ; flags
  E5CD  B6 C5 47   LDAA  $C547          ; threshold C547 = 63
  E5D0  C5 08      BITB  #$08           ; warm start?
  E5D2  27 03      BEQ   loc_E5D7       ; no
  E5D4  B6 C5 27   LDAA  $C527          ; C527 = 95

loc_E5D7:
  E5D7  B1 80 1B   CMPA  $801B          ; G62 below the threshold (warmer)?
  E5DA  23 12      BLS   loc_E5EE       ; no
  E5DC  B6 80 66   LDAA  $8066          ; sensor open circuit?
  E5DF  85 02      BITA  #$02           ; check
  E5E1  26 0B      BNE   loc_E5EE       ; yes
  E5E3  C5 10      BITB  #$10           ; sensor ready?
  E5E5  27 07      BEQ   loc_E5EE       ; no
  E5E7  CA 40      ORAB  #$40           ; closed loop
  E5E9  C4 FD      ANDB  #$FD           ; clear the current 2342
  E5EB  F7 80 60   STAB  $8060          ; store

loc_E5EE:
  E5EE  5F         CLRB                 ; B = 0
  E5EF  B6 80 57   LDAA  $8057          ; N7
  E5F2  7E E7 3A   JMP   loc_E73A       ; output

;------------------------------------------------------------------------------
; CLOSED LOOP: PI controller, integrator $8059 (16 bit, middle $5F00 = 0 %).
; Sensor side: G39 < 48 means lean, ≥ 52 means rich, 48…51 means N7 is not recalculated.
; A side change gives a jump (4×4 table C560 / C580 by pressure C558 and rpm
; C55C; for HS +16, for CAL +128, tables C5E0/C600). Without a change, a step
; (C5A0 / C5C0, for CAL C620 / C640). At idle, constants from C6A4/C6A6.
; The first step after readiness is C6B0/C6B1 = 46. Jumps and steps are multiplied
; by $8214 / 256 (patch FA00). Rich moves the integrator down, lean moves it up.
; N7 = base + (integrator - middle), 5…95 %; at the limits the integrator is pulled back.
;------------------------------------------------------------------------------
loc_E5F5:
  E5F5  86 40      LDAA  #$40           ; enrichment after pressure rise?
  E5F7  B5 80 77   BITA  $8077          ; check
  E5FA  26 12      BNE   loc_E60E       ; yes - leave the integrator alone
  E5FC  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  E5FF  25 13      BCS   loc_E614       ; yes
  E601  CE 80 00   LDX   #$8000         ; X = $8000
  E604  6B 04 66   TIM   #$04,$66,X     ; first step after readiness?
  E607  27 0B      BEQ   loc_E614       ; no
  E609  61 FB 66   AIM   #$FB,$66,X     ; clear
  E60C  20 06      BRA   loc_E614       ; continue

loc_E60E:
  E60E  FC 80 59   LDD   $8059          ; integrator
  E611  7E E6 FD   JMP   loc_E6FD       ; to the N7 calculation

loc_E614:
  E614  37         PSHB                 ; save
  E615  CE C5 58   LDX   #$C558         ; pressure axis C558
  E618  C6 04      LDAB  #$04           ; 4 points
  E61A  BD E9 D6   JSR   ROW4_MAP       ; row
  E61D  CE C5 5C   LDX   #$C55C         ; rpm axis C55C
  E620  C6 04      LDAB  #$04           ; 4 points
  E622  BD E9 F2   JSR   COL4_RPM       ; cell 4×4
  E625  F7 80 5F   STAB  $805F          ; $805F
  E628  33         PULB                 ; restore
  E629  B6 80 1C   LDAA  $801C          ; G39
  E62C  8B 02      ADDA  #$02           ; + 2
  E62E  B1 C6 B6   CMPA  $C6B6          ; below 50 (G39 < 48)?
  E631  25 0A      BCS   loc_E63D       ; yes - lean
  E633  80 04      SUBA  #$04           ; - 4
  E635  B1 C6 B6   CMPA  $C6B6          ; not below 50 (G39 ≥ 52)?
  E638  24 08      BCC   loc_E642       ; yes - rich
  E63A  7E E7 56   JMP   loc_E756       ; in the middle - leave N7 alone

loc_E63D:
  E63D  17         TBA                  ; old side
  E63E  C4 7F      ANDB  #$7F           ; new: lean
  E640  20 05      BRA   loc_E647       ; continue

loc_E642:
  E642  17         TBA                  ; old side
  E643  CA 80      ORAB  #$80           ; new: rich
  E645  88 80      EORA  #$80           ; compare with the old one

loc_E647:
  E647  F7 80 60   STAB  $8060          ; store the side
  E64A  4D         TSTA                 ; side changed?
  E64B  2B 55      BMI   loc_E6A2       ; yes - jump
  E64D  86 04      LDAA  #$04           ; first step after readiness?
  E64F  B5 80 66   BITA  $8066          ; check
  E652  27 0F      BEQ   loc_E663       ; no
  E654  F6 C6 B0   LDAB  $C6B0          ; C6B0
  E657  86 80      LDAA  #$80           ; rich?
  E659  B5 80 60   BITA  $8060          ; check
  E65C  26 41      BNE   loc_E69F       ; yes
  E65E  F6 C6 B1   LDAB  $C6B1          ; C6B1
  E661  20 3C      BRA   loc_E69F       ; continue

loc_E663:
  E663  CE C6 A6   LDX   #$C6A6         ; idle step C6A6
  E666  F6 80 60   LDAB  $8060          ; side
  E669  2B 02      BMI   loc_E66D       ; rich
  E66B  08         INX                  ; lean: +2
  E66C  08         INX                  ; (same)

loc_E66D:
  E66D  7B 04 17   TIM   #$04,PORT6     ; HS?
  E670  27 01      BEQ   loc_E673       ; no
  E672  08         INX                  ; +1

loc_E673:
  E673  F6 80 58   LDAB  $8058          ; market
  E676  27 03      BEQ   loc_E67B       ; BUND
  E678  C6 06      LDAB  #$06           ; CAL: +6
  E67A  3A         ABX                  ; (same)

loc_E67B:
  E67B  E6 00      LDAB  $00,X          ; step
  E67D  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  E680  25 1D      BCS   loc_E69F       ; yes - this step
  E682  CE C5 A0   LDX   #$C5A0         ; step table C5A0 (rich)
  E685  F6 80 60   LDAB  $8060          ; side
  E688  2B 03      BMI   loc_E68D       ; rich
  E68A  CE C5 C0   LDX   #$C5C0         ; C5C0 (lean)

loc_E68D:
  E68D  F6 80 58   LDAB  $8058          ; market (0 / $80)
  E690  7B 04 17   TIM   #$04,PORT6     ; HS?
  E693  27 02      BEQ   loc_E697       ; no
  E695  CB 10      ADDB  #$10           ; +16

loc_E697:
  E697  3A         ABX                  ; X -> table
  E698  F6 80 5F   LDAB  $805F          ; cell
  E69B  7E FA 40   JMP   loc_FA40       ; patch: step × $8214

loc_E69E:
  E69E  16         TAB                  ; step

loc_E69F:
  E69F  4F         CLRA                 ; high byte 0 (small step)
  E6A0  20 3C      BRA   loc_E6DE       ; continue

loc_E6A2:
  E6A2  CE 80 00   LDX   #$8000         ; X = $8000
  E6A5  61 FB 66   AIM   #$FB,$66,X     ; clear "first step"
  E6A8  CE C6 A4   LDX   #$C6A4         ; idle jump C6A4
  E6AB  B6 80 58   LDAA  $8058          ; market
  E6AE  27 03      BEQ   loc_E6B3       ; BUND
  E6B0  C6 06      LDAB  #$06           ; CAL: +6
  E6B2  3A         ABX                  ; (same)

loc_E6B3:
  E6B3  7B 04 17   TIM   #$04,PORT6     ; HS?
  E6B6  27 01      BEQ   loc_E6B9       ; no
  E6B8  08         INX                  ; +1

loc_E6B9:
  E6B9  E6 00      LDAB  $00,X          ; jump
  E6BB  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  E6BE  17         TBA                  ; jump in A
  E6BF  25 1C      BCS   loc_E6DD       ; yes - this one
  E6C1  CE C5 60   LDX   #$C560         ; jump table C560 (rich)
  E6C4  F6 80 60   LDAB  $8060          ; side
  E6C7  2B 03      BMI   loc_E6CC       ; rich
  E6C9  CE C5 80   LDX   #$C580         ; C580 (lean)

loc_E6CC:
  E6CC  F6 80 58   LDAB  $8058          ; market
  E6CF  7B 04 17   TIM   #$04,PORT6     ; HS?
  E6D2  27 02      BEQ   loc_E6D6       ; no
  E6D4  CB 10      ADDB  #$10           ; +16

loc_E6D6:
  E6D6  3A         ABX                  ; X -> table
  E6D7  F6 80 5F   LDAB  $805F          ; cell
  E6DA  7E FA 32   JMP   loc_FA32       ; patch: jump × $8214

loc_E6DD:
  E6DD  5F         CLRB                 ; low byte 0 (large step in percent)

loc_E6DE:
  E6DE  FD 80 10   STD   $8010          ; $8010 = step
  E6E1  B6 80 60   LDAA  $8060          ; side
  E6E4  48         ASLA                 ; rich?
  E6E5  FC 80 59   LDD   $8059          ; integrator
  E6E8  24 09      BCC   loc_E6F3       ; lean
  E6EA  B3 80 10   SUBD  $8010          ; rich - down
  E6ED  24 0E      BCC   loc_E6FD       ; not below 0
  E6EF  4F         CLRA                 ; 0
  E6F0  5F         CLRB                 ; (same)
