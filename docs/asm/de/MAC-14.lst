;------------------------------------------------------------------------------
; LADEDRUCKABSENKUNG nach Temperaturen, wird vom Tastverhältnis abgezogen:
; nach G42 (Achse C758 = 185 175 165 137 -> C75C = 83 38 13 13; kälter bedeutet mehr;
; zu G42 wird (Momentwert $806C - 146) addiert, wenn der Momentwert kalt ist)
; plus nach G62 (Achse C760 = 216 … 21 -> C768 = 89 89 89 81 71 64 25 0; kalter
; Motor bedeutet mehr), bei $8066.5 (Motor heiß) nach der Zeit mit heißem Motor
; (~$80B1, Achse C770 -> C778 = 64 … 0). Laut SSP: unter +10 °C wird der Ladedruck abgesenkt,
; eine Unterbrechung von G42 (−20 °C) hält den Ladedruck niedrig.
; Der Integrator sinkt nicht unter die Absenkung. Ein Rest unter 224/65536 wird null.
; Grenzen C7A9 = 0 … C7AA = 255.
;------------------------------------------------------------------------------
loc_E8F5:
  E8F5  B6 80 20   LDAA  $8020          ; G42
  E8F8  F6 80 6C   LDAB  $806C          ; Momentwert G42
  E8FB  C0 92      SUBB  #$92           ; - 146
  E8FD  25 05      BCS   loc_E904       ; warm - ohne Zuschlag
  E8FF  1B         ABA                  ; + zu G42
  E900  24 02      BCC   loc_E904       ; kein Überlauf
  E902  86 FF      LDAA  #$FF           ; 255

loc_E904:
