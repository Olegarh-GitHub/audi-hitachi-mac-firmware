  D0CE  C1 A5      CMPB  #$A5           ; G42 unter 165 (warme Ansaugluft) [Vermutung]?
  D0D0  24 08      BCC   loc_D0DA       ; nein
  D0D2  86 10      LDAA  #$10           ; $8066.4 [?]
  D0D4  BA 80 66   ORAA  $8066          ; setzen
  D0D7  B7 80 66   STAA  $8066          ; speichern

loc_D0DA:
  D0DA  86 40      LDAA  #$40           ; Momentaufnahme erfolgt
  D0DC  BA 80 51   ORAA  $8051          ; setzen
  D0DF  B7 80 51   STAA  $8051          ; speichern

loc_D0E2:
  D0E2  3B         RTI                  ; verlassen

;------------------------------------------------------------------------------
; TICK (≈10 ms), aus IRQ1 bei freigegebenen Interrupts.
; Motorstillstand: nach der Synchronisation wächst $8025 jeden Tick, ein Zylinderereignis
; setzt ihn zurück. 100 Ticks (C78D, ≈1 s) ohne Ereignis bedeuten Motorstillstand:
; $8003.7; bei PORT5.5 = 1 [?] wird der Fehlerspeicher mit Prüfsumme ins interne RAM kopiert,
; und das Programm startet neu (CA8E), ohne vollständige RAM-Prüfung.
; Vor der Synchronisation: bei PORT5.5 = 1 und $8003.3 (Kopie wartet auf Rückspielen), falls
; die Versorgung des internen RAM nicht ausgefallen ist (RP5CR.7) und die Prüfsumme stimmt, werden Codes und Zähler
; aus der Kopie zurückgeholt; sonst vollständiger Neustart (CA88).
;------------------------------------------------------------------------------
loc_D0E3:
  D0E3  86 20      LDAA  #$20           ; synchronisiert?
  D0E5  B5 80 95   BITA  $8095          ; prüfen
  D0E8  27 46      BEQ   loc_D130       ; nein
  D0EA  7C 80 25   INC   $8025          ; Ticks ohne Ereignis + 1
  D0ED  F6 80 25   LDAB  $8025          ; Wert
  D0F0  F1 C7 8D   CMPB  $C78D          ; kleiner als 100?
  D0F3  25 3B      BCS   loc_D130       ; ja - zu den Tasks
  D0F5  0F         SEI                  ; Interrupts sperren
  D0F6  86 80      LDAA  #$80           ; Motor steht ($8003.7)
  D0F8  BA 80 03   ORAA  $8003          ; setzen
  D0FB  B7 80 03   STAA  $8003          ; speichern
  D0FE  7B 20 15   TIM   #$20,PORT5     ; PORT5.5 [?]
  D101  27 24      BEQ   loc_D127       ; 0 - ohne Kopie
  D103  72 40 14   OIM   #$40,RP5CR     ; internes RAM einschalten
  D106  4F         CLRA                 ; Prüfsumme = 0
  D107  F6 80 00   LDAB  $8000          ; Codebyte 1
  D10A  1B         ABA                  ; zur Prüfsumme
  D10B  D7 41      STAB  $41            ; Kopie
  D10D  F6 80 01   LDAB  $8001          ; Codebyte 2
  D110  1B         ABA                  ; zur Prüfsumme
  D111  D7 42      STAB  $42            ; Kopie
  D113  F6 80 02   LDAB  $8002          ; Codebyte 3
  D116  1B         ABA                  ; zur Prüfsumme
  D117  D7 43      STAB  $43            ; Kopie
  D119  F6 80 2B   LDAB  $802B          ; Starts ohne Änderung
  D11C  1B         ABA                  ; zur Prüfsumme
  D11D  D7 44      STAB  $44            ; Kopie
  D11F  F6 80 2C   LDAB  $802C          ; $802C
  D122  1B         ABA                  ; zur Prüfsumme
  D123  D7 45      STAB  $45            ; Kopie
  D125  97 40      STAA  $40            ; Prüfsumme

loc_D127:
  D127  8E 82 90   LDS   #$8290         ; Stack neu setzen
  D12A  CE 80 05   LDX   #$8005         ; X = $8005
  D12D  7E CA 8E   JMP   loc_CA8E       ; Programm neu starten (ohne RAM-Prüfung)

loc_D130:
  D130  7B 20 15   TIM   #$20,PORT5     ; PORT5.5 [?]
  D133  27 48      BEQ   loc_D17D       ; 0 - zu den Tasks
  D135  F6 80 03   LDAB  $8003          ; Flags
  D138  C5 08      BITB  #$08           ; Kopie wartet auf Rückspielen?
  D13A  27 41      BEQ   loc_D17D       ; nein - zu den Tasks
  D13C  7B 80 14   TIM   #$80,RP5CR     ; Versorgung des internen RAM nicht ausgefallen?
  D13F  27 38      BEQ   loc_D179       ; ausgefallen - vollständiger Neustart
  D141  0F         SEI                  ; Interrupts sperren
  D142  72 40 14   OIM   #$40,RP5CR     ; internes RAM einschalten
  D145  CE 00 41   LDX   #$0041         ; Kopie
  D148  4F         CLRA                 ; Prüfsumme = 0

loc_D149:
  D149  AB 00      ADDA  $00,X          ; + Byte
  D14B  08         INX                  ; nächstes
  D14C  8C 00 46   CPX   #$0046         ; bis $45
  D14F  26 F8      BNE   loc_D149       ; wiederholen
  D151  91 40      CMPA  $40            ; Prüfsumme stimmt?
  D153  26 24      BNE   loc_D179       ; nein - vollständiger Neustart
  D155  96 41      LDAA  $41            ; Codes zurückholen
  D157  B7 80 00   STAA  $8000          ; (ebenso)
  D15A  96 42      LDAA  $42            ; (ebenso)
  D15C  B7 80 01   STAA  $8001          ; (ebenso)
  D15F  96 43      LDAA  $43            ; (ebenso)
  D161  B7 80 02   STAA  $8002          ; (ebenso)
  D164  96 44      LDAA  $44            ; Starts
  D166  B7 80 2B   STAA  $802B          ; (ebenso)
  D169  96 45      LDAA  $45            ; $802C
  D16B  B7 80 2C   STAA  $802C          ; (ebenso)
  D16E  71 BF 14   AIM   #$BF,RP5CR     ; internes RAM ausschalten
  D171  0E         CLI                  ; Interrupts freigeben
  D172  C4 F7      ANDB  #$F7           ; Kopie zurückgeholt
  D174  F7 80 03   STAB  $8003          ; speichern
  D177  20 04      BRA   loc_D17D       ; zu den Tasks

loc_D179:
  D179  0F         SEI                  ; Interrupts sperren
  D17A  7E CA 88   JMP   RESET          ; vollständiger Neustart

;------------------------------------------------------------------------------
; TASK-VERTEILER (präemptiv). Zähler $8006-$8009, je einer pro Task,
; Teiler D1E1 = 1 2 4 10. Jeden Tick Zähler + 1; erreicht er den Teiler, ist die Task
; bereit (Bit 6). Gestartet wird die erste bereite Task in der Reihenfolge (Bit 7 = läuft),
; falls keine laufende vor ihr steht: Task 0 unterbricht 1-3, Task 1 unterbricht 2-3 usw.
; Eine Task endet mit Sprung nach D1D1: „läuft“ löschen, nächste suchen.
;------------------------------------------------------------------------------
loc_D17D:
  D17D  CE D1 E1   LDX   #$D1E1         ; Teiler
  D180  3C         PSHX                 ; auf den Stack
  D181  CE 80 06   LDX   #$8006         ; Zähler Task 0

loc_D184:
  D184  6C 00      INC   $00,X          ; + 1
  D186  A6 00      LDAA  $00,X          ; Wert
  D188  FF 80 0A   STX   $800A          ; X sichern
  D18B  38         PULX                 ; Teiler
  D18C  E6 00      LDAB  $00,X          ; Teiler
  D18E  08         INX                  ; nächster
  D18F  3C         PSHX                 ; sichern
  D190  FE 80 0A   LDX   $800A          ; Zähler
  D193  84 3F      ANDA  #$3F           ; Zählstand (ohne Bits 7, 6)
  D195  10         SBA                  ; Teiler erreicht?
  D196  26 07      BNE   loc_D19F       ; nein
  D198  A6 00      LDAA  $00,X          ; Zähler
  D19A  8A 40      ORAA  #$40           ; + bereit
  D19C  10         SBA                  ; - Teiler (Zählung ab null)
  D19D  A7 00      STAA  $00,X          ; speichern

loc_D19F:
  D19F  08         INX                  ; nächster Zähler
  D1A0  8C 80 0A   CPX   #$800A         ; alle vier?
  D1A3  26 DF      BNE   loc_D184       ; nein
  D1A5  38         PULX                 ; Zeiger entfernen

loc_D1A6:
  D1A6  5F         CLRB                 ; Tasknummer 0
  D1A7  CE 80 06   LDX   #$8006         ; Zähler Task 0

loc_D1AA:
  D1AA  A6 00      LDAA  $00,X          ; Zähler
  D1AC  2B 0B      BMI   loc_D1B9       ; läuft? - verlassen (wichtigere Task belegt)
  D1AE  85 40      BITA  #$40           ; bereit?
  D1B0  26 08      BNE   loc_D1BA       ; ja - starten
  D1B2  5C         INCB                 ; Nummer + 1
  D1B3  08         INX                  ; nächster
  D1B4  8C 80 0A   CPX   #$800A         ; alle?
  D1B7  26 F1      BNE   loc_D1AA       ; nein

loc_D1B9:
  D1B9  3B         RTI                  ; Interrupt verlassen

loc_D1BA:
  D1BA  8A 80      ORAA  #$80           ; läuft
  D1BC  80 40      SUBA  #$40           ; „bereit“ löschen
  D1BE  A7 00      STAA  $00,X          ; speichern
  D1C0  CE D1 C9   LDX   #$D1C9         ; Task-Tabelle D1C9
  D1C3  58         ASLB                 ; Nummer × 2
  D1C4  3A         ABX                  ; X -> Adresse
  D1C5  EE 00      LDX   $00,X          ; Task-Adresse
  D1C7  6E 00      JMP   $00,X          ; zur Task springen

; Tabelle $D1C9, 8 Bytes: Task-Adressen: D220 (0), DD18 (1), E30A (2), EA2C (3)
  D1C9  db D2 20 DD 18 E3 0A EA 2C

loc_D1D1:
  D1D1  CE 80 06   LDX   #$8006         ; Zähler

loc_D1D4:
  D1D4  A6 00      LDAA  $00,X          ; Zähler
  D1D6  2B 03      BMI   loc_D1DB       ; läuft? - diese ist beendet
  D1D8  08         INX                  ; nächster
  D1D9  20 F9      BRA   loc_D1D4       ; suchen

loc_D1DB:
  D1DB  84 7F      ANDA  #$7F           ; „läuft“ löschen
  D1DD  A7 00      STAA  $00,X          ; speichern
  D1DF  20 C5      BRA   loc_D1A6       ; nächste bereite Task suchen

; Tabelle $D1E1, 4 Bytes: Task-Teiler: 1 2 4 10 Ticks
  D1E1  db 01 02 04 0A

;------------------------------------------------------------------------------
; IS_IDLE: Drosselklappe geschlossen (Leerlaufschalter F60)?
; Ausgang: C = 1 bedeutet geschlossen. Liegt die Drehzahl nicht unter dem ersten Punkt der Achse C210
; (40 Einh. ≈ 890 U/min) und ist der Leerlaufschalter als defekt erkannt ($8093.3),
; lautet die Antwort immer „nicht geschlossen“.
;------------------------------------------------------------------------------
IS_IDLE:                                ; aufgerufen von: TASK0, TASK1, TASK2, TASK3
  D1E5  B6 80 18   LDAA  $8018          ; Drehzahl
  D1E8  B1 C2 10   CMPA  $C210          ; unter 40 Einh. (≈890 U/min)?
  D1EB  25 07      BCS   loc_D1F4       ; ja: dem Schalter vertrauen
  D1ED  86 08      LDAA  #$08           ; Fehlerbit Leerlaufschalter
  D1EF  B5 80 93   BITA  $8093          ; Leerlaufschalter defekt?
  D1F2  26 08      BNE   loc_D1FC       ; ja: Drosselklappe als offen behandeln

loc_D1F4:
  D1F4  8D 1F      BSR   RD_INPUTS      ; digitale Eingänge lesen (Chip-Reg. $19)
  D1F6  85 20      BITA  #$20           ; Bit 5 ist der Leerlaufschalter F60
  D1F8  27 02      BEQ   loc_D1FC       ; offen? ja: Drosselklappe offen
  D1FA  0D         SEC                  ; geschlossen: C = 1
  D1FB  39         RTS

loc_D1FC:
  D1FC  0C         CLC                  ; C = 0: Drosselklappe offen
  D1FD  39         RTS

;------------------------------------------------------------------------------
; MAP_BAD_LOAD: G71 defekt und Motor unter Last?
; Ausgang: C = 1, wenn ein Druckfehler vorliegt ($8091 & $72), die Drehzahl nicht unter
; 40 Einh. liegt und die Drosselklappe nicht geschlossen ist. Dann wird statt des Messwerts
; der Ersatzwert $C79E verwendet.
;------------------------------------------------------------------------------
MAP_BAD_LOAD:                           ; aufgerufen von: TASK1, TASK3
  D1FE  86 72      LDAA  #$72           ; Fehlerbits Druck
  D200  B5 80 91   BITA  $8091          ; Druckfehler vorhanden?
  D203  27 0E      BEQ   loc_D213       ; nein: C = 0
  D205  B6 80 18   LDAA  $8018          ; Drehzahl
  D208  B1 C2 10   CMPA  $C210          ; unter 40 Einh. (≈890 U/min)?
  D20B  25 06      BCS   loc_D213       ; ja: C = 0
  D20D  8D D6      BSR   IS_IDLE        ; Drosselklappe geschlossen?
  D20F  25 02      BCS   loc_D213       ; ja: C = 0
  D211  0D         SEC                  ; C = 1: Ersatzwert für den Druck verwenden
  D212  39         RTS

loc_D213:
  D213  0C         CLC                  ; C = 0
  D214  39         RTS

;------------------------------------------------------------------------------
; RD_INPUTS: Chipregister $19 lesen, die digitalen Eingänge.
; Bit 5 ist F60 (Leerlauf), Bit 4 ist F81 (Vollast), Bit 3 ist der Bremslichtschalter,
; Bit 2 liest den Ausgang N115 zurück. 1 = Kontakt geschlossen [Vermutung aus der Logik].
;------------------------------------------------------------------------------
RD_INPUTS:                              ; aufgerufen von: TASK0, TASK1, TASK2, TASK3
  D215  86 19      LDAA  #$19           ; Registernummer $19

;------------------------------------------------------------------------------
; CHIP_RD: Chipregister $0100 lesen: A = Nummer, am Ausgang A = Daten.
; Interrupts sind gesperrt, damit ein IRQ die Registernummer zwischen Schreiben und Lesen nicht verändert.
;------------------------------------------------------------------------------
CHIP_RD:                                ; aufgerufen von: TASK0, TASK1, TASK2, TASK3
  D217  0F         SEI                  ; Interrupts sperren
  D218  B7 01 00   STAA  $0100          ; Registernummer
  D21B  B6 01 01   LDAA  $0101          ; Daten
  D21E  0E         CLI                  ; Interrupts freigeben
  D21F  39         RTS

;------------------------------------------------------------------------------
; TASK 0 — jeder Tick (≈10 ms).
; 1) PORT6.7 wird umgeschaltet: Signal an die externe Schaltung, dass das Programm läuft.
; 2) PORT2.5 [?] = 1 bei Drehzahl ≥ 20 Einh. (≈440-480 U/min), nur nach der Synchronisation.
; 3) Abfrage des A/D-Wandlers im Chip: Kanäle 0-5 -> $8019-$801E, 7 -> $8020. Kanal 6 (Klopfen)
;   wird hier nicht gelesen. Kanal 4 ($801D) wird einmal gelesen — im ersten Tick nach der
;   Synchronisation ($8075.0).
;------------------------------------------------------------------------------
TASK0:                                  ; aufgerufen von: TASK0
  D220  75 80 17   EIM   #$80,PORT6     ; PORT6.7 umschalten: „Programm läuft“
  D223  5F         CLRB                 ; A/D-Kanalnummer = 0
  D224  CE 80 19   LDX   #$8019         ; X -> $8019, erste Zelle
  D227  86 20      LDAA  #$20           ; Synchronisation vorhanden?
  D229  B5 80 95   BITA  $8095          ; prüfen
  D22C  27 28      BEQ   loc_D256       ; nein — PORT2.5 nicht verändern
  D22E  B6 80 18   LDAA  $8018          ; Drehzahl
  D231  81 14      CMPA  #$14           ; unter 20 Einh.?
  D233  24 05      BCC   loc_D23A       ; nein — PORT2.5 = 1
  D235  71 DF 03   AIM   #$DF,PORT2     ; PORT2.5 = 0
  D238  20 03      BRA   loc_D23D       ; weiter

loc_D23A:
  D23A  72 20 03   OIM   #$20,PORT2     ; PORT2.5 = 1

loc_D23D:
  D23D  5C         INCB                 ; nächster Kanal
  D23E  08         INX                  ; nächste Zelle
  D23F  C1 04      CMPB  #$04           ; Kanal 4?
  D241  26 13      BNE   loc_D256       ; nein — lesen
  D243  86 20      LDAA  #$20           ; Synchronisation vorhanden?
  D245  B5 80 95   BITA  $8095          ; prüfen
  D248  27 F3      BEQ   loc_D23D       ; nein — Kanal 4 überspringen
  D24A  B6 80 75   LDAA  $8075          ; Kanal 4 nach der Synchronisation schon gelesen?
  D24D  85 01      BITA  #$01           ; prüfen
  D24F  26 EC      BNE   loc_D23D       ; ja — überspringen
  D251  8A 01      ORAA  #$01           ; markieren: gelesen
  D253  B7 80 75   STAA  $8075          ; $8075 schreiben

loc_D256:
  D256  C1 06      CMPB  #$06           ; Kanal 6 (Klopfen)?
  D258  27 E3      BEQ   loc_D23D       ; ja — überspringen
  D25A  86 14      LDAA  #$14           ; Chipregister $14 — A/D-Start
  D25C  0F         SEI                  ; Interrupts sperren
  D25D  B7 80 2A   STAA  $802A          ; Kennung „A/D-Wandler von Task 0 belegt“
  D260  FD 01 00   STD   $0100          ; Wandlung starten, Kanal = B
  D263  0E         CLI                  ; Interrupts freigeben

loc_D264:
  D264  86 1F      LDAA  #$1F           ; Statusregister $1F
  D266  8D AF      BSR   CHIP_RD        ; lesen
  D268  2B FA      BMI   loc_D264       ; Bit 7 = 1 — läuft noch, warten
  D26A  0F         SEI                  ; Interrupts sperren
  D26B  B6 80 2A   LDAA  $802A          ; Kennung noch vorhanden?
  D26E  27 E6      BEQ   loc_D256       ; nein (ein Interrupt hat den A/D-Wandler benutzt) — wiederholen
  D270  C1 03      CMPB  #$03           ; Kanal 3 (Lambda)?
  D272  26 1E      BNE   loc_D292       ; nein — 8 Bit
  D274  37         PSHB                 ; Kanalnummer sichern
  D275  C6 14      LDAB  #$14           ; Ergebnisregister, High-Byte
  D277  F7 01 00   STAB  $0100          ; auswählen
  D27A  B6 01 01   LDAA  $0101          ; lesen
  D27D  5C         INCB                 ; Low-Byte
  D27E  F7 01 00   STAB  $0100          ; auswählen
  D281  F6 01 01   LDAB  $0101          ; lesen
  D284  FD 80 B3   STD   $80B3          ; $80B3/$80B4 = volles Lambda-Ergebnis
  D287  05         ASLD                 ; verdoppeln (Lambda 0…1 V belegt die untere Hälfte der Skala) [Vermutung]
  D288  0E         CLI                  ; Interrupts freigeben
  D289  24 02      BCC   loc_D28D       ; kein Überlauf? ja
  D28B  86 FF      LDAA  #$FF           ; auf 255 begrenzen

loc_D28D:
  D28D  A7 00      STAA  $00,X          ; in die Zelle schreiben
  D28F  33         PULB                 ; Kanalnummer
  D290  20 AB      BRA   loc_D23D       ; nächster

loc_D292:
  D292  86 14      LDAA  #$14           ; Ergebnisregister
  D294  8D 81      BSR   CHIP_RD        ; lesen
  D296  A7 00      STAA  $00,X          ; in die Zelle schreiben
  D298  8C 80 20   CPX   #$8020         ; letzte ($8020)?
  D29B  26 A0      BNE   loc_D23D       ; nein — nächster Kanal

;------------------------------------------------------------------------------
; Signal Schubabschaltung von J142 (Kontakt 4, $801E): unter 128 — Abschaltung,
; $8077.0 = 1. Danach N7 = 40 % (E484).
;------------------------------------------------------------------------------
  D29D  F6 80 77   LDAB  $8077          ; Flags
  D2A0  CA 01      ORAB  #$01           ; Abschaltung — Bit 0 = 1
  D2A2  B6 80 1E   LDAA  $801E          ; Signal von Kontakt 4
  D2A5  81 80      CMPA  #$80           ; unter 128?
  D2A7  25 02      BCS   loc_D2AB       ; ja — Abschaltung
  D2A9  C4 FE      ANDB  #$FE           ; nein — Bit 0 = 0

loc_D2AB:
  D2AB  F7 80 77   STAB  $8077          ; $8077 schreiben

;------------------------------------------------------------------------------
; Prüfung der Temperaturfühler auf Unterbrechung und Kurzschluss. Flags in $8092:
; Bit 7 — G42 jetzt defekt; 5 — G42 unter 16 (Kurzschluss); 4 — G42 über 235 (Unterbrechung);
; Bit 6 — G62 jetzt defekt; 3 — G62 unter 8 (Kurzschluss); 2 — G62 über 228 (Unterbrechung).
; Ersatzwerte: G42 = 194 (−20 °C laut SSP), G62 = 30 (80 °C laut SSP).
; Bits 5-2 sind speichernd (Löschen setzt sie zurück) — Codes 2322 und 2312.
;------------------------------------------------------------------------------
  D2AE  F6 80 92   LDAB  $8092          ; Temperaturflags
  D2B1  C4 3F      ANDB  #$3F           ; „jetzt“ löschen, speichernde behalten
  D2B3  B6 80 20   LDAA  $8020          ; G42
  D2B6  B1 C7 86   CMPA  $C786          ; unter C786 = 16?
  D2B9  24 04      BCC   loc_D2BF       ; nein
  D2BB  CA A0      ORAB  #$A0           ; G42 Kurzschluss
  D2BD  20 07      BRA   loc_D2C6       ; ersetzen

loc_D2BF:
  D2BF  B1 C7 85   CMPA  $C785          ; über C785 = 235?
  D2C2  23 08      BLS   loc_D2CC       ; nein — in Ordnung
  D2C4  CA 90      ORAB  #$90           ; G42 Unterbrechung

loc_D2C6:
  D2C6  B6 C7 88   LDAA  $C788          ; Ersatzwert C788 = 194 (−20 °C)
  D2C9  B7 80 20   STAA  $8020          ; statt des Messwerts

loc_D2CC:
  D2CC  B6 80 1B   LDAA  $801B          ; G62
  D2CF  B1 C7 84   CMPA  $C784          ; unter C784 = 8?
  D2D2  24 04      BCC   loc_D2D8       ; nein
  D2D4  CA 48      ORAB  #$48           ; G62 Kurzschluss
  D2D6  20 07      BRA   loc_D2DF       ; ersetzen

loc_D2D8:
  D2D8  B1 C7 83   CMPA  $C783          ; über C783 = 228?
  D2DB  23 08      BLS   loc_D2E5       ; nein — in Ordnung
  D2DD  CA 44      ORAB  #$44           ; G62 Unterbrechung

loc_D2DF:
  D2DF  B6 C7 87   LDAA  $C787          ; Ersatzwert C787 = 30 (80 °C)
  D2E2  B7 80 1B   STAA  $801B          ; statt des Messwerts

loc_D2E5:
  D2E5  F7 80 92   STAB  $8092          ; $8092 schreiben

;------------------------------------------------------------------------------
; Temperaturmerker in $8075 nach G62 (Skala [Vermutung], siehe Legende):
; Bit 4 — nicht über 90 (wärmer als ≈ +37 °C); Bit 3 — nicht über 169 (wärmer als ≈ +4 °C);
; Bit 2 — nicht über 14 (heißer als ≈ 100 °C); Bit 1 — unter 44 (wärmer als ≈ 65 °C,
; laut SSP Umschaltung auf Zündkennfeld 1), wird gelöscht, wenn der Wert 49 oder mehr wird.
; $807B — niedrigste Temperatur (größter Wert) seit dem Einschalten.
;------------------------------------------------------------------------------
  D2E8  F6 80 75   LDAB  $8075          ; Temperaturflags
  D2EB  C4 E3      ANDB  #$E3           ; Bits 4, 3, 2 löschen
  D2ED  B1 C6 BE   CMPA  $C6BE          ; G62 über C6BE = 90?
  D2F0  22 02      BHI   loc_D2F4       ; ja — Bit 4 nicht setzen
  D2F2  CA 10      ORAB  #$10           ; Bit 4

