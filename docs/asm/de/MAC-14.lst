;------------------------------------------------------------------------------
; DLS — Leerlaufstabilisierung über den Zündwinkel unter 40 Einh. (≈890 U/min).
; Schwellen AT C6D0 / HS C6D3 = 16 28 30 Einh. (identisch):
;  unter 16 (≈350 U/min) — Startzündwinkel C6CB = 50;
;  30 und darüber — C6D8 = 51;
;  dazwischen, wenn der Motor angesprungen ist ($8029.6) — nach Tabelle C6D6 = 45 45 51
;  (je niedriger die Drehzahl, desto früher die Zündung — der Motor fängt sich);
;  sonst (noch nicht angesprungen) — C6CC = 50 unter 28, C6CD = 48 ab 28.
; Zum Ergebnis wird die Korrektur $800F addiert.
;------------------------------------------------------------------------------
loc_DF0E:
  DF0E  CE C6 D6   LDX   #$C6D6         ; DLS-Tabelle C6D6
  DF11  FF 80 0C   STX   $800C          ; Zeiger
  DF14  CE C6 D0   LDX   #$C6D0         ; Schwellen AT
  DF17  7B 04 17   TIM   #$04,PORT6     ; Codierung: HS?
  DF1A  27 03      BEQ   loc_DF1F       ; nein
  DF1C  CE C6 D3   LDX   #$C6D3         ; Schwellen HS

loc_DF1F:
  DF1F  A1 00      CMPA  $00,X          ; unter 16?
  DF21  24 05      BCC   loc_DF28       ; nein
  DF23  B6 C6 CB   LDAA  $C6CB          ; Startzündwinkel 50
  DF26  20 1C      BRA   loc_DF44       ; weiter

loc_DF28:
  DF28  A1 02      CMPA  $02,X          ; 30 und darüber?
  DF2A  25 05      BCS   loc_DF31       ; nein
  DF2C  B6 C6 D8   LDAA  $C6D8          ; 51
  DF2F  20 13      BRA   loc_DF44       ; weiter

loc_DF31:
