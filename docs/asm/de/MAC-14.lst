;------------------------------------------------------------------------------
; Werkspatch: zwei weitere G71-Prüfungen (Bit 1 in $8091).
; 1) Vollast (F81), Drehzahl nicht unter C846 = 80 Einh. (≈1780 U/min),
;   und der Druck weicht weniger als 13 vom Luftdruck ab, 30 Aufrufe
;   hintereinander (3 s, C848): Bit 1.
; 2) Pumpe freigegeben, N75 aktiv ($8067/$8068 nicht null), Drehzahl ≥ 80 Einh.,
;   und der Druck ist innerhalb 100 ms um 25 oder mehr gefallen (C847; $806D ist der Druck beim
;   vorigen Aufruf): merken ($806E.0). Bleibt der Druck danach 6 Aufrufe
;   hintereinander (C849) beim Luftdruck: Bit 1. Sieht nach einem abgerutschten
;   Ladedruckschlauch aus [Vermutung].
;------------------------------------------------------------------------------
loc_F760:
  F760  BD D2 15   JSR   RD_INPUTS      ; digitale Eingänge
  F763  85 10      BITA  #$10           ; Bit 4 ist F81
  F765  27 1E      BEQ   loc_F785       ; offen? ja: Zähler 1 auf null
  F767  A6 18      LDAA  $18,X          ; Drehzahl
  F769  B1 C8 46   CMPA  $C846          ; unter C846 = 80 Einh.?
  F76C  25 17      BCS   loc_F785       ; ja: Zähler 1 auf null
  F76E  A6 19      LDAA  $19,X          ; Druck
  F770  A0 04      SUBA  $04,X          ; minus Luftdruck
  F772  24 01      BCC   loc_F775       ; Differenz positiv? ja: weiter
  F774  40         NEGA                 ; Betrag

loc_F775:
  F775  B1 C7 A0   CMPA  $C7A0          ; nicht kleiner als 13?
  F778  24 0B      BCC   loc_F785       ; ja: Druck hat sich bewegt, Zähler auf null
  F77A  6C 62      INC   $62,X          ; Zähler 1 ($8062) + 1
  F77C  A6 62      LDAA  $62,X          ; Wert
  F77E  B1 C8 48   CMPA  $C848          ; kleiner als C848 = 30 (3 s)?
  F781  25 04      BCS   loc_F787       ; ja: warten
  F783  CA 02      ORAB  #$02           ; Bit 1: kein Ladedruck bei Vollast

loc_F785:
  F785  6F 62      CLR   $62,X          ; Zähler 1 = 0

loc_F787:
  F787  01         NOP                  ; leer (Füllbefehl)
  F788  01         NOP                  ; leer
  F789  01         NOP                  ; leer
  F78A  7B 40 17   TIM   #$40,PORT6     ; Kraftstoffpumpe freigegeben (PORT6.6)?
  F78D  27 3D      BEQ   loc_F7CC       ; nein: zurücksetzen
  F78F  A6 67      LDAA  $67,X          ; Ansteuerung N75, Byte 1
  F791  26 04      BNE   loc_F797       ; nicht null? ja: prüfen
  F793  A6 68      LDAA  $68,X          ; Byte 2
  F795  27 35      BEQ   loc_F7CC       ; null? ja: zurücksetzen

loc_F797:
  F797  A6 18      LDAA  $18,X          ; Drehzahl
  F799  B1 C8 46   CMPA  $C846          ; unter 80 Einh.?
  F79C  25 2E      BCS   loc_F7CC       ; ja: zurücksetzen
  F79E  A6 6D      LDAA  $6D,X          ; Druck beim vorigen Aufruf
  F7A0  A0 19      SUBA  $19,X          ; minus aktueller (Abfall innerhalb 100 ms)
  F7A2  25 0A      BCS   loc_F7AE       ; Druck gestiegen? ja: Kennzeichen ansehen
  F7A4  B1 C8 47   CMPA  $C847          ; Differenz kleiner als C847 = 25?
  F7A7  25 05      BCS   loc_F7AE       ; ja: Kennzeichen ansehen
  F7A9  62 01 6E   OIM   #$01,$6E,X     ; merken: Druck stark gefallen
  F7AC  20 23      BRA   loc_F7D1       ; Flags speichern

loc_F7AE:
  F7AE  6B 01 6E   TIM   #$01,$6E,X     ; Kennzeichen $806E.0 gesetzt?
  F7B1  27 1C      BEQ   loc_F7CF       ; nein: Zähler 2 auf null
  F7B3  A6 19      LDAA  $19,X          ; Druck
  F7B5  A0 04      SUBA  $04,X          ; minus Luftdruck
  F7B7  24 01      BCC   loc_F7BA       ; Differenz positiv? ja: weiter
  F7B9  40         NEGA                 ; Betrag

loc_F7BA:
  F7BA  B1 C7 A0   CMPA  $C7A0          ; nicht kleiner als 13?
  F7BD  24 0D      BCC   loc_F7CC       ; ja: Kennzeichen löschen
  F7BF  6C 90      INC   $90,X          ; Zähler 2 ($8090) + 1
  F7C1  A6 90      LDAA  $90,X          ; Wert
  F7C3  B1 C8 49   CMPA  $C849          ; kleiner als C849 = 6?
  F7C6  25 09      BCS   loc_F7D1       ; ja: Flags speichern
  F7C8  CA 02      ORAB  #$02           ; Bit 1: kein Ladedruck bei aktivem N75
  F7CA  20 03      BRA   loc_F7CF       ; weiter

loc_F7CC:
  F7CC  61 FE 6E   AIM   #$FE,$6E,X     ; Kennzeichen löschen

loc_F7CF:
