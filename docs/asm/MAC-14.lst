  E20C  CE C6 E0   LDX   #$C6E0         ; ось оборотов C6E0
  E20F  B6 80 18   LDAA  $8018          ; обороты
  E212  C6 04      LDAB  #$04           ; 4 точки
  E214  BD CA 5F   JSR   AXIS_UP        ; найти точку
  E217  CE C6 E4   LDX   #$C6E4         ; порог C6E4
  E21A  3A         ABX                  ; X -> порог
  E21B  A6 00      LDAA  $00,X          ; порог
  E21D  B1 80 86   CMPA  $8086          ; дошёл старший байт счётчика до порога?
  E220  22 1C      BHI   loc_E23E       ; нет — ждать
