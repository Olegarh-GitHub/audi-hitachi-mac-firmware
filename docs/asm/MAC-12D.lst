  EAF3  A6 00      LDAA  $00,X          ; значение
  EAF5  DF 4A      STX   $4A            ; сохранить X
  EAF7  38         PULX                 ; делители
  EAF8  E6 00      LDAB  $00,X          ; делитель
  EAFA  08         INX                  ; следующий
  EAFB  3C         PSHX                 ; сохранить
  EAFC  DE 4A      LDX   $4A            ; счётчик
  EAFE  84 3F      ANDA  #$3F           ; счёт (без битов 7, 6)
  EB00  10         SBA                  ; дошёл до делителя?
  EB01  26 07      BNE   loc_EB0A       ; нет
  EB03  A6 00      LDAA  $00,X          ; счётчик
  EB05  8A 40      ORAA  #$40           ; + готова
  EB07  10         SBA                  ; - делитель
