  EDE4  FA 80 28   ORAB  $8028          ; Bits setzen

loc_EDE7:
  EDE7  F7 80 28   STAB  $8028          ; $8028 schreiben

loc_EDEA:
  EDEA  39         RTS                  ; Rücksprung

;------------------------------------------------------------------------------
; OVER_CNT: Zähler B: + 1, wenn der Druck über A (der Grenze) liegt, sonst 0.
; Läuft nicht über (bleibt bei 255).
