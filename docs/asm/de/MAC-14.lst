;------------------------------------------------------------------------------
; FRAC_UP: Anteil zwischen zwei Punkten einer steigenden Achse.
; Eingang: A = Wert, X -> linker Achsenpunkt (Ergebnis von AXIS_UP).
; Ausgang: B = (A - Achse[i]) * 256 / (Achse[i+1] - Achse[i]), also 0...255.
;------------------------------------------------------------------------------
FRAC_UP:                                ; aufgerufen von: TASK1, TASK2, TASK3
  CA05  5F         CLRB                 ; B = 0 für den Fall eines exakten Treffers
  CA06  A0 00      SUBA  $00,X          ; A = Wert minus linker Punkt
  CA08  27 36      BEQ   loc_CA40       ; genau auf dem Punkt? ja: Anteil 0
  CA0A  E6 01      LDAB  $01,X          ; B = Intervallbreite
  CA0C  E0 00      SUBB  $00,X
  CA0E  20 0B      BRA   DIV8           ; dividieren

;------------------------------------------------------------------------------
; FRAC_DN: dasselbe für eine fallende Achse (Achse[i] > Achse[i+1]).
;------------------------------------------------------------------------------
FRAC_DN:                                ; aufgerufen von: TASK0, TASK1, TASK2, TASK3
  CA10  5F         CLRB                 ; B = 0 für den Fall eines exakten Treffers
  CA11  A0 00      SUBA  $00,X          ; A = linker Punkt minus Wert
  CA13  40         NEGA
  CA14  27 2A      BEQ   loc_CA40       ; genau auf dem Punkt? ja: Anteil 0
  CA16  E6 01      LDAB  $01,X          ; B = Intervallbreite (positiv)
  CA18  E0 00      SUBB  $00,X
  CA1A  50         NEGB

;------------------------------------------------------------------------------
; DIV8: Anteilsdivision: B = A * 256 / B. Bedingung: A < B.
; Gewöhnliche schriftliche Division, 8 Schritte. Die Quotientenbits werden
; invertiert gesammelt und am Ende umgedreht (COMB).
;------------------------------------------------------------------------------
DIV8:                                   ; aufgerufen von: TASK0, TASK1, TASK2, TASK3
  CA1B  37         PSHB                 ; Divisor auf den Stack
  CA1C  36         PSHA                 ; Dividend auf den Stack
  CA1D  34         DES                  ; Platz für den Schrittzähler
  CA1E  30         TSX
  CA1F  86 08      LDAA  #$08           ; 8 Schritte
  CA21  A7 00      STAA  $00,X          ; Zähler
  CA23  A6 01      LDAA  $01,X          ; A = Dividend (Rest)
  CA25  C6 FF      LDAB  #$FF           ; Quotient: Anfangswert FF (Bits invertiert)
  CA27  E7 01      STAB  $01,X          ; speichern
  CA29  5F         CLRB                 ; B ist der höherwertige Teil des Rests

loc_CA2A:
  CA2A  48         ASLA                 ; Rest nach links schieben
  CA2B  59         ROLB                 ; Übertrag nach B
  CA2C  A0 02      SUBA  $02,X          ; Divisor subtrahieren
  CA2E  C2 00      SBCB  #$00           ; Borgen berücksichtigen
  CA30  24 04      BCC   loc_CA36       ; nicht negativ? ja: Quotientenbit 1 (hier wird 0 geschrieben, da invertiert)
  CA32  AB 02      ADDA  $02,X          ; negativ geworden: Divisor wieder addieren
  CA34  C9 00      ADCB  #$00           ; Übertrag = 1 (Quotientenbit 0, invertiert geschrieben)

loc_CA36:
  CA36  69 01      ROL   $01,X          ; Quotientenbit ins Ergebnis
  CA38  6A 00      DEC   $00,X          ; nächster Schritt
  CA3A  26 EE      BNE   loc_CA2A       ; Schritte übrig? ja: wiederholen
  CA3C  32         PULA                 ; Zähler entfernen
  CA3D  33         PULB                 ; B = invertierter Quotient
  CA3E  31         INS                  ; Divisor entfernen
  CA3F  53         COMB                 ; B = Quotient (Anteil 0...255)

loc_CA40:
  CA40  39         RTS                  ; Rücksprung

;------------------------------------------------------------------------------
; INTERP: lineare Interpolation zwischen zwei benachbarten Tabellenwerten.
; Eingang: X -> Tabelle[i], B = Anteil (0...255).
; Ausgang: A = T[i] + (T[i+1] - T[i]) * Anteil / 256, gerundet.
;------------------------------------------------------------------------------
INTERP:                                 ; aufgerufen von: TASK0, TASK1, TASK2, TASK3
  CA41  A6 00      LDAA  $00,X          ; T[i]
  CA43  36         PSHA                 ; auf den Stack
  CA44  A6 01      LDAA  $01,X          ; T[i+1]
  CA46  36         PSHA                 ; auf den Stack
  CA47  30         TSX                  ; X -> T[i+1] auf dem Stack, danach T[i]
  CA48  A6 00      LDAA  $00,X          ; A = T[i+1]; an seine Stelle kommt das Vorzeichen
  CA4A  6F 00      CLR   $00,X          ; Vorzeichen = 0 (steigend)
  CA4C  A0 01      SUBA  $01,X          ; A = T[i+1] - T[i]
  CA4E  24 03      BCC   loc_CA53       ; Tabelle steigend? ja: Differenz ist bereits positiv
  CA50  40         NEGA                 ; fallend: Betrag der Differenz
  CA51  63 00      COM   $00,X          ; Vorzeichen = FF (fallend)

loc_CA53:
  CA53  3D         MUL                  ; Differenz * Anteil
  CA54  58         ASLB                 ; Rundung: oberstes Bit des niederwertigen Bytes
  CA55  89 00      ADCA  #$00           ; dazuaddieren
  CA57  33         PULB                 ; B = Vorzeichen
  CA58  5D         TSTB                 ; Tabelle steigend?
  CA59  27 01      BEQ   loc_CA5C       ; ja: addieren
  CA5B  40         NEGA                 ; nein: subtrahieren

loc_CA5C:
  CA5C  33         PULB                 ; B = T[i]
  CA5D  1B         ABA                  ; A = T[i] + Korrektur
  CA5E  39         RTS                  ; Rücksprung

;------------------------------------------------------------------------------
; AXIS_UP: Intervall auf einer steigenden Achse suchen.
; Eingang: A = Wert, X -> Achse, B = Anzahl der Punkte.
; Ausgang: X -> linker Punkt des Intervalls, B = seine Nummer, A = Wert.
; Unter dem ersten Punkt: Nummer 0 und A = erster Punkt (Anteil wird 0).
; Über dem letzten: letzter Punkt und A = sein Wert.
;------------------------------------------------------------------------------
AXIS_UP:                                ; aufgerufen von: TASK0, TASK1, TASK2, TASK3
  CA5F  36         PSHA                 ; Wert sichern
  CA60  37         PSHB                 ; Anzahl der Punkte sichern

loc_CA61:
  CA61  A1 00      CMPA  $00,X          ; Wert kleiner als dieser Punkt?
  CA63  25 17      BCS   loc_CA7C       ; ja: Intervall gefunden
  CA65  08         INX                  ; nächster Punkt
  CA66  5A         DECB                 ; noch Punkte übrig?
  CA67  27 0C      BEQ   loc_CA75       ; nein: über das Achsenende hinaus
  CA69  20 F6      BRA   loc_CA61       ; zum nächsten

;------------------------------------------------------------------------------
; AXIS_DN: dasselbe für eine fallende Achse (zum Beispiel Temperatur vom A/D-Wandler:
; je kälter, desto größer die Zahl).
;------------------------------------------------------------------------------
AXIS_DN:                                ; aufgerufen von: TASK0, TASK1, TASK2, TASK3
  CA6B  36         PSHA                 ; Wert sichern
  CA6C  37         PSHB                 ; Anzahl der Punkte sichern

loc_CA6D:
  CA6D  A1 00      CMPA  $00,X          ; Wert größer als dieser Punkt?
  CA6F  22 0B      BHI   loc_CA7C       ; ja: Intervall gefunden
  CA71  08         INX                  ; nächster Punkt
  CA72  5A         DECB                 ; noch Punkte übrig?
  CA73  26 F8      BNE   loc_CA6D       ; ja: weiter

loc_CA75:
  CA75  33         PULB                 ; über das Ende hinaus: B = Anzahl der Punkte
  CA76  32         PULA                 ; A = Wert
  CA77  5A         DECB                 ; Nummer des letzten Punkts
  CA78  09         DEX                  ; X -> letzter Punkt

loc_CA79:
  CA79  A6 00      LDAA  $00,X          ; A = Punktwert (Anteil wird 0)
  CA7B  39         RTS                  ; Rücksprung

loc_CA7C:
  CA7C  32         PULA                 ; A = Anzahl der Punkte
  CA7D  10         SBA                  ; A = Nummer des gefundenen Punkts
  CA7E  16         TAB                  ; nach B
  CA7F  27 04      BEQ   loc_CA85       ; ist das der erste Punkt (Wert vor dem Achsenanfang)?
  CA81  5A         DECB                 ; nein: linker Punkt = vorheriger
  CA82  09         DEX                  ; X -> linker Punkt
  CA83  32         PULA                 ; A = Wert
  CA84  39         RTS                  ; Rücksprung

loc_CA85:
  CA85  32         PULA                 ; Wert entfernen; A = erster Punkt
  CA86  20 F1      BRA   loc_CA79       ; zum gemeinsamen Ausgang

;------------------------------------------------------------------------------
; RESET. Stack $8290. Ein vollständiger Reset prüft das RAM ab $8000; ein Neustart nach
; Motorstillstand (D12A) ab $8005, um die Codes ($8000-$8002) und den
; Luftdruck ($8004) zu erhalten.
; Prozessorregister: RMCR = $06 (SCI-Geschwindigkeit [?]), RP5CR = $C1 (internes RAM,
; IRQ1), TRCSR1 = $1A (Empfang, Senden, Empfangsinterrupt), TCSR1 = $18 (Interrupts
; Capture und Compare 1 [Vermutung]), TCSR2 = $09 (Ausgang OC1 = N7 [Vermutung]), PORT2 = $20,
; PORT6 = $20 (N17 geschlossen, Pumpe aus), P2DDR = $02 (P21-P27 Ausgänge),
; P6DDR = $F9 (P62, P61 sind Eingänge: Codierung, Hall).
;------------------------------------------------------------------------------
RESET:                                  ; aufgerufen von: IRQ1, RES, SWI, TRAP
  CA88  8E 82 90   LDS   #$8290         ; Stack
  CA8B  CE 80 00   LDX   #$8000         ; RAM-Prüfung ab $8000

loc_CA8E:
  CA8E  86 06      LDAA  #$06           ; RMCR
  CA90  97 10      STAA  RMCR           ; SCI-Geschwindigkeit
  CA92  86 C1      LDAA  #$C1           ; RP5CR = $C1
  CA94  D6 14      LDAB  RP5CR          ; alter Wert (Bit 7 = RAM-Versorgung blieb erhalten)
  CA96  97 14      STAA  RP5CR          ; speichern
  CA98  86 1A      LDAA  #$1A           ; SCI: Empfang, Senden, Empfangsinterrupt
  CA9A  97 11      STAA  TRCSR1         ; speichern
  CA9C  86 18      LDAA  #$18           ; Timer 1
  CA9E  97 08      STAA  TCSR1          ; speichern
  CAA0  86 09      LDAA  #$09           ; Timer 1, Teil 2
  CAA2  97 0F      STAA  TCSR2          ; speichern
  CAA4  86 20      LDAA  #$20           ; PORT2.5 = 1
  CAA6  97 03      STAA  PORT2          ; speichern
  CAA8  86 20      LDAA  #$20           ; PORT6.5 = 1 (N17 geschlossen), PORT6.6 = 0 (Pumpe aus)
  CAAA  97 17      STAA  PORT6          ; speichern
  CAAC  86 02      LDAA  #$02           ; P21-P27 sind Ausgänge
  CAAE  97 01      STAA  P2DDR          ; speichern
  CAB0  86 F9      LDAA  #$F9           ; P60, P63-P67 sind Ausgänge
  CAB2  97 16      STAA  P6DDR          ; speichern
  CAB4  3C         PSHX                 ; Beginn der RAM-Prüfung
  CAB5  37         PSHB                 ; alter RP5CR
  CAB6  CE CB 91   LDX   #$CB91         ; Chip-Einrichtungstabelle CB91 (Paare Nummer/Wert)

loc_CAB9:
  CAB9  EC 00      LDD   $00,X          ; Paar
  CABB  FD 01 00   STD   $0100          ; in den Chip schreiben
  CABE  08         INX                  ; nächstes
  CABF  08         INX                  ; (+2)
  CAC0  8C CB B1   CPX   #$CBB1         ; alle 16?
  CAC3  26 F4      BNE   loc_CAB9       ; nein
  CAC5  33         PULB                 ; alter RP5CR
  CAC6  5D         TSTB                 ; Versorgung des internen RAM erhalten?
  CAC7  2A 43      BPL   loc_CB0C       ; nein - Fehlerkopie unzuverlässig
  CAC9  CE 00 41   LDX   #$0041         ; Fehlerkopie
  CACC  4F         CLRA                 ; Prüfsumme = 0

loc_CACD:
  CACD  AB 00      ADDA  $00,X          ; + Byte
  CACF  08         INX                  ; nächstes
  CAD0  8C 00 46   CPX   #$0046         ; bis $45
  CAD3  26 F8      BNE   loc_CACD       ; wiederholen
  CAD5  91 40      CMPA  $40            ; Prüfsumme stimmt?
  CAD7  26 33      BNE   loc_CB0C       ; nein
  CAD9  38         PULX                 ; Anfang
  CADA  CC 55 AA   LDD   #$55AA         ; Muster $55 und $AA

loc_CADD:
  CADD  A7 00      STAA  $00,X          ; $55 schreiben
  CADF  A1 00      CMPA  $00,X          ; zurückgelesen?
  CAE1  26 4B      BNE   loc_CB2E       ; nein - RAM defekt
  CAE3  E7 00      STAB  $00,X          ; $AA schreiben
  CAE5  E1 00      CMPB  $00,X          ; zurückgelesen?
  CAE7  26 45      BNE   loc_CB2E       ; nein - RAM defekt
  CAE9  6F 00      CLR   $00,X          ; löschen
  CAEB  08         INX                  ; nächstes
  CAEC  8C 82 91   CPX   #$8291         ; bis $8290
  CAEF  25 EC      BCS   loc_CADD       ; wiederholen
  CAF1  96 41      LDAA  $41            ; Codes aus der Kopie zurückholen
  CAF3  B7 80 00   STAA  $8000          ; (ebenso)
  CAF6  96 42      LDAA  $42            ; (ebenso)
  CAF8  B7 80 01   STAA  $8001          ; (ebenso)
  CAFB  96 43      LDAA  $43            ; (ebenso)
  CAFD  B7 80 02   STAA  $8002          ; (ebenso)
  CB00  96 44      LDAA  $44            ; Startzähler
  CB02  B7 80 2B   STAA  $802B          ; (ebenso)
  CB05  96 45      LDAA  $45            ; $802C
  CB07  B7 80 2C   STAA  $802C          ; (ebenso)
  CB0A  20 1D      BRA   loc_CB29       ; internes RAM prüfen

loc_CB0C:
  CB0C  38         PULX                 ; Anfang
  CB0D  CC 55 AA   LDD   #$55AA         ; Muster

loc_CB10:
  CB10  A7 00      STAA  $00,X          ; $55 schreiben
  CB12  A1 00      CMPA  $00,X          ; zurückgelesen?
  CB14  26 18      BNE   loc_CB2E       ; nein - defekt
  CB16  E7 00      STAB  $00,X          ; $AA schreiben
  CB18  E1 00      CMPB  $00,X          ; zurückgelesen?
  CB1A  26 12      BNE   loc_CB2E       ; nein - defekt
  CB1C  6F 00      CLR   $00,X          ; löschen
  CB1E  08         INX                  ; nächstes
  CB1F  8C 01 00   CPX   #$0100         ; Ende des internen RAM ($0100)?
  CB22  27 0F      BEQ   loc_CB33       ; ja - fertig
  CB24  8C 82 91   CPX   #$8291         ; Ende des externen RAM?
  CB27  25 E7      BCS   loc_CB10       ; nein

loc_CB29:
  CB29  CE 00 40   LDX   #$0040         ; weiter mit internem $40-$FF
  CB2C  20 E2      BRA   loc_CB10       ; prüfen

loc_CB2E:
  CB2E  86 80      LDAA  #$80           ; RAM defekt: Steuergerätefehler (1111)
  CB30  B7 80 95   STAA  $8095          ; speichern

loc_CB33:
  CB33  71 BF 14   AIM   #$BF,RP5CR     ; internes RAM ausschalten
  CB36  86 A8      LDAA  #$A8           ; Betriebsart: Start ($A8)
  CB38  B7 80 29   STAA  $8029          ; speichern
  CB3B  B6 C6 CB   LDAA  $C6CB          ; Startwinkel 50
  CB3E  C6 C0      LDAB  #$C0           ; × 0,75
  CB40  3D         MUL                  ; (ebenso)
  CB41  58         ASLB                 ; runden
  CB42  89 00      ADCA  #$00           ; (ebenso)
  CB44  B7 80 23   STAA  $8023          ; ausgegebener Winkel
  CB47  86 FF      LDAA  #$FF           ; K-Leitungs-Timeout läuft nicht
  CB49  B7 80 FD   STAA  $80FD          ; speichern
  CB4C  86 6C      LDAA  #$6C           ; Winkelgrenze 108
  CB4E  B7 80 8E   STAA  $808E          ; speichern
  CB51  86 08      LDAA  #$08           ; Verstärkung 8
  CB53  B7 08 00   STAA  $0800          ; Verstärker-Latch
  CB56  CC 5F 00   LDD   #$5F00         ; Mitte
  CB59  FD 80 59   STD   $8059          ; Lambda-Integrator
  CB5C  CE 01 00   LDX   #$0100         ; Chip
  CB5F  86 1F      LDAA  #$1F           ; Statusregister $1F
  CB61  A7 00      STAA  $00,X          ; auswählen

loc_CB63:
  CB63  E6 01      LDAB  $01,X          ; Status
  CB65  C5 20      BITB  #$20           ; Chip bereit (Bit 5)?
  CB67  27 FA      BEQ   loc_CB63       ; nein - warten
  CB69  CC 1D A0   LDD   #$1DA0         ; Ereignismaske: Zylinder und Tick
  CB6C  F7 80 05   STAB  $8005          ; lokal
  CB6F  ED 00      STD   $00,X          ; speichern
  CB71  CC 1C 25   LDD   #$1C25         ; Chip-Betriebsart $25 (Synchronisationssuche)
  CB74  ED 00      STD   $00,X          ; speichern
  CB76  CC 1E FF   LDD   #$1EFF         ; alle Ereignisse löschen
  CB79  ED 00      STD   $00,X          ; speichern
  CB7B  0E         CLI                  ; Interrupts freigeben

;------------------------------------------------------------------------------
; HINTERGRUNDSCHLEIFE: die gesamte von Interrupts freie Zeit dient der ROM-Prüfsumme.
; Die Summe aller Bytes $C000-$FFFF (8 Bit) muss 0 sein, sonst Steuergerätefehler 1111
; ($8095.6). Jede Änderung der Software muss diese Summe erhalten.
;------------------------------------------------------------------------------
BG_LOOP:
  CB7C  CE C0 00   LDX   #$C000         ; ROM-Anfang
  CB7F  4F         CLRA                 ; Prüfsumme = 0

loc_CB80:
  CB80  AB 00      ADDA  $00,X          ; + Byte
  CB82  08         INX                  ; nächstes
  CB83  26 FB      BNE   loc_CB80       ; bis $FFFF
  CB85  4D         TSTA                 ; Prüfsumme 0?
  CB86  27 F4      BEQ   BG_LOOP        ; ja - von vorn
  CB88  CE 80 00   LDX   #$8000         ; X = $8000
  CB8B  62 40 95   OIM   #$40,$95,X     ; ROM-Fehler (1111)
  CB8E  20 EC      BRA   BG_LOOP        ; von vorn

; Tabelle $CB90, 1 Bytes: Byte $0A ohne Verweise, vermutlich Ausgleich der ROM-Prüfsumme auf 0 [Vermutung]
  CB90  db 0A

; Tabelle $CB91, 32 Bytes: Chip-Einrichtung $0100 (Nummer, Wert): 00 FF, 01 6C (108 Halbzähne = 144°), 02 2D, 03 1B, 05 00, 06 05, 07 06, 08 03, 09 FF, 0A FF, 0B 00, 0C 33, 0D 76, 18 04, 19 00, 1F 00
  CB91  db 00 FF 01 6C 02 2D 03 1B 05 00 06 05 07 06 08 03
  CBA1  db 09 FF 0A FF 0B 00 0C 33 0D 76 18 04 19 00 1F 00

;------------------------------------------------------------------------------
; IRQ1 — INTERRUPT VOM BAUSTEIN $0100. Register $1E des Bausteins zeigt, welche Ereignisse
; eingetroffen sind (mit Maske $8005). Zurückschreiben des Bits in $1E löscht das Ereignis.
;  Bit 7 — Zylinderereignis (alle 144° Kurbelwelle): Synchronisation, Zündfunke (CC83);
;  Bit 6 — Klopffenster: Öffnen/Schließen, Messung (CBDB);
;  Bit 2 — Beginn der Schließzeit der Zündspule (CC74);
;  Bit 5 — Tick (≈10 ms) -> D0E3 und Task-Dispatcher.
;  Bit 1 (innerhalb des Zylinderereignisses) — Bezugsmarke G4.
;------------------------------------------------------------------------------
IRQ1:                                   ; aufgerufen von: IRQ1
  CBB1  CE 01 00   LDX   #$0100         ; X -> Baustein
  CBB4  86 1E      LDAA  #$1E           ; Ereignisregister $1E
  CBB6  A7 00      STAA  $00,X          ; auswählen
  CBB8  E6 01      LDAB  $01,X          ; Ereignisse
  CBBA  F4 80 05   ANDB  $8005          ; nur freigegebene ($8005)
  CBBD  5D         TSTB                 ; Zylinderereignis (Bit 7)?
  CBBE  2A 03      BPL   loc_CBC3       ; nein
  CBC0  7E CC 83   JMP   loc_CC83       ; ja — Zylinder

loc_CBC3:
  CBC3  C5 40      BITB  #$40           ; Klopffenster?
  CBC5  26 14      BNE   loc_CBDB       ; ja
  CBC7  C5 04      BITB  #$04           ; Schließzeit Zündspule?
  CBC9  27 03      BEQ   loc_CBCE       ; nein
  CBCB  7E CC 74   JMP   loc_CC74       ; ja

loc_CBCE:
  CBCE  C5 20      BITB  #$20           ; Tick?
  CBD0  26 01      BNE   loc_CBD3       ; ja
  CBD2  3B         RTI                  ; nichts — verlassen

loc_CBD3:
  CBD3  C6 20      LDAB  #$20           ; Tick-Ereignis löschen
  CBD5  E7 01      STAB  $01,X          ; schreiben
  CBD7  0E         CLI                  ; verschachtelte Interrupts zulassen
  CBD8  7E D0 E3   JMP   loc_D0E3       ; Tick-Verarbeitung

;------------------------------------------------------------------------------
; KLOPFFENSTER. Zwei Durchgänge: Öffnen des Fensters ($80B5.7 = 1) und Schließen.
; Schließen: PORT6.0 = 0, Fensterende = Beginn + $80B8, PORT6.3 = 0 (Drehzahlmesserimpuls,
; Pin 7 [Vermutung]). Öffnen: Start ADC-Kanal 6 (Integrator), Messwert = $80EC - Ergebnis
; -> Zylinderdatensatz +2, neuer Messwert (+0 Bit 7), Verstärkung des nächsten Zylinders in
; Latch $0800 (Bit 4 — Sensor G66, nach Tabelle C910). Der Tester kann mit Befehl $1B
; einen eigenen Latch-Wert vorgeben ($8205).
;------------------------------------------------------------------------------
loc_CBDB:
  CBDB  C6 40      LDAB  #$40           ; Ereignis löschen
  CBDD  E7 01      STAB  $01,X          ; schreiben
  CBDF  B6 80 B5   LDAA  $80B5          ; Fensterphase
  CBE2  85 80      BITA  #$80           ; Fenster offen?
  CBE4  27 1C      BEQ   loc_CC02       ; nein — öffnen
  CBE6  71 FE 17   AIM   #$FE,PORT6     ; PORT6.0 = 0 (Integrator stoppen [Vermutung])
  CBE9  84 7F      ANDA  #$7F           ; Phase: geschlossen
  CBEB  B7 80 B5   STAA  $80B5          ; schreiben
  CBEE  86 00      LDAA  #$00           ; Register $00 — Zeitpunkt des nächsten Fensterereignisses
  CBF0  F6 80 B8   LDAB  $80B8          ; Fensterbeginn
  CBF3  FB 80 B9   ADDB  $80B9          ; + Fensterlänge
  CBF6  ED 00      STD   $00,X          ; schreiben
  CBF8  B6 80 96   LDAA  $8096          ; Zylinder
  CBFB  B7 80 BC   STAA  $80BC          ; merken, zu wem die Messung gehört
  CBFE  71 F7 17   AIM   #$F7,PORT6     ; PORT6.3 = 0: Drehzahlmesser (Pin 7) [Vermutung]
  CC01  3B         RTI                  ; verlassen

loc_CC02:
  CC02  CE 14 06   LDX   #$1406         ; ADC-Kanal 6
  CC05  FF 01 00   STX   $0100          ; Start
  CC08  7F 80 2A   CLR   $802A          ; ADC durch Interrupt belegt (Task 0 wiederholt ihre Wandlung)
  CC0B  F6 80 BC   LDAB  $80BC          ; gemessener Zylinder
  CC0E  58         ASLB                 ; × 8
  CC0F  58         ASLB                 ; (dasselbe)
  CC10  58         ASLB                 ; (dasselbe)
  CC11  CE 80 C0   LDX   #$80C0         ; Zylinderdatensätze
  CC14  3A         ABX                  ; X -> Datensatz
  CC15  E6 07      LDAB  $07,X          ; neue Verstärkung
  CC17  E7 01      STAB  $01,X          ; wurde aktuell
  CC19  62 80 00   OIM   #$80,$00,X     ; neuer Messwert bereit
  CC1C  3C         PSHX                 ; X sichern
  CC1D  CE 01 00   LDX   #$0100         ; X -> Baustein
  CC20  86 00      LDAA  #$00           ; Register $00
  CC22  F6 80 B7   LDAB  $80B7          ; Fensterbeginn $80B7
  CC25  F7 80 B9   STAB  $80B9          ; merken
  CC28  ED 00      STD   $00,X          ; schreiben
  CC2A  86 14      LDAA  #$14           ; ADC-Ergebnisregister
  CC2C  A7 00      STAA  $00,X          ; auswählen
  CC2E  B6 80 EC   LDAA  $80EC          ; Referenz (Messung am Zylinderbeginn)
  CC31  B0 01 01   SUBA  $0101          ; - Ergebnis = Messwert
  CC34  72 01 17   OIM   #$01,PORT6     ; PORT6.0 = 1
  CC37  24 01      BCC   loc_CC3A       ; nicht kleiner null
  CC39  4F         CLRA                 ; 0

loc_CC3A:
  CC3A  38         PULX                 ; X zurückholen
  CC3B  A7 02      STAA  $02,X          ; +2 = Messwert
  CC3D  86 80      LDAA  #$80           ; Phase: offen
  CC3F  BA 80 B5   ORAA  $80B5          ; setzen
  CC42  B7 80 B5   STAA  $80B5          ; schreiben
  CC45  F6 80 BC   LDAB  $80BC          ; Zylinder
  CC48  5C         INCB                 ; nächster
  CC49  C1 05      CMPB  #$05           ; 5?
  CC4B  25 01      BCS   loc_CC4E       ; nein
  CC4D  5F         CLRB                 ; 0

loc_CC4E:
  CC4E  58         ASLB                 ; × 8
  CC4F  58         ASLB                 ; (dasselbe)
  CC50  58         ASLB                 ; (dasselbe)
  CC51  CE 80 C0   LDX   #$80C0         ; Datensätze
  CC54  3A         ABX                  ; X -> Datensatz des nächsten Zylinders
  CC55  A6 07      LDAA  $07,X          ; dessen Verstärkung
  CC57  F6 80 F7   LDAB  $80F7          ; Testermodus $1B?
  CC5A  C5 01      BITB  #$01           ; prüfen
  CC5C  27 03      BEQ   loc_CC61       ; nein
  CC5E  B6 82 05   LDAA  $8205          ; Wert vom Tester

loc_CC61:
  CC61  84 EF      ANDA  #$EF           ; Bit 4 löschen
  CC63  CE C9 10   LDX   #$C910         ; Sensortabelle C910
  CC66  F6 80 BC   LDAB  $80BC          ; Zylinder
  CC69  3A         ABX                  ; X -> Wert
  CC6A  E6 00      LDAB  $00,X          ; Sensor
  CC6C  27 02      BEQ   loc_CC70       ; G61 — Bit 4 = 0
  CC6E  8A 10      ORAA  #$10           ; G66 — Bit 4 = 1

loc_CC70:
  CC70  B7 08 00   STAA  $0800          ; Verstärker-Latch $0800
  CC73  3B         RTI                  ; verlassen

;------------------------------------------------------------------------------
; Beginn der Schließzeit: Register $03 = $8024 + $8056 (Korrektur für den Unterschied der
; Spätverstellung benachbarter Zylinder, damit die Schließzeit gleich bleibt).
;------------------------------------------------------------------------------
loc_CC74:
  CC74  C6 04      LDAB  #$04           ; Ereignis löschen
  CC76  E7 01      STAB  $01,X          ; schreiben
  CC78  86 03      LDAA  #$03           ; Register $03
  CC7A  F6 80 24   LDAB  $8024          ; Beginn der Schließzeit
  CC7D  FB 80 56   ADDB  $8056          ; + Korrektur
  CC80  ED 00      STD   $00,X          ; schreiben
  CC82  3B         RTI                  ; verlassen

;------------------------------------------------------------------------------
; ZYLINDEREREIGNIS. Vor der Synchronisation — Suche: Marke G4 bei niedrigem Hallsignal
; (PORT6.1 = 0) — erster Zylinder im Verdichtungstakt, Synchronisation hergestellt.
; 11 Ereignisse ohne Marke — Fehler G4 (2112). 4 Marken bei hohem Hallsignal — Fehler
; Hallgeber (2113). Nach der Synchronisation — CD9C.
;------------------------------------------------------------------------------
loc_CC83:
  CC83  C6 80      LDAB  #$80           ; Ereignis löschen
  CC85  E7 01      STAB  $01,X          ; schreiben
  CC87  96 17      LDAA  PORT6          ; Port 6 (Hall — Bit 1)
  CC89  C6 20      LDAB  #$20           ; synchronisiert?
  CC8B  F5 80 95   BITB  $8095          ; prüfen
  CC8E  27 03      BEQ   loc_CC93       ; nein
  CC90  7E CD 9C   JMP   loc_CD9C       ; ja

loc_CC93:
  CC93  72 01 17   OIM   #$01,PORT6     ; PORT6.0 = 1
  CC96  C6 02      LDAB  #$02           ; Marke G4?
  CC98  E5 01      BITB  $01,X          ; prüfen
  CC9A  26 1A      BNE   loc_CCB6       ; ja
  CC9C  F6 80 18   LDAB  $8018          ; Drehzahl
  CC9F  C0 01      SUBB  #$01           ; null?
  CCA1  25 35      BCS   loc_CCD8       ; ja — verlassen
  CCA3  7C 80 96   INC   $8096          ; Ereignisse ohne Marke + 1
  CCA6  F6 80 96   LDAB  $8096          ; Wert
  CCA9  C0 0B      SUBB  #$0B           ; 11?
  CCAB  25 2B      BCS   loc_CCD8       ; nein — verlassen
  CCAD  86 30      LDAA  #$30           ; Fehler G4 (2112)
  CCAF  BA 80 94   ORAA  $8094          ; setzen
  CCB2  B7 80 94   STAA  $8094          ; schreiben
  CCB5  3B         RTI                  ; verlassen

loc_CCB6:
  CCB6  E7 01      STAB  $01,X          ; Marke löschen
  CCB8  7F 80 96   CLR   $8096          ; Zylinderzähler = 0
  CCBB  F6 80 18   LDAB  $8018          ; Drehzahl
  CCBE  C0 01      SUBB  #$01           ; null?
  CCC0  25 16      BCS   loc_CCD8       ; ja — verlassen
  CCC2  85 02      BITA  #$02           ; Hallsignal hoch?
  CCC4  27 13      BEQ   loc_CCD9       ; nein — Synchronisation
  CCC6  7C 80 97   INC   $8097          ; Marken bei hohem Hallsignal + 1
  CCC9  F6 80 97   LDAB  $8097          ; Wert
  CCCC  C0 04      SUBB  #$04           ; 4?
  CCCE  25 08      BCS   loc_CCD8       ; nein — verlassen
  CCD0  86 0C      LDAA  #$0C           ; Fehler Hallgeber (2113)
  CCD2  BA 80 94   ORAA  $8094          ; setzen
  CCD5  B7 80 94   STAA  $8094          ; schreiben

loc_CCD8:
  CCD8  3B         RTI                  ; verlassen

loc_CCD9:
  CCD9  86 20      LDAA  #$20           ; SYNCHRONISIERT ($8095.5)
  CCDB  BA 80 95   ORAA  $8095          ; setzen
  CCDE  B7 80 95   STAA  $8095          ; schreiben
  CCE1  86 57      LDAA  #$57           ; Synchronisationsverdacht löschen
  CCE3  B4 80 94   ANDA  $8094          ; löschen
  CCE6  B7 80 94   STAA  $8094          ; schreiben
  CCE9  72 40 17   OIM   #$40,PORT6     ; PORT6.6 = 1: Kraftstoffpumpenrelais J17 einschalten
  CCEC  5F         CLRB                 ; 0
  CCED  F7 80 96   STAB  $8096          ; Zylinder 0
  CCF0  F7 80 97   STAB  $8097          ; Hallzähler 0
  CCF3  BD F7 26   JSR   TEST_EXIT      ; Stellglieddiagnose beenden
  CCF6  CC 1C 27   LDD   #$1C27         ; Baustein: Register $1C = $27 (zylinderweiser Modus)
  CCF9  ED 00      STD   $00,X          ; schreiben
  CCFB  CC 1D E4   LDD   #$1DE4         ; Register $1D = $E4 (Ereignismaske)
  CCFE  F7 80 05   STAB  $8005          ; dieselbe Maske in eigener Kopie
  CD01  ED 00      STD   $00,X          ; schreiben
  CD03  CC 06 32   LDD   #$0632         ; Register $06 = $32 [?]
  CD06  ED 00      STD   $00,X          ; schreiben
  CD08  CC 14 06   LDD   #$1406         ; ADC-Kanal 6
  CD0B  ED 00      STD   $00,X          ; Start
  CD0D  86 00      LDAA  #$00           ; Register $00
  CD0F  F6 80 B7   LDAB  $80B7          ; Fensterbeginn
  CD12  F7 80 B9   STAB  $80B9          ; merken
  CD15  ED 00      STD   $00,X          ; schreiben
  CD17  86 80      LDAA  #$80           ; Fenster offen
  CD19  BA 80 B5   ORAA  $80B5          ; setzen
  CD1C  B7 80 B5   STAA  $80B5          ; schreiben
  CD1F  F6 80 96   LDAB  $8096          ; Zylinder
  CD22  58         ASLB                 ; × 8
  CD23  58         ASLB                 ; (dasselbe)
  CD24  58         ASLB                 ; (dasselbe)
  CD25  CE 80 C0   LDX   #$80C0         ; Datensätze
  CD28  3A         ABX                  ; X -> Datensatz
  CD29  A6 07      LDAA  $07,X          ; Verstärkung
  CD2B  84 EF      ANDA  #$EF           ; Bit 4 löschen
  CD2D  CE C9 10   LDX   #$C910         ; Sensortabelle
  CD30  F6 80 96   LDAB  $8096          ; Zylinder
  CD33  3A         ABX                  ; X -> Wert
  CD34  E6 00      LDAB  $00,X          ; Sensor
  CD36  27 02      BEQ   loc_CD3A       ; G61
  CD38  8A 10      ORAA  #$10           ; G66

loc_CD3A:
  CD3A  B7 08 00   STAA  $0800          ; Verstärker-Latch
  CD3D  86 14      LDAA  #$14           ; ADC-Ergebnisregister
  CD3F  B7 01 00   STAA  $0100          ; auswählen
  CD42  B6 01 01   LDAA  $0101          ; Ergebnis
  CD45  B7 80 EC   STAA  $80EC          ; Messreferenz

;------------------------------------------------------------------------------
; Zählung der Starts ohne neue Fehler (einmal pro Einschalten, bei Synchronisation).
; 50 Starts ($32) ohne Änderung im Fehlerspeicher — automatisches Löschen
; ($8092.1). Wurde der Speicher aus dem internen RAM wiederhergestellt, wird
; in der Kopie ($44) gezählt, mit Korrektur der Prüfsumme ($40).
;------------------------------------------------------------------------------
  CD48  C6 32      LDAB  #$32           ; Schwelle 50
  CD4A  CE 80 00   LDX   #$8000         ; X = $8000
  CD4D  7B 40 14   TIM   #$40,RP5CR     ; internes RAM eingeschaltet?
  CD50  27 03      BEQ   loc_CD55       ; nein
  CD52  62 04 03   OIM   #$04,$03,X     ; $8003.2 markieren

loc_CD55:
  CD55  6B 08 03   TIM   #$08,$03,X     ; Speicher wiederhergestellt ($8003.3)?
  CD58  26 0E      BNE   loc_CD68       ; ja — in der Kopie zählen
  CD5A  61 7F 2C   AIM   #$7F,$2C,X     ; „Codes ausgegeben“ löschen
  CD5D  7C 80 2B   INC   $802B          ; Starts + 1
  CD60  B6 80 2B   LDAA  $802B          ; Wert
  CD63  11         CBA                  ; kleiner 50?
  CD64  25 32      BCS   loc_CD98       ; ja
  CD66  20 25      BRA   loc_CD8D       ; 50 — löschen

loc_CD68:
  CD68  72 40 14   OIM   #$40,RP5CR     ; internes RAM einschalten
  CD6B  7B 80 45   TIM   #$80,$45       ; „Codes ausgegeben“ in der Kopie?
  CD6E  27 09      BEQ   loc_CD79       ; nein
  CD70  71 7F 45   AIM   #$7F,$45       ; löschen
  CD73  96 40      LDAA  $40            ; Prüfsumme
  CD75  80 80      SUBA  #$80           ; - $80
  CD77  97 40      STAA  $40            ; schreiben

loc_CD79:
  CD79  7C 00 44   INC   $0044          ; Starts + 1 (in der Kopie)
  CD7C  7C 00 40   INC   $0040          ; Prüfsumme + 1
  CD7F  96 44      LDAA  $44            ; Starts
  CD81  11         CBA                  ; kleiner 50?
  CD82  25 0C      BCS   loc_CD90       ; ja
  CD84  CC 00 00   LDD   #$0000         ; 0
  CD87  97 40      STAA  $40            ; Prüfsumme = 0
  CD89  DD 41      STD   $41            ; Codes = 0
  CD8B  DD 43      STD   $43            ; Starts = 0

loc_CD8D:
  CD8D  62 02 92   OIM   #$02,$92,X     ; Löschanforderung

loc_CD90:
  CD90  6B 04 03   TIM   #$04,$03,X     ; war das RAM schon vorher eingeschaltet?
  CD93  26 03      BNE   loc_CD98       ; ja — nicht anfassen
  CD95  71 BF 14   AIM   #$BF,RP5CR     ; internes RAM ausschalten

loc_CD98:
  CD98  61 FB 03   AIM   #$FB,$03,X     ; $8003.2 löschen
  CD9B  3B         RTI                  ; verlassen

;------------------------------------------------------------------------------
; Nach der Synchronisation: Zylinderzähler $8096 = 0…4 (Zündfolge), Rücksetzen an
; der Marke G4 bei Hall low. Beim Start: 2-mal Hall low nicht auf Zylinder null —
; Fehler Hallgeber (2113) und Notlauf des Chips ($1C = $21, ohne zylinderselektive Klopfregelung [Vermutung]).
;------------------------------------------------------------------------------
loc_CD9C:
  CD9C  C6 02      LDAB  #$02           ; Marke G4?
  CD9E  E5 01      BITB  $01,X          ; prüfen
  CDA0  27 06      BEQ   loc_CDA8       ; nein
  CDA2  E7 01      STAB  $01,X          ; Marke löschen
  CDA4  85 02      BITA  #$02           ; Hall high?
  CDA6  27 08      BEQ   loc_CDB0       ; nein — Zylinder 0

loc_CDA8:
  CDA8  F6 80 96   LDAB  $8096          ; Zylinder
  CDAB  5C         INCB                 ; + 1
  CDAC  C1 05      CMPB  #$05           ; 5?
  CDAE  25 01      BCS   loc_CDB1       ; nein

loc_CDB0:
  CDB0  5F         CLRB                 ; 0

loc_CDB1:
  CDB1  F7 80 96   STAB  $8096          ; $8096 = Zylinder
  CDB4  C6 80      LDAB  #$80           ; Start?
  CDB6  F5 80 29   BITB  $8029          ; prüfen
  CDB9  27 24      BEQ   loc_CDDF       ; nein
  CDBB  F6 80 96   LDAB  $8096          ; Zylinder 0?
  CDBE  27 1C      BEQ   loc_CDDC       ; ja — in Ordnung
  CDC0  85 02      BITA  #$02           ; Hall high?
  CDC2  26 18      BNE   loc_CDDC       ; ja — in Ordnung
  CDC4  7C 80 97   INC   $8097          ; Abweichung + 1
  CDC7  F6 80 97   LDAB  $8097          ; Wert
  CDCA  C1 02      CMPB  #$02           ; 2?
  CDCC  25 11      BCS   loc_CDDF       ; nein
  CDCE  86 03      LDAA  #$03           ; Fehler Hallgeber (2113)
  CDD0  BA 80 94   ORAA  $8094          ; setzen
  CDD3  B7 80 94   STAA  $8094          ; speichern
  CDD6  CC 1C 21   LDD   #$1C21         ; Chip: Register $1C = $21 (Notlauf [Vermutung])
  CDD9  ED 00      STD   $00,X          ; speichern
  CDDB  3B         RTI                  ; verlassen

loc_CDDC:
  CDDC  7F 80 97   CLR   $8097          ; Abweichungen 0

loc_CDDF:
  CDDF  5F         CLRB                 ; Register $14, Kanal 0
  CDE0  86 14      LDAA  #$14           ; (dasselbe)
  CDE2  ED 00      STD   $00,X          ; AD-Wandlung Druck starten (Messung am Zylinderanfang)
  CDE4  F7 80 2A   STAB  $802A          ; AD-Wandler vom Interrupt belegt
  CDE7  F7 80 25   STAB  $8025          ; Stillstandszähler = 0 (Motor dreht)
  CDEA  72 08 17   OIM   #$08,PORT6     ; PORT6.3 = 1: Drehzahlmesser [Vermutung]
  CDED  7B 02 17   TIM   #$02,PORT6     ; Hall high?
  CDF0  27 0A      BEQ   loc_CDFC       ; nein
  CDF2  B6 80 6E   LDAA  $806E          ; $806E.4?
  CDF5  85 10      BITA  #$10           ; prüfen
  CDF7  27 03      BEQ   loc_CDFC       ; nein
  CDF9  72 02 14   OIM   #$02,RP5CR     ; IRQ2 freigeben [?]

;------------------------------------------------------------------------------
; Sanfte Änderung des Zündwinkels. $8023 — tatsächlich ausgegebener Winkel; $8022 — Sollwert.
; Später (Rücknahme) — sofort bis 3 Einh. (C6DA) pro Zylinder; früher — um 1 Einh. (C6D9) alle
; $808B + 1 Zylinder. Bei Ruckeldämpfung — Rücknahme $8080 = $808A, Grenze $808E.
;------------------------------------------------------------------------------
loc_CDFC:
  CDFC  B6 80 88   LDAA  $8088          ; Ruckeldämpfung begonnen?
  CDFF  85 80      BITA  #$80           ; prüfen
  CE01  27 0C      BEQ   loc_CE0F       ; nein
