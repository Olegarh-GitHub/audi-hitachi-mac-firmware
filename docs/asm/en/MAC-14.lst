  D5D9  09         DEX                  ; - 1
  D5DA  FF 80 AA   STX   $80AA          ; save
  D5DD  27 55      BEQ   loc_D634       ; expired — finish
  D5DF  F6 80 AC   LDAB  $80AC          ; phase timer
  D5E2  27 04      BEQ   loc_D5E8       ; zero
  D5E4  5A         DECB                 ; - 1
  D5E5  F7 80 AC   STAB  $80AC          ; save

