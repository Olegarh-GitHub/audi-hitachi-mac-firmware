  F571  BD CA 05   JSR   FRAC_UP        ; доля
  F574  F7 80 16   STAB  $8016          ; $8016 = доля
  F577  F6 80 15   LDAB  $8015          ; номер строки
  F57A  58         ASLB                 ; * 8
  F57B  58         ASLB                 ; *
  F57C  58         ASLB                 ; *
  F57D  FB 80 14   ADDB  $8014          ; + столбец
  F580  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; MAP8X8 — двойная интерполяция по карте 8×8: сначала по оборотам в своей
; строке и в следующей, потом между строками по давлению.
; Вход: X = карта, B = номер ячейки. Выход: A.
