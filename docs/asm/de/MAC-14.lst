;------------------------------------------------------------------------------
; Zündwinkelkorrektur nach Motorlaufzeit (Tabelle C2C4 = 10 8 8 0 auf Achse C2C0 =
; 24 28 35 47 in Einheiten von 5,12 s, also ≈ 123…241 s). Die Entscheidung fällt einmal, wenn
; $8060.0 erscheint [?]: geschah das 10-20 s oder 41-56 s nach dem Start —
; ist die Korrektur aktiv ($807A.2), sonst — nie ($807A.1). Nur bei Drehzahl
; unter 120 Einh. und Druck unter 128. Zweck — [?].
;------------------------------------------------------------------------------
  DFF3  CE 80 00   LDX   #$8000         ; X = $8000
  DFF6  6B 01 60   TIM   #$01,$60,X     ; $8060.0?
  DFF9  27 57      BEQ   loc_E052       ; nein — ohne Korrektur
