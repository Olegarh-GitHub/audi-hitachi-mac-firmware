;------------------------------------------------------------------------------
; Factory patch: two more G71 checks (bit 1 in $8091).
; 1) Full throttle (F81), engine speed not below C846 = 80 units (≈1780 rpm),
;   and pressure differs from atmospheric by less than 13 for 30 calls
;   in a row (3 s, C848): bit 1.
; 2) Pump enabled, N75 active ($8067/$8068 not zero), engine speed ≥ 80 units,
;   and pressure dropped by 25 or more within 100 ms (C847; $806D is the pressure on
;   the previous call): remember it ($806E.0). If the pressure then stays for 6 calls
;   in a row (C849) near atmospheric: bit 1. Looks like a detached
;   boost hose [assumed].
;------------------------------------------------------------------------------
loc_F760:
  F760  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  F763  85 10      BITA  #$10           ; bit 4 is F81
  F765  27 1E      BEQ   loc_F785       ; open? yes: counter 1 to zero
  F767  A6 18      LDAA  $18,X          ; engine speed
  F769  B1 C8 46   CMPA  $C846          ; below C846 = 80 units?
  F76C  25 17      BCS   loc_F785       ; yes: counter 1 to zero
  F76E  A6 19      LDAA  $19,X          ; pressure
  F770  A0 04      SUBA  $04,X          ; minus atmospheric
  F772  24 01      BCC   loc_F775       ; difference positive? yes: continue
  F774  40         NEGA                 ; absolute value

loc_F775:
  F775  B1 C7 A0   CMPA  $C7A0          ; not less than 13?
  F778  24 0B      BCC   loc_F785       ; yes: pressure has moved, counter to zero
  F77A  6C 62      INC   $62,X          ; counter 1 ($8062) + 1
  F77C  A6 62      LDAA  $62,X          ; value
  F77E  B1 C8 48   CMPA  $C848          ; less than C848 = 30 (3 s)?
  F781  25 04      BCS   loc_F787       ; yes: wait
  F783  CA 02      ORAB  #$02           ; bit 1: no boost at full throttle

loc_F785:
  F785  6F 62      CLR   $62,X          ; counter 1 = 0

loc_F787:
  F787  01         NOP                  ; empty (filler)
  F788  01         NOP                  ; empty
  F789  01         NOP                  ; empty
  F78A  7B 40 17   TIM   #$40,PORT6     ; fuel pump enabled (PORT6.6)?
  F78D  27 3D      BEQ   loc_F7CC       ; no: reset
  F78F  A6 67      LDAA  $67,X          ; N75 control, byte 1
  F791  26 04      BNE   loc_F797       ; not zero? yes: check
  F793  A6 68      LDAA  $68,X          ; byte 2
  F795  27 35      BEQ   loc_F7CC       ; zero? yes: reset

loc_F797:
  F797  A6 18      LDAA  $18,X          ; engine speed
  F799  B1 C8 46   CMPA  $C846          ; below 80 units?
  F79C  25 2E      BCS   loc_F7CC       ; yes: reset
  F79E  A6 6D      LDAA  $6D,X          ; pressure on the previous call
  F7A0  A0 19      SUBA  $19,X          ; minus the current one (drop within 100 ms)
  F7A2  25 0A      BCS   loc_F7AE       ; pressure rose? yes: look at the flag
  F7A4  B1 C8 47   CMPA  $C847          ; difference less than C847 = 25?
  F7A7  25 05      BCS   loc_F7AE       ; yes: look at the flag
  F7A9  62 01 6E   OIM   #$01,$6E,X     ; remember: pressure dropped sharply
  F7AC  20 23      BRA   loc_F7D1       ; save flags

loc_F7AE:
  F7AE  6B 01 6E   TIM   #$01,$6E,X     ; flag $806E.0 set?
  F7B1  27 1C      BEQ   loc_F7CF       ; no: counter 2 to zero
  F7B3  A6 19      LDAA  $19,X          ; pressure
  F7B5  A0 04      SUBA  $04,X          ; minus atmospheric
  F7B7  24 01      BCC   loc_F7BA       ; difference positive? yes: continue
  F7B9  40         NEGA                 ; absolute value

loc_F7BA:
  F7BA  B1 C7 A0   CMPA  $C7A0          ; not less than 13?
  F7BD  24 0D      BCC   loc_F7CC       ; yes: clear the flag
  F7BF  6C 90      INC   $90,X          ; counter 2 ($8090) + 1
  F7C1  A6 90      LDAA  $90,X          ; value
  F7C3  B1 C8 49   CMPA  $C849          ; less than C849 = 6?
  F7C6  25 09      BCS   loc_F7D1       ; yes: save flags
  F7C8  CA 02      ORAB  #$02           ; bit 1: no boost while N75 is active
  F7CA  20 03      BRA   loc_F7CF       ; continue

loc_F7CC:
  F7CC  61 FE 6E   AIM   #$FE,$6E,X     ; clear the flag

loc_F7CF:
  F7CF  6F 90      CLR   $90,X          ; counter 2 = 0

loc_F7D1:
