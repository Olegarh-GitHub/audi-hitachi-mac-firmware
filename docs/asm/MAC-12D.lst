;------------------------------------------------------------------------------
; N17 — ПУСКОВАЯ ФОРСУНКА (PORT6.5 = 0 — открыта). Логика как у MAC-14 (D3B1),
; отличаются таблицы и одна важная деталь:
; - пуск: длительность E344 = 100 50 10 0 × 10 тиков по оси E340 = 216 205 189 90
;   (у MC 120 50 10 0 по 216 205 169 90); импульсы по высоте те же (E4D4/E4D8);
; - после пуска: E354 = 30 30 10 0 (у MC 30 20 10 0);
; - горячий пуск: времена E393-E396 = 0 — импульсов нет (у MC 10/30);
; - рост давления: вес 1 E37C = 255 128 32 0, таблица E368 = 0 50 60 150 200…;
; - биты $9D.1 / $9D.0 сравнивают ОБОРОТЫ с 28 / 26 (E391/E441) и работают.
;   В MAC-14 на этом месте в регистре номер высоты, и биты всегда 0.
;------------------------------------------------------------------------------
  ECD1  7B 10 43   TIM   #$10,$43       ; мотор крутился или тест закончен ($43.4)?
  ECD4  26 35      BNE   loc_ED0B       ; да — обычная работа (B = обороты)
  ECD6  7B 10 D7   TIM   #$10,$D7       ; шаг теста N17 ($D7.4)?
  ECD9  27 2A      BEQ   loc_ED05       ; нет — счётчики в ноль
  ECDB  DE D2      LDX   $D2            ; время теста
  ECDD  8C 03 E8   CPX   #$03E8         ; 1000 тиков (10 с) прошло?
  ECE0  24 1A      BCC   loc_ECFC       ; да — закрыть
  ECE2  08         INX                  ; + 1
  ECE3  DF D2      STX   $D2            ; сохранить
  ECE5  96 D4      LDAA  $D4            ; таймер фазы
  ECE7  27 03      BEQ   loc_ECEC       ; ноль — переключить
  ECE9  4A         DECA                 ; - 1
  ECEA  26 14      BNE   loc_ED00       ; не ноль — ждать

loc_ECEC:
  ECEC  75 20 17   EIM   #$20,PORT6     ; переключить N17
  ECEF  7B 20 17   TIM   #$20,PORT6     ; теперь закрыта?
  ECF2  27 04      BEQ   loc_ECF8       ; нет (открыта)
  ECF4  86 62      LDAA  #$62           ; закрыта 98 тиков
  ECF6  20 08      BRA   loc_ED00       ; дальше

