  DA03  20 DB      BRA   loc_D9E0       ; weiter

loc_DA05:
  DA05  F1 81 04   CMPB  $8104          ; letztes ($03)?
  DA08  27 0C      BEQ   loc_DA16       ; ja
  DA0A  3C         PSHX                 ; X sichern
  DA0B  C0 02      SUBB  #$02           ; Nummer - 2
  DA0D  CE 81 85   LDX   #$8185         ; Puffer für den Block des Testers $8185
  DA10  3A         ABX                  ; X -> Platz
  DA11  A7 00      STAA  $00,X          ; Byte speichern
  DA13  38         PULX                 ; X zurückholen
  DA14  20 E7      BRA   loc_D9FD       ; weiter

loc_DA16:
  DA16  F6 81 85   LDAB  $8185          ; Titel des Testerblocks
  DA19  C1 09      CMPB  #$09           ; $09 (Bestätigung)?
  DA1B  27 08      BEQ   loc_DA25       ; ja
  DA1D  C6 DF      LDAB  #$DF           ; sonst $8077.5 löschen [?]
  DA1F  F4 80 77   ANDB  $8077          ; löschen
  DA22  F7 80 77   STAB  $8077          ; schreiben

loc_DA25:
  DA25  81 03      CMPA  #$03           ; letztes Byte $03?
  DA27  26 1B      BNE   loc_DA44       ; nein — Fehler
  DA29  F6 81 85   LDAB  $8185          ; Titel
  DA2C  C1 0B      CMPB  #$0B           ; kleiner als $0B?
  DA2E  25 16      BCS   loc_DA46       ; ja — Nummer = Titel
  DA30  C1 1B      CMPB  #$1B           ; $1B?
  DA32  26 04      BNE   loc_DA38       ; nein
  DA34  C6 0F      LDAB  #$0F           ; Nummer $0F
  DA36  20 0E      BRA   loc_DA46       ; weiter

loc_DA38:
  DA38  C1 10      CMPB  #$10           ; kleiner als $10?
  DA3A  25 08      BCS   loc_DA44       ; ja — unbekannt
  DA3C  C1 13      CMPB  #$13           ; $13 oder mehr?
  DA3E  24 04      BCC   loc_DA44       ; ja — unbekannt
  DA40  C0 05      SUBB  #$05           ; $10-$12 -> $0B-$0D
  DA42  20 02      BRA   loc_DA46       ; weiter

loc_DA44:
  DA44  C6 0E      LDAB  #$0E           ; unbekannter Befehl -> $0E

loc_DA46:
  DA46  58         ASLB                 ; × 2
  DA47  3C         PSHX                 ; X sichern
  DA48  CE DA DF   LDX   #$DADF         ; Befehlstabelle $DADF
  DA4B  3A         ABX                  ; X -> Adresse
  DA4C  EE 00      LDX   $00,X          ; Adresse der Behandlungsroutine
  DA4E  AD 00      JSR   $00,X          ; Befehl ausführen
  DA50  7F 80 FE   CLR   $80FE          ; Bytenummer = 0
  DA53  38         PULX                 ; X zurückholen
  DA54  61 DF 00   AIM   #$DF,$00,X     ; Blockempfang beendet
  DA57  20 87      BRA   loc_D9E0       ; antworten

loc_DA59:
  DA59  7D 80 FB   TST   $80FB          ; Pause vor dem Senden
  DA5C  27 05      BEQ   loc_DA63       ; abgelaufen
  DA5E  7A 80 FB   DEC   $80FB          ; - 1

loc_DA61:
  DA61  20 83      BRA   loc_D9E6       ; zum Ende

loc_DA63:
  DA63  3C         PSHX                 ; X sichern
  DA64  6B 20 00   TIM   #$20,$00,X     ; Block des Testers wird empfangen?
  DA67  27 06      BEQ   loc_DA6F       ; nein — eigener Block
  DA69  B6 80 FC   LDAA  $80FC          ; zuletzt empfangenes Byte
  DA6C  43         COMA                 ; Inversion — Bestätigung
  DA6D  20 21      BRA   loc_DA90       ; senden

loc_DA6F:
  DA6F  F6 80 FE   LDAB  $80FE          ; Bytenummer
  DA72  26 05      BNE   loc_DA79       ; nicht das erste
  DA74  B6 81 03   LDAA  $8103          ; erstes — Länge
  DA77  20 4B      BRA   loc_DAC4       ; senden

loc_DA79:
  DA79  C1 01      CMPB  #$01           ; zweites?
  DA7B  26 06      BNE   loc_DA83       ; nein
  DA7D  B6 81 00   LDAA  $8100          ; Blockzähler
  DA80  4C         INCA                 ; + 1
  DA81  20 41      BRA   loc_DAC4       ; senden

loc_DA83:
  DA83  F1 81 03   CMPB  $8103          ; letztes?
  DA86  26 0E      BNE   loc_DA96       ; nein
  DA88  7F 80 FE   CLR   $80FE          ; Nummer = 0
  DA8B  62 20 00   OIM   #$20,$00,X     ; weiter den Block des Testers empfangen
  DA8E  86 03      LDAA  #$03           ; Blockende $03

loc_DA90:
  DA90  97 13      STAA  TDR            ; an SCI
  DA92  86 65      LDAA  #$65           ; auf Antwort 101 Ticks warten
  DA94  20 38      BRA   loc_DACE       ; weiter

loc_DA96:
  DA96  B6 81 85   LDAA  $8185          ; Befehl des Testers
  DA99  81 0A      CMPA  #$0A           ; $0A?
  DA9B  27 21      BEQ   loc_DABE       ; ja — aus dem Puffer
  DA9D  81 01      CMPA  #$01           ; $01 (RAM lesen)?
  DA9F  27 09      BEQ   loc_DAAA       ; ja — aus dem Speicher
  DAA1  81 03      CMPA  #$03           ; $03 (ROM lesen)?
  DAA3  27 05      BEQ   loc_DAAA       ; ja — aus dem Speicher
  DAA5  7D 81 01   TST   $8101          ; Datenstrom aus dem Speicher ($8101)?
  DAA8  27 14      BEQ   loc_DABE       ; nein — aus dem Puffer

loc_DAAA:
  DAAA  C1 02      CMPB  #$02           ; drittes Byte (Titel)?
  DAAC  27 10      BEQ   loc_DABE       ; ja — aus dem Puffer
  DAAE  C0 03      SUBB  #$03           ; Nummer - 3
  DAB0  FE 81 87   LDX   $8187          ; Speicheradresse ($8187/$8188)
  DAB3  3A         ABX                  ; X -> Byte
  DAB4  A6 00      LDAA  $00,X          ; Speicherbyte
  DAB6  CE 81 06   LDX   #$8106         ; Puffer $8106
  DAB9  3A         ABX                  ; X -> Platz
  DABA  A7 00      STAA  $00,X          ; Kopie in den Puffer
  DABC  20 06      BRA   loc_DAC4       ; senden

loc_DABE:
  DABE  CE 81 03   LDX   #$8103         ; Puffer des eigenen Blocks
  DAC1  3A         ABX                  ; X -> Byte
  DAC2  A6 00      LDAA  $00,X          ; Byte

loc_DAC4:
  DAC4  97 13      STAA  TDR            ; an SCI
  DAC6  B7 80 FC   STAA  $80FC          ; für die Prüfung der Antwort merken
  DAC9  7C 80 FE   INC   $80FE          ; Nummer + 1
  DACC  86 06      LDAA  #$06           ; auf Antwort 6 Ticks warten

loc_DACE:
  DACE  38         PULX                 ; X zurückholen
  DACF  B7 80 FD   STAA  $80FD          ; Timeout
  DAD2  6B 02 00   TIM   #$02,$00,X     ; vorheriges Byte nie bestätigt?
  DAD5  27 03      BEQ   loc_DADA       ; nein
  DAD7  7E DC E6   JMP   loc_DCE6       ; ja — zum Ende (Austauschfehler)

loc_DADA:
  DADA  62 02 00   OIM   #$02,$00,X     ; warten auf Bestätigung
  DADD  20 82      BRA   loc_DA61       ; zum Ende

; Tabelle $DADF, 32 Bytes: Befehlstabelle KW1281 (16 Adressen): $00 DAFF, $01 DB2A, $02 DBA9, $03 DB2A, $04 DBB5, $05 DC03, $06 DCDF, $07 DC03, $08 DC65, $09 DC90, $0A DCE5, $10 DBA9, $11 DCAC, $12 DBA9, andere DBA9, $1B DCB4
  DADF  db DA FF DB 2A DB A9 DB 2A DB B5 DC 03 DC DF DC 03
  DAEF  db DC 65 DC 90 DC E5 DB A9 DC AC DB A9 DB A9 DC B4

;------------------------------------------------------------------------------
; Befehl $00 / Beginn der Sitzung: Identifikation. 3 ASCII-Blöcke (Kopf $F6, 11 Zeichen)
; aus $C9C3: „447905383L ", „Motor      ", dann eine Variante je nach Codierung:
; „PMC AT/CAL.", „PMC AT/BUND", „PMC HS/CAL.", „PMC HS/BUND".
; Der nächste Block wird auf Quittung des Testers gesendet ($09, DC90).
;------------------------------------------------------------------------------
KW_IDENT:                               ; aufgerufen von: KW_IDENT, TASK0
  DAFF  C6 03      LDAB  #$03           ; Identifikationsblöcke: 3
  DB01  F7 81 01   STAB  $8101          ; $8101 = verbleibend

loc_DB04:
  DB04  86 03      LDAA  #$03           ; 3
  DB06  10         SBA                  ; - verbleibend = Blocknummer 0…2
  DB07  16         TAB                  ; nach B
  DB08  C1 02      CMPB  #$02           ; Block 2 (Variante)?
  DB0A  26 0D      BNE   loc_DB19       ; nein
  DB0C  7B 04 17   TIM   #$04,PORT6     ; Codierung: PORT6.2 = 1 bedeutet HS
  DB0F  27 02      BEQ   loc_DB13       ; AT: +0
  DB11  5C         INCB                 ; HS: +2
  DB12  5C         INCB                 ; (+2)

loc_DB13:
  DB13  7B 10 15   TIM   #$10,PORT5     ; Codierung: PORT5.4 = 1 bedeutet BUND
  DB16  27 01      BEQ   loc_DB19       ; CAL: +0
  DB18  5C         INCB                 ; BUND: +1

loc_DB19:
  DB19  86 0B      LDAA  #$0B           ; 11 Zeichen pro Zeile
  DB1B  3D         MUL                  ; × Nummer
  DB1C  CE C9 C3   LDX   #$C9C3         ; Identifikationszeilen
  DB1F  3A         ABX                  ; X -> Zeile
  DB20  FF 81 87   STX   $8187          ; Sendeadresse
  DB23  C6 0E      LDAB  #$0E           ; Blocklänge 14
  DB25  86 F6      LDAA  #$F6           ; Kopf $F6 (ASCII)
  DB27  7E DB FC   JMP   loc_DBFC       ; speichern

;------------------------------------------------------------------------------
; Befehle $01 (RAM lesen) und $03 (ROM lesen). Testerblock: Byteanzahl ($8186),
; Adresse ($8187/$8188). Erlaubt: RAM $8000-$8290; ROM nur $C000-$CA04
; (Tabellen und Kalibrierung) und $FFE6-$FFE9 (4 Bytes vor den Vektoren). Der
; Programmcode selbst ist nicht lesbar. Antwort in Blöcken zu 16 Bytes: Kopf $FE (RAM)
; oder $FD (ROM); Fortsetzung auf Quittung des Testers. Verstoß ergibt „nicht verstanden".
;------------------------------------------------------------------------------
KW_READMEM:                             ; aufgerufen von: KW_READMEM
  DB2A  B6 81 86   LDAA  $8186          ; wie viele Bytes
  DB2D  27 7A      BEQ   KW_NAK         ; null ergibt „nicht verstanden"
  DB2F  81 FF      CMPA  #$FF           ; mehr als 255: kommt nie vor (belassen)
  DB31  22 76      BHI   KW_NAK         ; (unmöglich: ein Byte ist nicht größer als 255)
  DB33  FE 81 87   LDX   $8187          ; Adresse
  DB36  F6 81 86   LDAB  $8186          ; Anzahl
  DB39  5A         DECB                 ; - 1
  DB3A  B6 81 85   LDAA  $8185          ; Befehl
  DB3D  81 01      CMPA  #$01           ; RAM lesen?
  DB3F  27 1A      BEQ   loc_DB5B       ; ja
  DB41  8C C0 00   CPX   #$C000         ; ROM: Adresse unter $C000?
  DB44  25 63      BCS   KW_NAK         ; ja: nicht erlaubt
  DB46  8C FF E6   CPX   #$FFE6         ; Adresse ab $FFE6?
  DB49  24 08      BCC   loc_DB53       ; ja: Ende prüfen
  DB4B  3A         ABX                  ; Ende
  DB4C  8C CA 05   CPX   #$CA05         ; über $CA04 hinaus?
  DB4F  24 58      BCC   KW_NAK         ; ja: nicht erlaubt
  DB51  20 06      BRA   loc_DB59       ; erlaubt

loc_DB53:
  DB53  3A         ABX                  ; Ende
  DB54  8C FF E9   CPX   #$FFE9         ; über $FFE9 hinaus?
  DB57  22 50      BHI   KW_NAK         ; ja: nicht erlaubt

loc_DB59:
  DB59  20 0B      BRA   loc_DB66       ; erlaubt

loc_DB5B:
  DB5B  8C 80 00   CPX   #$8000         ; RAM: unter $8000?
  DB5E  25 49      BCS   KW_NAK         ; ja: nicht erlaubt
  DB60  3A         ABX                  ; Ende
  DB61  8C 82 90   CPX   #$8290         ; über $8290 hinaus?
  DB64  22 43      BHI   KW_NAK         ; ja: nicht erlaubt

loc_DB66:
  DB66  B7 82 0C   STAA  $820C          ; Befehl merken
  DB69  5C         INCB                 ; Byteanzahl
  DB6A  F7 82 0D   STAB  $820D          ; noch zu senden
  DB6D  FE 81 87   LDX   $8187          ; Adresse
  DB70  FF 82 0E   STX   $820E          ; merken

loc_DB73:
  DB73  FE 82 0E   LDX   $820E          ; Adresse des nächsten Stücks
  DB76  FF 81 87   STX   $8187          ; zum Senden
  DB79  B6 82 0D   LDAA  $820D          ; verbleibend
  DB7C  C6 10      LDAB  #$10           ; Stück zu 16
  DB7E  11         CBA                  ; mehr als 16 verbleibend?
  DB7F  22 08      BHI   loc_DB89       ; ja
  DB81  B7 81 86   STAA  $8186          ; letztes Stück
  DB84  7F 82 0D   CLR   $820D          ; nichts mehr übrig
  DB87  20 0B      BRA   loc_DB94       ; weiter

loc_DB89:
  DB89  F7 81 86   STAB  $8186          ; Stück zu 16
  DB8C  10         SBA                  ; verbleibend - 16
  DB8D  B7 82 0D   STAA  $820D          ; speichern
  DB90  3A         ABX                  ; Adresse des nächsten Stücks
  DB91  FF 82 0E   STX   $820E          ; speichern

loc_DB94:
  DB94  F6 82 0C   LDAB  $820C          ; Befehl
  DB97  F7 81 85   STAB  $8185          ; wiederherstellen
  DB9A  86 FE      LDAA  #$FE           ; Kopf $FE (RAM)
  DB9C  C1 01      CMPB  #$01           ; RAM?
  DB9E  27 02      BEQ   loc_DBA2       ; ja
  DBA0  86 FD      LDAA  #$FD           ; $FD (ROM)

loc_DBA2:
  DBA2  F6 81 86   LDAB  $8186          ; Byteanzahl
  DBA5  CB 03      ADDB  #$03           ; + 3 = Blocklänge
  DBA7  20 53      BRA   loc_DBFC       ; speichern

;------------------------------------------------------------------------------
; „Nicht verstanden": Block mit Kopf $0A und der Blocknummer des Testers.
;------------------------------------------------------------------------------
KW_NAK:                                 ; aufgerufen von: KW_NAK, KW_READING, KW_READMEM
  DBA9  B6 81 00   LDAA  $8100          ; Blocknummer
  DBAC  B7 81 06   STAA  $8106          ; in die Daten
  DBAF  86 0A      LDAA  #$0A           ; Kopf $0A
  DBB1  C6 04      LDAB  #$04           ; Länge 4
  DBB3  20 47      BRA   loc_DBFC       ; speichern

;------------------------------------------------------------------------------
; Befehl $04: Stellglieddiagnose vom Tester. Nur solange der Motor nicht gedreht hat.
; Jeder Befehl ist der nächste Schritt (wie Öffnen von Kontakt 5). Antwort $F5 ist die
; Stellgliednummer aus Tabelle C9AE: 01259, 01261, 01262, 01263, 01247,
; 01241, 00767 (nach Schrittbit $80AF; Zuordnung zu den Stellgliedern ist [Vermutung]).
;------------------------------------------------------------------------------
KW_ACTTEST:                             ; aufgerufen von: KW_ACTTEST
  DBB5  CE 80 00   LDX   #$8000         ; X = $8000
  DBB8  6B 40 03   TIM   #$40,$03,X     ; Zähne schon erkannt?
  DBBB  26 12      BNE   loc_DBCF       ; ja: nur Quittung
  DBBD  6B 10 F7   TIM   #$10,$F7,X     ; Test schon beendet?
  DBC0  26 0D      BNE   loc_DBCF       ; ja: nur Quittung
  DBC2  F6 80 AF   LDAB  $80AF          ; Schritt
  DBC5  C1 04      CMPB  #$04           ; letzter (N115)?
  DBC7  26 08      BNE   loc_DBD1       ; nein
  DBC9  62 10 F7   OIM   #$10,$F7,X     ; Test beendet
  DBCC  BD F7 26   JSR   TEST_EXIT      ; Test verlassen

loc_DBCF:
  DBCF  20 47      BRA   loc_DC18       ; Quittung

loc_DBD1:
  DBD1  61 EF 03   AIM   #$EF,$03,X     ; Test freigeben
  DBD4  86 40      LDAA  #$40           ; Anforderung des nächsten Schritts
  DBD6  BA 80 A9   ORAA  $80A9          ; setzen
  DBD9  B7 80 A9   STAA  $80A9          ; speichern
  DBDC  62 08 F7   OIM   #$08,$F7,X     ; Start vom Tester
  DBDF  B6 80 AF   LDAA  $80AF          ; Schritt
  DBE2  C6 01      LDAB  #$01           ; Nummer = 1

loc_DBE4:
  DBE4  48         ASLA                 ; Schrittbit
  DBE5  25 06      BCS   loc_DBED       ; gefunden
  DBE7  5C         INCB                 ; + 1
  DBE8  C1 07      CMPB  #$07           ; kleiner als 7?
  DBEA  25 F8      BCS   loc_DBE4       ; ja
  DBEC  5F         CLRB                 ; kein Schritt: 0

loc_DBED:
  DBED  CE C9 AE   LDX   #$C9AE         ; Tabelle C9AE
  DBF0  3A         ABX                  ; + Nummer
  DBF1  58         ASLB                 ; × 3
  DBF2  3A         ABX                  ; X -> Eintrag
  DBF3  EC 00      LDD   $00,X          ; Stellgliednummer (2 Bytes)
  DBF5  FD 81 06   STD   $8106          ; in die Daten
  DBF8  86 F5      LDAA  #$F5           ; Kopf $F5
  DBFA  C6 05      LDAB  #$05           ; Länge 5

loc_DBFC:
  DBFC  B7 81 05   STAA  $8105          ; Kopf des eigenen Blocks
  DBFF  F7 81 03   STAB  $8103          ; Länge
  DC02  39         RTS                  ; Rücksprung

;------------------------------------------------------------------------------
; Befehle $05 (löschen) und $07 (Codes lesen). Solange der Fehlerspeicher nach der
; Wiederherstellung nicht bestätigt ist ($8003.3), gibt es keine Antwort.
; $07: für jedes Bit von $8000-$8002 (23 Codes) 3 Bytes aus C966: VAG-Nummer
; und Kennung. Kopf $FC. Nummern: 1111 → 65535, 2111 → 00513,
; 2112 → 00514, 2113 → 00515, 2222 → 00519, 2221 → 00519, 2142 → 00524,
; 2144 → 00540, 2141 → 00535, 2143 → 00536, 2123 → 00517, 2121 → 00516,
; 2322 → 00523, 2312 → 00522, 2342 → 00525, 2214 → 00543, 2224 → 00544.
;------------------------------------------------------------------------------
KW_ERRORS:                              ; aufgerufen von: KW_ERRORS
  DC03  86 08      LDAA  #$08           ; Speicher wiederhergestellt und nicht bestätigt?
  DC05  B5 80 03   BITA  $8003          ; prüfen
  DC08  27 01      BEQ   loc_DC0B       ; nein
  DC0A  39         RTS                  ; ja: keine Antwort

loc_DC0B:
  DC0B  CE 80 00   LDX   #$8000         ; X = $8000
  DC0E  B6 81 85   LDAA  $8185          ; Befehl
  DC11  81 07      CMPA  #$07           ; $07: lesen?
  DC13  27 06      BEQ   loc_DC1B       ; ja
  DC15  62 02 92   OIM   #$02,$92,X     ; $05: Löschanforderung

loc_DC18:
  DC18  7E DC A6   JMP   loc_DCA6       ; Quittung

loc_DC1B:
  DC1B  7F 81 02   CLR   $8102          ; Datenlänge = 0
  DC1E  86 80      LDAA  #$80           ; Maske Bit 7
  DC20  C6 00      LDAB  #$00           ; Codenummer 0

loc_DC22:
  DC22  A5 00      BITA  $00,X          ; Bit gesetzt?
  DC24  27 29      BEQ   loc_DC4F       ; nein
  DC26  36         PSHA                 ; sichern
  DC27  37         PSHB                 ; (sichern)
  DC28  3C         PSHX                 ; (sichern)
  DC29  CE C9 66   LDX   #$C966         ; Tabelle C966
  DC2C  3A         ABX                  ; + Nummer
  DC2D  58         ASLB                 ; × 3
  DC2E  3A         ABX                  ; X -> Eintrag
  DC2F  EC 00      LDD   $00,X          ; VAG-Nummer
  DC31  FD 80 1E   STD   $801E          ; zwischenspeichern
  DC34  A6 02      LDAA  $02,X          ; Kennung
  DC36  F6 81 02   LDAB  $8102          ; Versatz im Block
  DC39  CE 81 06   LDX   #$8106         ; Daten
  DC3C  3A         ABX                  ; X -> Stelle
  DC3D  A7 02      STAA  $02,X          ; Kennung
  DC3F  FC 80 1E   LDD   $801E          ; Nummer
  DC42  ED 00      STD   $00,X          ; speichern
  DC44  B6 81 02   LDAA  $8102          ; Versatz
  DC47  8B 03      ADDA  #$03           ; + 3
  DC49  B7 81 02   STAA  $8102          ; speichern
  DC4C  38         PULX                 ; zurückholen
  DC4D  33         PULB                 ; (zurückholen)
  DC4E  32         PULA                 ; (zurückholen)

loc_DC4F:
  DC4F  5C         INCB                 ; Nummer + 1
  DC50  C1 17      CMPB  #$17           ; alle 23?
  DC52  27 08      BEQ   loc_DC5C       ; ja
  DC54  44         LSRA                 ; nächstes Bit
  DC55  24 CB      BCC   loc_DC22       ; noch im Byte
  DC57  08         INX                  ; nächstes Byte
  DC58  86 80      LDAA  #$80           ; Maske Bit 7
  DC5A  20 C6      BRA   loc_DC22       ; weiter

loc_DC5C:
  DC5C  F6 81 02   LDAB  $8102          ; Datenlänge
  DC5F  CB 03      ADDB  #$03           ; + 3
  DC61  86 FC      LDAA  #$FC           ; Kopf $FC

loc_DC63:
  DC63  20 97      BRA   loc_DBFC       ; speichern

;------------------------------------------------------------------------------
; Befehl $08: ein ADC-Wert. Kanalnummer 0…7 ($8186) -> Zelle $8019+N:
; 0 Saugrohrdruck, 1 Spannung, 2 G62, 3 Lambda (10 Bit, 2 Bytes), 4 $801D [?],
; 5 Abschaltsignal (J142), 6 $801F (Zwischenzelle für N17), 7 G42.
; Antwort $FB, 2 Bytes. Über 7 ergibt „nicht verstanden".
;------------------------------------------------------------------------------
KW_READING:                             ; aufgerufen von: KW_READING
  DC65  CE 80 19   LDX   #$8019         ; ADC-Zellen
  DC68  F6 81 86   LDAB  $8186          ; Kanalnummer
  DC6B  3A         ABX                  ; X -> Zelle
  DC6C  E6 00      LDAB  $00,X          ; Wert
  DC6E  B6 81 86   LDAA  $8186          ; Kanalnummer
  DC71  81 07      CMPA  #$07           ; nicht über 7?
  DC73  23 03      BLS   loc_DC78       ; ja
  DC75  7E DB A9   JMP   KW_NAK         ; „nicht verstanden"

loc_DC78:
  DC78  81 03      CMPA  #$03           ; Lambda (3)?
  DC7A  27 03      BEQ   loc_DC7F       ; ja
  DC7C  4F         CLRA                 ; High-Byte = 0
  DC7D  20 08      BRA   loc_DC87       ; weiter

loc_DC7F:
  DC7F  FC 80 B3   LDD   $80B3          ; 10 Bit Lambda
  DC82  05         ASLD                 ; ausrichten
  DC83  16         TAB                  ; Low-Byte
  DC84  49         ROLA                 ; High-Byte
  DC85  84 01      ANDA  #$01           ; zwei Bits

loc_DC87:
  DC87  FD 81 06   STD   $8106          ; in die Daten
  DC8A  86 FB      LDAA  #$FB           ; Kopf $FB
  DC8C  C6 05      LDAB  #$05           ; Länge 5
