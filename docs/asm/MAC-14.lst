  D74E  A7 00      STAA  $00,X          ; записать
  D750  A6 02      LDAA  $02,X          ; замер
  D752  B1 80 BA   CMPA  $80BA          ; не ниже нижнего предела $80BA?
  D755  24 03      BCC   loc_D75A       ; да
