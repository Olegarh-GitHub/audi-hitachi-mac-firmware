  DA50  7F 80 FE   CLR   $80FE          ; byte number = 0
  DA53  38         PULX                 ; restore X
  DA54  61 DF 00   AIM   #$DF,$00,X     ; block reception finished
  DA57  20 87      BRA   loc_D9E0       ; reply

loc_DA59:
  DA59  7D 80 FB   TST   $80FB          ; pause before sending
  DA5C  27 05      BEQ   loc_DA63       ; expired
  DA5E  7A 80 FB   DEC   $80FB          ; - 1

loc_DA61:
  DA61  20 83      BRA   loc_D9E6       ; to the end

loc_DA63:
  DA63  3C         PSHX                 ; save X
  DA64  6B 20 00   TIM   #$20,$00,X     ; receiving a tester block?
  DA67  27 06      BEQ   loc_DA6F       ; no — own block
  DA69  B6 80 FC   LDAA  $80FC          ; last received byte
  DA6C  43         COMA                 ; inverse — acknowledgement
  DA6D  20 21      BRA   loc_DA90       ; send

loc_DA6F:
  DA6F  F6 80 FE   LDAB  $80FE          ; byte number
  DA72  26 05      BNE   loc_DA79       ; not the first
  DA74  B6 81 03   LDAA  $8103          ; first — length
  DA77  20 4B      BRA   loc_DAC4       ; send

loc_DA79:
  DA79  C1 01      CMPB  #$01           ; second?
  DA7B  26 06      BNE   loc_DA83       ; no
  DA7D  B6 81 00   LDAA  $8100          ; block counter
  DA80  4C         INCA                 ; + 1
  DA81  20 41      BRA   loc_DAC4       ; send

loc_DA83:
  DA83  F1 81 03   CMPB  $8103          ; last?
  DA86  26 0E      BNE   loc_DA96       ; no
  DA88  7F 80 FE   CLR   $80FE          ; number = 0
  DA8B  62 20 00   OIM   #$20,$00,X     ; continue receiving the tester block
  DA8E  86 03      LDAA  #$03           ; block end $03

loc_DA90:
  DA90  97 13      STAA  TDR            ; to SCI
  DA92  86 65      LDAA  #$65           ; wait for a response 101 ticks
  DA94  20 38      BRA   loc_DACE       ; continue

loc_DA96:
  DA96  B6 81 85   LDAA  $8185          ; tester command
  DA99  81 0A      CMPA  #$0A           ; $0A?
  DA9B  27 21      BEQ   loc_DABE       ; yes — from the buffer
  DA9D  81 01      CMPA  #$01           ; $01 (RAM read)?
  DA9F  27 09      BEQ   loc_DAAA       ; yes — from memory
  DAA1  81 03      CMPA  #$03           ; $03 (ROM read)?
  DAA3  27 05      BEQ   loc_DAAA       ; yes — from memory
  DAA5  7D 81 01   TST   $8101          ; stream from memory ($8101)?
  DAA8  27 14      BEQ   loc_DABE       ; no — from the buffer

loc_DAAA:
  DAAA  C1 02      CMPB  #$02           ; third byte (title)?
  DAAC  27 10      BEQ   loc_DABE       ; yes — from the buffer
  DAAE  C0 03      SUBB  #$03           ; number - 3
  DAB0  FE 81 87   LDX   $8187          ; memory address ($8187/$8188)
  DAB3  3A         ABX                  ; X -> byte
  DAB4  A6 00      LDAA  $00,X          ; memory byte
  DAB6  CE 81 06   LDX   #$8106         ; buffer $8106
  DAB9  3A         ABX                  ; X -> location
  DABA  A7 00      STAA  $00,X          ; copy into the buffer
  DABC  20 06      BRA   loc_DAC4       ; send

loc_DABE:
