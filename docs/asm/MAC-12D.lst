  FBB3  C1 19      CMPB  #$19           ; уже 25 вызовов (2,5 с)?
  FBB5  24 05      BCC   loc_FBBC       ; да — запустить
  FBB7  5C         INCB                 ; + 1
  FBB8  D7 D6      STAB  $D6            ; сохранить
