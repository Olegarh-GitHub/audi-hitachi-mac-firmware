;------------------------------------------------------------------------------
; N17_BY_COLDEST — value of table [$801E] for the lowest temperature
; $807B, axis X (4 points). $801E is a temporary cell here (table address).
;------------------------------------------------------------------------------
N17_BY_COLDEST:                         ; called from: TASK0
  D525  B6 80 7B   LDAA  $807B          ; lowest temperature
  D528  C6 04      LDAB  #$04           ; 4 points
  D52A  BD CA 6B   JSR   AXIS_DN        ; find the interval
  D52D  37         PSHB                 ; index
  D52E  BD CA 10   JSR   FRAC_DN        ; fraction
  D531  17         TBA                  ; A = fraction
  D532  33         PULB                 ; B = index
  D533  FE 80 1E   LDX   $801E          ; table address
  D536  3A         ABX                  ; X -> value
  D537  16         TAB                  ; B = fraction
  D538  BD CA 41   JSR   INTERP         ; interpolation
  D53B  39         RTS                  ; return

;------------------------------------------------------------------------------
; TIMES10 — $80AA = A × 10 (duration in ticks). Flag Z — result is zero.
;------------------------------------------------------------------------------
TIMES10:                                ; called from: TASK0
  D53C  C6 0A      LDAB  #$0A           ; × 10
  D53E  3D         MUL                  ; D = A × 10
  D53F  FD 80 AA   STD   $80AA          ; $80AA
  D542  39         RTS                  ; return

