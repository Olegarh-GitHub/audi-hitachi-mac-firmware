;------------------------------------------------------------------------------
; ТИК (≈10 мс). После синхронизации: 100 тиков (E440) без событий цилиндра — мотор
; встал: $43.7 и перезапуск программы с проверкой ОЗУ от $0045 (ячейки $40-$44 —
; коды и атмосферное давление — сохраняются). Копии во внутреннем ОЗУ, как в
; MAC-14, нет.
;------------------------------------------------------------------------------
loc_EACE:
  EACE  7B 20 BC   TIM   #$20,$BC       ; синхронизация есть ($BC.5)?
  EAD1  27 17      BEQ   loc_EAEA       ; нет
  EAD3  7C 00 64   INC   $0064          ; тиков без событий + 1
  EAD6  D6 64      LDAB  $64            ; значение
  EAD8  F1 E4 40   CMPB  $E440          ; меньше 100?
  EADB  25 0D      BCS   loc_EAEA       ; да — к задачам
  EADD  0F         SEI                  ; запрет прерываний
  EADE  72 80 43   OIM   #$80,$43       ; мотор встал ($43.7)
  EAE1  8E 00 FF   LDS   #$00FF         ; стек заново
  EAE4  CE 00 45   LDX   #$0045         ; проверка ОЗУ с $0045
  EAE7  7E E6 5C   JMP   loc_E65C       ; перезапуск

;------------------------------------------------------------------------------
; ДИСПЕТЧЕР ЗАДАЧ — как в MAC-14: счётчики $46-$49, делители EB4C = 1 2 4 10,
; таблица задач EB34; задача 0 прерывает 1-3 и т. д.
;------------------------------------------------------------------------------
loc_EAEA:
  EAEA  CE EB 4C   LDX   #$EB4C         ; делители
  EAED  3C         PSHX                 ; в стек
  EAEE  CE 00 46   LDX   #$0046         ; счётчик задачи 0

