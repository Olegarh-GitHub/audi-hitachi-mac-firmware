;------------------------------------------------------------------------------
; IS_IDLE — дроссель закрыт (F60)? C = 1 — закрыт. При оборотах от 40 ед. и
; неисправном F60 ($BA.3) — «не закрыт».
;------------------------------------------------------------------------------
IS_IDLE:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  EB50  96 59      LDAA  $59            ; обороты
  EB52  B1 E2 10   CMPA  $E210          ; ниже E210 = 40 ед.?
  EB55  25 05      BCS   loc_EB5C       ; да — верить концевику
  EB57  7B 08 BA   TIM   #$08,$BA       ; F60 неисправен?
  EB5A  26 08      BNE   loc_EB64       ; да — считать открытым

loc_EB5C:
  EB5C  8D 1C      BSR   RD_INPUTS      ; дискретные входы
  EB5E  85 20      BITA  #$20           ; бит 5 — F60
  EB60  27 02      BEQ   loc_EB64       ; разомкнут — открыт
  EB62  0D         SEC                  ; C = 1: закрыт
  EB63  39         RTS                  ; возврат

loc_EB64:
  EB64  0C         CLC                  ; C = 0: открыт
  EB65  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; MAP_BAD_LOAD — G71 неисправен ($B8 & $72), обороты от 40 ед., дроссель не закрыт:
; C = 1 — брать подстановку давления.
;------------------------------------------------------------------------------
MAP_BAD_LOAD:                           ; вызов из: TASK1, TASK3
  EB66  7B 72 B8   TIM   #$72,$B8       ; ошибки G71?
  EB69  27 0D      BEQ   loc_EB78       ; нет — C = 0
  EB6B  96 59      LDAA  $59            ; обороты
  EB6D  B1 E2 10   CMPA  $E210          ; ниже 40 ед.?
  EB70  25 06      BCS   loc_EB78       ; да — C = 0
  EB72  8D DC      BSR   IS_IDLE        ; дроссель закрыт?
