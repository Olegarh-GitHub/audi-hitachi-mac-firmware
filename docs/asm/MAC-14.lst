;------------------------------------------------------------------------------
; FRAC_UP — доля между двумя точками возрастающей оси.
; Вход: A = величина, X -> левая точка оси (результат AXIS_UP).
; Выход: B = (A - ось[i]) * 256 / (ось[i+1] - ось[i]), то есть 0...255.
;------------------------------------------------------------------------------
FRAC_UP:                                ; вызов из: TASK1, TASK2, TASK3
  CA05  5F         CLRB                 ; B = 0 на случай точного попадания
  CA06  A0 00      SUBA  $00,X          ; A = величина - левая точка
  CA08  27 36      BEQ   loc_CA40       ; ровно в точке? да — доля 0
  CA0A  E6 01      LDAB  $01,X          ; B = ширина интервала
  CA0C  E0 00      SUBB  $00,X
  CA0E  20 0B      BRA   DIV8           ; делить

;------------------------------------------------------------------------------
; FRAC_DN — то же для убывающей оси (ось[i] > ось[i+1]).
;------------------------------------------------------------------------------
FRAC_DN:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  CA10  5F         CLRB                 ; B = 0 на случай точного попадания
  CA11  A0 00      SUBA  $00,X          ; A = левая точка - величина
  CA13  40         NEGA
  CA14  27 2A      BEQ   loc_CA40       ; ровно в точке? да — доля 0
  CA16  E6 01      LDAB  $01,X          ; B = ширина интервала (со знаком плюс)
  CA18  E0 00      SUBB  $00,X
  CA1A  50         NEGB

;------------------------------------------------------------------------------
; DIV8 — деление «доля»: B = A * 256 / B. Условие: A < B.
; Обычное деление столбиком, 8 шагов. Биты частного копятся
; инвертированными и в конце переворачиваются (COMB).
;------------------------------------------------------------------------------
DIV8:                                   ; вызов из: TASK0, TASK1, TASK2, TASK3
  CA1B  37         PSHB                 ; делитель в стек
  CA1C  36         PSHA                 ; делимое в стек
  CA1D  34         DES                  ; место под счётчик шагов
  CA1E  30         TSX
  CA1F  86 08      LDAA  #$08           ; 8 шагов
  CA21  A7 00      STAA  $00,X          ; счётчик
  CA23  A6 01      LDAA  $01,X          ; A = делимое (остаток)
  CA25  C6 FF      LDAB  #$FF           ; частное: начальное значение FF (биты инвертированы)
  CA27  E7 01      STAB  $01,X          ; сохранить
  CA29  5F         CLRB                 ; B — старший разряд остатка

loc_CA2A:
  CA2A  48         ASLA                 ; сдвинуть остаток влево
  CA2B  59         ROLB                 ; перенос в B
  CA2C  A0 02      SUBA  $02,X          ; вычесть делитель
  CA2E  C2 00      SBCB  #$00           ; учесть заём
  CA30  24 04      BCC   loc_CA36       ; не ушли в минус? да — бит частного 1 (здесь пишется 0, он инвертирован)
  CA32  AB 02      ADDA  $02,X          ; ушли в минус — вернуть делитель назад
  CA34  C9 00      ADCB  #$00           ; перенос = 1 (бит частного 0, записывается инвертированным)

loc_CA36:
  CA36  69 01      ROL   $01,X          ; бит частного в результат
  CA38  6A 00      DEC   $00,X          ; следующий шаг
  CA3A  26 EE      BNE   loc_CA2A       ; шаги остались? да — повторить
  CA3C  32         PULA                 ; снять счётчик
  CA3D  33         PULB                 ; B = инвертированное частное
  CA3E  31         INS                  ; убрать делитель
  CA3F  53         COMB                 ; B = частное (доля 0...255)

loc_CA40:
  CA40  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; INTERP — линейная интерполяция между двумя соседними значениями таблицы.
; Вход: X -> таблица[i], B = доля (0...255).
; Выход: A = т[i] + (т[i+1] - т[i]) * доля / 256, с округлением.
;------------------------------------------------------------------------------
INTERP:                                 ; вызов из: TASK0, TASK1, TASK2, TASK3
  CA41  A6 00      LDAA  $00,X          ; т[i]
  CA43  36         PSHA                 ; в стек
  CA44  A6 01      LDAA  $01,X          ; т[i+1]
  CA46  36         PSHA                 ; в стек
  CA47  30         TSX                  ; X -> т[i+1] в стеке, за ним т[i]
  CA48  A6 00      LDAA  $00,X          ; A = т[i+1]; на его место ляжет знак
  CA4A  6F 00      CLR   $00,X          ; знак = 0 (рост)
  CA4C  A0 01      SUBA  $01,X          ; A = т[i+1] - т[i]
  CA4E  24 03      BCC   loc_CA53       ; таблица растёт? да — разность уже положительная
  CA50  40         NEGA                 ; убывает: модуль разности
  CA51  63 00      COM   $00,X          ; знак = FF (спад)

loc_CA53:
  CA53  3D         MUL                  ; разность * доля
  CA54  58         ASLB                 ; округление: старший бит младшего байта
  CA55  89 00      ADCA  #$00           ; прибавить его
  CA57  33         PULB                 ; B = знак
  CA58  5D         TSTB                 ; таблица растёт?
  CA59  27 01      BEQ   loc_CA5C       ; да — прибавлять
  CA5B  40         NEGA                 ; нет — вычитать

loc_CA5C:
  CA5C  33         PULB                 ; B = т[i]
  CA5D  1B         ABA                  ; A = т[i] + поправка
  CA5E  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; AXIS_UP — найти интервал на возрастающей оси.
; Вход: A = величина, X -> ось, B = число точек.
; Выход: X -> левая точка интервала, B = её номер, A = величина.
; Ниже первой точки — номер 0 и A = первая точка (доля выйдет 0).
; Выше последней — последняя точка и A = её значение.
;------------------------------------------------------------------------------
AXIS_UP:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  CA5F  36         PSHA                 ; сохранить величину
  CA60  37         PSHB                 ; сохранить число точек

loc_CA61:
  CA61  A1 00      CMPA  $00,X          ; величина меньше этой точки?
  CA63  25 17      BCS   loc_CA7C       ; да — интервал найден
  CA65  08         INX                  ; следующая точка
  CA66  5A         DECB                 ; точек осталось?
  CA67  27 0C      BEQ   loc_CA75       ; нет — вышли за конец оси
  CA69  20 F6      BRA   loc_CA61       ; к следующей

;------------------------------------------------------------------------------
; AXIS_DN — то же для убывающей оси (например, температура по АЦП:
; чем холоднее, тем больше число).
;------------------------------------------------------------------------------
AXIS_DN:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  CA6B  36         PSHA                 ; сохранить величину
  CA6C  37         PSHB                 ; сохранить число точек

loc_CA6D:
  CA6D  A1 00      CMPA  $00,X          ; величина больше этой точки?
  CA6F  22 0B      BHI   loc_CA7C       ; да — интервал найден
  CA71  08         INX                  ; следующая точка
  CA72  5A         DECB                 ; точек осталось?
  CA73  26 F8      BNE   loc_CA6D       ; да — дальше

loc_CA75:
  CA75  33         PULB                 ; вышли за конец: B = число точек
  CA76  32         PULA                 ; A = величина
  CA77  5A         DECB                 ; номер последней точки
  CA78  09         DEX                  ; X -> последняя точка

loc_CA79:
  CA79  A6 00      LDAA  $00,X          ; A = значение точки (доля будет 0)
  CA7B  39         RTS                  ; возврат

loc_CA7C:
  CA7C  32         PULA                 ; A = число точек
  CA7D  10         SBA                  ; A = номер найденной точки
  CA7E  16         TAB                  ; в B
  CA7F  27 04      BEQ   loc_CA85       ; это первая точка (величина за началом оси)?
  CA81  5A         DECB                 ; нет — левая точка = предыдущая
  CA82  09         DEX                  ; X -> левая точка
  CA83  32         PULA                 ; A = величина
  CA84  39         RTS                  ; возврат

loc_CA85:
  CA85  32         PULA                 ; снять величину; A = первая точка
  CA86  20 F1      BRA   loc_CA79       ; к общему выходу

;------------------------------------------------------------------------------
; СБРОС. Стек $8290. Полный сброс проверяет ОЗУ с $8000; повторный пуск после
; остановки мотора (D12A) — с $8005, чтобы сохранить коды ($8000-$8002) и
; атмосферное давление ($8004).
; Регистры процессора: RMCR = $06 (скорость SCI [?]), RP5CR = $C1 (внутреннее ОЗУ,
; IRQ1), TRCSR1 = $1A (приём, передача, прерывание приёма), TCSR1 = $18 (прерывания
; захвата и сравнения 1 [Пр]), TCSR2 = $09 (выход OC1 = N7 [Пр]), PORT2 = $20,
; PORT6 = $20 (N17 закрыта, насос выключен), P2DDR = $02 (P21-P27 выходы),
; P6DDR = $F9 (P62, P61 — входы: кодировка, Холл).
;------------------------------------------------------------------------------
RESET:                                  ; вызов из: IRQ1, RES, SWI, TRAP
  CA88  8E 82 90   LDS   #$8290         ; стек
  CA8B  CE 80 00   LDX   #$8000         ; проверка ОЗУ с $8000

loc_CA8E:
  CA8E  86 06      LDAA  #$06           ; RMCR
  CA90  97 10      STAA  RMCR           ; скорость SCI
  CA92  86 C1      LDAA  #$C1           ; RP5CR = $C1
  CA94  D6 14      LDAB  RP5CR          ; старое значение (бит 7 — питание ОЗУ сохранялось)
  CA96  97 14      STAA  RP5CR          ; записать
  CA98  86 1A      LDAA  #$1A           ; SCI: приём, передача, прерывание приёма
  CA9A  97 11      STAA  TRCSR1         ; записать
  CA9C  86 18      LDAA  #$18           ; таймер 1
  CA9E  97 08      STAA  TCSR1          ; записать
  CAA0  86 09      LDAA  #$09           ; таймер 1, часть 2
  CAA2  97 0F      STAA  TCSR2          ; записать
  CAA4  86 20      LDAA  #$20           ; PORT2.5 = 1
  CAA6  97 03      STAA  PORT2          ; записать
  CAA8  86 20      LDAA  #$20           ; PORT6.5 = 1 (N17 закрыта), PORT6.6 = 0 (насос выключен)
  CAAA  97 17      STAA  PORT6          ; записать
  CAAC  86 02      LDAA  #$02           ; P21-P27 — выходы
  CAAE  97 01      STAA  P2DDR          ; записать
  CAB0  86 F9      LDAA  #$F9           ; P60, P63-P67 — выходы
  CAB2  97 16      STAA  P6DDR          ; записать
  CAB4  3C         PSHX                 ; начало проверки ОЗУ
  CAB5  37         PSHB                 ; старый RP5CR
  CAB6  CE CB 91   LDX   #$CB91         ; таблица настройки чипа CB91 (пары номер/значение)

loc_CAB9:
  CAB9  EC 00      LDD   $00,X          ; пара
  CABB  FD 01 00   STD   $0100          ; записать в чип
  CABE  08         INX                  ; следующая
  CABF  08         INX                  ; (+2)
  CAC0  8C CB B1   CPX   #$CBB1         ; все 16?
  CAC3  26 F4      BNE   loc_CAB9       ; нет
  CAC5  33         PULB                 ; старый RP5CR
  CAC6  5D         TSTB                 ; питание внутреннего ОЗУ сохранялось?
  CAC7  2A 43      BPL   loc_CB0C       ; нет — копия ошибок недостоверна
  CAC9  CE 00 41   LDX   #$0041         ; копия ошибок
  CACC  4F         CLRA                 ; сумма = 0

loc_CACD:
  CACD  AB 00      ADDA  $00,X          ; + байт
  CACF  08         INX                  ; следующий
  CAD0  8C 00 46   CPX   #$0046         ; до $45
  CAD3  26 F8      BNE   loc_CACD       ; повторить
  CAD5  91 40      CMPA  $40            ; сумма верна?
  CAD7  26 33      BNE   loc_CB0C       ; нет
  CAD9  38         PULX                 ; начало
  CADA  CC 55 AA   LDD   #$55AA         ; образцы $55 и $AA

loc_CADD:
  CADD  A7 00      STAA  $00,X          ; записать $55
  CADF  A1 00      CMPA  $00,X          ; прочиталось?
  CAE1  26 4B      BNE   loc_CB2E       ; нет — ОЗУ неисправно
  CAE3  E7 00      STAB  $00,X          ; записать $AA
  CAE5  E1 00      CMPB  $00,X          ; прочиталось?
  CAE7  26 45      BNE   loc_CB2E       ; нет — ОЗУ неисправно
  CAE9  6F 00      CLR   $00,X          ; очистить
  CAEB  08         INX                  ; следующий
  CAEC  8C 82 91   CPX   #$8291         ; до $8290
  CAEF  25 EC      BCS   loc_CADD       ; повторить
  CAF1  96 41      LDAA  $41            ; вернуть коды из копии
  CAF3  B7 80 00   STAA  $8000          ; (то же)
  CAF6  96 42      LDAA  $42            ; (то же)
  CAF8  B7 80 01   STAA  $8001          ; (то же)
  CAFB  96 43      LDAA  $43            ; (то же)
  CAFD  B7 80 02   STAA  $8002          ; (то же)
  CB00  96 44      LDAA  $44            ; счётчик пусков
  CB02  B7 80 2B   STAA  $802B          ; (то же)
  CB05  96 45      LDAA  $45            ; $802C
  CB07  B7 80 2C   STAA  $802C          ; (то же)
  CB0A  20 1D      BRA   loc_CB29       ; проверить внутреннее ОЗУ

loc_CB0C:
  CB0C  38         PULX                 ; начало
  CB0D  CC 55 AA   LDD   #$55AA         ; образцы

loc_CB10:
  CB10  A7 00      STAA  $00,X          ; записать $55
  CB12  A1 00      CMPA  $00,X          ; прочиталось?
  CB14  26 18      BNE   loc_CB2E       ; нет — неисправно
  CB16  E7 00      STAB  $00,X          ; записать $AA
  CB18  E1 00      CMPB  $00,X          ; прочиталось?
  CB1A  26 12      BNE   loc_CB2E       ; нет — неисправно
  CB1C  6F 00      CLR   $00,X          ; очистить
  CB1E  08         INX                  ; следующий
  CB1F  8C 01 00   CPX   #$0100         ; конец внутреннего ОЗУ ($0100)?
  CB22  27 0F      BEQ   loc_CB33       ; да — готово
  CB24  8C 82 91   CPX   #$8291         ; конец внешнего?
  CB27  25 E7      BCS   loc_CB10       ; нет

loc_CB29:
  CB29  CE 00 40   LDX   #$0040         ; дальше внутреннее $40-$FF
  CB2C  20 E2      BRA   loc_CB10       ; проверять

loc_CB2E:
  CB2E  86 80      LDAA  #$80           ; ОЗУ неисправно: ошибка ЭБУ (1111)
  CB30  B7 80 95   STAA  $8095          ; записать

loc_CB33:
  CB33  71 BF 14   AIM   #$BF,RP5CR     ; выключить внутреннее ОЗУ
  CB36  86 A8      LDAA  #$A8           ; режим: пуск ($A8)
  CB38  B7 80 29   STAA  $8029          ; записать
  CB3B  B6 C6 CB   LDAA  $C6CB          ; угол пуска 50
  CB3E  C6 C0      LDAB  #$C0           ; × 0,75
  CB40  3D         MUL                  ; (то же)
  CB41  58         ASLB                 ; округлить
  CB42  89 00      ADCA  #$00           ; (то же)
  CB44  B7 80 23   STAA  $8023          ; выдаваемый угол
  CB47  86 FF      LDAA  #$FF           ; таймаут K-линии не идёт
  CB49  B7 80 FD   STAA  $80FD          ; записать
  CB4C  86 6C      LDAA  #$6C           ; предел угла 108
  CB4E  B7 80 8E   STAA  $808E          ; записать
  CB51  86 08      LDAA  #$08           ; усиление 8
  CB53  B7 08 00   STAA  $0800          ; защёлка усилителя
  CB56  CC 5F 00   LDD   #$5F00         ; середина
  CB59  FD 80 59   STD   $8059          ; интегратор лямбды
  CB5C  CE 01 00   LDX   #$0100         ; чип
  CB5F  86 1F      LDAA  #$1F           ; регистр состояния $1F
  CB61  A7 00      STAA  $00,X          ; выбрать

loc_CB63:
  CB63  E6 01      LDAB  $01,X          ; состояние
  CB65  C5 20      BITB  #$20           ; чип готов (бит 5)?
  CB67  27 FA      BEQ   loc_CB63       ; нет — ждать
  CB69  CC 1D A0   LDD   #$1DA0         ; маска событий: цилиндр и тик
  CB6C  F7 80 05   STAB  $8005          ; у себя
  CB6F  ED 00      STD   $00,X          ; записать
  CB71  CC 1C 25   LDD   #$1C25         ; режим чипа $25 (поиск синхронизации)
  CB74  ED 00      STD   $00,X          ; записать
  CB76  CC 1E FF   LDD   #$1EFF         ; снять все события
  CB79  ED 00      STD   $00,X          ; записать
  CB7B  0E         CLI                  ; разрешить прерывания

;------------------------------------------------------------------------------
; ФОНОВЫЙ ЦИКЛ: всё время, свободное от прерываний, — контрольная сумма ПЗУ.
; Сумма всех байт $C000-$FFFF (8 бит) должна быть 0, иначе ошибка ЭБУ 1111
; ($8095.6). Любая правка прошивки должна сохранять эту сумму.
;------------------------------------------------------------------------------
BG_LOOP:
  CB7C  CE C0 00   LDX   #$C000         ; начало ПЗУ
  CB7F  4F         CLRA                 ; сумма = 0

loc_CB80:
  CB80  AB 00      ADDA  $00,X          ; + байт
  CB82  08         INX                  ; следующий
  CB83  26 FB      BNE   loc_CB80       ; до $FFFF
  CB85  4D         TSTA                 ; сумма 0?
  CB86  27 F4      BEQ   BG_LOOP        ; да — заново
  CB88  CE 80 00   LDX   #$8000         ; X = $8000
  CB8B  62 40 95   OIM   #$40,$95,X     ; ошибка ПЗУ (1111)
  CB8E  20 EC      BRA   BG_LOOP        ; заново

; таблица $CB90, 1 байт: байт $0A без ссылок — вероятно, подгонка контрольной суммы ПЗУ к 0 [Пр]
  CB90  db 0A

; таблица $CB91, 32 байт: настройка чипа $0100 (номер, значение): 00 FF, 01 6C (108 полузубьев = 144°), 02 2D, 03 1B, 05 00, 06 05, 07 06, 08 03, 09 FF, 0A FF, 0B 00, 0C 33, 0D 76, 18 04, 19 00, 1F 00
  CB91  db 00 FF 01 6C 02 2D 03 1B 05 00 06 05 07 06 08 03
  CBA1  db 09 FF 0A FF 0B 00 0C 33 0D 76 18 04 19 00 1F 00

;------------------------------------------------------------------------------
; IRQ1 — ПРЕРЫВАНИЕ ОТ ЧИПА $0100. Регистр $1E чипа — какие события пришли
; (с маской $8005). Запись бита обратно в $1E снимает событие.
;  бит 7 — событие цилиндра (каждые 144° коленвала): синхронизация, искра (CC83);
;  бит 6 — окно детонации: открытие/закрытие, замер (CBDB);
;  бит 2 — момент начала накопления катушки (CC74);
;  бит 5 — тик (≈10 мс) -> D0E3 и диспетчер задач.
;  бит 1 (внутри события цилиндра) — метка G4.
;------------------------------------------------------------------------------
IRQ1:                                   ; вызов из: IRQ1
  CBB1  CE 01 00   LDX   #$0100         ; X -> чип
  CBB4  86 1E      LDAA  #$1E           ; регистр событий $1E
  CBB6  A7 00      STAA  $00,X          ; выбрать
  CBB8  E6 01      LDAB  $01,X          ; события
  CBBA  F4 80 05   ANDB  $8005          ; только разрешённые ($8005)
  CBBD  5D         TSTB                 ; событие цилиндра (бит 7)?
  CBBE  2A 03      BPL   loc_CBC3       ; нет
  CBC0  7E CC 83   JMP   loc_CC83       ; да — цилиндр

loc_CBC3:
  CBC3  C5 40      BITB  #$40           ; окно детонации?
  CBC5  26 14      BNE   loc_CBDB       ; да
  CBC7  C5 04      BITB  #$04           ; накопление катушки?
  CBC9  27 03      BEQ   loc_CBCE       ; нет
  CBCB  7E CC 74   JMP   loc_CC74       ; да

loc_CBCE:
  CBCE  C5 20      BITB  #$20           ; тик?
  CBD0  26 01      BNE   loc_CBD3       ; да
  CBD2  3B         RTI                  ; ничего — выйти

loc_CBD3:
  CBD3  C6 20      LDAB  #$20           ; снять событие тика
  CBD5  E7 01      STAB  $01,X          ; записать
  CBD7  0E         CLI                  ; разрешить вложенные прерывания
  CBD8  7E D0 E3   JMP   loc_D0E3       ; обработка тика

;------------------------------------------------------------------------------
; ОКНО ДЕТОНАЦИИ. Два хода: открытие окна ($80B5.7 = 1) и закрытие.
; Закрытие: PORT6.0 = 0, конец окна = начало + $80B8, PORT6.3 = 0 (импульс тахометра,
; контакт 7 [Пр]). Открытие: запуск АЦП канала 6 (интегратор), замер = $80EC - результат
; -> запись цилиндра +2, новый замер (+0 бит 7), усиление следующего цилиндра в
; защёлку $0800 (бит 4 — датчик G66, по таблице C910). Тестер командой $1B может
; задать своё значение защёлки ($8205).
;------------------------------------------------------------------------------
loc_CBDB:
  CBDB  C6 40      LDAB  #$40           ; снять событие
  CBDD  E7 01      STAB  $01,X          ; записать
  CBDF  B6 80 B5   LDAA  $80B5          ; фаза окна
  CBE2  85 80      BITA  #$80           ; окно открыто?
  CBE4  27 1C      BEQ   loc_CC02       ; нет — открыть
  CBE6  71 FE 17   AIM   #$FE,PORT6     ; PORT6.0 = 0 (стоп интегратору [Пр])
  CBE9  84 7F      ANDA  #$7F           ; фаза: закрыто
  CBEB  B7 80 B5   STAA  $80B5          ; записать
  CBEE  86 00      LDAA  #$00           ; регистр $00 — момент следующего события окна
  CBF0  F6 80 B8   LDAB  $80B8          ; начало окна
  CBF3  FB 80 B9   ADDB  $80B9          ; + длина окна
  CBF6  ED 00      STD   $00,X          ; записать
  CBF8  B6 80 96   LDAA  $8096          ; цилиндр
  CBFB  B7 80 BC   STAA  $80BC          ; запомнить, чей замер
  CBFE  71 F7 17   AIM   #$F7,PORT6     ; PORT6.3 = 0: тахометр (контакт 7) [Пр]
  CC01  3B         RTI                  ; выйти

loc_CC02:
  CC02  CE 14 06   LDX   #$1406         ; АЦП канал 6
  CC05  FF 01 00   STX   $0100          ; запуск
  CC08  7F 80 2A   CLR   $802A          ; АЦП занят прерыванием (задача 0 повторит своё)
  CC0B  F6 80 BC   LDAB  $80BC          ; цилиндр замера
  CC0E  58         ASLB                 ; × 8
  CC0F  58         ASLB                 ; (то же)
  CC10  58         ASLB                 ; (то же)
  CC11  CE 80 C0   LDX   #$80C0         ; записи цилиндров
  CC14  3A         ABX                  ; X -> запись
  CC15  E6 07      LDAB  $07,X          ; новое усиление
  CC17  E7 01      STAB  $01,X          ; стало текущим
  CC19  62 80 00   OIM   #$80,$00,X     ; новый замер готов
  CC1C  3C         PSHX                 ; сохранить X
  CC1D  CE 01 00   LDX   #$0100         ; X -> чип
  CC20  86 00      LDAA  #$00           ; регистр $00
  CC22  F6 80 B7   LDAB  $80B7          ; начало окна $80B7
  CC25  F7 80 B9   STAB  $80B9          ; запомнить
  CC28  ED 00      STD   $00,X          ; записать
  CC2A  86 14      LDAA  #$14           ; регистр результата АЦП
  CC2C  A7 00      STAA  $00,X          ; выбрать
  CC2E  B6 80 EC   LDAA  $80EC          ; опора (замер в начале цилиндра)
  CC31  B0 01 01   SUBA  $0101          ; - результат = замер
  CC34  72 01 17   OIM   #$01,PORT6     ; PORT6.0 = 1
  CC37  24 01      BCC   loc_CC3A       ; не меньше нуля
  CC39  4F         CLRA                 ; 0

loc_CC3A:
  CC3A  38         PULX                 ; вернуть X
  CC3B  A7 02      STAA  $02,X          ; +2 = замер
  CC3D  86 80      LDAA  #$80           ; фаза: открыто
  CC3F  BA 80 B5   ORAA  $80B5          ; поставить
  CC42  B7 80 B5   STAA  $80B5          ; записать
  CC45  F6 80 BC   LDAB  $80BC          ; цилиндр
  CC48  5C         INCB                 ; следующий
  CC49  C1 05      CMPB  #$05           ; 5?
  CC4B  25 01      BCS   loc_CC4E       ; нет
  CC4D  5F         CLRB                 ; 0

loc_CC4E:
  CC4E  58         ASLB                 ; × 8
  CC4F  58         ASLB                 ; (то же)
  CC50  58         ASLB                 ; (то же)
  CC51  CE 80 C0   LDX   #$80C0         ; записи
  CC54  3A         ABX                  ; X -> запись следующего
  CC55  A6 07      LDAA  $07,X          ; его усиление
  CC57  F6 80 F7   LDAB  $80F7          ; режим тестера $1B?
  CC5A  C5 01      BITB  #$01           ; проверить
  CC5C  27 03      BEQ   loc_CC61       ; нет
  CC5E  B6 82 05   LDAA  $8205          ; значение от тестера

loc_CC61:
  CC61  84 EF      ANDA  #$EF           ; бит 4 снять
  CC63  CE C9 10   LDX   #$C910         ; таблица датчиков C910
  CC66  F6 80 BC   LDAB  $80BC          ; цилиндр
  CC69  3A         ABX                  ; X -> значение
  CC6A  E6 00      LDAB  $00,X          ; датчик
  CC6C  27 02      BEQ   loc_CC70       ; G61 — бит 4 = 0
  CC6E  8A 10      ORAA  #$10           ; G66 — бит 4 = 1

loc_CC70:
  CC70  B7 08 00   STAA  $0800          ; защёлка усилителя $0800
  CC73  3B         RTI                  ; выйти

;------------------------------------------------------------------------------
; Начало накопления катушки: регистр $03 = $8024 + $8056 (поправка на разницу
; отвода соседних цилиндров, чтобы время накопления не менялось).
;------------------------------------------------------------------------------
loc_CC74:
  CC74  C6 04      LDAB  #$04           ; снять событие
  CC76  E7 01      STAB  $01,X          ; записать
  CC78  86 03      LDAA  #$03           ; регистр $03
  CC7A  F6 80 24   LDAB  $8024          ; начало накопления
  CC7D  FB 80 56   ADDB  $8056          ; + поправка
  CC80  ED 00      STD   $00,X          ; записать
  CC82  3B         RTI                  ; выйти

;------------------------------------------------------------------------------
; СОБЫТИЕ ЦИЛИНДРА. До синхронизации — поиск: метка G4 при низком Холле
; (PORT6.1 = 0) — первый цилиндр в такте сжатия, синхронизация есть.
; 11 событий без метки — ошибка G4 (2112). 4 метки при высоком Холле — ошибка
; Холла (2113). После синхронизации — CD9C.
;------------------------------------------------------------------------------
loc_CC83:
  CC83  C6 80      LDAB  #$80           ; снять событие
  CC85  E7 01      STAB  $01,X          ; записать
  CC87  96 17      LDAA  PORT6          ; порт 6 (Холл — бит 1)
  CC89  C6 20      LDAB  #$20           ; синхронизация есть?
  CC8B  F5 80 95   BITB  $8095          ; проверить
  CC8E  27 03      BEQ   loc_CC93       ; нет
  CC90  7E CD 9C   JMP   loc_CD9C       ; да

loc_CC93:
  CC93  72 01 17   OIM   #$01,PORT6     ; PORT6.0 = 1
  CC96  C6 02      LDAB  #$02           ; метка G4?
  CC98  E5 01      BITB  $01,X          ; проверить
  CC9A  26 1A      BNE   loc_CCB6       ; да
  CC9C  F6 80 18   LDAB  $8018          ; обороты
  CC9F  C0 01      SUBB  #$01           ; ноль?
  CCA1  25 35      BCS   loc_CCD8       ; да — выйти
  CCA3  7C 80 96   INC   $8096          ; событий без метки + 1
  CCA6  F6 80 96   LDAB  $8096          ; значение
  CCA9  C0 0B      SUBB  #$0B           ; 11?
  CCAB  25 2B      BCS   loc_CCD8       ; нет — выйти
  CCAD  86 30      LDAA  #$30           ; ошибка G4 (2112)
  CCAF  BA 80 94   ORAA  $8094          ; поставить
  CCB2  B7 80 94   STAA  $8094          ; записать
  CCB5  3B         RTI                  ; выйти

loc_CCB6:
  CCB6  E7 01      STAB  $01,X          ; снять метку
  CCB8  7F 80 96   CLR   $8096          ; счётчик цилиндров = 0
  CCBB  F6 80 18   LDAB  $8018          ; обороты
  CCBE  C0 01      SUBB  #$01           ; ноль?
  CCC0  25 16      BCS   loc_CCD8       ; да — выйти
  CCC2  85 02      BITA  #$02           ; Холл высокий?
  CCC4  27 13      BEQ   loc_CCD9       ; нет — синхронизация
  CCC6  7C 80 97   INC   $8097          ; метка при высоком Холле + 1
  CCC9  F6 80 97   LDAB  $8097          ; значение
  CCCC  C0 04      SUBB  #$04           ; 4?
  CCCE  25 08      BCS   loc_CCD8       ; нет — выйти
  CCD0  86 0C      LDAA  #$0C           ; ошибка Холла (2113)
  CCD2  BA 80 94   ORAA  $8094          ; поставить
  CCD5  B7 80 94   STAA  $8094          ; записать

loc_CCD8:
  CCD8  3B         RTI                  ; выйти

loc_CCD9:
  CCD9  86 20      LDAA  #$20           ; СИНХРОНИЗАЦИЯ ЕСТЬ ($8095.5)
  CCDB  BA 80 95   ORAA  $8095          ; поставить
  CCDE  B7 80 95   STAA  $8095          ; записать
  CCE1  86 57      LDAA  #$57           ; подозрения синхронизации снять
  CCE3  B4 80 94   ANDA  $8094          ; снять
  CCE6  B7 80 94   STAA  $8094          ; записать
  CCE9  72 40 17   OIM   #$40,PORT6     ; PORT6.6 = 1: реле насоса J17 включить
  CCEC  5F         CLRB                 ; 0
  CCED  F7 80 96   STAB  $8096          ; цилиндр 0
  CCF0  F7 80 97   STAB  $8097          ; счётчик Холла 0
  CCF3  BD F7 26   JSR   TEST_EXIT      ; выйти из теста исполнителей
  CCF6  CC 1C 27   LDD   #$1C27         ; чип: регистр $1C = $27 (режим по цилиндрам)
  CCF9  ED 00      STD   $00,X          ; записать
  CCFB  CC 1D E4   LDD   #$1DE4         ; регистр $1D = $E4 (маска событий)
  CCFE  F7 80 05   STAB  $8005          ; та же маска у себя
  CD01  ED 00      STD   $00,X          ; записать
  CD03  CC 06 32   LDD   #$0632         ; регистр $06 = $32 [?]
  CD06  ED 00      STD   $00,X          ; записать
  CD08  CC 14 06   LDD   #$1406         ; АЦП канал 6
  CD0B  ED 00      STD   $00,X          ; запуск
  CD0D  86 00      LDAA  #$00           ; регистр $00
  CD0F  F6 80 B7   LDAB  $80B7          ; начало окна
  CD12  F7 80 B9   STAB  $80B9          ; запомнить
  CD15  ED 00      STD   $00,X          ; записать
  CD17  86 80      LDAA  #$80           ; окно открыто
  CD19  BA 80 B5   ORAA  $80B5          ; поставить
  CD1C  B7 80 B5   STAA  $80B5          ; записать
  CD1F  F6 80 96   LDAB  $8096          ; цилиндр
  CD22  58         ASLB                 ; × 8
  CD23  58         ASLB                 ; (то же)
  CD24  58         ASLB                 ; (то же)
  CD25  CE 80 C0   LDX   #$80C0         ; записи
  CD28  3A         ABX                  ; X -> запись
  CD29  A6 07      LDAA  $07,X          ; усиление
  CD2B  84 EF      ANDA  #$EF           ; бит 4 снять
  CD2D  CE C9 10   LDX   #$C910         ; таблица датчиков
  CD30  F6 80 96   LDAB  $8096          ; цилиндр
  CD33  3A         ABX                  ; X -> значение
  CD34  E6 00      LDAB  $00,X          ; датчик
  CD36  27 02      BEQ   loc_CD3A       ; G61
  CD38  8A 10      ORAA  #$10           ; G66

loc_CD3A:
  CD3A  B7 08 00   STAA  $0800          ; защёлка усилителя
  CD3D  86 14      LDAA  #$14           ; регистр результата АЦП
  CD3F  B7 01 00   STAA  $0100          ; выбрать
  CD42  B6 01 01   LDAA  $0101          ; результат
  CD45  B7 80 EC   STAA  $80EC          ; опора замера

;------------------------------------------------------------------------------
; Счёт пусков без новых ошибок (раз за включение, при синхронизации).
; 50 пусков ($32) без изменений в памяти ошибок — автоматическое стирание
; ($8092.1). Если память восстановлена из внутреннего ОЗУ — счёт ведётся
; в копии ($44) с поправкой контрольной суммы ($40).
;------------------------------------------------------------------------------
  CD48  C6 32      LDAB  #$32           ; порог 50
  CD4A  CE 80 00   LDX   #$8000         ; X = $8000
  CD4D  7B 40 14   TIM   #$40,RP5CR     ; внутреннее ОЗУ включено?
  CD50  27 03      BEQ   loc_CD55       ; нет
  CD52  62 04 03   OIM   #$04,$03,X     ; отметить $8003.2

loc_CD55:
  CD55  6B 08 03   TIM   #$08,$03,X     ; память восстановлена ($8003.3)?
  CD58  26 0E      BNE   loc_CD68       ; да — считать в копии
  CD5A  61 7F 2C   AIM   #$7F,$2C,X     ; снять «коды показаны»
  CD5D  7C 80 2B   INC   $802B          ; пусков + 1
