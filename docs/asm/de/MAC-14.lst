  EBBC  B0 80 04   SUBA  $8004          ; minus Luftdruck
  EBBF  24 01      BCC   loc_EBC2       ; Differenz positiv? ja: weiter
  EBC1  40         NEGA                 ; Betrag

loc_EBC2:
  EBC2  B1 C7 A0   CMPA  $C7A0          ; kleiner als C7A0 = 13?
  EBC5  24 03      BCC   loc_EBCA       ; nein: Druck hat sich bewegt
