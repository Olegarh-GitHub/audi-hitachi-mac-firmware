  EB76  0D         SEC                  ; C = 1
  EB77  39         RTS                  ; возврат

loc_EB78:
  EB78  0C         CLC                  ; C = 0
  EB79  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; RD_INPUTS — регистр $19 чипа: бит 5 F60, бит 4 F81 [Пр по сходству с MAC-14].
;------------------------------------------------------------------------------
RD_INPUTS:                              ; вызов из: TASK0, TASK1, TASK2, TASK3
  EB7A  86 19      LDAA  #$19           ; регистр $19

CHIP_RD:                                ; вызов из: TASK0, TASK1, TASK2, TASK3
  EB7C  0F         SEI                  ; запрет прерываний
  EB7D  B7 01 00   STAA  $0100          ; номер регистра
  EB80  B6 01 01   LDAA  $0101          ; данные
  EB83  0E         CLI                  ; разрешить прерывания
  EB84  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; ЗАДАЧА 0. PORT6.7 переключается («программа работает»). PORT2.3 [?] = 1 при
; оборотах ≥ 20 ед. после синхронизации (у MAC-14 то же делает PORT2.5).
; АЦП: кан. 0 -> $5A (давление G71), 1 -> $5B (напряжение), 2 -> $5C (G62),
; кан. 3 (лямбда у MAC-14) НЕ читается, 4 -> $5D (один раз после синхронизации),
; 5 -> $5E, 6 (детонация) не читается, 7 -> $5F (G42).
;------------------------------------------------------------------------------
TASK0:                                  ; вызов из: TASK0
  EB85  75 80 17   EIM   #$80,PORT6     ; переключить PORT6.7
  EB88  5F         CLRB                 ; канал 0
  EB89  CE 00 5A   LDX   #$005A         ; X -> $5A
  EB8C  7B 20 BC   TIM   #$20,$BC       ; синхронизация?
  EB8F  27 29      BEQ   loc_EBBA       ; нет — PORT2.3 не трогать
  EB91  96 59      LDAA  $59            ; обороты
  EB93  81 14      CMPA  #$14           ; ниже 20 ед.?
  EB95  24 05      BCC   loc_EB9C       ; нет
  EB97  71 F7 03   AIM   #$F7,PORT2     ; PORT2.3 = 0
  EB9A  20 03      BRA   loc_EB9F       ; дальше

loc_EB9C:
  EB9C  72 08 03   OIM   #$08,PORT2     ; PORT2.3 = 1

loc_EB9F:
  EB9F  08         INX                  ; следующая ячейка

loc_EBA0:
  EBA0  5C         INCB                 ; следующий канал
  EBA1  C1 04      CMPB  #$04           ; канал 4?
  EBA3  26 0D      BNE   loc_EBB2       ; нет
  EBA5  7B 20 BC   TIM   #$20,$BC       ; синхронизация?
  EBA8  27 F5      BEQ   loc_EB9F       ; нет — пропустить
  EBAA  7B 01 9C   TIM   #$01,$9C       ; канал 4 уже читали?
  EBAD  26 F0      BNE   loc_EB9F       ; да — пропустить
  EBAF  72 01 9C   OIM   #$01,$9C       ; отметить ($9C.0)

loc_EBB2:
  EBB2  C1 03      CMPB  #$03           ; канал 3 (лямбды нет)?
  EBB4  27 EA      BEQ   loc_EBA0       ; да — пропустить, ячейку не сдвигать
  EBB6  C1 06      CMPB  #$06           ; канал 6?
  EBB8  27 E6      BEQ   loc_EBA0       ; да — пропустить

loc_EBBA:
  EBBA  86 14      LDAA  #$14           ; регистр $14 — запуск АЦП
  EBBC  0F         SEI                  ; запрет прерываний
  EBBD  97 69      STAA  $69            ; метка «АЦП занят задачей 0»
  EBBF  FD 01 00   STD   $0100          ; запуск, канал = B
  EBC2  0E         CLI                  ; разрешить прерывания

loc_EBC3:
  EBC3  86 1F      LDAA  #$1F           ; регистр состояния $1F
  EBC5  8D B5      BSR   CHIP_RD        ; прочитать
  EBC7  2B FA      BMI   loc_EBC3       ; ещё идёт — ждать
  EBC9  0F         SEI                  ; запрет прерываний
  EBCA  96 69      LDAA  $69            ; метка на месте?
  EBCC  27 EC      BEQ   loc_EBBA       ; нет — повторить
  EBCE  86 14      LDAA  #$14           ; регистр результата
  EBD0  8D AA      BSR   CHIP_RD        ; прочитать
  EBD2  A7 00      STAA  $00,X          ; записать в ячейку
  EBD4  8C 00 5F   CPX   #$005F         ; последняя ($5F)?
  EBD7  26 C6      BNE   loc_EB9F       ; нет — следующий канал

;------------------------------------------------------------------------------
; Канал 5 ($5E) — линия диагностики [Пр]: у 1B блинк-коды вызывают перемычкой на
; реле J17 (контакт 31). Ниже 33 (E45D) — $9E.2 «линия внизу»; от 230 — $9E.1
; «линия вверху». Иначе оба сняты. Пока $D1.7 = 0 и линия не внизу — выход из теста
; исполнителей (FEFA) [?].
;------------------------------------------------------------------------------
  EBD9  96 5E      LDAA  $5E            ; канал 5
  EBDB  B1 E4 5D   CMPA  $E45D          ; ниже E45D = 33?
  EBDE  24 05      BCC   loc_EBE5       ; нет
  EBE0  72 04 9E   OIM   #$04,$9E       ; линия внизу ($9E.2)
  EBE3  20 11      BRA   loc_EBF6       ; дальше

loc_EBE5:
  EBE5  71 FB 9E   AIM   #$FB,$9E       ; снять «внизу»
  EBE8  7B 80 D1   TIM   #$80,$D1       ; $D1.7?
  EBEB  26 03      BNE   loc_EBF0       ; стоит
  EBED  BD FE FA   JSR   TEST_EXIT      ; выйти из теста исполнителей

loc_EBF0:
  EBF0  96 5E      LDAA  $5E            ; канал 5
  EBF2  81 E6      CMPA  #$E6           ; 230 и выше?
  EBF4  24 05      BCC   loc_EBFB       ; да

loc_EBF6:
  EBF6  71 FD 9E   AIM   #$FD,$9E       ; снять «вверху»
  EBF9  20 03      BRA   loc_EBFE       ; дальше

loc_EBFB:
  EBFB  72 02 9E   OIM   #$02,$9E       ; линия вверху ($9E.1)

;------------------------------------------------------------------------------
; Обрыв и замыкание датчиков температуры — пороги и подстановки как в MAC-14:
; G42 < 16 или > 235 -> 194 (−20 °C); G62 < 8 или > 228 -> 30 (80 °C). Флаги $B9.
; Температурные признаки $9C: бит 4 — G62 ≤ 90; бит 3 — ≤ 169; бит 2 — ≤ 17
; (у MAC-14 14); бит 1 — ниже 39 (≈70 °C; у MAC-14 44 ≈ 65 °C), снимается от 44.
;------------------------------------------------------------------------------
loc_EBFE:
  EBFE  D6 B9      LDAB  $B9            ; флаги температур
  EC00  C4 3F      ANDB  #$3F           ; «сейчас» снять
  EC02  96 5F      LDAA  $5F            ; G42
  EC04  B1 E4 3B   CMPA  $E43B          ; ниже 16?
  EC07  24 04      BCC   loc_EC0D       ; нет
  EC09  CA A0      ORAB  #$A0           ; G42 замкнут
  EC0B  20 07      BRA   loc_EC14       ; подставить

loc_EC0D:
  EC0D  B1 E4 3A   CMPA  $E43A          ; выше 235?
  EC10  23 07      BLS   loc_EC19       ; нет — исправен
  EC12  CA 90      ORAB  #$90           ; G42 оборван

loc_EC14:
