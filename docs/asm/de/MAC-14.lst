  EF90  ED ED      STD   $ED,X          ; $80ED/$80EE = 0
  EF92  ED 9B      STD   $9B,X          ; Zähler der Schalterprüfung
  EF94  ED 9D      STD   $9D,X          ; und G71
  EF96  6F AE      CLR   $AE,X          ; Zähler L-Leitung
  EF98  6B 20 95   TIM   #$20,$95,X     ; Synchronisation vorhanden?
  EF9B  26 02      BNE   loc_EF9F       ; ja: Zylinderzähler nicht anfassen
  EF9D  6F 96      CLR   $96,X          ; nein: Zylinderzähler auf null

loc_EF9F:
  EF9F  6F 00      CLR   $00,X          ; Codebyte 1
  EFA1  6F 01      CLR   $01,X          ; Codebyte 2
  EFA3  6F 02      CLR   $02,X          ; Codebyte 3
  EFA5  6F 2B      CLR   $2B,X          ; Zähler der Starts ohne Änderung

;------------------------------------------------------------------------------
; Einmal pro Fahrt, wenn die Drehzahl zum ersten Mal 32 Einh. erreicht
; (≈710-770 U/min): der Motor läuft sicher, daher werden die beim Anlassen gesetzten
; Synchronisationsfehler (2111, 2112, 2113) gelöscht.
;------------------------------------------------------------------------------
loc_EFA7:
  EFA7  6B 08 9F   TIM   #$08,$9F,X     ; schon geschehen?
  EFAA  26 2D      BNE   loc_EFD9       ; ja: weiter
  EFAC  A6 18      LDAA  $18,X          ; Drehzahl
  EFAE  81 20      CMPA  #$20           ; unter 32 Einh.?
  EFB0  25 27      BCS   loc_EFD9       ; ja: warten
  EFB2  62 08 9F   OIM   #$08,$9F,X     ; merken: geschehen
  EFB5  6B 08 03   TIM   #$08,$03,X     ; Fehlerspeicher aus dem internen RAM wiederhergestellt ($8003.3)?
  EFB8  26 05      BNE   loc_EFBF       ; ja: auch in der Kopie löschen
  EFBA  61 87 00   AIM   #$87,$00,X     ; 2111-2113 in Codebyte 1 löschen
  EFBD  20 17      BRA   loc_EFD6       ; weiter

loc_EFBF:
  EFBF  0F         SEI                  ; Interrupts sperren
  EFC0  72 40 14   OIM   #$40,RP5CR     ; internes RAM einschalten
  EFC3  71 87 41   AIM   #$87,$41       ; 2111-2113 in der Kopie löschen
  EFC6  96 41      LDAA  $41            ; Prüfsumme der Kopie neu berechnen:
  EFC8  9B 42      ADDA  $42            ; $41
  EFCA  9B 43      ADDA  $43            ; + $42
  EFCC  9B 44      ADDA  $44            ; + $43
  EFCE  9B 45      ADDA  $45            ; + $44
  EFD0  97 40      STAA  $40            ; $40 = Summe
  EFD2  71 BF 14   AIM   #$BF,RP5CR     ; internes RAM ausschalten
  EFD5  0E         CLI                  ; Interrupts freigeben

loc_EFD6:
  EFD6  61 AA 94   AIM   #$AA,$94,X     ; gerade Synchronisationsbits löschen

;------------------------------------------------------------------------------
; Aufbau des Fehlerspeichers. Jedes Byte $8000-$8002 enthält 8 Codes, Bit 7 zuerst.
; Die Reihenfolge entspricht der Blinkcode-Tabelle $C928. Bits werden nur hinzugefügt
; (der Speicher ist „klebrig“), nur das Löschen entfernt sie. Hat sich ein Byte geändert,
; wird der Zähler der Starts ohne Änderung $802B auf null gesetzt.
; $8000: 7 ist 1111 Steuergerät ($8095 & $C0); 6 ist 2111 G28 ($8094.6); 5 ist 2112 G4 ($8094.4);
;       4 ist 2113 Hallgeber ($8094.2); 3 ist 2113 ($8094.0); 2 ist 2222 G71 oben ($8091.6);
;       1 ist 2222 G71 unten ($8091.5); 0 ist 2221 G71 bewegt sich nicht ($8091 & $12).
; $8001: 7 ist 2142 G61 ($80B6.6); 6 ist 2144 G66 ($80B6.4); 5 ist 2141 ($8051.3);
;       4 ist 2143 ($8051.2); 3 ist 2123 F81 ($8093.1); 2 ist 2121 F60 ($8093.3);
;       1 ist 2121 ($8093.2, in dieser Kalibrierung nie gesetzt); 0 ist 2322 G42 ($8092.5).
; $8002: 7 ist 2322 G42 ($8092.4); 6 ist 2312 G62 ($8092.3); 5 ist 2312 ($8092.2);
;       4 ist 2342 Lambda ($8060.1); 3 ist 2214 Drehzahl ($809F.2);
;       2 ist 2224 Ladedruck zu hoch ($809F.1); 1 ist 4444 „kein Fehler“; 0 ist Listenende.
;------------------------------------------------------------------------------
loc_EFD9:
  EFD9  B6 80 00   LDAA  $8000          ; Byte 1, alter Wert
  EFDC  36         PSHA                 ; auf den Stack zum Vergleich
  EFDD  C6 C0      LDAB  #$C0           ; Steuergerätefehler
  EFDF  F5 80 95   BITB  $8095          ; vorhanden?
  EFE2  27 02      BEQ   loc_EFE6       ; nein
  EFE4  8A 80      ORAA  #$80           ; 1111

loc_EFE6:
  EFE6  F6 80 94   LDAB  $8094          ; Synchronisationsfehler
  EFE9  C5 40      BITB  #$40           ; G28?
  EFEB  27 02      BEQ   loc_EFEF       ; nein
  EFED  8A 40      ORAA  #$40           ; 2111

loc_EFEF:
  EFEF  C5 10      BITB  #$10           ; G4?
  EFF1  27 02      BEQ   loc_EFF5       ; nein
  EFF3  8A 20      ORAA  #$20           ; 2112

loc_EFF5:
  EFF5  C5 04      BITB  #$04           ; Hallgeber?
  EFF7  27 02      BEQ   loc_EFFB       ; nein
  EFF9  8A 10      ORAA  #$10           ; 2113

loc_EFFB:
  EFFB  C5 01      BITB  #$01           ; Hallgeber, zweites Kennzeichen?
  EFFD  27 02      BEQ   loc_F001       ; nein
  EFFF  8A 08      ORAA  #$08           ; 2113

loc_F001:
  F001  F6 80 91   LDAB  $8091          ; G71-Fehler
  F004  C5 40      BITB  #$40           ; „oben“?
  F006  27 02      BEQ   loc_F00A       ; nein
  F008  8A 04      ORAA  #$04           ; 2222

loc_F00A:
  F00A  C5 20      BITB  #$20           ; „unten“?
  F00C  27 02      BEQ   loc_F010       ; nein
  F00E  8A 02      ORAA  #$02           ; 2222

loc_F010:
  F010  C5 12      BITB  #$12           ; „bewegt sich nicht“?
  F012  27 02      BEQ   loc_F016       ; nein
  F014  8A 01      ORAA  #$01           ; 2221

loc_F016:
  F016  B7 80 00   STAA  $8000          ; Byte 1 schreiben
  F019  32         PULA                 ; alter Wert
  F01A  B1 80 00   CMPA  $8000          ; geändert?
  F01D  27 03      BEQ   loc_F022       ; nein
  F01F  7F 80 2B   CLR   $802B          ; ja: Zähler der Starts ohne Änderung = 0

loc_F022:
  F022  B6 80 01   LDAA  $8001          ; Byte 2, alter Wert
  F025  36         PSHA                 ; auf den Stack
  F026  F6 80 B6   LDAB  $80B6          ; Fehler der Klopfsensoren
  F029  C5 40      BITB  #$40           ; G61?
  F02B  27 02      BEQ   loc_F02F       ; nein
  F02D  8A 80      ORAA  #$80           ; 2142

loc_F02F:
  F02F  C5 10      BITB  #$10           ; G66?
  F031  27 02      BEQ   loc_F035       ; nein
  F033  8A 40      ORAA  #$40           ; 2144

loc_F035:
  F035  F6 80 51   LDAB  $8051          ; Fehler der Klopfregelung
  F038  C5 08      BITB  #$08           ; erstes Kennzeichen?
  F03A  27 02      BEQ   loc_F03E       ; nein
  F03C  8A 20      ORAA  #$20           ; 2141

loc_F03E:
  F03E  C5 04      BITB  #$04           ; zweites?
  F040  27 02      BEQ   loc_F044       ; nein
  F042  8A 10      ORAA  #$10           ; 2143

loc_F044:
  F044  F6 80 93   LDAB  $8093          ; Schalterfehler
  F047  C5 02      BITB  #$02           ; F81?
  F049  27 02      BEQ   loc_F04D       ; nein
  F04B  8A 08      ORAA  #$08           ; 2123

loc_F04D:
  F04D  C5 08      BITB  #$08           ; F60?
  F04F  27 02      BEQ   loc_F053       ; nein
  F051  8A 04      ORAA  #$04           ; 2121

loc_F053:
  F053  C5 04      BITB  #$04           ; F60, zweites Kennzeichen?
  F055  27 02      BEQ   loc_F059       ; nein
  F057  8A 02      ORAA  #$02           ; 2121

loc_F059:
  F059  F6 80 92   LDAB  $8092          ; Temperaturfehler
  F05C  C5 20      BITB  #$20           ; G42, erstes Kennzeichen?
  F05E  27 02      BEQ   loc_F062       ; nein
  F060  8A 01      ORAA  #$01           ; 2322

loc_F062:
  F062  B7 80 01   STAA  $8001          ; Byte 2 schreiben
  F065  32         PULA                 ; alter Wert
  F066  B1 80 01   CMPA  $8001          ; geändert?
  F069  27 03      BEQ   loc_F06E       ; nein
  F06B  7F 80 2B   CLR   $802B          ; ja: Zähler = 0

loc_F06E:
  F06E  B6 80 02   LDAA  $8002          ; Byte 3, alter Wert
  F071  36         PSHA                 ; auf den Stack
  F072  C5 10      BITB  #$10           ; G42, zweites Kennzeichen?
  F074  27 02      BEQ   loc_F078       ; nein
  F076  8A 80      ORAA  #$80           ; 2322

loc_F078:
  F078  C5 08      BITB  #$08           ; G62, erstes?
  F07A  27 02      BEQ   loc_F07E       ; nein
  F07C  8A 40      ORAA  #$40           ; 2312

loc_F07E:
  F07E  C5 04      BITB  #$04           ; G62, zweites?
  F080  27 02      BEQ   loc_F084       ; nein
  F082  8A 20      ORAA  #$20           ; 2312

loc_F084:
  F084  F6 80 60   LDAB  $8060          ; Lambdaflags
  F087  C5 02      BITB  #$02           ; Fehler der Lambdaregelung?
  F089  27 02      BEQ   loc_F08D       ; nein
  F08B  8A 10      ORAA  #$10           ; 2342

loc_F08D:
  F08D  F6 80 9F   LDAB  $809F          ; Flags $809F
  F090  C5 04      BITB  #$04           ; Überdrehzahl?
  F092  27 02      BEQ   loc_F096       ; nein
  F094  8A 08      ORAA  #$08           ; 2214

loc_F096:
  F096  C5 02      BITB  #$02           ; Ladedruck zu hoch?
  F098  27 02      BEQ   loc_F09C       ; nein
  F09A  8A 04      ORAA  #$04           ; 2224

loc_F09C:
  F09C  8A 01      ORAA  #$01           ; Bit 0 ist das Listenende, immer 1
  F09E  B7 80 02   STAA  $8002          ; Byte 3 schreiben
  F0A1  84 FC      ANDA  #$FC           ; ohne die Dienstbits 1 und 0
  F0A3  33         PULB                 ; alter Wert
  F0A4  C4 FC      ANDB  #$FC           ; ohne die Dienstbits
  F0A6  11         CBA                  ; geändert?
  F0A7  27 03      BEQ   loc_F0AC       ; nein
  F0A9  7F 80 2B   CLR   $802B          ; ja: Zähler = 0

loc_F0AC:
  F0AC  BA 80 00   ORAA  $8000          ; mindestens ein Fehler in den drei Bytes?
  F0AF  BA 80 01   ORAA  $8001          ; + Byte 2
  F0B2  26 07      BNE   loc_F0BB       ; ja: ohne 4444
  F0B4  86 03      LDAA  #$03           ; kein Fehler: 4444 und Listenende
  F0B6  B7 80 02   STAA  $8002          ; schreiben
  F0B9  20 08      BRA   loc_F0C3       ; weiter

loc_F0BB:
  F0BB  86 FD      LDAA  #$FD           ; Fehler vorhanden: 4444 löschen
  F0BD  B4 80 02   ANDA  $8002          ; löschen
  F0C0  B7 80 02   STAA  $8002          ; schreiben

;------------------------------------------------------------------------------
; Länger anstehende Fehler in $806E: Bit 7 ist $8092.7 [?], Bit 6 ist G71 „hängt“ ($8091 & $60),
; Bit 5 ist G71 „bewegt sich nicht“ ($8091 & $12). Ein Bit wird gesetzt, wenn der Fehler
; 40 Aufrufe hintereinander (4 s) ansteht, und sofort gelöscht. Zähler $806F-$8071.
;------------------------------------------------------------------------------
loc_F0C3:
  F0C3  C6 80      LDAB  #$80           ; erstes Maskenbit
  F0C5  CE 80 6F   LDX   #$806F         ; erster Zähler
  F0C8  86 80      LDAA  #$80           ; $8092.7 [?]
  F0CA  B5 80 92   BITA  $8092          ; vorhanden?
  F0CD  27 04      BEQ   loc_F0D3       ; nein: löschen
  F0CF  8D 1C      BSR   LONGERR_CNT    ; steht an: zählen
  F0D1  20 02      BRA   loc_F0D5       ; weiter

loc_F0D3:
  F0D3  8D 26      BSR   LONGERR_CLR    ; löschen

loc_F0D5:
  F0D5  86 60      LDAA  #$60           ; G71 „hängt“?
  F0D7  B5 80 91   BITA  $8091          ; prüfen
  F0DA  27 04      BEQ   loc_F0E0       ; nein: löschen
  F0DC  8D 0F      BSR   LONGERR_CNT    ; steht an: zählen
  F0DE  20 02      BRA   loc_F0E2       ; weiter

loc_F0E0:
  F0E0  8D 19      BSR   LONGERR_CLR    ; löschen

loc_F0E2:
  F0E2  86 12      LDAA  #$12           ; G71 „bewegt sich nicht“?
  F0E4  B5 80 91   BITA  $8091          ; prüfen
  F0E7  27 1F      BEQ   loc_F108       ; nein: löschen
  F0E9  8D 02      BSR   LONGERR_CNT    ; steht an: zählen
  F0EB  20 1D      BRA   loc_F10A       ; weiter

;------------------------------------------------------------------------------
; LONGERR_CNT: Zähler [X] + 1; bei 40 Bit B in $806E setzen.
; Dann X auf den nächsten Zähler, B auf das nächste Bit.
;------------------------------------------------------------------------------
LONGERR_CNT:                            ; aufgerufen von: TASK3
  F0ED  86 28      LDAA  #$28           ; Schwelle 40
  F0EF  6C 00      INC   $00,X          ; Zähler + 1
  F0F1  A0 00      SUBA  $00,X          ; 40 - Zähler
  F0F3  22 10      BHI   loc_F105       ; noch nicht erreicht? ja: Bit nicht setzen
  F0F5  17         TBA                  ; Bit
  F0F6  BA 80 6E   ORAA  $806E          ; setzen
  F0F9  20 07      BRA   loc_F102       ; schreiben

;------------------------------------------------------------------------------
; LONGERR_CLR: Zähler [X] = 0, Bit B in $806E löschen.
;------------------------------------------------------------------------------
LONGERR_CLR:                            ; aufgerufen von: TASK3
  F0FB  6F 00      CLR   $00,X          ; Zähler = 0
  F0FD  17         TBA                  ; Bit
  F0FE  43         COMA                 ; invertieren
  F0FF  B4 80 6E   ANDA  $806E          ; löschen

loc_F102:
  F102  B7 80 6E   STAA  $806E          ; $806E schreiben

loc_F105:
  F105  08         INX                  ; nächster Zähler
  F106  54         LSRB                 ; nächstes Bit
  F107  39         RTS                  ; Rücksprung

loc_F108:
  F108  8D F1      BSR   LONGERR_CLR    ; kein G71 „bewegt sich nicht“: löschen

;------------------------------------------------------------------------------
; Druckänderungsgeschwindigkeit über 100 ms. $806D = Druck beim vorigen Aufruf.
; $8066.7 = 1 heißt, der Druck steigt. $806B = Wert aus Tabelle C740 (steigend)
; oder C748 (fallend) über dem Betrag der Änderung. Beide Tabellen haben die Achse 3 2 1 0,
; Werte 3 2 1 0: praktisch ist $806B = 3 bei einer Änderung unter 3, sonst 0 [Vermutung].
;------------------------------------------------------------------------------
loc_F10A:
  F10A  CE C7 40   LDX   #$C740         ; Tabelle für Anstieg
  F10D  B6 80 19   LDAA  $8019          ; Druck jetzt
  F110  F6 80 6D   LDAB  $806D          ; Druck beim vorigen Aufruf
  F113  B7 80 6D   STAA  $806D          ; aktuellen merken
  F116  10         SBA                  ; Änderung = jetzt - vorher
  F117  24 0C      BCC   loc_F125       ; steigend? ja
  F119  40         NEGA                 ; fallend: Betrag
  F11A  CE C7 48   LDX   #$C748         ; Tabelle für Abfall
  F11D  C6 7F      LDAB  #$7F           ; Anstiegskennzeichen löschen
  F11F  0F         SEI                  ; Interrupts sperren
  F120  F4 80 66   ANDB  $8066          ; löschen
  F123  20 06      BRA   loc_F12B       ; weiter

loc_F125:
  F125  C6 80      LDAB  #$80           ; Anstiegskennzeichen
  F127  0F         SEI                  ; Interrupts sperren
  F128  FA 80 66   ORAB  $8066          ; setzen

loc_F12B:
  F12B  F7 80 66   STAB  $8066          ; $8066 schreiben
  F12E  0E         CLI                  ; Interrupts freigeben
  F12F  C6 04      LDAB  #$04           ; 4 Punkte
  F131  3C         PSHX                 ; Tabellenadresse
  F132  BD CA 5F   JSR   AXIS_UP        ; Intervall suchen
  F135  37         PSHB                 ; Nummer
  F136  BD CA 05   JSR   FRAC_UP        ; Anteil
  F139  17         TBA                  ; A = Anteil
  F13A  33         PULB                 ; B = Nummer
  F13B  38         PULX                 ; Tabellenadresse
  F13C  CB 04      ADDB  #$04           ; die Werte folgen auf die Achse (+4)
  F13E  3A         ABX                  ; X -> Wert
  F13F  16         TAB                  ; B = Anteil
  F140  BD CA 41   JSR   INTERP         ; Interpolation
  F143  B7 80 6B   STAA  $806B          ; $806B = Ergebnis

;------------------------------------------------------------------------------
; L-Leitung (Pin 5, PORT5.6). Pin an Masse bedeutet PORT5.6 = 0 [Vermutung].
; 25 Aufrufe (2,5 s) geschlossen halten startet die Ausgabe ($80A9.7 = 1).
; Solange der Motor noch nie gedreht hat ($8003.4 = 0), ist das die Stellglieddiagnose
; (F24D), sonst die Ausgabe der Fehlercodes. Im Test setzt das Öffnen des Kontakts eine Anforderung,
; und der Schritt wechselt beim nächsten Schließen von ≥ 2,5 s: das Schrittbit in $80AF wird nach rechts geschoben
; ($80 J17, $40 N7, $20 N75, $10 N17, $08 N80, $04 N115).
; Derselbe Start kann vom Tester über die K-Leitung kommen ($80F7.3).
;------------------------------------------------------------------------------
  F146  CE 80 00   LDX   #$8000         ; X = $8000
  F149  D6 15      LDAB  PORT5          ; Port 5
  F14B  F7 80 14   STAB  $8014          ; Momentaufnahme Port 5
  F14E  B6 80 A9   LDAA  $80A9          ; Ausgabeflags
  F151  6B 08 F7   TIM   #$08,$F7,X     ; Start vom Tester über die K-Leitung ($80F7.3)?
  F154  27 05      BEQ   loc_F15B       ; nein: Pin 5 ansehen
  F156  61 F7 F7   AIM   #$F7,$F7,X     ; Anforderung des Testers löschen
  F159  20 1B      BRA   loc_F176       ; Ausgabe starten

loc_F15B:
  F15B  F6 80 03   LDAB  $8003          ; Flags $8003
  F15E  C5 10      BITB  #$10           ; hat der Motor schon gedreht oder ist der Test beendet ($8003.4)?
  F160  26 52      BNE   loc_F1B4       ; ja: Ausgabe beenden
  F162  F6 80 14   LDAB  $8014          ; Momentaufnahme Port 5
  F165  C5 40      BITB  #$40           ; Pin 5 offen (PORT5.6 = 1)?
  F167  26 1A      BNE   loc_F183       ; ja
  F169  F6 80 AE   LDAB  $80AE          ; Schließdauer
  F16C  C1 19      CMPB  #$19           ; schon 25 Aufrufe (2,5 s)?
  F16E  24 06      BCC   loc_F176       ; ja: starten
  F170  5C         INCB                 ; + 1
  F171  F7 80 AE   STAB  $80AE          ; speichern
  F174  20 43      BRA   loc_F1B9       ; weiter

loc_F176:
  F176  85 80      BITA  #$80           ; Ausgabe läuft schon?
  F178  26 1A      BNE   loc_F194       ; ja: Schrittanforderung ansehen
  F17A  8A 80      ORAA  #$80           ; Ausgabe starten ($80A9.7)
  F17C  C6 80      LDAB  #$80           ; erster Testschritt ist J17
  F17E  F7 80 AF   STAB  $80AF          ; $80AF = $80
  F181  20 2C      BRA   loc_F1AF       ; Flags schreiben

loc_F183:
  F183  5F         CLRB                 ; Kontakt offen: Schließdauer = 0
  F184  F7 80 AE   STAB  $80AE          ; speichern
  F187  85 80      BITA  #$80           ; Ausgabe läuft?
  F189  27 04      BEQ   loc_F18F       ; nein: Test verlassen
  F18B  8A 40      ORAA  #$40           ; läuft: nächsten Schritt anfordern ($80A9.6)
  F18D  20 20      BRA   loc_F1AF       ; Flags schreiben

loc_F18F:
  F18F  BD F7 26   JSR   TEST_EXIT      ; Stellglieddiagnose verlassen
  F192  20 25      BRA   loc_F1B9       ; weiter

loc_F194:
  F194  85 40      BITA  #$40           ; Anforderung für nächsten Schritt vorhanden?
  F196  27 21      BEQ   loc_F1B9       ; nein: weiter
  F198  84 BF      ANDA  #$BF           ; Anforderung löschen
  F19A  F6 80 AF   LDAB  $80AF          ; aktueller Schritt
  F19D  54         LSRB                 ; nächster Schritt (Bit nach rechts)
  F19E  C1 04      CMPB  #$04           ; ist das noch ein Stellgliedschritt (Bit $04 oder höher)?
  F1A0  24 0A      BCC   loc_F1AC       ; ja: Schritt speichern
  F1A2  CE 80 00   LDX   #$8000         ; X = $8000
  F1A5  62 10 F7   OIM   #$10,$F7,X     ; Stellglieder durchlaufen ($80F7.4)
  F1A8  C5 02      BITB  #$02           ; Schritt $02 (Listenende, Anzeige 0000)?
  F1AA  27 E3      BEQ   loc_F18F       ; nein: Test beendet

loc_F1AC:
  F1AC  F7 80 AF   STAB  $80AF          ; $80AF = neuer Schritt

loc_F1AF:
  F1AF  B7 80 A9   STAA  $80A9          ; Ausgabeflags schreiben
  F1B2  20 05      BRA   loc_F1B9       ; weiter

loc_F1B4:
  F1B4  84 7F      ANDA  #$7F           ; Ausgabe beenden ($80A9.7 = 0)
  F1B6  B7 80 A9   STAA  $80A9          ; schreiben

loc_F1B9:
  F1B9  C6 20      LDAB  #$20           ; Synchronisation vorhanden (Motor läuft)?
  F1BB  F5 80 95   BITB  $8095          ; prüfen
  F1BE  26 66      BNE   loc_F226       ; ja: Testausgänge nicht anfassen
  F1C0  F6 80 A9   LDAB  $80A9          ; Ausgabeflags
  F1C3  C5 80      BITB  #$80           ; Ausgabe läuft?
  F1C5  26 05      BNE   loc_F1CC       ; ja: Testausgänge
  F1C7  71 BF 03   AIM   #$BF,PORT2     ; nein: N75 (PORT2.6) = 0
  F1CA  20 4D      BRA   loc_F219       ; und N80/N115 in Ruhe

loc_F1CC:
  F1CC  B6 80 AD   LDAA  $80AD          ; Teiler für den Testtakt (5 Aufrufe)
  F1CF  27 08      BEQ   loc_F1D9       ; null: neuer Takt
  F1D1  4A         DECA                 ; - 1
