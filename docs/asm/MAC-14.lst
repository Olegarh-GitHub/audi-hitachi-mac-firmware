  F55E  F7 80 15   STAB  $8015          ; $8015 = номер строки
  F561  BD CA 10   JSR   FRAC_DN        ; доля
  F564  F7 80 17   STAB  $8017          ; $8017 = доля
  F567  39         RTS                  ; возврат

;------------------------------------------------------------------------------
