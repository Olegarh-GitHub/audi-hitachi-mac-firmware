;------------------------------------------------------------------------------
; ДИСПЕТЧЕР ЗАДАЧ (с вытеснением). Счётчики $8006-$8009 — по одному на задачу,
; делители D1E1 = 1 2 4 10. Каждый тик счётчик + 1; дошёл до делителя — задача
; готова (бит 6). Запускается первая по порядку готовая задача (бит 7 — идёт),
; если перед ней нет идущей: задача 0 прерывает 1-3, задача 1 прерывает 2-3 и т. д.
; Задача заканчивается переходом на D1D1: снять «идёт», искать следующую.
;------------------------------------------------------------------------------
loc_D17D:
  D17D  CE D1 E1   LDX   #$D1E1         ; делители
