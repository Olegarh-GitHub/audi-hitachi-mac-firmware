loc_D57F:
  D57F  B6 C6 C0   LDAA  $C6C0          ; open for C6C0 = 5
  D582  B7 80 AC   STAA  $80AC          ; timer

loc_D585:
  D585  7E D6 2A   JMP   loc_D62A       ; open

loc_D588:
  D588  F6 80 AD   LDAB  $80AD          ; hot start: pulse timer
  D58B  85 10      BITA  #$10           ; pulse in progress (bit 4)?
  D58D  27 0D      BEQ   loc_D59C       ; no
  D58F  85 01      BITA  #$01           ; bit 0 (always 0)
  D591  26 03      BNE   loc_D596       ; set —
  D593  5A         DECB                 ; - 1
  D594  26 37      BNE   loc_D5CD       ; not finished

loc_D596:
