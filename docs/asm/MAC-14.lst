  F648  C1 FF      CMPB  #$FF           ; 255?
  F64A  27 0F      BEQ   loc_F65B       ; да — оставить включённым
  F64C  84 BF      ANDA  #$BF           ; выключить
  F64E  97 03      STAA  PORT2          ; записать
  F650  C6 FF      LDAB  #$FF           ; 255
  F652  F0 80 67   SUBB  $8067          ; - скважность = «выключено»
  F655  20 08      BRA   loc_F65F       ; в таймер

