;------------------------------------------------------------------------------
; Dämpfung des Lastwechselrucks beim Öffnen der Drosselklappe nach Leerlauf — nur Schaltgetriebe (HS) [Vermutung].
; Bedingungen: warm ($8088.4: G62 ≤ 39, gelöscht über 42), Leerlaufschalter F60 in Ordnung,
; Motor läuft länger als 30 s ($8029.2). Drosselklappe war ≥ 25 Aufrufe (0,5 s) geschlossen —
; „scharf“ ($8088.5). Beim Öffnen: Stärke k = (Schließzeit - 25) × 5 (bis 255),
; nach Drehzahl (Achse C270): $8089 = C280 × k / 256 — Zuschlag zu N7 (sinkt um 1 pro
; Aufruf), $808A = C290 × k / 256 — Spätverstellung, $808B = C2A0 — Rückführschritt des Zündwinkels
; (wird vom Interrupt ausgeführt, CE03). $8088.7 — Funktion aktiv.
;------------------------------------------------------------------------------
  E0B8  CE 80 00   LDX   #$8000         ; X = $8000
  E0BB  7B 04 17   TIM   #$04,PORT6     ; Codierung: HS?
  E0BE  27 5C      BEQ   loc_E11C       ; AT — nicht nötig
  E0C0  F6 80 1B   LDAB  $801B          ; G62
  E0C3  C1 2A      CMPB  #$2A           ; kälter als 42?
  E0C5  22 09      BHI   loc_E0D0       ; ja — „warm“ löschen
  E0C7  C1 27      CMPB  #$27           ; kälter als 39?
  E0C9  22 08      BHI   loc_E0D3       ; ja — nicht ändern
  E0CB  62 10 88   OIM   #$10,$88,X     ; $8088.4: warm
  E0CE  20 03      BRA   loc_E0D3       ; weiter

loc_E0D0:
  E0D0  61 EF 88   AIM   #$EF,$88,X     ; $8088.4 löschen

loc_E0D3:
  E0D3  F6 80 93   LDAB  $8093          ; Fehler F60
  E0D6  C5 0C      BITB  #$0C           ; vorhanden?
  E0D8  26 42      BNE   loc_E11C       ; ja — nicht ausführen
  E0DA  6B 10 88   TIM   #$10,$88,X     ; warm?
  E0DD  27 3D      BEQ   loc_E11C       ; nein — nicht ausführen
  E0DF  F6 80 29   LDAB  $8029          ; Motor läuft länger als 30 s?
  E0E2  C5 04      BITB  #$04           ; prüfen
  E0E4  27 36      BEQ   loc_E11C       ; nein — nicht ausführen
  E0E6  F6 80 7E   LDAB  $807E          ; Zeit Drosselklappe geschlossen
  E0E9  6B 04 88   TIM   #$04,$88,X     ; Drosselklappe geschlossen?
  E0EC  27 10      BEQ   loc_E0FE       ; nein — geöffnet
  E0EE  5C         INCB                 ; + 1
  E0EF  26 01      BNE   loc_E0F2       ; kein Überlauf
  E0F1  5A         DECB                 ; 255

loc_E0F2:
  E0F2  F7 80 7E   STAB  $807E          ; speichern
  E0F5  C1 19      CMPB  #$19           ; kleiner als 25 (0,5 s)?
  E0F7  25 26      BCS   loc_E11F       ; ja — warten
  E0F9  62 20 88   OIM   #$20,$88,X     ; scharf ($8088.5)
  E0FC  20 21      BRA   loc_E11F       ; weiter

loc_E0FE:
  E0FE  7F 80 7E   CLR   $807E          ; Zeit = 0
  E101  6B 20 88   TIM   #$20,$88,X     ; war scharf?
  E104  27 54      BEQ   loc_E15A       ; nein
  E106  86 80      LDAA  #$80           ; Blinkcodeausgabe aktiv?
  E108  B5 80 A0   BITA  $80A0          ; prüfen
  E10B  26 4D      BNE   loc_E15A       ; ja — nicht ausführen
