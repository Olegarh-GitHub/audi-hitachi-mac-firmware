;------------------------------------------------------------------------------
; KLOPFEN: Verarbeitung der Messwerte. Für jeden der 5 Zylinder ein Datensatz zu 8 Byte
; ab $80C0 (Zylinder N — $80C0 + 8·N):
;  +0 Bit 7 — neuer Messwert eingetroffen (setzt der Interrupt), Bit 0 — Sensorsignal
;     zu schwach bei höchster Verstärkung;
;  +1 Verstärkung (1, 2, 4, 8), die der Interrupt am Verstärker einstellt;
;  +2 Messwert (Integrator über das Klopffenster);
;  +3 Messwert, auf den gemeinsamen Maßstab gebracht (× $80BD / 256);
;  +4/+5 Grundgeräusch — langsamer Mittelwert der skalierten Messwerte (16 Bit);
;  +6 geglätteter Messwert (halb alt, halb neu, C917 = 128);
;  +7 neue Verstärkung.
; Klopfen: skalierter Messwert ist f/32-mal größer als das Grundgeräusch, f — Tabelle C8C0
; (5 Zeilen für die Zylinder × 16 Spalten nach Drehzahl, Achse C8B0). f = 144 bei
; niedriger Drehzahl (4,5-fach), 80…107 bei hoher Drehzahl (2,5…3,3-fach).
; Klopfen erkannt — Zylinderbit in $8054 (Zylinder 1 = Bit 7); das Grundgeräusch wird dann nicht
; nachgeführt. Kein Klopfen — das Grundgeräusch nähert sich dem Messwert in Schritten von 0,5 (C915).
; Verstärkung: Grundgeräusch über 3 × untere Grenze — Verstärkung halbiert,
; Grundgeräusch unter der Grenze — Verstärkung verdoppelt (höchstens 8).
;------------------------------------------------------------------------------
loc_D738:
  D738  86 80      LDAA  #$80           ; Maske des ersten Zylinders (Bit 7)
  D73A  B7 80 E9   STAA  $80E9          ; $80E9 = Zylindermaske
  D73D  5F         CLRB                 ; Datensatz-Offset = 0

loc_D73E:
  D73E  F7 80 E8   STAB  $80E8          ; $80E8 = Offset (8 je Zylinder)
  D741  CE 80 C0   LDX   #$80C0         ; Zylinderdatensätze
  D744  3A         ABX                  ; X -> Zylinderdatensatz
  D745  A6 00      LDAA  $00,X          ; Flags
  D747  2B 03      BMI   loc_D74C       ; neuer Messwert vorhanden?
  D749  7E D8 7A   JMP   loc_D87A       ; nein — zum nächsten Zylinder

loc_D74C:
  D74C  84 7F      ANDA  #$7F           ; „neuer Messwert“ löschen
  D74E  A7 00      STAA  $00,X          ; schreiben
  D750  A6 02      LDAA  $02,X          ; Messwert
  D752  B1 80 BA   CMPA  $80BA          ; nicht unter der unteren Grenze $80BA?
  D755  24 03      BCC   loc_D75A       ; ja
  D757  B6 80 BA   LDAA  $80BA          ; auf die Grenze anheben

loc_D75A:
  D75A  F6 80 BD   LDAB  $80BD          ; Maßstab $80BD
  D75D  3D         MUL                  ; Messwert × Maßstab
  D75E  C3 00 80   ADDD  #$0080         ; runden
  D761  A7 03      STAA  $03,X          ; +3 = skalierter Messwert
  D763  E6 04      LDAB  $04,X          ; Grundgeräusch
  D765  26 0B      BNE   loc_D772       ; schon vorhanden?
  D767  A7 04      STAA  $04,X          ; erster Messwert: Grundgeräusch = Messwert
  D769  86 08      LDAA  #$08           ; Verstärkung 8
  D76B  A7 01      STAA  $01,X          ; aktuelle
  D76D  A7 07      STAA  $07,X          ; neue
  D76F  7E D8 7A   JMP   loc_D87A       ; zum nächsten Zylinder

loc_D772:
  D772  3C         PSHX                 ; X sichern
  D773  B6 80 18   LDAA  $8018          ; Drehzahl
  D776  CE C8 B0   LDX   #$C8B0         ; Drehzahlachse C8B0
  D779  C6 10      LDAB  #$10           ; 16 Stützstellen
  D77B  BD CA 5F   JSR   AXIS_UP        ; Stützstelle suchen
  D77E  CE C8 C0   LDX   #$C8C0         ; Schwellentabelle C8C0
  D781  3A         ABX                  ; + Spalte
  D782  F6 80 E8   LDAB  $80E8          ; Datensatz-Offset (8·N)
  D785  58         ASLB                 ; × 2 = 16·N — Zylinderzeile
  D786  3A         ABX                  ; X -> f
  D787  A6 00      LDAA  $00,X          ; f
  D789  F6 80 E8   LDAB  $80E8          ; Offset
  D78C  54         LSRB                 ; / 8 = Zylindernummer
