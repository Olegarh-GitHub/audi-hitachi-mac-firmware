  F709  B6 80 F6   LDAA  $80F6          ; состояние сеанса
  F70C  2A 13      BPL   loc_F721       ; синхробайты не отправлены — выбросить
  F70E  85 10      BITA  #$10           ; байт уже ждёт?
  F710  26 13      BNE   loc_F725       ; да — выйти
  F712  8A 10      ORAA  #$10           ; отметить
  F714  B7 80 F6   STAA  $80F6          ; записать
  F717  20 05      BRA   loc_F71E       ; дальше

loc_F719:
