  D101  27 24      BEQ   loc_D127       ; 0 — без копии
  D103  72 40 14   OIM   #$40,RP5CR     ; включить внутреннее ОЗУ
  D106  4F         CLRA                 ; сумма = 0
  D107  F6 80 00   LDAB  $8000          ; байт кодов 1
  D10A  1B         ABA                  ; в сумму
  D10B  D7 41      STAB  $41            ; копия
  D10D  F6 80 01   LDAB  $8001          ; байт кодов 2
  D110  1B         ABA                  ; в сумму
