  E9A6  96 03      LDAA  PORT2          ; PORT2
  E9A8  B7 82 08   STAA  $8208          ; Momentwert
  E9AB  96 15      LDAA  PORT5          ; PORT5
  E9AD  B7 82 09   STAA  $8209          ; Momentwert
