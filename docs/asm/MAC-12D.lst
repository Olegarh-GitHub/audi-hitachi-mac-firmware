  EC17  97 5F      STAA  $5F            ; вместо замера

loc_EC19:
  EC19  96 5C      LDAA  $5C            ; G62
  EC1B  B1 E4 39   CMPA  $E439          ; ниже 8?
  EC1E  24 04      BCC   loc_EC24       ; нет
  EC20  CA 48      ORAB  #$48           ; G62 замкнут
  EC22  20 07      BRA   loc_EC2B       ; подставить

loc_EC24:
  EC24  B1 E4 38   CMPA  $E438          ; выше 228?
  EC27  23 07      BLS   loc_EC30       ; нет — исправен
  EC29  CA 44      ORAB  #$44           ; G62 оборван

loc_EC2B:
  EC2B  B6 E4 3C   LDAA  $E43C          ; подстановка 30 (80 °C)
  EC2E  97 5C      STAA  $5C            ; вместо замера

loc_EC30:
  EC30  D7 B9      STAB  $B9            ; записать $B9
  EC32  D6 9C      LDAB  $9C            ; температурные флаги
  EC34  C4 E3      ANDB  #$E3           ; биты 4, 3, 2 снять
  EC36  B1 E3 8B   CMPA  $E38B          ; G62 выше 90?
  EC39  22 02      BHI   loc_EC3D       ; да
  EC3B  CA 10      ORAB  #$10           ; бит 4

loc_EC3D:
  EC3D  B1 E3 8F   CMPA  $E38F          ; выше 169?
  EC40  22 02      BHI   loc_EC44       ; да
  EC42  CA 08      ORAB  #$08           ; бит 3

loc_EC44:
  EC44  B1 E3 97   CMPA  $E397          ; выше 17?
  EC47  22 02      BHI   loc_EC4B       ; да
  EC49  CA 04      ORAB  #$04           ; бит 2

loc_EC4B:
  EC4B  B1 E4 45   CMPA  $E445          ; ниже 39?
  EC4E  25 0B      BCS   loc_EC5B       ; да — бит 1
  EC50  80 05      SUBA  #$05           ; гистерезис 5
  EC52  B1 E4 45   CMPA  $E445          ; ниже 44?
  EC55  25 06      BCS   loc_EC5D       ; да — не менять
  EC57  C4 FD      ANDB  #$FD           ; бит 1 снять
  EC59  20 02      BRA   loc_EC5D       ; дальше

loc_EC5B:
  EC5B  CA 02      ORAB  #$02           ; бит 1: прогрет (≈70 °C)

loc_EC5D:
  EC5D  D7 9C      STAB  $9C            ; записать $9C
  EC5F  7B 20 43   TIM   #$20,$43       ; атмосферное давление снято ($43.5)?
  EC62  26 07      BNE   loc_EC6B       ; да
  EC64  D6 5A      LDAB  $5A            ; давление
  EC66  D7 44      STAB  $44            ; $44 = атмосферное давление при включении
  EC68  72 20 43   OIM   #$20,$43       ; снято

;------------------------------------------------------------------------------
; Высота: $6C = номер точки атмосферного давления $44 по оси E4D0 = 128 122 109 102
; (как C2B0 у MAC-14).
;------------------------------------------------------------------------------
loc_EC6B:
  EC6B  96 44      LDAA  $44            ; атмосферное давление
  EC6D  CE E4 D0   LDX   #$E4D0         ; ось высоты E4D0
  EC70  C6 04      LDAB  #$04           ; 4 точки
  EC72  BD E6 39   JSR   AXIS_DN        ; номер точки (ось убывает)
  EC75  D7 6C      STAB  $6C            ; $6C = высота 0…3

;------------------------------------------------------------------------------
; ОБОРОТЫ: регистры $0C/$0D чипа — зубья за тик -> $65/$66. Отличие от MAC-14:
; $59 = зубья × 254 / 256 (с округлением), без усреднения на малых оборотах;
; больше 255 — 255. 540 зубьев без метки G4 — ошибка G4 ($BB биты 5, 4).
;------------------------------------------------------------------------------
  EC77  C6 0C      LDAB  #$0C           ; регистр $0C
  EC79  CE 01 00   LDX   #$0100         ; X -> чип
  EC7C  0F         SEI                  ; запрет прерываний
  EC7D  E7 00      STAB  $00,X          ; выбрать
  EC7F  A6 01      LDAA  $01,X          ; старший байт
  EC81  5C         INCB                 ; регистр $0D
  EC82  E7 00      STAB  $00,X          ; выбрать
  EC84  E6 01      LDAB  $01,X          ; младший байт
