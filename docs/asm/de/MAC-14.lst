  F7F3  db FF FF FF FF FF FF FF FF FF FF FF FF FF

;------------------------------------------------------------------------------
; Werkspatch: Spätverstellung bei schnellem Druckanstieg mit warmem Motor
; (G62 ≤ 63, Drosselklappe nicht geschlossen, Funktion E0B8 nicht aktiv). Druckanstieg in 40 ms
; ($8073) auf Achse F7E0 = 0 4 11 15 30 43 56 68 -> F7E8 = 0 0 0 6 6 6 6 6:
; ein Anstieg ab 15 ergibt 6 Einh. Spätverstellung. Der größte Wert wird gespeichert ($8213), dann
; klingt die Spätverstellung $8211 = (25 - n) × 10 × $8213 / 256 über 25 Aufrufe (0,5 s) ab.
; $8211 wird im Interrupt (F870) zum Zündwinkel addiert.
;------------------------------------------------------------------------------
loc_F800:
  F800  B6 80 1B   LDAA  $801B          ; G62
  F803  B1 F7 F0   CMPA  $F7F0          ; kälter als 63?
  F806  22 57      BHI   loc_F85F       ; ja — zurücksetzen
  F808  BD D1 E5   JSR   IS_IDLE        ; Drosselklappe geschlossen?
  F80B  25 52      BCS   loc_F85F       ; ja — zurücksetzen
  F80D  86 FF      LDAA  #$FF           ; Funktion E0B8 aktiv ($808B)?
  F80F  B5 80 8B   BITA  $808B          ; prüfen
  F812  26 4B      BNE   loc_F85F       ; ja — zurücksetzen
  F814  B6 80 73   LDAA  $8073          ; Druckanstieg
  F817  27 23      BEQ   loc_F83C       ; null — nur Abnahme
  F819  C6 08      LDAB  #$08           ; 8 Stützstellen
  F81B  CE F7 E0   LDX   #$F7E0         ; Achse F7E0
  F81E  BD CA 5F   JSR   AXIS_UP        ; Intervall suchen
  F821  37         PSHB                 ; Index
  F822  BD CA 05   JSR   FRAC_UP        ; Anteil
  F825  17         TBA                  ; A = Anteil
  F826  33         PULB                 ; B = Index
  F827  CE F7 E8   LDX   #$F7E8         ; Tabelle F7E8
  F82A  3A         ABX                  ; X -> Wert
  F82B  16         TAB                  ; B = Anteil
  F82C  BD CA 41   JSR   INTERP         ; Spätverstellung
  F82F  4D         TSTA                 ; null?
  F830  27 0A      BEQ   loc_F83C       ; ja — Abnahme
  F832  B1 82 13   CMPA  $8213          ; größer als gespeicherter Wert?
  F835  25 0A      BCS   loc_F841       ; nein
  F837  B7 82 13   STAA  $8213          ; speichern
  F83A  20 05      BRA   loc_F841       ; weiter

loc_F83C:
  F83C  7D 82 12   TST   $8212          ; läuft Abnahme?
  F83F  27 1E      BEQ   loc_F85F       ; nein — zurücksetzen

loc_F841:
  F841  B6 82 12   LDAA  $8212          ; Zähler n
  F844  4C         INCA                 ; + 1
  F845  B7 82 12   STAA  $8212          ; schreiben
  F848  B0 F7 F1   SUBA  $F7F1          ; n - 25
  F84B  24 12      BCC   loc_F85F       ; abgelaufen — zurücksetzen
  F84D  40         NEGA                 ; 25 - n
  F84E  F6 F7 F2   LDAB  $F7F2          ; B = 10 (F7F2)
  F851  3D         MUL                  ; (25 - n) × 10
  F852  B6 82 13   LDAA  $8213          ; gespeicherte Spätverstellung
  F855  3D         MUL                  ; × Spätverstellung; High-Byte = / 256
  F856  5D         TSTB                 ; Low-Byte ≥ 128?
  F857  2A 01      BPL   loc_F85A       ; nein — ohne Rundung
  F859  4C         INCA                 ; + 1

loc_F85A:
  F85A  B7 82 11   STAA  $8211          ; $8211 = Spätverstellung
  F85D  20 0A      BRA   loc_F869       ; weiter

loc_F85F:
  F85F  7F 82 11   CLR   $8211          ; Spätverstellung = 0
  F862  7F 82 13   CLR   $8213          ; gespeicherter Wert = 0
  F865  4F         CLRA                 ; A = 0
  F866  B7 82 12   STAA  $8212          ; n = 0

loc_F869:
  F869  B6 80 18   LDAA  $8018          ; Drehzahl
  F86C  7E E1 79   JMP   loc_E179       ; zurück

; Tabelle $F86F, 1 Bytes: leer
  F86F  db FF

;------------------------------------------------------------------------------
; Patch im Interrupt: Spätverstellung $8211 zum Zündwinkel addieren.
;------------------------------------------------------------------------------
loc_F870:
  F870  BB 82 11   ADDA  $8211          ; + Spätverstellung
  F873  B7 80 7D   STAA  $807D          ; $807D = Winkel
  F876  7E CE 80   JMP   loc_CE80       ; zurück

; Tabelle $F879, 7 Bytes: leer
  F879  db FF FF FF FF FF FF FF

