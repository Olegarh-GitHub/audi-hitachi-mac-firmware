  D5C2  7F 80 73   CLR   $8073          ; fetch
  D5C5  F1 C7 91   CMPB  $C791          ; less than C791 = 12?
  D5C8  25 06      BCS   loc_D5D0       ; yes
  D5CA  F6 C7 90   LDAB  $C790          ; C790 = 0

