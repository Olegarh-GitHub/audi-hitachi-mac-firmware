;------------------------------------------------------------------------------
; TICK (≈10 ms), from IRQ1 with interrupts enabled.
; Engine stop: after synchronisation $8025 grows every tick, a cylinder event
; resets it. 100 ticks (C78D, ≈1 s) without events means the engine has stopped:
; $8003.7; with PORT5.5 = 1 [?] the fault memory is copied to internal RAM with a checksum,
; and the program restarts (CA8E) without a full RAM check.
; Before synchronisation: with PORT5.5 = 1 and $8003.3 (copy awaits restore), if
; internal RAM power was not lost (RP5CR.7) and the checksum is correct, codes and counters
; are restored from the copy; otherwise a full restart (CA88).
;------------------------------------------------------------------------------
loc_D0E3:
  D0E3  86 20      LDAA  #$20           ; synchronised?
  D0E5  B5 80 95   BITA  $8095          ; check
  D0E8  27 46      BEQ   loc_D130       ; no
  D0EA  7C 80 25   INC   $8025          ; ticks without events + 1
  D0ED  F6 80 25   LDAB  $8025          ; value
  D0F0  F1 C7 8D   CMPB  $C78D          ; below 100?
  D0F3  25 3B      BCS   loc_D130       ; yes - to the tasks
  D0F5  0F         SEI                  ; disable interrupts
  D0F6  86 80      LDAA  #$80           ; engine stopped ($8003.7)
  D0F8  BA 80 03   ORAA  $8003          ; set
  D0FB  B7 80 03   STAA  $8003          ; store
  D0FE  7B 20 15   TIM   #$20,PORT5     ; PORT5.5 [?]
  D101  27 24      BEQ   loc_D127       ; 0 - no copy
  D103  72 40 14   OIM   #$40,RP5CR     ; enable internal RAM
  D106  4F         CLRA                 ; checksum = 0
  D107  F6 80 00   LDAB  $8000          ; code byte 1
  D10A  1B         ABA                  ; add to checksum
  D10B  D7 41      STAB  $41            ; copy
  D10D  F6 80 01   LDAB  $8001          ; code byte 2
  D110  1B         ABA                  ; add to checksum
  D111  D7 42      STAB  $42            ; copy
  D113  F6 80 02   LDAB  $8002          ; code byte 3
  D116  1B         ABA                  ; add to checksum
  D117  D7 43      STAB  $43            ; copy
  D119  F6 80 2B   LDAB  $802B          ; starts without change
  D11C  1B         ABA                  ; add to checksum
  D11D  D7 44      STAB  $44            ; copy
  D11F  F6 80 2C   LDAB  $802C          ; $802C
  D122  1B         ABA                  ; add to checksum
  D123  D7 45      STAB  $45            ; copy
  D125  97 40      STAA  $40            ; checksum

loc_D127:
  D127  8E 82 90   LDS   #$8290         ; reset stack
  D12A  CE 80 05   LDX   #$8005         ; X = $8005
  D12D  7E CA 8E   JMP   loc_CA8E       ; restart the program (without RAM check)

loc_D130:
  D130  7B 20 15   TIM   #$20,PORT5     ; PORT5.5 [?]
  D133  27 48      BEQ   loc_D17D       ; 0 - to the tasks
  D135  F6 80 03   LDAB  $8003          ; flags
  D138  C5 08      BITB  #$08           ; copy awaits restore?
  D13A  27 41      BEQ   loc_D17D       ; no - to the tasks
  D13C  7B 80 14   TIM   #$80,RP5CR     ; internal RAM power not lost?
  D13F  27 38      BEQ   loc_D179       ; lost - full restart
  D141  0F         SEI                  ; disable interrupts
  D142  72 40 14   OIM   #$40,RP5CR     ; enable internal RAM
  D145  CE 00 41   LDX   #$0041         ; copy
  D148  4F         CLRA                 ; checksum = 0

loc_D149:
  D149  AB 00      ADDA  $00,X          ; + byte
  D14B  08         INX                  ; next
  D14C  8C 00 46   CPX   #$0046         ; up to $45
  D14F  26 F8      BNE   loc_D149       ; repeat
  D151  91 40      CMPA  $40            ; checksum correct?
  D153  26 24      BNE   loc_D179       ; no - full restart
  D155  96 41      LDAA  $41            ; restore codes
  D157  B7 80 00   STAA  $8000          ; (same)
  D15A  96 42      LDAA  $42            ; (same)
  D15C  B7 80 01   STAA  $8001          ; (same)
  D15F  96 43      LDAA  $43            ; (same)
  D161  B7 80 02   STAA  $8002          ; (same)
  D164  96 44      LDAA  $44            ; starts
  D166  B7 80 2B   STAA  $802B          ; (same)
  D169  96 45      LDAA  $45            ; $802C
  D16B  B7 80 2C   STAA  $802C          ; (same)
  D16E  71 BF 14   AIM   #$BF,RP5CR     ; disable internal RAM
  D171  0E         CLI                  ; enable interrupts
  D172  C4 F7      ANDB  #$F7           ; copy restored
  D174  F7 80 03   STAB  $8003          ; store
  D177  20 04      BRA   loc_D17D       ; to the tasks

loc_D179:
  D179  0F         SEI                  ; disable interrupts
  D17A  7E CA 88   JMP   RESET          ; full restart

;------------------------------------------------------------------------------
; TASK DISPATCHER (preemptive). Counters $8006-$8009, one per task,
; dividers D1E1 = 1 2 4 10. Each tick the counter + 1; when it reaches the divider the task
; is ready (bit 6). The first ready task in order is started (bit 7 = running),
; if no running task precedes it: task 0 preempts 1-3, task 1 preempts 2-3, and so on.
; A task ends by jumping to D1D1: clear "running", search for the next one.
;------------------------------------------------------------------------------
loc_D17D:
  D17D  CE D1 E1   LDX   #$D1E1         ; dividers
  D180  3C         PSHX                 ; push
  D181  CE 80 06   LDX   #$8006         ; task 0 counter

loc_D184:
  D184  6C 00      INC   $00,X          ; + 1
  D186  A6 00      LDAA  $00,X          ; value
  D188  FF 80 0A   STX   $800A          ; save X
  D18B  38         PULX                 ; dividers
  D18C  E6 00      LDAB  $00,X          ; divider
  D18E  08         INX                  ; next
  D18F  3C         PSHX                 ; save
  D190  FE 80 0A   LDX   $800A          ; counter
  D193  84 3F      ANDA  #$3F           ; count (without bits 7, 6)
  D195  10         SBA                  ; reached the divider?
  D196  26 07      BNE   loc_D19F       ; no
  D198  A6 00      LDAA  $00,X          ; counter
  D19A  8A 40      ORAA  #$40           ; + ready
  D19C  10         SBA                  ; - divider (count from zero)
  D19D  A7 00      STAA  $00,X          ; store

loc_D19F:
  D19F  08         INX                  ; next counter
  D1A0  8C 80 0A   CPX   #$800A         ; all four?
  D1A3  26 DF      BNE   loc_D184       ; no
  D1A5  38         PULX                 ; drop pointer

loc_D1A6:
  D1A6  5F         CLRB                 ; task number 0
  D1A7  CE 80 06   LDX   #$8006         ; task 0 counter

loc_D1AA:
  D1AA  A6 00      LDAA  $00,X          ; counter
  D1AC  2B 0B      BMI   loc_D1B9       ; running? - exit (a more important task is busy)
  D1AE  85 40      BITA  #$40           ; ready?
  D1B0  26 08      BNE   loc_D1BA       ; yes - start it
  D1B2  5C         INCB                 ; number + 1
  D1B3  08         INX                  ; next
  D1B4  8C 80 0A   CPX   #$800A         ; all?
  D1B7  26 F1      BNE   loc_D1AA       ; no

loc_D1B9:
  D1B9  3B         RTI                  ; return from interrupt

loc_D1BA:
  D1BA  8A 80      ORAA  #$80           ; running
  D1BC  80 40      SUBA  #$40           ; clear "ready"
  D1BE  A7 00      STAA  $00,X          ; store
  D1C0  CE D1 C9   LDX   #$D1C9         ; task table D1C9
  D1C3  58         ASLB                 ; number × 2
  D1C4  3A         ABX                  ; X -> address
  D1C5  EE 00      LDX   $00,X          ; task address
  D1C7  6E 00      JMP   $00,X          ; jump to the task

; table $D1C9, 8 bytes: task addresses: D220 (0), DD18 (1), E30A (2), EA2C (3)
  D1C9  db D2 20 DD 18 E3 0A EA 2C

loc_D1D1:
  D1D1  CE 80 06   LDX   #$8006         ; counters

loc_D1D4:
  D1D4  A6 00      LDAA  $00,X          ; counter
  D1D6  2B 03      BMI   loc_D1DB       ; running? - this one has finished
  D1D8  08         INX                  ; next
  D1D9  20 F9      BRA   loc_D1D4       ; search

loc_D1DB:
  D1DB  84 7F      ANDA  #$7F           ; clear "running"
  D1DD  A7 00      STAA  $00,X          ; store
  D1DF  20 C5      BRA   loc_D1A6       ; search for the next ready task

; table $D1E1, 4 bytes: task dividers: 1 2 4 10 ticks
  D1E1  db 01 02 04 0A

;------------------------------------------------------------------------------
; IS_IDLE: is the throttle closed (idle switch F60)?
; Output: C = 1 means closed. If engine speed is not below the first point of axis C210
; (40 units ≈ 890 rpm) and the idle switch is flagged as faulty ($8093.3),
; the answer is always "not closed".
;------------------------------------------------------------------------------
IS_IDLE:                                ; called from: TASK0, TASK1, TASK2, TASK3
  D1E5  B6 80 18   LDAA  $8018          ; engine speed
  D1E8  B1 C2 10   CMPA  $C210          ; below 40 units (≈890 rpm)?
  D1EB  25 07      BCS   loc_D1F4       ; yes: trust the switch
  D1ED  86 08      LDAA  #$08           ; idle switch fault bit
  D1EF  B5 80 93   BITA  $8093          ; idle switch faulty?
  D1F2  26 08      BNE   loc_D1FC       ; yes: treat the throttle as open

loc_D1F4:
  D1F4  8D 1F      BSR   RD_INPUTS      ; read digital inputs (chip reg. $19)
  D1F6  85 20      BITA  #$20           ; bit 5 is the idle switch F60
  D1F8  27 02      BEQ   loc_D1FC       ; open? yes: throttle open
  D1FA  0D         SEC                  ; closed: C = 1
  D1FB  39         RTS

loc_D1FC:
  D1FC  0C         CLC                  ; C = 0: throttle open
  D1FD  39         RTS

;------------------------------------------------------------------------------
; MAP_BAD_LOAD: is G71 faulty while the engine is under load?
; Output: C = 1 if there is a pressure fault ($8091 & $72), engine speed is not below
; 40 units and the throttle is not closed. Then instead of the measured pressure
; the substitute value $C79E is used.
;------------------------------------------------------------------------------
MAP_BAD_LOAD:                           ; called from: TASK1, TASK3
  D1FE  86 72      LDAA  #$72           ; pressure fault bits
  D200  B5 80 91   BITA  $8091          ; any pressure faults?
  D203  27 0E      BEQ   loc_D213       ; no: C = 0
  D205  B6 80 18   LDAA  $8018          ; engine speed
  D208  B1 C2 10   CMPA  $C210          ; below 40 units (≈890 rpm)?
  D20B  25 06      BCS   loc_D213       ; yes: C = 0
  D20D  8D D6      BSR   IS_IDLE        ; throttle closed?
  D20F  25 02      BCS   loc_D213       ; yes: C = 0
  D211  0D         SEC                  ; C = 1: use the substitute pressure
  D212  39         RTS

loc_D213:
  D213  0C         CLC                  ; C = 0
  D214  39         RTS

;------------------------------------------------------------------------------
; RD_INPUTS: read chip register $19, the digital inputs.
; Bit 5 is F60 (idle), bit 4 is F81 (full throttle), bit 3 is the brake light switch,
; bit 2 reads back the N115 output. 1 = contact closed [assumed from the logic].
;------------------------------------------------------------------------------
RD_INPUTS:                              ; called from: TASK0, TASK1, TASK2, TASK3
  D215  86 19      LDAA  #$19           ; register number $19

;------------------------------------------------------------------------------
; CHIP_RD: read chip register $0100: A = number, on exit A = data.
; Interrupts are disabled so that an IRQ cannot change the register number between the write and the read.
;------------------------------------------------------------------------------
CHIP_RD:                                ; called from: TASK0, TASK1, TASK2, TASK3
  D217  0F         SEI                  ; disable interrupts
  D218  B7 01 00   STAA  $0100          ; register number
  D21B  B6 01 01   LDAA  $0101          ; data
  D21E  0E         CLI                  ; enable interrupts
  D21F  39         RTS

;------------------------------------------------------------------------------
; TASK 0 — every tick (≈10 ms).
; 1) PORT6.7 toggles: a signal to the external circuit that the program is running.
; 2) PORT2.5 [?] = 1 at engine speed ≥ 20 units (≈440-480 rpm), only after synchronisation.
; 3) Polling of the chip's ADC: channels 0-5 -> $8019-$801E, 7 -> $8020. Channel 6 (knock)
;   is not read here. Channel 4 ($801D) is read once — on the first tick after
;   synchronisation ($8075.0).
;------------------------------------------------------------------------------
TASK0:                                  ; called from: TASK0
  D220  75 80 17   EIM   #$80,PORT6     ; toggle PORT6.7: "program running"
  D223  5F         CLRB                 ; ADC channel number = 0
  D224  CE 80 19   LDX   #$8019         ; X -> $8019, first cell
  D227  86 20      LDAA  #$20           ; synchronisation present?
  D229  B5 80 95   BITA  $8095          ; check
  D22C  27 28      BEQ   loc_D256       ; no — leave PORT2.5 alone
  D22E  B6 80 18   LDAA  $8018          ; engine speed
  D231  81 14      CMPA  #$14           ; below 20 units?
  D233  24 05      BCC   loc_D23A       ; no — PORT2.5 = 1
  D235  71 DF 03   AIM   #$DF,PORT2     ; PORT2.5 = 0
  D238  20 03      BRA   loc_D23D       ; continue

loc_D23A:
  D23A  72 20 03   OIM   #$20,PORT2     ; PORT2.5 = 1

loc_D23D:
  D23D  5C         INCB                 ; next channel
  D23E  08         INX                  ; next cell
  D23F  C1 04      CMPB  #$04           ; channel 4?
  D241  26 13      BNE   loc_D256       ; no — read
  D243  86 20      LDAA  #$20           ; synchronisation present?
  D245  B5 80 95   BITA  $8095          ; check
  D248  27 F3      BEQ   loc_D23D       ; no — skip channel 4
  D24A  B6 80 75   LDAA  $8075          ; channel 4 already read after synchronisation?
  D24D  85 01      BITA  #$01           ; check
  D24F  26 EC      BNE   loc_D23D       ; yes — skip
  D251  8A 01      ORAA  #$01           ; mark: read
  D253  B7 80 75   STAA  $8075          ; store $8075

loc_D256:
  D256  C1 06      CMPB  #$06           ; channel 6 (knock)?
  D258  27 E3      BEQ   loc_D23D       ; yes — skip
  D25A  86 14      LDAA  #$14           ; chip register $14 — ADC start
  D25C  0F         SEI                  ; disable interrupts
  D25D  B7 80 2A   STAA  $802A          ; marker "ADC in use by task 0"
  D260  FD 01 00   STD   $0100          ; start conversion, channel = B
  D263  0E         CLI                  ; enable interrupts

loc_D264:
  D264  86 1F      LDAA  #$1F           ; status register $1F
  D266  8D AF      BSR   CHIP_RD        ; read
  D268  2B FA      BMI   loc_D264       ; bit 7 = 1 — still running, wait
  D26A  0F         SEI                  ; disable interrupts
  D26B  B6 80 2A   LDAA  $802A          ; marker still in place?
  D26E  27 E6      BEQ   loc_D256       ; no (an interrupt used the ADC) — repeat
  D270  C1 03      CMPB  #$03           ; channel 3 (lambda)?
  D272  26 1E      BNE   loc_D292       ; no — 8 bits
  D274  37         PSHB                 ; save the channel number
  D275  C6 14      LDAB  #$14           ; result register, high byte
  D277  F7 01 00   STAB  $0100          ; select
  D27A  B6 01 01   LDAA  $0101          ; read
  D27D  5C         INCB                 ; low byte
  D27E  F7 01 00   STAB  $0100          ; select
  D281  F6 01 01   LDAB  $0101          ; read
  D284  FD 80 B3   STD   $80B3          ; $80B3/$80B4 = full lambda result
  D287  05         ASLD                 ; double (lambda 0…1 V occupies the lower half of the scale) [assumed]
  D288  0E         CLI                  ; enable interrupts
  D289  24 02      BCC   loc_D28D       ; no overflow? yes
  D28B  86 FF      LDAA  #$FF           ; limit to 255

loc_D28D:
  D28D  A7 00      STAA  $00,X          ; store into the cell
  D28F  33         PULB                 ; channel number
  D290  20 AB      BRA   loc_D23D       ; next

loc_D292:
  D292  86 14      LDAA  #$14           ; result register
  D294  8D 81      BSR   CHIP_RD        ; read
  D296  A7 00      STAA  $00,X          ; store into the cell
  D298  8C 80 20   CPX   #$8020         ; last one ($8020)?
  D29B  26 A0      BNE   loc_D23D       ; no — next channel

;------------------------------------------------------------------------------
; Fuel cut-off signal from J142 (pin 4, $801E): below 128 — cut-off,
; $8077.0 = 1. It sets N7 = 40 % (E484).
;------------------------------------------------------------------------------
  D29D  F6 80 77   LDAB  $8077          ; flags
  D2A0  CA 01      ORAB  #$01           ; cut-off — bit 0 = 1
  D2A2  B6 80 1E   LDAA  $801E          ; pin 4 signal
  D2A5  81 80      CMPA  #$80           ; below 128?
  D2A7  25 02      BCS   loc_D2AB       ; yes — cut-off
  D2A9  C4 FE      ANDB  #$FE           ; no — bit 0 = 0

loc_D2AB:
  D2AB  F7 80 77   STAB  $8077          ; store $8077

;------------------------------------------------------------------------------
; Open-circuit and short-circuit check of the temperature sensors. Flags in $8092:
; bit 7 — G42 faulty now; 5 — G42 below 16 (short circuit); 4 — G42 above 235 (open circuit);
; bit 6 — G62 faulty now; 3 — G62 below 8 (short circuit); 2 — G62 above 228 (open circuit).
; Substitute values: G42 = 194 (−20 °C per SSP), G62 = 30 (80 °C per SSP).
; Bits 5-2 are latching (cleared by erasing) — codes 2322 and 2312.
;------------------------------------------------------------------------------
  D2AE  F6 80 92   LDAB  $8092          ; temperature flags
  D2B1  C4 3F      ANDB  #$3F           ; clear "now", keep the latching ones
  D2B3  B6 80 20   LDAA  $8020          ; G42
  D2B6  B1 C7 86   CMPA  $C786          ; below C786 = 16?
  D2B9  24 04      BCC   loc_D2BF       ; no
  D2BB  CA A0      ORAB  #$A0           ; G42 short-circuited
  D2BD  20 07      BRA   loc_D2C6       ; substitute

loc_D2BF:
  D2BF  B1 C7 85   CMPA  $C785          ; above C785 = 235?
  D2C2  23 08      BLS   loc_D2CC       ; no — OK
  D2C4  CA 90      ORAB  #$90           ; G42 open circuit

loc_D2C6:
  D2C6  B6 C7 88   LDAA  $C788          ; substitute value C788 = 194 (−20 °C)
  D2C9  B7 80 20   STAA  $8020          ; instead of the measured value

loc_D2CC:
  D2CC  B6 80 1B   LDAA  $801B          ; G62
  D2CF  B1 C7 84   CMPA  $C784          ; below C784 = 8?
  D2D2  24 04      BCC   loc_D2D8       ; no
  D2D4  CA 48      ORAB  #$48           ; G62 short-circuited
  D2D6  20 07      BRA   loc_D2DF       ; substitute

loc_D2D8:
  D2D8  B1 C7 83   CMPA  $C783          ; above C783 = 228?
  D2DB  23 08      BLS   loc_D2E5       ; no — OK
  D2DD  CA 44      ORAB  #$44           ; G62 open circuit

loc_D2DF:
  D2DF  B6 C7 87   LDAA  $C787          ; substitute value C787 = 30 (80 °C)
  D2E2  B7 80 1B   STAA  $801B          ; instead of the measured value

loc_D2E5:
  D2E5  F7 80 92   STAB  $8092          ; store $8092

;------------------------------------------------------------------------------
; Temperature flags in $8075 from G62 (scale [assumed], see the legend):
; bit 4 — not above 90 (warmer than ≈ +37 °C); bit 3 — not above 169 (warmer than ≈ +4 °C);
; bit 2 — not above 14 (hotter than ≈ 100 °C); bit 1 — below 44 (warmer than ≈ 65 °C,
; per SSP the switch to ignition map 1), cleared when the value becomes 49 or more.
; $807B — the lowest temperature (largest value) since switch-on.
;------------------------------------------------------------------------------
  D2E8  F6 80 75   LDAB  $8075          ; temperature flags
  D2EB  C4 E3      ANDB  #$E3           ; clear bits 4, 3, 2
  D2ED  B1 C6 BE   CMPA  $C6BE          ; G62 above C6BE = 90?
  D2F0  22 02      BHI   loc_D2F4       ; yes — do not set bit 4
  D2F2  CA 10      ORAB  #$10           ; bit 4

loc_D2F4:
  D2F4  B1 C6 C2   CMPA  $C6C2          ; above C6C2 = 169?
  D2F7  22 02      BHI   loc_D2FB       ; yes
  D2F9  CA 08      ORAB  #$08           ; bit 3

loc_D2FB:
  D2FB  B1 C6 CA   CMPA  $C6CA          ; above C6CA = 14?
  D2FE  22 02      BHI   loc_D302       ; yes
  D300  CA 04      ORAB  #$04           ; bit 2

loc_D302:
  D302  B1 C7 92   CMPA  $C792          ; below C792 = 44?
  D305  25 0B      BCS   loc_D312       ; yes — bit 1
  D307  80 05      SUBA  #$05           ; hysteresis 5
  D309  B1 C7 92   CMPA  $C792          ; below 49?
  D30C  25 06      BCS   loc_D314       ; yes — no change
  D30E  C4 FD      ANDB  #$FD           ; colder — clear bit 1
  D310  20 02      BRA   loc_D314       ; continue

loc_D312:
  D312  CA 02      ORAB  #$02           ; bit 1: warm (≈65 °C)

loc_D314:
  D314  F7 80 75   STAB  $8075          ; store $8075
  D317  B6 80 1B   LDAA  $801B          ; G62
  D31A  B1 80 7B   CMPA  $807B          ; colder than before?
  D31D  25 03      BCS   loc_D322       ; no
  D31F  B7 80 7B   STAA  $807B          ; $807B = new lowest temperature

;------------------------------------------------------------------------------
; ENGINE SPEED. Each tick the chip counts the ring gear teeth (G28), registers $0C/$0D -> $8026/$8027.
; $8018 — engine speed in units (≈22…24 rpm per unit [assumed]). From 31 units upwards —
; the count of the last tick as is; below 31 — the average over 8 ticks (during cranking
; the count is small and jumps). More than 255 — 255.
; $8098 accumulates teeth between G4 marks: 540 without a mark — suspicion
; and G4 fault (2112). The mark is handled by the interrupt (CC83).
;------------------------------------------------------------------------------
loc_D322:
  D322  C6 0C      LDAB  #$0C           ; register $0C — tooth count, high byte
  D324  CE 01 00   LDX   #$0100         ; X -> chip
  D327  0F         SEI                  ; disable interrupts
  D328  E7 00      STAB  $00,X          ; select register
  D32A  A6 01      LDAA  $01,X          ; high byte
  D32C  5C         INCB                 ; register $0D
  D32D  E7 00      STAB  $00,X          ; select
  D32F  E6 01      LDAB  $01,X          ; low byte
  D331  0E         CLI                  ; enable interrupts
  D332  FD 80 26   STD   $8026          ; $8026/$8027 = teeth per tick
  D335  CE 80 00   LDX   #$8000         ; X = $8000
  D338  4D         TSTA                 ; any teeth?
  D339  26 03      BNE   loc_D33E       ; yes
  D33B  5D         TSTB                 ; low byte
  D33C  27 09      BEQ   loc_D347       ; no — there were no teeth

loc_D33E:
  D33E  62 08 95   OIM   #$08,$95,X     ; teeth present ($8095.3)
  D341  62 40 03   OIM   #$40,$03,X     ; "teeth already seen" ($8003.6)
  D344  BD F7 26   JSR   TEST_EXIT      ; leave the actuator test: the engine is turning

loc_D347:
  D347  F3 80 98   ADDD  $8098          ; accumulate teeth between G4 marks
  D34A  FD 80 98   STD   $8098          ; save
  D34D  83 02 1C   SUBD  #$021C         ; reached 540?
  D350  25 17      BCS   loc_D369       ; no
  D352  86 10      LDAA  #$10           ; was there a G4 mark in this time ($8095.4)?
  D354  B5 80 95   BITA  $8095          ; check
  D357  26 05      BNE   loc_D35E       ; yes — reset
  D359  62 30 94   OIM   #$30,$94,X     ; no mark: G4 fault (2112) and suspicion
  D35C  20 0B      BRA   loc_D369       ; continue

loc_D35E:
  D35E  61 DF 94   AIM   #$DF,$94,X     ; clear the suspicion
  D361  4F         CLRA                 ; D = 0
  D362  5F         CLRB                 ; (D = 0)
  D363  FD 80 98   STD   $8098          ; count from zero
  D366  61 EF 95   AIM   #$EF,$95,X     ; clear the "mark seen" flag

loc_D369:
  D369  F6 80 27   LDAB  $8027          ; teeth, low byte
  D36C  7D 80 26   TST   $8026          ; high byte not zero?
  D36F  27 02      BEQ   loc_D373       ; no
  D371  C6 FF      LDAB  #$FF           ; more than 255 — 255

loc_D373:
  D373  CE 80 00   LDX   #$8000         ; X = $8000
  D376  C1 1F      CMPB  #$1F           ; 31 or more?
  D378  24 13      BCC   loc_D38D       ; yes — take as is
  D37A  A6 83      LDAA  $83,X          ; ticks accumulated
  D37C  81 08      CMPA  #$08           ; already 8?
  D37E  24 08      BCC   loc_D388       ; yes — average
  D380  EB 84      ADDB  $84,X          ; sum
  D382  E7 84      STAB  $84,X          ; save
  D384  6C 83      INC   $83,X          ; ticks + 1
  D386  20 0B      BRA   loc_D393       ; do not change $8018 yet

loc_D388:
  D388  E6 84      LDAB  $84,X          ; sum over 8 ticks
  D38A  54         LSRB                 ; / 8
  D38B  54         LSRB                 ; (/ 8)
  D38C  54         LSRB                 ; (/ 8)

loc_D38D:
  D38D  6F 83      CLR   $83,X          ; ticks = 0
  D38F  6F 84      CLR   $84,X          ; sum = 0
  D391  E7 18      STAB  $18,X          ; $8018 = engine speed

loc_D393:
  D393  6B 20 03   TIM   #$20,$03,X     ; atmospheric pressure already taken ($8003.5)?
  D396  26 0C      BNE   loc_D3A4       ; yes
  D398  A6 19      LDAA  $19,X          ; G71 pressure on the first tick after switch-on
  D39A  5D         TSTB                 ; leftover of old code (changes nothing)
  D39B  20 02      BRA   loc_D39F       ; continue

; table $D39D, 2 bytes: dead bytes of old code
  D39D  db 86 80

loc_D39F:
  D39F  A7 04      STAA  $04,X          ; $8004 = atmospheric pressure
  D3A1  62 20 03   OIM   #$20,$03,X     ; taken

loc_D3A4:
  D3A4  A6 04      LDAA  $04,X          ; atmospheric pressure

;------------------------------------------------------------------------------
; N17 — COLD START VALVE. All times in ticks (≈10 ms).
; Altitude: $802D = point index for atmospheric pressure $8004 on axis C2B0
; (128 122 109 102): 0 — at sea level (> 122), 3 — high altitude (≤ 102).
; Modes (they work only after the first synchronisation, $8075.0):
; 1) Test 4443: open for 2 ticks, closed for 98, 1000 ticks in total (10 s).
; 2) Cold engine start (colder than ≈ +37 °C, $8075.4 = 0), until the
;   post-start delay has expired: duration from the lowest temperature $807B —
;   C664 (120 50 10 0) × 10 ticks over axis C660 (216 205 169 90), reduced
;   in proportion to ($8079 - $801D) / $8079, where $8079 comes from C66C (214 154 79 29).
;   Pulses by altitude: open C2B4 / closed C2B8 = 255/0 (at sea level —
;   continuously), 20/5, 10/10, 5/10.
; 3) After start (colder than ≈ +4 °C, $8075.3 = 0): C674 (30 20 10 0) × 10 ticks
;   over axis C670 (211 205 189 169), pulses 5 open / 10 closed.
; 4) Hot start (hotter than ≈ 100 °C, $8075.2 = 1): wait 200 ticks, then
;   10 open / 30 closed until 400 ticks have expired (C6C3, C6C5, C6C6, C6C8).
; 5) Pressure rise (after modes 2-4, engine colder than ≈ 65 °C, throttle not
;   closed): pressure increase over 40 ms ($8073) -> opening time from C678/C680,
;   weighted by temperature (C690 -> C694). The second output ($8077.6) is the flag
;   "enrichment took place" for the mixture.
; Flags: $8075.7 — start mode in progress, .6 — start mode finished,
; .5 — after-start mode finished; $8076.7 — valve open (mode 4),
; .5 and .3 — modes 2-4 completed. $80AA — how many ticks are left, $80AC — pulse
; phase timer.
; Note: bits 0 and 1 of $8076 (D3F5-D430) compare the altitude index 0…3 with
; thresholds 28 and 26, so they are always cleared; the branches depending on them never run.
; Proof (checked by a script over the whole code, 2026-11-18):
; - D3F5 is entered only from D3B6 (B = altitude index from AXIS_DN, 0…3) and
;   by fall-through from D3ED (B = 0); D3F5-D430 is passed before every D475;
; - $8076 is written only by D3FE-D42E, D447, D627, D648; D627/D648 write A,
;   obtained from $8076 at D475, and bits 0/1 are not set on the way;
; - there is no indexed write with offset $76 and no 16-bit write to $8075 anywhere.
; Bit 2 is set only at D63B, which is reached only with bit 1 — so also never (see the header).
; Branch D5A8-D5B5 does not run because of calibration C78F = 0 (in another firmware it may).
; The only caveat: if a tester can write to RAM over the K-line, it could
; set these bits manually (the KW1281 commands have not been analysed yet).
;------------------------------------------------------------------------------
  D3A6  CE C2 B0   LDX   #$C2B0         ; atmospheric pressure axis C2B0
  D3A9  C6 04      LDAB  #$04           ; 4 points
  D3AB  BD CA 6B   JSR   AXIS_DN        ; point index (A = $8004)
  D3AE  F7 80 2D   STAB  $802D          ; $802D = altitude 0…3
  D3B1  B6 80 03   LDAA  $8003          ; flags $8003
  D3B4  85 10      BITA  #$10           ; engine has turned or test finished ($8003.4)?
  D3B6  26 3D      BNE   loc_D3F5       ; yes — normal operation
  D3B8  86 10      LDAA  #$10           ; N17 test step?
  D3BA  B5 80 AF   BITA  $80AF          ; check
  D3BD  27 2E      BEQ   loc_D3ED       ; no — counters to zero
  D3BF  FE 80 AA   LDX   $80AA          ; test time
  D3C2  8C 03 E8   CPX   #$03E8         ; 1000 ticks (10 s) elapsed?
  D3C5  24 1C      BCC   loc_D3E3       ; yes — close
  D3C7  08         INX                  ; + 1
  D3C8  FF 80 AA   STX   $80AA          ; save
  D3CB  B6 80 AC   LDAA  $80AC          ; phase timer
  D3CE  27 03      BEQ   loc_D3D3       ; zero — toggle
  D3D0  4A         DECA                 ; - 1
  D3D1  26 14      BNE   loc_D3E7       ; not zero — wait

loc_D3D3:
  D3D3  75 20 17   EIM   #$20,PORT6     ; toggle N17
  D3D6  7B 20 17   TIM   #$20,PORT6     ; now closed?
  D3D9  27 04      BEQ   loc_D3DF       ; no (open)
  D3DB  86 62      LDAA  #$62           ; closed for 98 ticks
  D3DD  20 08      BRA   loc_D3E7       ; continue

loc_D3DF:
  D3DF  86 02      LDAA  #$02           ; open for 2 ticks
  D3E1  20 04      BRA   loc_D3E7       ; continue

loc_D3E3:
  D3E3  4F         CLRA                 ; timer = 0
  D3E4  72 20 17   OIM   #$20,PORT6     ; close

loc_D3E7:
  D3E7  B7 80 AC   STAA  $80AC          ; store the timer
  D3EA  7E D7 38   JMP   loc_D738       ; to knock detection

loc_D3ED:
  D3ED  4F         CLRA                 ; D = 0
  D3EE  5F         CLRB                 ; B = 0
  D3EF  FD 80 AA   STD   $80AA          ; time = 0
  D3F2  B7 80 AC   STAA  $80AC          ; timer = 0

loc_D3F5:
  D3F5  B6 C6 C4   LDAA  $C6C4          ; threshold 28 (compared with the altitude index 0…3)
  D3F8  11         CBA                  ; index greater than 28? never (see the header)
  D3F9  24 0A      BCC   loc_D405       ; no — do not set bit 1
  D3FB  36         PSHA                 ; save
  D3FC  86 02      LDAA  #$02           ; bit 1
  D3FE  BA 80 76   ORAA  $8076          ; set
  D401  B7 80 76   STAA  $8076          ; store
  D404  32         PULA                 ; restore

loc_D405:
  D405  80 02      SUBA  #$02           ; threshold - 2
  D407  11         CBA                  ; index greater? never (see the header)
  D408  25 0A      BCS   loc_D414       ; do not clear (not executed)
  D40A  36         PSHA                 ; save
  D40B  86 FD      LDAA  #$FD           ; clear bit 1
  D40D  B4 80 76   ANDA  $8076          ; clear
  D410  B7 80 76   STAA  $8076          ; store
  D413  32         PULA                 ; restore

loc_D414:
  D414  B6 C7 8E   LDAA  $C78E          ; threshold C78E = 26
  D417  11         CBA                  ; index greater? never (see the header)
  D418  24 0A      BCC   loc_D424       ; no — do not set bit 0
  D41A  36         PSHA                 ; save
  D41B  86 01      LDAA  #$01           ; bit 0
  D41D  BA 80 76   ORAA  $8076          ; set
  D420  B7 80 76   STAA  $8076          ; store
  D423  32         PULA                 ; restore

loc_D424:
  D424  80 02      SUBA  #$02           ; threshold - 2
  D426  11         CBA                  ; index greater? never (see the header)
  D427  25 08      BCS   loc_D431       ; do not clear (not executed)
  D429  86 FE      LDAA  #$FE           ; clear bit 0
  D42B  B4 80 76   ANDA  $8076          ; clear
  D42E  B7 80 76   STAA  $8076          ; store

loc_D431:
  D431  CE 00 00   LDX   #$0000         ; X = 0 (for resets)
  D434  86 01      LDAA  #$01           ; first synchronisation done ($8075.0)?
  D436  B5 80 75   BITA  $8075          ; check
  D439  26 03      BNE   loc_D43E       ; yes
  D43B  7E D6 4F   JMP   loc_D64F       ; no — close N17

loc_D43E:
  D43E  F6 80 75   LDAB  $8075          ; temperature flags
  D441  C5 04      BITB  #$04           ; hotter than ≈ 100 °C?
  D443  26 30      BNE   loc_D475       ; yes — hot start
