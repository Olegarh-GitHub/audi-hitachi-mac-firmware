  D9AC  27 06      BEQ   loc_D9B4       ; nein
  D9AE  96 11      LDAA  TRCSR1         ; Fehler zurücksetzen
  D9B0  96 12      LDAA  RDR            ; Byte verwerfen
  D9B2  20 9B      BRA   loc_D94F       ; weiter

loc_D9B4:
  D9B4  96 11      LDAA  TRCSR1         ; Status lesen
  D9B6  96 12      LDAA  RDR            ; Byte
  D9B8  B7 80 FF   STAA  $80FF          ; $80FF = empfangenes Byte
  D9BB  61 FD 00   AIM   #$FD,$00,X     ; Bestätigung erhalten
  D9BE  6B 20 00   TIM   #$20,$00,X     ; Block des Testers wird empfangen?
  D9C1  26 26      BNE   loc_D9E9       ; ja — Byte speichern
  D9C3  73 80 FC   COM   $80FC          ; erwartete Antwort = Inversion des eigenen Bytes
  D9C6  B1 80 FC   CMPA  $80FC          ; stimmt überein?
  D9C9  26 84      BNE   loc_D94F       ; nein — weiter warten
  D9CB  6B 80 00   TIM   #$80,$00,X     ; Schlüsselwörter schon bestätigt?
  D9CE  26 10      BNE   loc_D9E0       ; ja
  D9D0  62 80 00   OIM   #$80,$00,X     ; bestätigt
  D9D3  86 05      LDAA  #$05           ; Pause 5 Ticks
  D9D5  B7 80 FB   STAA  $80FB          ; schreiben
  D9D8  7F 80 FE   CLR   $80FE          ; Bytenummer = 0
  D9DB  3C         PSHX                 ; X sichern
  D9DC  BD DA FF   JSR   KW_IDENT       ; erster Block — Steuergeräteidentifikation
  D9DF  38         PULX                 ; X zurückholen

