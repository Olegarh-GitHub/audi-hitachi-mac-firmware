;------------------------------------------------------------------------------
; N80_ROW — строка карты по давлению: $8015 = номер, $8017 = доля.
; Вход: X = ось давления, B = число точек. При ошибке G71 — подстановка 192.
;------------------------------------------------------------------------------
N80_ROW:                                ; вызов из: TASK3
  F54C  37         PSHB                 ; число точек в стек
  F54D  B6 80 19   LDAA  $8019          ; давление
  F550  C6 72      LDAB  #$72           ; ошибки G71
