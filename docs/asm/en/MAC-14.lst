;------------------------------------------------------------------------------
; N7 output: + addition from jerk damping ($8089), limits 5…95 %, converted to timer clocks.
;------------------------------------------------------------------------------
loc_E73A:
  E73A  BB 80 89   ADDA  $8089          ; + addition
  E73D  24 02      BCC   loc_E741       ; no overflow
  E73F  86 64      LDAA  #$64           ; 100

loc_E741:
  E741  81 5F      CMPA  #$5F           ; above 95 %?
  E743  25 04      BCS   loc_E749       ; no
  E745  86 5F      LDAA  #$5F           ; 95 %
  E747  20 06      BRA   loc_E74F       ; continue

loc_E749:
  E749  81 05      CMPA  #$05           ; below 5 %?
  E74B  24 03      BCC   loc_E750       ; no
  E74D  86 05      LDAA  #$05           ; 5 %

loc_E74F:
  E74F  5F         CLRB                 ; fraction = 0

loc_E750:
  E750  CE 80 10   LDX   #$8010         ; temporary cell
  E753  BD DD 06   JSR   N7_TO_TICKS    ; $805D = N7 time in clocks

loc_E756:
  E756  86 20      LDAA  #$20           ; synchronised?
  E758  B5 80 95   BITA  $8095          ; check
  E75B  26 03      BNE   loc_E760       ; yes
  E75D  7E E9 8F   JMP   loc_E98F       ; no - to pressure

loc_E760:
  E760  86 53      LDAA  #$53           ; timer 2: setting TCSR3 |= $53 (PWM N75) [assumed]
  E762  0F         SEI                  ; disable interrupts
  E763  9A 1B      ORAA  TCSR3          ; (same)
  E765  97 1B      STAA  TCSR3          ; (same)
  E767  0E         CLI                  ; enable interrupts
  E768  CE 80 00   LDX   #$8000         ; X = $8000
  E76B  B6 80 1B   LDAA  $801B          ; G62
  E76E  81 1E      CMPA  #$1E           ; colder than 30 (≈80 °C)?
  E770  22 17      BHI   loc_E789       ; yes
  E772  B6 80 B2   LDAA  $80B2          ; counter
  E775  4C         INCA                 ; + 1
  E776  81 32      CMPA  #$32           ; 50 (2 s)?
  E778  25 09      BCS   loc_E783       ; no
  E77A  4F         CLRA                 ; 0
  E77B  7C 80 B1   INC   $80B1          ; hot engine time, in 2 s steps ($80B1)
  E77E  26 03      BNE   loc_E783       ; no overflow
  E780  7A 80 B1   DEC   $80B1          ; hold

loc_E783:
  E783  B7 80 B2   STAA  $80B2          ; store
  E786  62 20 66   OIM   #$20,$66,X     ; $8066.5: engine hot

loc_E789:
  E789  6B 10 66   TIM   #$10,$66,X     ; $8066.4 (hot air under boost)?
  E78C  27 03      BEQ   loc_E791       ; no
  E78E  61 DF 66   AIM   #$DF,$66,X     ; clear $8066.5

;------------------------------------------------------------------------------
; N75 - BOOST CONTROL. Duty cycle $8067 = 0…255 (0…100 %), output
; by software PWM in the CMI interrupt on PORT2.6. Higher duty cycle means higher boost [assumed].
; It works only if ALL of these hold: full load (F81 closed and OK), no prolonged
; knock ($807A.5), no G71 faults, no overheating (F76 open, PORT5.7 = 1),
; limit switch F60 OK and open. Otherwise N75 = 0 and the integrator is preset
; from the pilot control map C700 (4×4: pressure C6F8, rpm C6FC).
; Boost TARGET: table C718 by rpm (axis C710 = 80 119 160 200 213 223 240 255):
; 174 178 176 177 179 179 178 176 (≈1.36…1.40 bar abs. [assumed scale 128 = 1 bar]).
; Controller: integrator $8069 (16 bit) + fast part from the error + correction
; by the rate of pressure change ($806B).
;------------------------------------------------------------------------------
loc_E791:
  E791  F6 80 93   LDAB  $8093          ; limit switch flags
  E794  C5 02      BITB  #$02           ; F81 faulty?
  E796  26 25      BNE   loc_E7BD       ; yes - switch N75 off
  E798  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  E79B  85 10      BITA  #$10           ; full load (F81)?
  E79D  27 1E      BEQ   loc_E7BD       ; no - switch off
  E79F  86 20      LDAA  #$20           ; prolonged knock ($807A.5)?
  E7A1  B5 80 7A   BITA  $807A          ; check
  E7A4  26 17      BNE   loc_E7BD       ; yes - switch off
  E7A6  86 72      LDAA  #$72           ; G71 faults
  E7A8  B5 80 91   BITA  $8091          ; check
  E7AB  26 10      BNE   loc_E7BD       ; present - switch off
  E7AD  7B 80 15   TIM   #$80,PORT5     ; overheating (F76 closes the input: PORT5.7 = 0)?
  E7B0  27 0B      BEQ   loc_E7BD       ; yes - switch off
  E7B2  C5 0C      BITB  #$0C           ; F60 faulty?
  E7B4  26 07      BNE   loc_E7BD       ; yes - switch off
  E7B6  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  E7B9  85 20      BITA  #$20           ; F60 (throttle closed)?
  E7BB  27 48      BEQ   loc_E805       ; no - regulate

loc_E7BD:
  E7BD  61 3F 66   AIM   #$3F,$66,X     ; N75 off: clear "overshoot" and "rise"
  E7C0  B6 80 20   LDAA  $8020          ; G42
  E7C3  81 A5      CMPA  #$A5           ; 165 and above (cold air)?
  E7C5  24 04      BCC   loc_E7CB       ; yes
  E7C7  4F         CLRA                 ; warm air: snapshot $806C = 0
  E7C8  B7 80 6C   STAA  $806C          ; store

loc_E7CB:
  E7CB  CE C6 F8   LDX   #$C6F8         ; pressure axis C6F8 = 166 154 141 115
  E7CE  C6 04      LDAB  #$04           ; 4 points
  E7D0  BD E9 D6   JSR   ROW4_MAP       ; row
  E7D3  CE C6 FC   LDX   #$C6FC         ; rpm axis C6FC = 100 120 160 200
  E7D6  C6 04      LDAB  #$04           ; 4 points
  E7D8  BD E9 F2   JSR   COL4_RPM       ; cell
  E7DB  CE C7 00   LDX   #$C700         ; pilot control map C700
  E7DE  BD EA 0A   JSR   MAP4X4         ; initial integrator value
  E7E1  C6 10      LDAB  #$10           ; hot air under boost ($8066.4)?
  E7E3  F5 80 66   BITB  $8066          ; check
  E7E6  26 15      BNE   loc_E7FD       ; yes - from the map
  E7E8  F6 80 B1   LDAB  $80B1          ; hot engine time
  E7EB  C1 3C      CMPB  #$3C           ; 60 or more (≥ 120 s)?
  E7ED  24 02      BCC   loc_E7F1       ; yes - from the map
  E7EF  86 66      LDAA  #$66           ; otherwise 102

loc_E7F1:
  E7F1  F6 80 6C   LDAB  $806C          ; snapshot of G42
  E7F4  C1 92      CMPB  #$92           ; 146 or more (cold)?
  E7F6  24 05      BCC   loc_E7FD       ; yes - keep
  E7F8  80 33      SUBA  #$33           ; - 51
  E7FA  24 01      BCC   loc_E7FD       ; not below zero
  E7FC  4F         CLRA                 ; 0

loc_E7FD:
  E7FD  5F         CLRB                 ; low byte 0
  E7FE  FD 80 69   STD   $8069          ; integrator
  E801  4F         CLRA                 ; N75 = 0
  E802  7E E9 8B   JMP   loc_E98B       ; store

loc_E805:
  E805  CE C7 10   LDX   #$C710         ; rpm axis C710
  E808  B6 80 18   LDAA  $8018          ; rpm
  E80B  C6 08      LDAB  #$08           ; 8 points
  E80D  BD CA 5F   JSR   AXIS_UP        ; find the interval
  E810  F7 80 10   STAB  $8010          ; index
  E813  BD CA 05   JSR   FRAC_UP        ; fraction
  E816  17         TBA                  ; A = fraction
  E817  F6 80 10   LDAB  $8010          ; B = index
  E81A  CE C7 18   LDX   #$C718         ; target C718
  E81D  3A         ABX                  ; X -> value
  E81E  16         TAB                  ; B = fraction
  E81F  BD CA 41   JSR   INTERP         ; boost TARGET
  E822  CE 80 00   LDX   #$8000         ; X = $8000
  E825  B0 80 19   SUBA  $8019          ; target - pressure
  E828  24 06      BCC   loc_E830       ; undershoot - continue
  E82A  62 40 66   OIM   #$40,$66,X     ; overshoot ($8066.6)
  E82D  40         NEGA                 ; absolute value
  E82E  20 03      BRA   loc_E833       ; continue

loc_E830:
  E830  61 BF 66   AIM   #$BF,$66,X     ; undershoot: $8066.6 = 0

loc_E833:
  E833  B7 80 10   STAA  $8010          ; $8010 = |error|
  E836  CE C7 30   LDX   #$C730         ; integrator step C730 (undershoot)
  E839  C5 40      BITB  #$40           ; bit 6 of register B: here B holds the left node of the target table C718[i] (after INTERP), not the overshoot flag
  E83B  27 03      BEQ   loc_E840       ; for 174…179 bit 6 = 0, so always C730; bit 6 = 1 for values 64…127 and 192…255, then C738
  E83D  CE C7 38   LDX   #$C738         ; C738 (not executed in the stock ROM; the tables are identical)

loc_E840:
  E840  BD E9 BE   JSR   TAB4_ERR       ; step by |error|: axis 12 8 4 0 -> 255 170 85 0
  E843  16         TAB                  ; B = step
  E844  4F         CLRA                 ; high byte 0 (step in the low byte)
  E845  FD 80 11   STD   $8011          ; $8011
  E848  86 40      LDAA  #$40           ; overshoot?
  E84A  B5 80 66   BITA  $8066          ; check
  E84D  27 0C      BEQ   loc_E85B       ; no - up
  E84F  FC 80 69   LDD   $8069          ; integrator
  E852  B3 80 11   SUBD  $8011          ; - step
  E855  24 0F      BCC   loc_E866       ; not below 0
  E857  4F         CLRA                 ; 0
  E858  5F         CLRB                 ; (same)
  E859  20 0B      BRA   loc_E866       ; continue

loc_E85B:
  E85B  FC 80 69   LDD   $8069          ; integrator
  E85E  F3 80 11   ADDD  $8011          ; + step
  E861  24 03      BCC   loc_E866       ; no overflow
  E863  CC FF 00   LDD   #$FF00         ; limit

loc_E866:
  E866  FD 80 69   STD   $8069          ; store the integrator
  E869  CE C7 20   LDX   #$C720         ; fast part, undershoot: C720 (axis 40 27 13 0 -> 51 34 17 0)
  E86C  86 40      LDAA  #$40           ; overshoot?
  E86E  B5 80 66   BITA  $8066          ; check
  E871  27 03      BEQ   loc_E876       ; no
  E873  CE C7 28   LDX   #$C728         ; overshoot: C728 (axis 50 33 17 0 -> 153 102 51 0)

loc_E876:
  E876  BD E9 BE   JSR   TAB4_ERR       ; fast part by |error|
  E879  C6 40      LDAB  #$40           ; overshoot?
  E87B  F5 80 66   BITB  $8066          ; check
  E87E  26 14      BNE   loc_E894       ; yes - subtract
  E880  16         TAB                  ; B = fast part
  E881  BB 80 69   ADDA  $8069          ; integrator + fast part
  E884  25 04      BCS   loc_E88A       ; overflow
  E886  81 FF      CMPA  #$FF           ; above 255?
  E888  25 12      BCS   loc_E89C       ; no

loc_E88A:
  E88A  86 FF      LDAA  #$FF           ; 255
  E88C  10         SBA                  ; - fast part
  E88D  B7 80 69   STAA  $8069          ; pull back the integrator (do not accumulate beyond 100 %)
  E890  86 FF      LDAA  #$FF           ; 255
  E892  20 08      BRA   loc_E89C       ; continue

loc_E894:
  E894  16         TAB                  ; B = fast part
  E895  B6 80 69   LDAA  $8069          ; integrator
  E898  10         SBA                  ; - fast part
  E899  24 01      BCC   loc_E89C       ; not below 0
  E89B  4F         CLRA                 ; 0

loc_E89C:
  E89C  C6 80      LDAB  #$80           ; pressure rising ($8066.7)?
  E89E  F5 80 66   BITB  $8066          ; check
  E8A1  26 09      BNE   loc_E8AC       ; yes - reduce
  E8A3  BB 80 6B   ADDA  $806B          ; falling: + $806B
  E8A6  24 0A      BCC   loc_E8B2       ; no overflow
  E8A8  86 FF      LDAA  #$FF           ; 255
  E8AA  20 06      BRA   loc_E8B2       ; continue

loc_E8AC:
  E8AC  B0 80 6B   SUBA  $806B          ; rising: - $806B
  E8AF  24 01      BCC   loc_E8B2       ; not below 0
  E8B1  4F         CLRA                 ; 0

loc_E8B2:
  E8B2  F6 80 6A   LDAB  $806A          ; integrator low byte
  E8B5  FD 80 10   STD   $8010          ; $8010 = duty cycle (16 bit)
  E8B8  B6 80 18   LDAA  $8018          ; rpm
  E8BB  C6 04      LDAB  #$04           ; 4 points
  E8BD  CE C7 50   LDX   #$C750         ; axis C750 = 40 120 200 255
  E8C0  BD CA 5F   JSR   AXIS_UP        ; find the interval
  E8C3  37         PSHB                 ; index
  E8C4  BD CA 05   JSR   FRAC_UP        ; fraction
  E8C7  17         TBA                  ; A = fraction
  E8C8  33         PULB                 ; B = index
  E8C9  CE C7 54   LDX   #$C754         ; maximum duty cycle C754 = 217 217 217 204 (≈85 %, 80 %)
  E8CC  3A         ABX                  ; X -> value
  E8CD  16         TAB                  ; B = fraction
  E8CE  BD CA 41   JSR   INTERP         ; limit
  E8D1  B7 80 12   STAA  $8012          ; $8012
  E8D4  B6 80 69   LDAA  $8069          ; integrator
  E8D7  F6 80 10   LDAB  $8010          ; duty cycle
  E8DA  F0 80 12   SUBB  $8012          ; - limit
  E8DD  25 04      BCS   loc_E8E3       ; not above the limit
  E8DF  10         SBA                  ; integrator - excess
  E8E0  24 01      BCC   loc_E8E3       ; not below 0
  E8E2  4F         CLRA                 ; 0

loc_E8E3:
  E8E3  B7 80 69   STAA  $8069          ; store the integrator
  E8E6  B6 80 10   LDAA  $8010          ; duty cycle
  E8E9  B1 80 12   CMPA  $8012          ; not above the limit?
  E8EC  25 07      BCS   loc_E8F5       ; yes
  E8EE  B6 80 12   LDAA  $8012          ; limit
  E8F1  5F         CLRB                 ; low byte 0
  E8F2  FD 80 10   STD   $8010          ; store

;------------------------------------------------------------------------------
; BOOST REDUCTION by temperatures, subtracted from the duty cycle:
; by G42 (axis C758 = 185 175 165 137 -> C75C = 83 38 13 13; colder means more;
; (snapshot $806C - 146) is added to G42 if the snapshot is cold)
; plus by G62 (axis C760 = 216 … 21 -> C768 = 89 89 89 81 71 64 25 0; cold
; engine means more), and with $8066.5 (engine hot) by hot engine time
; (~$80B1, axis C770 -> C778 = 64 … 0). Per SSP: below +10 °C boost is reduced,
; an open circuit in G42 (−20 °C) keeps boost low.
; The integrator does not drop below the reduction. A remainder below 224/65536 becomes zero.
; Limits C7A9 = 0 … C7AA = 255.
;------------------------------------------------------------------------------
loc_E8F5:
  E8F5  B6 80 20   LDAA  $8020          ; G42
  E8F8  F6 80 6C   LDAB  $806C          ; snapshot of G42
  E8FB  C0 92      SUBB  #$92           ; - 146
  E8FD  25 05      BCS   loc_E904       ; warm - no addition
  E8FF  1B         ABA                  ; + to G42
  E900  24 02      BCC   loc_E904       ; no overflow
  E902  86 FF      LDAA  #$FF           ; 255

loc_E904:
  E904  CE C7 58   LDX   #$C758         ; axis C758
  E907  C6 04      LDAB  #$04           ; 4 points
  E909  BD CA 6B   JSR   AXIS_DN        ; find the interval
  E90C  37         PSHB                 ; index
  E90D  BD CA 10   JSR   FRAC_DN        ; fraction
  E910  17         TBA                  ; A = fraction
  E911  33         PULB                 ; B = index
  E912  CE C7 5C   LDX   #$C75C         ; table C75C
  E915  3A         ABX                  ; X -> value
  E916  16         TAB                  ; B = fraction
  E917  BD CA 41   JSR   INTERP         ; reduction by air
  E91A  B7 80 12   STAA  $8012          ; $8012
  E91D  B6 80 1B   LDAA  $801B          ; G62
  E920  CE C7 60   LDX   #$C760         ; axis C760
  E923  C6 20      LDAB  #$20           ; engine hot ($8066.5)?
  E925  F5 80 66   BITB  $8066          ; check
  E928  27 07      BEQ   loc_E931       ; no
  E92A  B6 80 B1   LDAA  $80B1          ; hot engine time
  E92D  43         COMA                 ; invert
  E92E  CE C7 70   LDX   #$C770         ; axis C770

loc_E931:
  E931  C6 08      LDAB  #$08           ; 8 points
  E933  BD CA 6B   JSR   AXIS_DN        ; find the interval
  E936  37         PSHB                 ; index
  E937  BD CA 10   JSR   FRAC_DN        ; fraction
  E93A  17         TBA                  ; A = fraction
  E93B  CE C7 68   LDX   #$C768         ; table C768
  E93E  C6 20      LDAB  #$20           ; hot?
  E940  F5 80 66   BITB  $8066          ; check
  E943  27 03      BEQ   loc_E948       ; no
  E945  CE C7 78   LDX   #$C778         ; table C778

loc_E948:
  E948  33         PULB                 ; index
  E949  3A         ABX                  ; X -> value
  E94A  16         TAB                  ; B = fraction
  E94B  BD CA 41   JSR   INTERP         ; reduction by engine
  E94E  BB 80 12   ADDA  $8012          ; + by air
  E951  24 02      BCC   loc_E955       ; no overflow
  E953  86 FF      LDAA  #$FF           ; 255

loc_E955:
  E955  B7 80 12   STAA  $8012          ; $8012 = reduction
  E958  B6 80 69   LDAA  $8069          ; integrator
  E95B  B1 80 12   CMPA  $8012          ; not below the reduction?
  E95E  24 03      BCC   loc_E963       ; yes
  E960  B6 80 12   LDAA  $8012          ; raise to the reduction

loc_E963:
  E963  B7 80 69   STAA  $8069          ; store
  E966  FC 80 10   LDD   $8010          ; duty cycle
  E969  B0 80 12   SUBA  $8012          ; - reduction
  E96C  25 09      BCS   loc_E977       ; below zero - 0
  E96E  18         XGDX                 ; D to X
  E96F  8C 00 E0   CPX   #$00E0         ; below 224/65536?
  E972  25 03      BCS   loc_E977       ; yes - 0
  E974  18         XGDX                 ; restore
  E975  20 02      BRA   loc_E979       ; continue

loc_E977:
  E977  4F         CLRA                 ; 0
  E978  5F         CLRB                 ; (same)

loc_E979:
  E979  B1 C7 AA   CMPA  $C7AA          ; not above C7AA = 255?
  E97C  25 05      BCS   loc_E983       ; yes
  E97E  B6 C7 AA   LDAA  $C7AA          ; 255
  E981  20 08      BRA   loc_E98B       ; continue

loc_E983:
  E983  B1 C7 A9   CMPA  $C7A9          ; not below C7A9 = 0?
  E986  24 04      BCC   loc_E98C       ; yes
  E988  B6 C7 A9   LDAA  $C7A9          ; 0

loc_E98B:
  E98B  5F         CLRB                 ; low byte 0

loc_E98C:
  E98C  FD 80 67   STD   $8067          ; $8067 = N75 duty cycle

;------------------------------------------------------------------------------
; Pressure rise over 40 ms ($8073, 0 when falling or on a G71 fault), for N17 and patch F800.
; $8208-$820B - snapshots of PORT2, PORT5, PORT6 and the chip inputs: not read by the program,
; apparently for the tester (RAM read) [assumed].
;------------------------------------------------------------------------------
loc_E98F:
  E98F  86 72      LDAA  #$72           ; G71 faults
  E991  B5 80 91   BITA  $8091          ; check
  E994  26 0C      BNE   loc_E9A2       ; present - 0
  E996  B6 80 19   LDAA  $8019          ; pressure
  E999  F6 80 72   LDAB  $8072          ; pressure of the previous call
  E99C  B7 80 72   STAA  $8072          ; remember
  E99F  10         SBA                  ; increment
  E9A0  24 01      BCC   loc_E9A3       ; rising

loc_E9A2:
  E9A2  4F         CLRA                 ; falling or fault - 0

loc_E9A3:
  E9A3  B7 80 73   STAA  $8073          ; $8073
  E9A6  96 03      LDAA  PORT2          ; PORT2
  E9A8  B7 82 08   STAA  $8208          ; snapshot
  E9AB  96 15      LDAA  PORT5          ; PORT5
  E9AD  B7 82 09   STAA  $8209          ; snapshot
  E9B0  96 17      LDAA  PORT6          ; PORT6
  E9B2  B7 82 0A   STAA  $820A          ; snapshot
  E9B5  BD D2 15   JSR   RD_INPUTS      ; chip inputs
  E9B8  B7 82 0B   STAA  $820B          ; snapshot
  E9BB  7E D1 D1   JMP   loc_D1D1       ; end of task 2 - to the dispatcher

;------------------------------------------------------------------------------
; TAB4_ERR - table X: axis of 4 points (descending), followed by 4 values; quantity $8010.
;------------------------------------------------------------------------------
TAB4_ERR:                               ; called from: TASK2
  E9BE  B6 80 10   LDAA  $8010          ; quantity
  E9C1  C6 04      LDAB  #$04           ; 4 points
  E9C3  3C         PSHX                 ; save X
  E9C4  BD CA 6B   JSR   AXIS_DN        ; find the interval
  E9C7  37         PSHB                 ; index
  E9C8  BD CA 10   JSR   FRAC_DN        ; fraction
  E9CB  17         TBA                  ; A = fraction
  E9CC  33         PULB                 ; B = index
  E9CD  38         PULX                 ; X
  E9CE  CB 04      ADDB  #$04           ; values after the axis
  E9D0  3A         ABX                  ; X -> value
  E9D1  16         TAB                  ; B = fraction
  E9D2  BD CA 41   JSR   INTERP         ; interpolation
  E9D5  39         RTS                  ; return

;------------------------------------------------------------------------------
; ROW4_MAP - row of a 4×4 map by pressure (X = axis): $8011 index, $8013 fraction.
;------------------------------------------------------------------------------
ROW4_MAP:                               ; called from: TASK2
  E9D6  37         PSHB                 ; number of points
  E9D7  B6 80 19   LDAA  $8019          ; pressure
  E9DA  C6 72      LDAB  #$72           ; G71 faults
  E9DC  F5 80 91   BITB  $8091          ; check
  E9DF  27 03      BEQ   loc_E9E4       ; no
  E9E1  B6 C7 9E   LDAA  $C79E          ; substitute value

loc_E9E4:
  E9E4  33         PULB                 ; number of points
  E9E5  BD CA 6B   JSR   AXIS_DN        ; find the interval
  E9E8  F7 80 11   STAB  $8011          ; $8011
  E9EB  BD CA 10   JSR   FRAC_DN        ; fraction
  E9EE  F7 80 13   STAB  $8013          ; $8013
  E9F1  39         RTS                  ; return

;------------------------------------------------------------------------------
; COL4_RPM - column of a 4×4 map by rpm: $8010 index, $8012 fraction; B = row × 4 + column.
;------------------------------------------------------------------------------
COL4_RPM:                               ; called from: TASK2
  E9F2  B6 80 18   LDAA  $8018          ; rpm
  E9F5  BD CA 5F   JSR   AXIS_UP        ; find the interval
  E9F8  F7 80 10   STAB  $8010          ; $8010
  E9FB  BD CA 05   JSR   FRAC_UP        ; fraction
  E9FE  F7 80 12   STAB  $8012          ; $8012
  EA01  F6 80 11   LDAB  $8011          ; row
  EA04  58         ASLB                 ; × 4
  EA05  58         ASLB                 ; (× 4)
  EA06  FB 80 10   ADDB  $8010          ; + column
  EA09  39         RTS                  ; return

;------------------------------------------------------------------------------
; MAP4X4 - double interpolation 4×4 (X = map, B = cell).
;------------------------------------------------------------------------------
MAP4X4:                                 ; called from: TASK2
  EA0A  3A         ABX                  ; X -> cell
  EA0B  3C         PSHX                 ; save
  EA0C  F6 80 12   LDAB  $8012          ; rpm fraction
  EA0F  BD CA 41   JSR   INTERP         ; in the row
  EA12  B7 80 10   STAA  $8010          ; $8010
  EA15  C6 04      LDAB  #$04           ; next row (+4)
  EA17  38         PULX                 ; X
  EA18  3A         ABX                  ; X -> cell
  EA19  F6 80 12   LDAB  $8012          ; fraction
  EA1C  BD CA 41   JSR   INTERP         ; in the next row
  EA1F  B7 80 11   STAA  $8011          ; $8011
  EA22  CE 80 10   LDX   #$8010         ; two values
  EA25  F6 80 13   LDAB  $8013          ; pressure fraction
  EA28  BD CA 41   JSR   INTERP         ; between the rows
  EA2B  39         RTS                  ; return

;------------------------------------------------------------------------------
; TASK 3, start. Intake air temperature snapshot $8206.
; $8206 = G42 ($8020), but it is updated only when the engine has been idling for 2 s
; in a row (throttle closed, engine speed below 40 units).
; While driving the snapshot is frozen, so intake heating while driving has no effect [assumed].
; The snapshot is used to choose the N115 threshold (EAE1). The first one is taken immediately.
;------------------------------------------------------------------------------
TASK3:                                  ; called from: TASK3
  EA2C  7D 82 06   TST   $8206          ; snapshot never taken yet?
  EA2F  27 1F      BEQ   loc_EA50       ; yes: take it now
  EA31  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  EA34  24 08      BCC   loc_EA3E       ; no: idle counter to zero
  EA36  B6 80 18   LDAA  $8018          ; engine speed
  EA39  B1 C2 10   CMPA  $C210          ; below 40 units (≈890 rpm)?
  EA3C  25 05      BCS   loc_EA43       ; yes: count idle time

loc_EA3E:
  EA3E  7F 82 07   CLR   $8207          ; not idling: counter = 0
  EA41  20 13      BRA   loc_EA56       ; leave the snapshot alone

loc_EA43:
  EA43  B6 82 07   LDAA  $8207          ; idle time
  EA46  81 14      CMPA  #$14           ; already 20 calls (2 s)?
  EA48  24 06      BCC   loc_EA50       ; yes: update the snapshot
  EA4A  4C         INCA                 ; + 1
  EA4B  B7 82 07   STAA  $8207          ; save
  EA4E  20 06      BRA   loc_EA56       ; leave the snapshot alone for now

loc_EA50:
  EA50  B6 80 20   LDAA  $8020          ; intake air temperature G42
  EA53  B7 82 06   STAA  $8206          ; $8206 = snapshot

loc_EA56:
  EA56  86 20      LDAA  #$20           ; is there sync ($8095.5)?
  EA58  B5 80 95   BITA  $8095          ; check
  EA5B  26 03      BNE   loc_EA60       ; yes: N80 and N115
  EA5D  7E EA FC   JMP   loc_EAFC       ; no: skip them

;------------------------------------------------------------------------------
; N80: carbon canister purge. Duty cycle $8064 = 0…31 of 32 steps
; of a slow PWM (step 5.09 ms, period 163 ms, output in the OCF interrupt, F5FA).
; For the first 255 calls (25.5 s) after sync there is no purging (C795).
; After that an 8×8 map: rows by pressure (axis C7B0 = 116 103 90 77 71 64 58 51),
; columns by engine speed (axis C7B8 = 40 53 67 80 93 107 120 160).
; Map C7C0 is the normal one, C800 is used when $8066.1 is set [?]. At idle
; a constant value C7AE = 8 (or C845 = 4 when $8066.1 is set).
;------------------------------------------------------------------------------
loc_EA60:
  EA60  B6 80 63   LDAA  $8063          ; time counter since sync
  EA63  B1 C7 95   CMPA  $C795          ; reached C795 = 255 (25.5 s)?
  EA66  24 07      BCC   loc_EA6F       ; yes: purge according to the map
  EA68  4C         INCA                 ; + 1
  EA69  B7 80 63   STAA  $8063          ; save
  EA6C  5F         CLRB                 ; N80 duty cycle = 0
  EA6D  20 33      BRA   loc_EAA2       ; write

loc_EA6F:
  EA6F  CE C7 B0   LDX   #$C7B0         ; pressure axis C7B0
  EA72  C6 08      LDAB  #$08           ; 8 points
  EA74  BD F5 4C   JSR   N80_ROW        ; row and fraction by pressure
  EA77  CE C7 B8   LDX   #$C7B8         ; engine speed axis C7B8
  EA7A  C6 08      LDAB  #$08           ; 8 points
  EA7C  BD F5 68   JSR   N80_COL        ; column and fraction by engine speed; B = cell index
  EA7F  CE C7 C0   LDX   #$C7C0         ; map C7C0
  EA82  B6 80 66   LDAA  $8066          ; lambda flags [?]
  EA85  85 02      BITA  #$02           ; $8066.1?
  EA87  27 03      BEQ   loc_EA8C       ; no: normal map
  EA89  CE C8 00   LDX   #$C800         ; yes: map C800

loc_EA8C:
  EA8C  BD F5 81   JSR   MAP8X8         ; map interpolation
  EA8F  16         TAB                  ; B = duty cycle
  EA90  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  EA93  24 0D      BCC   loc_EAA2       ; no: from the map
  EA95  F6 C7 AE   LDAB  $C7AE          ; idle: C7AE = 8
  EA98  B6 80 66   LDAA  $8066          ; lambda flags
  EA9B  85 02      BITA  #$02           ; $8066.1?
  EA9D  27 03      BEQ   loc_EAA2       ; no: 8
  EA9F  F6 C8 45   LDAB  $C845          ; yes: C845 = 4

loc_EAA2:
  EAA2  F7 80 64   STAB  $8064          ; $8064 = N80 duty cycle

;------------------------------------------------------------------------------
; N115: tank vapour shut-off valve (chip reg. $19 bit 2).
; Enabled 50 calls (5 s) after sync (C844).
; Switched on:  pressure above 102 (96 + 6, ≈0.8 bar abs. [assumed])  or
;              engine speed above threshold + 4.
; Switched off: at idle, or pressure below 96 and engine speed below threshold.
; Engine speed threshold (C840…C843): 48 units (≈1070 rpm) if the G42 snapshot is ≥ 128
; (cold air), otherwise 58 units (≈1290 rpm). Same for AT and HS.
;------------------------------------------------------------------------------
  EAA5  CE 80 00   LDX   #$8000         ; X = $8000
  EAA8  A6 63      LDAA  $63,X          ; time since sync
  EAAA  B1 C8 44   CMPA  $C844          ; less than C844 = 50 (5 s)?
  EAAD  25 46      BCS   loc_EAF5       ; yes: switch N115 off
  EAAF  E6 19      LDAB  $19,X          ; pressure
  EAB1  BD D1 FE   JSR   MAP_BAD_LOAD   ; G71 faulty under load?
  EAB4  24 03      BCC   loc_EAB9       ; no: measurement
  EAB6  F6 C7 9E   LDAB  $C79E          ; yes: substitute value 192

loc_EAB9:
  EAB9  F0 C7 98   SUBB  $C798          ; pressure - C798 (96)
  EABC  25 09      BCS   loc_EAC7       ; below 96? yes: clear the flag
  EABE  C0 06      SUBB  #$06           ; another - 6
  EAC0  25 08      BCS   loc_EACA       ; between 96 and 102? yes: leave the flag unchanged
  EAC2  62 01 9F   OIM   #$01,$9F,X     ; above 102: $809F.0 = 1
  EAC5  20 03      BRA   loc_EACA       ; continue

loc_EAC7:
  EAC7  61 FE 9F   AIM   #$FE,$9F,X     ; below 96: $809F.0 = 0

loc_EACA:
  EACA  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  EACD  25 26      BCS   loc_EAF5       ; yes: switch N115 off
  EACF  6B 01 9F   TIM   #$01,$9F,X     ; pressure above 102?
  EAD2  26 1D      BNE   loc_EAF1       ; yes: switch N115 on
  EAD4  A6 18      LDAA  $18,X          ; engine speed
  EAD6  CE C8 40   LDX   #$C840         ; manual gearbox thresholds C840/C841
  EAD9  7B 04 17   TIM   #$04,PORT6     ; coding: PORT6.2 = 1 means HS
  EADC  26 03      BNE   loc_EAE1       ; HS? yes: keep
  EADE  CE C8 42   LDX   #$C842         ; AT: C842/C843

loc_EAE1:
  EAE1  F6 82 06   LDAB  $8206          ; G42 snapshot
  EAE4  C1 80      CMPB  #$80           ; 128 or above (cold)?
  EAE6  24 01      BCC   loc_EAE9       ; yes: threshold 48
  EAE8  08         INX                  ; no: threshold 58

loc_EAE9:
  EAE9  A0 00      SUBA  $00,X          ; engine speed - threshold
  EAEB  25 08      BCS   loc_EAF5       ; below threshold? yes: switch off
  EAED  81 04      CMPA  #$04           ; above by less than 4?
  EAEF  25 0B      BCS   loc_EAFC       ; yes: leave the state unchanged

loc_EAF1:
  EAF1  C6 04      LDAB  #$04           ; bit 2 = 1: N115 on
  EAF3  20 02      BRA   loc_EAF7       ; write

loc_EAF5:
  EAF5  C6 FB      LDAB  #$FB           ; bit 2 = 0: N115 off

loc_EAF7:
  EAF7  86 19      LDAA  #$19           ; chip register $19
  EAF9  FD 01 00   STD   $0100          ; write the output

;------------------------------------------------------------------------------
; Check of the engine speed sensors while the engine is (as far as the unit knows) stationary.
; While the chip has never counted any teeth yet ($8003.6 = 0, set by D341),
; but manifold pressure differs from atmospheric pressure (taken at switch-on)
; by 5 or more for 10 calls in a row (1 s), the engine is clearly turning but there is no
; engine speed signal. Then: faults G28 and G4 ($8094 |= $F0), $8003.6 = 1
; (the check is not run again) and exit from the actuator test (F726).
;------------------------------------------------------------------------------
loc_EAFC:
  EAFC  CE 80 00   LDX   #$8000         ; X = $8000
  EAFF  6B 40 03   TIM   #$40,$03,X     ; teeth already seen ($8003.6)?
  EB02  26 26      BNE   loc_EB2A       ; yes: no check needed
  EB04  F6 80 85   LDAB  $8085          ; deviation counter
  EB07  B6 80 19   LDAA  $8019          ; pressure
  EB0A  B0 80 04   SUBA  $8004          ; minus atmospheric pressure at switch-on
  EB0D  24 01      BCC   loc_EB10       ; difference positive? yes: continue
  EB0F  40         NEGA                 ; absolute value

loc_EB10:
  EB10  B1 C7 8A   CMPA  $C78A          ; less than C78A = 5?
  EB13  25 11      BCS   loc_EB26       ; yes: no deviation, counter = 0
  EB15  5C         INCB                 ; + 1
  EB16  F1 C7 8B   CMPB  $C78B          ; less than C78B = 10 (1 s)?
  EB19  25 0C      BCS   loc_EB27       ; yes: save counter
  EB1B  62 F0 94   OIM   #$F0,$94,X     ; faults G28 and G4 (codes 2111, 2112)
  EB1E  62 40 03   OIM   #$40,$03,X     ; check done
  EB21  BD F7 26   JSR   TEST_EXIT      ; exit the actuator test
  EB24  20 04      BRA   loc_EB2A       ; continue

loc_EB26:
  EB26  5F         CLRB                 ; counter = 0

loc_EB27:
  EB27  F7 80 85   STAB  $8085          ; save counter

;------------------------------------------------------------------------------
; G71 check. Fault flags in $8091:
;  bit 0: F60 closed (its own copy of the input);
;  bit 7: suspicion countdown running (counter $809C);
;  bit 6: pressure above 243 with the throttle closed for 10 calls (1 s): sensor "stuck high";
;  bit 5: pressure below 13 with the throttle open for 1 s: sensor "stuck low";
;  bit 4: during the first 10 s after start the pressure never moved 13 away from atmospheric;
;  bit 2: pressure has moved away from atmospheric (sensor is alive);
;  bit 3: check of the first 10 s finished;
;  bit 1: pressure does not move when it should (see EC18 and patch F760).
; Bits 6 and 5 give code 2222, bits 4 and 1 give code 2221 (code assembly, F001).
; Atmospheric pressure is $8004, taken when the ignition is switched on.
; In $8093 here: bit 7 means F60 has just closed; bit 6 means waiting for the pressure
; to drop after the throttle closes; bit 5 means the pressure has dropped.
;------------------------------------------------------------------------------
loc_EB2A:
  EB2A  F6 80 91   LDAB  $8091          ; G71 flags
  EB2D  C4 FE      ANDB  #$FE           ; clear bit 0 first
  EB2F  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  EB32  85 20      BITA  #$20           ; bit 5 is F60
  EB34  27 02      BEQ   loc_EB38       ; open? yes: bit 0 = 0
  EB36  CA 01      ORAB  #$01           ; bit 0 = 1: F60 closed

loc_EB38:
  EB38  17         TBA                  ; new state
  EB39  B8 80 91   EORA  $8091          ; compare with the old one
  EB3C  85 01      BITA  #$01           ; has F60 toggled?
  EB3E  27 0D      BEQ   loc_EB4D       ; no: clear the "just closed" flag
  EB40  C4 7F      ANDB  #$7F           ; toggled: restart the suspicion countdown
  EB42  C5 01      BITB  #$01           ; is F60 closed now?
  EB44  27 07      BEQ   loc_EB4D       ; no: clear the flag
  EB46  86 80      LDAA  #$80           ; $8093.7: F60 has just closed
  EB48  BA 80 93   ORAA  $8093          ; set
  EB4B  20 05      BRA   loc_EB52       ; write

loc_EB4D:
  EB4D  86 7F      LDAA  #$7F           ; clear $8093.7
  EB4F  B4 80 93   ANDA  $8093          ; clear

loc_EB52:
  EB52  B7 80 93   STAA  $8093          ; write $8093
  EB55  B6 80 19   LDAA  $8019          ; pressure
  EB58  C5 01      BITB  #$01           ; F60 closed?
  EB5A  27 1D      BEQ   loc_EB79       ; no: "stuck low" check
  EB5C  B1 C7 AD   CMPA  $C7AD          ; pressure above C7AD = 243?
  EB5F  23 14      BLS   loc_EB75       ; no: no suspicion
  EB61  C5 80      BITB  #$80           ; countdown running?
  EB63  27 33      BEQ   loc_EB98       ; no: start it
  EB65  B6 80 9C   LDAA  $809C          ; suspicion counter
  EB68  4C         INCA                 ; + 1
  EB69  B7 80 9C   STAA  $809C          ; save
  EB6C  B0 C7 A3   SUBA  $C7A3          ; reached C7A3 = 10 (1 s)?
  EB6F  25 2D      BCS   loc_EB9E       ; no: wait
  EB71  CA 40      ORAB  #$40           ; bit 6: G71 "stuck high" (2222)
  EB73  20 26      BRA   loc_EB9B       ; counter = 0

loc_EB75:
  EB75  C4 BF      ANDB  #$BF           ; pressure normal: clear bit 6
  EB77  20 1B      BRA   loc_EB94       ; clear countdown

loc_EB79:
  EB79  B1 C7 9F   CMPA  $C79F          ; pressure below C79F = 13?
  EB7C  24 14      BCC   loc_EB92       ; no: no suspicion
  EB7E  C5 80      BITB  #$80           ; countdown running?
  EB80  27 16      BEQ   loc_EB98       ; no: start it
  EB82  B6 80 9C   LDAA  $809C          ; suspicion counter
  EB85  4C         INCA                 ; + 1
  EB86  B7 80 9C   STAA  $809C          ; save
  EB89  B0 C7 A3   SUBA  $C7A3          ; reached 10 (1 s)?
  EB8C  25 10      BCS   loc_EB9E       ; no: wait
  EB8E  CA 20      ORAB  #$20           ; bit 5: G71 "stuck low" (2222)
  EB90  20 09      BRA   loc_EB9B       ; counter = 0

loc_EB92:
  EB92  C4 DF      ANDB  #$DF           ; pressure normal: clear bit 5

loc_EB94:
  EB94  C4 7F      ANDB  #$7F           ; clear countdown
  EB96  20 02      BRA   loc_EB9A       ; counter = 0

loc_EB98:
  EB98  CA 80      ORAB  #$80           ; bit 7: start countdown

loc_EB9A:
  EB9A  4F         CLRA                 ; counter = 0

loc_EB9B:
  EB9B  B7 80 9C   STAA  $809C          ; save counter

loc_EB9E:
  EB9E  C5 E0      BITB  #$E0           ; any suspicion or "stuck" fault (bits 7, 6, 5)?
  EBA0  27 03      BEQ   loc_EBA5       ; no: continue
  EBA2  7E EC 53   JMP   loc_EC53       ; yes: skip the remaining G71 checks

loc_EBA5:
  EBA5  B6 80 29   LDAA  $8029          ; operating mode flags
  EBA8  2B 2D      BMI   loc_EBD7       ; cranking in progress? yes: skip
  EBAA  C5 08      BITB  #$08           ; check of the first 10 s finished?
  EBAC  26 2C      BNE   loc_EBDA       ; yes: checks while driving
  EBAE  7C 80 9E   INC   $809E          ; time counter
  EBB1  B6 80 9E   LDAA  $809E          ; value
  EBB4  B1 C7 A4   CMPA  $C7A4          ; C7A4 = 100 calls (10 s) elapsed?
  EBB7  24 13      BCC   loc_EBCC       ; yes: pressure never moved
  EBB9  B6 80 19   LDAA  $8019          ; pressure
  EBBC  B0 80 04   SUBA  $8004          ; minus atmospheric
  EBBF  24 01      BCC   loc_EBC2       ; difference positive? yes: continue
  EBC1  40         NEGA                 ; absolute value

loc_EBC2:
  EBC2  B1 C7 A0   CMPA  $C7A0          ; less than C7A0 = 13?
  EBC5  24 03      BCC   loc_EBCA       ; no: pressure has moved
  EBC7  7E EC 5F   JMP   loc_EC5F       ; yes: keep waiting

loc_EBCA:
  EBCA  CA 04      ORAB  #$04           ; bit 2: sensor is alive

loc_EBCC:
  EBCC  7F 80 9E   CLR   $809E          ; counter = 0
  EBCF  CA 08      ORAB  #$08           ; bit 3: 10 s check finished
  EBD1  C5 04      BITB  #$04           ; has the pressure moved?
  EBD3  26 02      BNE   loc_EBD7       ; yes: no fault
  EBD5  CA 10      ORAB  #$10           ; bit 4: pressure did not move within 10 s (2221)

loc_EBD7:
  EBD7  7E EC 5F   JMP   loc_EC5F       ; continue

loc_EBDA:
  EBDA  B6 80 19   LDAA  $8019          ; pressure
  EBDD  B0 80 04   SUBA  $8004          ; minus atmospheric
  EBE0  24 01      BCC   loc_EBE3       ; difference positive? yes: continue
  EBE2  40         NEGA                 ; absolute value

loc_EBE3:
  EBE3  B1 C7 A0   CMPA  $C7A0          ; less than 13?
  EBE6  25 02      BCS   loc_EBEA       ; yes: leave bit 4 alone
  EBE8  C4 EF      ANDB  #$EF           ; pressure has moved: clear bit 4

loc_EBEA:
  EBEA  B6 80 18   LDAA  $8018          ; engine speed
  EBED  B1 C2 10   CMPA  $C210          ; below 40 units (≈890 rpm)?
  EBF0  25 61      BCS   loc_EC53       ; yes: reset the throttle closing check
  EBF2  C5 01      BITB  #$01           ; F60 closed?
  EBF4  27 10      BEQ   loc_EC06       ; no: continue
  EBF6  B6 80 19   LDAA  $8019          ; pressure
  EBF9  B0 80 04   SUBA  $8004          ; minus atmospheric
  EBFC  24 01      BCC   loc_EBFF       ; difference positive? yes: continue
  EBFE  40         NEGA                 ; absolute value

loc_EBFF:
  EBFF  B1 C7 A0   CMPA  $C7A0          ; less than 13?
  EC02  25 02      BCS   loc_EC06       ; yes: leave bit 1 alone
  EC04  C4 FD      ANDB  #$FD           ; |pressure − atmospheric| ≥ 13 with the throttle closed (sensor responds): clear bit 1

loc_EC06:
  EC06  B6 80 93   LDAA  $8093          ; flags $8093
  EC09  85 40      BITA  #$40           ; waiting for the pressure to drop?
  EC0B  26 0B      BNE   loc_EC18       ; yes: count
  EC0D  85 80      BITA  #$80           ; has F60 just closed?
  EC0F  27 4E      BEQ   loc_EC5F       ; no: continue
  EC11  8A 40      ORAA  #$40           ; start waiting for the pressure drop
  EC13  B7 80 93   STAA  $8093          ; write
  EC16  20 47      BRA   loc_EC5F       ; continue

loc_EC18:
  EC18  C5 01      BITB  #$01           ; F60 still closed?
  EC1A  27 37      BEQ   loc_EC53       ; no: reset the waiting
  EC1C  B6 80 9E   LDAA  $809E          ; waiting counter
  EC1F  B1 C7 A3   CMPA  $C7A3          ; already 10 (1 s)?
  EC22  24 3B      BCC   loc_EC5F       ; yes: already decided
  EC24  B6 80 9E   LDAA  $809E          ; counter
  EC27  4C         INCA                 ; + 1
  EC28  B7 80 9E   STAA  $809E          ; save
  EC2B  B1 C7 A3   CMPA  $C7A3          ; reached 10?
  EC2E  25 0B      BCS   loc_EC3B       ; no: look at the pressure
  EC30  86 20      LDAA  #$20           ; has the pressure dropped within 1 s?
  EC32  B5 80 93   BITA  $8093          ; check
  EC35  26 28      BNE   loc_EC5F       ; yes: everything is fine
  EC37  CA 02      ORAB  #$02           ; no: bit 1: pressure does not drop with the throttle closed (2221)
  EC39  20 24      BRA   loc_EC5F       ; continue

loc_EC3B:
  EC3B  B6 80 19   LDAA  $8019          ; pressure
  EC3E  B0 80 04   SUBA  $8004          ; minus atmospheric
  EC41  24 01      BCC   loc_EC44       ; difference positive? yes: continue
  EC43  40         NEGA                 ; absolute value

loc_EC44:
  EC44  B1 C7 A0   CMPA  $C7A0          ; less than 13?
  EC47  25 16      BCS   loc_EC5F       ; yes: wait
  EC49  86 20      LDAA  #$20           ; pressure has moved 13 or more away from atmospheric
  EC4B  BA 80 93   ORAA  $8093          ; set
  EC4E  B7 80 93   STAA  $8093          ; write
  EC51  20 0C      BRA   loc_EC5F       ; continue

loc_EC53:
  EC53  86 9F      LDAA  #$9F           ; clear waiting and "dropped"
  EC55  B4 80 93   ANDA  $8093          ; clear
  EC58  B7 80 93   STAA  $8093          ; write
  EC5B  4F         CLRA                 ; counter = 0
  EC5C  B7 80 9E   STAA  $809E          ; save

loc_EC5F:
  EC5F  7E F7 60   JMP   loc_F760       ; factory patch: more G71 checks

;------------------------------------------------------------------------------
; Checking the throttle switches against pressure G71. Flags in $8093:
;  bit 0: F60 closed (copy of the input on the previous call);
;  bit 3: F60 faulty: closed together with F81 at pressure > 141
;          for more than 15 calls (1.5 s). Cleared when F60 is open,
;          F81 is closed and pressure > 141 (code 2121 [assumed]);
;  bit 4: F60 suspicion countdown running (counter $809B);
;  bit 1: F81 faulty: F81 closed at pressure < 77
;          (deep vacuum) for more than 15 calls (counter $809D) (code 2123 [assumed]).
; While there is no sync or there is a G71 fault, no checks are done.
; Threshold C7A8 = 0, so two check branches do not work in this calibration.
;------------------------------------------------------------------------------
loc_EC62:
  EC62  86 20      LDAA  #$20           ; is there sync ($8095.5)?
  EC64  B5 80 95   BITA  $8095          ; check
  EC67  26 03      BNE   loc_EC6C       ; yes: run checks
  EC69  7E ED 20   JMP   loc_ED20       ; no: skip checks

loc_EC6C:
  EC6C  F6 80 93   LDAB  $8093          ; switch flags
  EC6F  86 72      LDAA  #$72           ; G71 faults
  EC71  B5 80 91   BITA  $8091          ; any?
  EC74  26 6D      BNE   loc_ECE3       ; yes: reset suspicion of F60
  EC76  C4 FE      ANDB  #$FE           ; clear bit 0 first
  EC78  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  EC7B  85 20      BITA  #$20           ; bit 5 is F60
  EC7D  27 02      BEQ   loc_EC81       ; open? yes: bit 0 = 0
  EC7F  CA 01      ORAB  #$01           ; bit 0 = 1: F60 closed

loc_EC81:
  EC81  17         TBA                  ; new state
  EC82  B8 80 93   EORA  $8093          ; compare with the old one
  EC85  85 01      BITA  #$01           ; has F60 toggled?
  EC87  27 05      BEQ   loc_EC8E       ; no: continue
  EC89  C4 EF      ANDB  #$EF           ; toggled: restart the suspicion countdown
  EC8B  7F 80 9B   CLR   $809B          ; counter = 0

loc_EC8E:
  EC8E  B6 80 19   LDAA  $8019          ; pressure
  EC91  C5 01      BITB  #$01           ; F60 closed?
  EC93  27 29      BEQ   loc_ECBE       ; no: branch "F60 open"
  EC95  B1 C7 A8   CMPA  $C7A8          ; pressure not below C7A8 = 0: always yes
  EC98  24 02      BCC   loc_EC9C       ; branch is always taken
  EC9A  C4 FB      ANDB  #$FB           ; dead instruction with C7A8 = 0

loc_EC9C:
  EC9C  36         PSHA                 ; save pressure
  EC9D  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  ECA0  85 10      BITA  #$10           ; bit 4 is F81
  ECA2  32         PULA                 ; restore pressure
  ECA3  27 40      BEQ   loc_ECE5       ; F81 open? yes: no suspicion
  ECA5  B1 C7 A1   CMPA  $C7A1          ; both closed; pressure above C7A1 = 141 (≈1.1 bar abs. [assumed])?
  ECA8  23 3B      BLS   loc_ECE5       ; no: no suspicion
  ECAA  C5 10      BITB  #$10           ; countdown already running?
  ECAC  27 3B      BEQ   loc_ECE9       ; no: start countdown
  ECAE  B6 80 9B   LDAA  $809B          ; suspicion counter
  ECB1  4C         INCA                 ; + 1
  ECB2  B7 80 9B   STAA  $809B          ; save
  ECB5  B0 C7 A2   SUBA  $C7A2          ; reached C7A2 = 15 (1.5 s)?
  ECB8  25 35      BCS   loc_ECEF       ; no: wait
  ECBA  CA 08      ORAB  #$08           ; bit 3: F60 faulty
  ECBC  20 2E      BRA   loc_ECEC       ; reset counter and write

loc_ECBE:
  ECBE  B1 C7 A8   CMPA  $C7A8          ; pressure not below C7A8 = 0: always yes
  ECC1  24 14      BCC   loc_ECD7       ; branch is always taken
  ECC3  C5 10      BITB  #$10           ; dead code with C7A8 = 0
  ECC5  27 22      BEQ   loc_ECE9       ; dead code
  ECC7  B6 80 9B   LDAA  $809B          ; dead code
  ECCA  4C         INCA                 ; dead code
  ECCB  B7 80 9B   STAA  $809B          ; dead code
  ECCE  B0 C7 A2   SUBA  $C7A2          ; dead code
  ECD1  25 1C      BCS   loc_ECEF       ; dead code
  ECD3  CA 04      ORAB  #$04           ; dead code: would have been bit 2
  ECD5  20 15      BRA   loc_ECEC       ; dead code

loc_ECD7:
  ECD7  B1 C7 A1   CMPA  $C7A1          ; F60 open; pressure below 141?
  ECDA  25 09      BCS   loc_ECE5       ; yes: no suspicion
  ECDC  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  ECDF  85 10      BITA  #$10           ; bit 4 is F81
  ECE1  27 02      BEQ   loc_ECE5       ; F81 open? yes: nothing proven

loc_ECE3:
  ECE3  C4 F7      ANDB  #$F7           ; F60 open at full throttle and boost (F60 is fine) or G71 fault: clear bit 3

loc_ECE5:
  ECE5  C4 EF      ANDB  #$EF           ; countdown not running
  ECE7  20 02      BRA   loc_ECEB       ; counter = 0

loc_ECE9:
  ECE9  CA 10      ORAB  #$10           ; bit 4: start countdown

loc_ECEB:
  ECEB  4F         CLRA                 ; counter = 0

loc_ECEC:
  ECEC  B7 80 9B   STAA  $809B          ; save counter

loc_ECEF:
  ECEF  F7 80 93   STAB  $8093          ; save flags
  ECF2  86 72      LDAA  #$72           ; G71 faults
  ECF4  B5 80 91   BITA  $8091          ; any?
  ECF7  26 1E      BNE   loc_ED17       ; yes: clear bit 1
  ECF9  B6 80 19   LDAA  $8019          ; pressure
  ECFC  B1 C7 A6   CMPA  $C7A6          ; not below C7A6 = 77 (≈0.6 bar abs. [assumed])?
  ECFF  24 18      BCC   loc_ED19       ; yes: no F81 check, counter = 0
  ED01  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  ED04  85 10      BITA  #$10           ; bit 4 is F81
  ED06  27 0F      BEQ   loc_ED17       ; open? yes: F81 is fine
  ED08  B6 80 9D   LDAA  $809D          ; F81 closed at deep vacuum: counter
  ED0B  4C         INCA                 ; + 1
  ED0C  B7 80 9D   STAA  $809D          ; save
  ED0F  80 0F      SUBA  #$0F           ; reached 15 (1.5 s)?
  ED11  25 0A      BCS   loc_ED1D       ; no: wait
  ED13  CA 02      ORAB  #$02           ; bit 1: F81 faulty
  ED15  20 03      BRA   loc_ED1A       ; reset counter

loc_ED17:
  ED17  C4 FD      ANDB  #$FD           ; clear bit 1

loc_ED19:
  ED19  4F         CLRA                 ; counter = 0

loc_ED1A:
  ED1A  B7 80 9D   STAA  $809D          ; save counter

loc_ED1D:
  ED1D  F7 80 93   STAB  $8093          ; save flags

;------------------------------------------------------------------------------
; Pressure flags in $8028 and overboost protection.
;  bit 0: pressure above 128 (≈1.0 bar abs. [assumed]), cleared below 125;
;  bit 4: pressure above the curve C2E0 over engine speed (hysteresis 3);
;  bit 6: overboost: pressure above the limit C220 for more than 10 consecutive
;          calls (1 s), or above the limit plus the G42 allowance for more than 5 calls
;          (0.5 s) (C793 = 10, C794 = 5). When warm the allowance is 0, and then
;          0.5 s is enough. Leads to code 2224 and fuel pump shut-off (EF45).
; Engine speed axis C210 (16 points): 40 53 67 80 93 107 120 133 147 160 173 187 200 213 220 240.
; Limit C220: 160 173 179 198 205 205 … 205 (≈1.25 … 1.6 bar abs. [assumed]).
; Curve C2E0: 127 131 140 156 164 168 169 168 166 166 154 141 134 128 128 128.
;------------------------------------------------------------------------------
loc_ED20:
  ED20  F6 80 19   LDAB  $8019          ; pressure G71
  ED23  BD D1 FE   JSR   MAP_BAD_LOAD   ; G71 faulty under load?
  ED26  24 03      BCC   loc_ED2B       ; no: use the measurement
  ED28  F6 C7 9E   LDAB  $C79E          ; yes: substitute value C79E = 192

loc_ED2B:
  ED2B  B6 C7 89   LDAA  $C789          ; threshold C789 = 128
  ED2E  11         CBA                  ; pressure above 128?
  ED2F  24 0A      BCC   loc_ED3B       ; no: do not set bit 0
  ED31  36         PSHA                 ; save threshold
  ED32  86 01      LDAA  #$01           ; bit 0
  ED34  BA 80 28   ORAA  $8028          ; set
  ED37  B7 80 28   STAA  $8028          ; write
  ED3A  32         PULA                 ; restore threshold

loc_ED3B:
  ED3B  80 03      SUBA  #$03           ; hysteresis 3: 125
  ED3D  11         CBA                  ; pressure above 125?
  ED3E  25 08      BCS   loc_ED48       ; yes: keep bit 0
  ED40  86 FE      LDAA  #$FE           ; no: clear bit 0
  ED42  B4 80 28   ANDA  $8028          ; clear
  ED45  B7 80 28   STAA  $8028          ; write

loc_ED48:
  ED48  CE C2 10   LDX   #$C210         ; engine speed axis C210
  ED4B  B6 80 18   LDAA  $8018          ; engine speed
  ED4E  C6 10      LDAB  #$10           ; 16 points
  ED50  BD CA 5F   JSR   AXIS_UP        ; find interval
  ED53  F7 80 14   STAB  $8014          ; $8014 = point index (for tables C220 and C2E0)
  ED56  BD CA 05   JSR   FRAC_UP        ; fraction
  ED59  F7 80 17   STAB  $8017          ; $8017 = fraction
  ED5C  CE C6 F0   LDX   #$C6F0         ; intake air temperature axis C6F0 = 175 165 156 146 (descending)
  ED5F  B6 80 20   LDAA  $8020          ; intake air temperature G42 (ADC ch. 7) [assumed]
  ED62  C6 04      LDAB  #$04           ; 4 points
  ED64  BD CA 6B   JSR   AXIS_DN        ; find interval
  ED67  37         PSHB                 ; push point index
  ED68  BD CA 10   JSR   FRAC_DN        ; fraction
  ED6B  17         TBA                  ; A = fraction
  ED6C  33         PULB                 ; B = point index
  ED6D  CE C6 F4   LDX   #$C6F4         ; table C6F4 = 26 26 26 0
  ED70  3A         ABX                  ; X -> value
  ED71  16         TAB                  ; B = fraction
  ED72  BD CA 41   JSR   INTERP         ; A = allowance added to the limit (26 when cold, 0 when warm)
  ED75  B7 80 16   STAA  $8016          ; $8016 = allowance
  ED78  CE C2 20   LDX   #$C220         ; overboost limit C220 over engine speed
  ED7B  8D 4A      BSR   TAB_RPM        ; A = limit
  ED7D  F6 80 81   LDAB  $8081          ; counter "above limit without correction"
  ED80  8D 69      BSR   OVER_CNT       ; pressure above the limit? counter + 1, otherwise 0
  ED82  F7 80 81   STAB  $8081          ; save
  ED85  BB 80 16   ADDA  $8016          ; limit + G42 allowance
  ED88  24 02      BCC   loc_ED8C       ; no overflow? yes: continue
  ED8A  86 FF      LDAA  #$FF           ; clamp to 255

loc_ED8C:
  ED8C  B7 80 16   STAA  $8016          ; $8016 = corrected limit
  ED8F  F6 80 82   LDAB  $8082          ; counter "above corrected limit"
  ED92  8D 57      BSR   OVER_CNT       ; pressure above? counter + 1, otherwise 0
  ED94  F7 80 82   STAB  $8082          ; save
  ED97  CE C2 E0   LDX   #$C2E0         ; curve C2E0 over engine speed
  ED9A  8D 2B      BSR   TAB_RPM        ; A = curve value
  ED9C  B7 80 14   STAA  $8014          ; $8014 = curve value
  ED9F  B6 80 28   LDAA  $8028          ; flags $8028
  EDA2  F6 80 81   LDAB  $8081          ; counter without correction
  EDA5  F1 C7 93   CMPB  $C793          ; reached C793 = 10?
  EDA8  24 0C      BCC   loc_EDB6       ; yes: overboost
  EDAA  F6 80 82   LDAB  $8082          ; counter with correction
  EDAD  F1 C7 94   CMPB  $C794          ; reached C794 = 5?
  EDB0  24 04      BCC   loc_EDB6       ; yes: overboost
  EDB2  84 BF      ANDA  #$BF           ; no: clear bit 6
  EDB4  20 02      BRA   loc_EDB8

loc_EDB6:
  EDB6  8A 40      ORAA  #$40           ; bit 6: overboost

loc_EDB8:
  EDB8  B7 80 28   STAA  $8028          ; write $8028
  EDBB  B6 80 19   LDAA  $8019          ; pressure
  EDBE  CE 80 14   LDX   #$8014         ; X -> curve value C2E0
  EDC1  C6 10      LDAB  #$10           ; bit 4
  EDC3  8D 0C      BSR   FLAG8028_HYST  ; bit 4 from comparison with the curve (hysteresis 3)
  EDC5  20 30      BRA   loc_EDF7       ; continue with the operating mode flags

;------------------------------------------------------------------------------
; TAB_RPM: value of table X over engine speed: point index in $8014,
; fraction in $8017 (both computed by ED48).
;------------------------------------------------------------------------------
TAB_RPM:                                ; called from: TASK3
  EDC7  F6 80 14   LDAB  $8014          ; point index
  EDCA  3A         ABX                  ; X -> value
  EDCB  F6 80 17   LDAB  $8017          ; fraction
  EDCE  7E CA 41   JMP   INTERP         ; interpolation

;------------------------------------------------------------------------------
; FLAG8028_HYST: in $8028 set the bits of mask B if A ≥ threshold [X],
; clear them if A < threshold - 3. In between change nothing.
;------------------------------------------------------------------------------
FLAG8028_HYST:                          ; called from: TASK3
  EDD1  37         PSHB                 ; push mask
  EDD2  E6 00      LDAB  $00,X          ; threshold
  EDD4  11         CBA                  ; A not below threshold?
  EDD5  24 0C      BCC   loc_EDE3       ; yes: set bits
  EDD7  C0 03      SUBB  #$03           ; threshold - 3
  EDD9  11         CBA                  ; A not below?
  EDDA  33         PULB                 ; mask
  EDDB  24 0D      BCC   loc_EDEA       ; yes: change nothing
  EDDD  53         COMB                 ; no: clear bits
  EDDE  F4 80 28   ANDB  $8028          ; clear
  EDE1  20 04      BRA   loc_EDE7       ; write

loc_EDE3:
  EDE3  33         PULB                 ; mask
  EDE4  FA 80 28   ORAB  $8028          ; set bits

loc_EDE7:
  EDE7  F7 80 28   STAB  $8028          ; write $8028

loc_EDEA:
  EDEA  39         RTS                  ; return

;------------------------------------------------------------------------------
; OVER_CNT: counter B: + 1 if pressure is above A (the limit), otherwise 0.
; Does not overflow (stays at 255).
;------------------------------------------------------------------------------
OVER_CNT:                               ; called from: TASK3
  EDEB  B1 80 19   CMPA  $8019          ; limit not below pressure?
  EDEE  24 05      BCC   loc_EDF5       ; yes: reset
  EDF0  5C         INCB                 ; + 1
  EDF1  26 03      BNE   loc_EDF6       ; no overflow? yes: return
  EDF3  5A         DECB                 ; stay at 255
  EDF4  39         RTS                  ; return

loc_EDF5:
  EDF5  5F         CLRB                 ; counter = 0

loc_EDF6:
  EDF6  39         RTS                  ; return

;------------------------------------------------------------------------------
; Delay after start: how many calls (100 ms each) engine speed must stay
; above 20 units before $8029.0 "delay after start elapsed" is set.
; Table over the lowest temperature since switch-on ($807B):
; axis C6E8 = 216 205 189 90, values C6EC = 10 10 1 0.
; At low atmospheric pressure ($8004 ≤ 122) there is no delay [?].
;------------------------------------------------------------------------------
loc_EDF7:
  EDF7  CE C6 E8   LDX   #$C6E8         ; temperature axis C6E8 (descending)
  EDFA  B6 80 7B   LDAA  $807B          ; coldest coolant temperature since switch-on
  EDFD  C6 04      LDAB  #$04           ; 4 points
  EDFF  BD CA 6B   JSR   AXIS_DN        ; find interval
  EE02  37         PSHB                 ; push point index
  EE03  BD CA 10   JSR   FRAC_DN        ; fraction
  EE06  17         TBA                  ; A = fraction
  EE07  33         PULB                 ; B = point index
  EE08  CE C6 EC   LDX   #$C6EC         ; delay table C6EC
  EE0B  3A         ABX                  ; X -> value
  EE0C  16         TAB                  ; B = fraction
  EE0D  BD CA 41   JSR   INTERP         ; A = delay (task 3 calls)
  EE10  F6 80 75   LDAB  $8075          ; start flags
  EE13  C5 40      BITB  #$40           ; $8075.6 [?]
  EE15  26 08      BNE   loc_EE1F       ; set: no delay
  EE17  F6 80 04   LDAB  $8004          ; atmospheric pressure at switch-on
  EE1A  F1 C2 B1   CMPB  $C2B1          ; above 122 (≈0.95 bar) [assumed]?
  EE1D  22 01      BHI   loc_EE20       ; yes: delay from the table

loc_EE1F:
  EE1F  4F         CLRA                 ; otherwise no delay

loc_EE20:
  EE20  B7 80 15   STAA  $8015          ; $8015 = delay
  EE23  F6 80 18   LDAB  $8018          ; engine speed
  EE26  F7 80 14   STAB  $8014          ; save in a temporary cell
  EE29  B6 80 29   LDAA  $8029          ; operating mode flags
  EE2C  2B 11      BMI   loc_EE3F       ; cranking in progress (bit 7)? yes: leave bit 6 alone
  EE2E  7B 04 17   TIM   #$04,PORT6     ; coding: PORT6.2 = 1 means manual gearbox (HS)
  EE31  27 05      BEQ   loc_EE38       ; AT? yes: AT threshold
  EE33  F1 C6 D5   CMPB  $C6D5          ; HS: threshold C6D5 = 30 units (≈670 rpm)
  EE36  20 03      BRA   loc_EE3B

loc_EE38:
  EE38  F1 C6 D2   CMPB  $C6D2          ; AT: threshold C6D2 = 30 units (both equal)

loc_EE3B:
  EE3B  25 02      BCS   loc_EE3F       ; engine speed below threshold? yes: do not set bit 6
  EE3D  8A 40      ORAA  #$40           ; bit 6: engine has started (speed ≥ 30 units)

loc_EE3F:
  EE3F  84 FD      ANDA  #$FD           ; clear bit 1 first
  EE41  F1 C6 BF   CMPB  $C6BF          ; engine speed below C6BF = 20 units (≈440 rpm)?
  EE44  25 18      BCS   loc_EE5E       ; yes: delay counter to zero
  EE46  85 01      BITA  #$01           ; bit 0 (delay elapsed) already set?
  EE48  26 09      BNE   loc_EE53       ; yes: do not set bit 1
  EE4A  F6 80 75   LDAB  $8075          ; start flags
  EE4D  C5 40      BITB  #$40           ; $8075.6 [?]
  EE4F  26 02      BNE   loc_EE53       ; set: do not set bit 1
  EE51  8A 02      ORAA  #$02           ; bit 1: engine is turning, delay still running

loc_EE53:
  EE53  F6 80 78   LDAB  $8078          ; delay counter
  EE56  F1 80 15   CMPB  $8015          ; reached $8015?
  EE59  24 09      BCC   loc_EE64       ; yes: delay elapsed
  EE5B  5C         INCB                 ; counter + 1
  EE5C  20 01      BRA   loc_EE5F

loc_EE5E:
  EE5E  5F         CLRB                 ; engine speed below 20 units: counter = 0

loc_EE5F:
  EE5F  F7 80 78   STAB  $8078          ; save counter
  EE62  20 02      BRA   loc_EE66

loc_EE64:
  EE64  8A 01      ORAA  #$01           ; bit 0: delay after start elapsed

loc_EE66:
  EE66  F6 80 14   LDAB  $8014          ; engine speed
  EE69  C1 10      CMPB  #$10           ; below 16 units (≈350 rpm)?
  EE6B  25 02      BCS   loc_EE6F       ; no: clear bit 3
  EE6D  84 F7      ANDA  #$F7           ; bit 3 = 0 (set only on reset)

loc_EE6F:
  EE6F  FE 80 8C   LDX   $808C          ; engine running time (task 1 calls, 20 ms each)
  EE72  8C 05 DC   CPX   #$05DC         ; less than 1500 (30 s)?
  EE75  25 02      BCS   loc_EE79       ; no: bit 2
  EE77  8A 04      ORAA  #$04           ; bit 2: engine has been running for more than 30 s

loc_EE79:
  EE79  F1 C6 BD   CMPB  $C6BD          ; engine speed below C6BD = 24 units (≈530 rpm)?
  EE7C  25 02      BCS   loc_EE80       ; no: clear bit 5
  EE7E  84 DF      ANDA  #$DF           ; bit 5 = 0

loc_EE80:
  EE80  7B 04 17   TIM   #$04,PORT6     ; AT/HS coding
  EE83  26 05      BNE   loc_EE8A       ; HS? yes: HS threshold
  EE85  F1 C6 D0   CMPB  $C6D0          ; AT: C6D0 = 16 units (≈350 rpm)
  EE88  20 03      BRA   loc_EE8D

loc_EE8A:
  EE8A  F1 C6 D3   CMPB  $C6D3          ; HS: C6D3 = 16 units (both equal)

loc_EE8D:
  EE8D  25 04      BCS   loc_EE93       ; engine speed below threshold?
  EE8F  84 7F      ANDA  #$7F           ; no: cranking finished, clear bit 7
  EE91  20 02      BRA   loc_EE95

loc_EE93:
  EE93  84 BF      ANDA  #$BF           ; yes: clear bit 6 (engine did not start or has stalled)

loc_EE95:
  EE95  84 EF      ANDA  #$EF           ; bit 4 is taken from the old value
  EE97  C6 10      LDAB  #$10           ; bit 4 mask
  EE99  0F         SEI                  ; disable interrupts: interrupts also change $8029
  EE9A  F4 80 29   ANDB  $8029          ; old bit 4
  EE9D  1B         ABA                  ; combine
  EE9E  B7 80 29   STAA  $8029          ; $8029 = new operating mode flags
  EEA1  0E         CLI                  ; enable interrupts
  EEA2  B6 80 28   LDAA  $8028          ; flags $8028
  EEA5  FE 80 26   LDX   $8026          ; tooth count per tick, 16 bit
  EEA8  BC C7 9C   CPX   $C79C          ; not below C79C = 268 units (≈5960 rpm at 22.2 or ≈6490 at 24.2 rpm per unit; scale not confirmed)?
  EEAB  25 02      BCS   loc_EEAF       ; no: do not set bit 7
  EEAD  8A 80      ORAA  #$80           ; bit 7: overspeed

loc_EEAF:
  EEAF  C6 04      LDAB  #$04           ; hysteresis 4 units
  EEB1  3A         ABX                  ; engine speed + 4
  EEB2  BC C7 9C   CPX   $C79C          ; still below the limit?
  EEB5  24 02      BCC   loc_EEB9       ; no: keep bit 7
  EEB7  84 7F      ANDA  #$7F           ; yes: no overspeed

loc_EEB9:
  EEB9  B7 80 28   STAA  $8028          ; save $8028
  EEBC  BD D2 15   JSR   RD_INPUTS      ; digital inputs
  EEBF  F6 80 28   LDAB  $8028          ; flags $8028
  EEC2  85 08      BITA  #$08           ; bit 3 is the brake light switch
  EEC4  27 11      BEQ   loc_EED7       ; pedal released? yes: reset
  EEC6  C5 08      BITB  #$08           ; "brake held" already set?
  EEC8  26 13      BNE   loc_EEDD       ; yes: continue
  EECA  B6 80 61   LDAA  $8061          ; brake press counter
  EECD  4C         INCA                 ; + 1 (one call = 100 ms)
  EECE  B1 C7 9A   CMPA  $C79A          ; less than C79A = 20 (2 s)?
  EED1  25 07      BCS   loc_EEDA       ; yes: save counter
  EED3  CA 08      ORAB  #$08           ; bit 3: brake held for more than 2 s
  EED5  20 03      BRA   loc_EEDA

loc_EED7:
  EED7  C4 F7      ANDB  #$F7           ; pedal released: clear bit 3
  EED9  4F         CLRA                 ; counter = 0

loc_EEDA:
  EEDA  B7 80 61   STAA  $8061          ; save counter

loc_EEDD:
  EEDD  B6 C7 99   LDAA  $C799          ; pressure threshold C799 = 154 (≈1.2 bar abs. [assumed])
  EEE0  B1 80 19   CMPA  $8019          ; pressure above threshold?
  EEE3  24 02      BCC   loc_EEE7       ; no: do not set bit 2
  EEE5  CA 04      ORAB  #$04           ; bit 2: pressure above 154

loc_EEE7:
  EEE7  80 09      SUBA  #$09           ; hysteresis 9
  EEE9  B1 80 19   CMPA  $8019          ; pressure below 145?
  EEEC  25 02      BCS   loc_EEF0       ; no: keep bit 2
  EEEE  C4 FB      ANDB  #$FB           ; yes: clear bit 2

loc_EEF0:
  EEF0  B6 C7 9B   LDAA  $C79B          ; engine speed threshold C79B = 120 units (≈2670 rpm)
  EEF3  B1 80 18   CMPA  $8018          ; engine speed above threshold?
  EEF6  24 02      BCC   loc_EEFA       ; no: do not set bit 1
  EEF8  CA 02      ORAB  #$02           ; bit 1: engine speed above 120 units

loc_EEFA:
  EEFA  80 04      SUBA  #$04           ; hysteresis 4
  EEFC  B1 80 18   CMPA  $8018          ; engine speed below 116 units?
  EEFF  25 02      BCS   loc_EF03       ; no: keep bit 1
  EF01  C4 FD      ANDB  #$FD           ; yes: clear bit 1

loc_EF03:
  EF03  F7 80 28   STAB  $8028          ; save $8028
  EF06  17         TBA                  ; copy of $8028 into A
  EF07  37         PSHB                 ; and onto the stack
  EF08  C6 80      LDAB  #$80           ; mask for the test mode check
  EF0A  7E F9 30   JMP   loc_F930       ; factory patch: the actuator test switches the pump on

; table $EF0D, 2 bytes: dead bytes of the old code (left under the patch)
  EF0D  db 27 03

loc_EF0F:
  EF0F  33         PULB                 ; pop copy of $8028
  EF10  20 49      BRA   loc_EF5B       ; switch the pump on

loc_EF12:
  EF12  C6 20      LDAB  #$20           ; is there sync from G4/Hall ($8095.5)?
  EF14  F5 80 95   BITB  $8095          ; check
  EF17  26 03      BNE   loc_EF1C       ; yes: continue

loc_EF19:
  EF19  33         PULB                 ; pop copy
  EF1A  20 44      BRA   loc_EF60       ; no sync: switch the pump off

loc_EF1C:
  EF1C  85 80      BITA  #$80           ; overspeed ($8028.7)?
  EF1E  27 0A      BEQ   loc_EF2A       ; no: continue
  EF20  C6 04      LDAB  #$04           ; fault bit 2214
  EF22  FA 80 9F   ORAB  $809F          ; into the fault memory
  EF25  F7 80 9F   STAB  $809F          ; write
  EF28  20 EF      BRA   loc_EF19       ; on overspeed the pump is switched off

loc_EF2A:
  EF2A  C6 FB      LDAB  #$FB           ; no overspeed: clear bit 2214
  EF2C  F4 80 9F   ANDB  $809F          ; clear
  EF2F  F7 80 9F   STAB  $809F          ; write
  EF32  C6 72      LDAB  #$72           ; pressure sensor faults
  EF34  F5 80 91   BITB  $8091          ; any?
  EF37  26 D6      BNE   loc_EF0F       ; yes: no pressure protection, switch the pump on
  EF39  33         PULB                 ; B = $8028
  EF3A  7B 04 17   TIM   #$04,PORT6     ; coding: PORT6.2 = 1 means manual gearbox (HS)
  EF3D  26 06      BNE   loc_EF45       ; HS? yes: skip the torque converter protection
  EF3F  88 0E      EORA  #$0E           ; AT: all three bits 1, 2, 3 are required at once (torque converter protection [assumed])
  EF41  85 0E      BITA  #$0E           ; brake > 2 s, pressure > 154 and engine speed > 120 units all together?
  EF43  27 1B      BEQ   loc_EF60       ; yes: switch the pump off (AT torque converter protection)

loc_EF45:
  EF45  C5 40      BITB  #$40           ; overboost ($8028.6)?
  EF47  27 0A      BEQ   loc_EF53       ; no: clear code 2224
  EF49  86 02      LDAA  #$02           ; fault bit 2224
  EF4B  BA 80 9F   ORAA  $809F          ; into the fault memory
  EF4E  B7 80 9F   STAA  $809F          ; write
  EF51  20 0D      BRA   loc_EF60       ; overboost: switch the pump off

loc_EF53:
  EF53  86 FD      LDAA  #$FD           ; no overboost: clear bit 2224
  EF55  B4 80 9F   ANDA  $809F          ; clear
  EF58  B7 80 9F   STAA  $809F          ; write

loc_EF5B:
  EF5B  72 40 17   OIM   #$40,PORT6     ; PORT6.6 = 1: fuel pump relay J17 on [assumed]
  EF5E  20 03      BRA   loc_EF63       ; continue

loc_EF60:
  EF60  71 BF 17   AIM   #$BF,PORT6     ; PORT6.6 = 0: J17 off, pump stopped [assumed]

;------------------------------------------------------------------------------
; Clearing the fault memory on request $8092.1. The request is set by: the tester via the K line
; (DC15), the blink code state machine after outputting the codes (F40D), and the counter of starts without
; changes in the fault memory (CD8D, after a set number of starts).
;------------------------------------------------------------------------------
loc_EF63:
  EF63  CE 80 00   LDX   #$8000         ; X = $8000
  EF66  6B 02 92   TIM   #$02,$92,X     ; clear request?
  EF69  27 3C      BEQ   loc_EFA7       ; no: continue
  EF6B  61 3F 95   AIM   #$3F,$95,X     ; clear ECU faults (1111)
  EF6E  61 AA 94   AIM   #$AA,$94,X     ; clear sync faults (even bits)
  EF71  61 0F B6   AIM   #$0F,$B6,X     ; clear knock sensor faults
  EF74  61 F3 51   AIM   #$F3,$51,X     ; clear knock control faults
  EF77  61 01 92   AIM   #$01,$92,X     ; clear all temperature faults and the request itself
  EF7A  61 8F 7A   AIM   #$8F,$7A,X     ; clear knock flags $807A [?]
  EF7D  61 E1 93   AIM   #$E1,$93,X     ; clear switch faults
  EF80  61 FD 60   AIM   #$FD,$60,X     ; clear the lambda control fault (2342)
  EF83  61 0D 91   AIM   #$0D,$91,X     ; clear G71 faults
  EF86  6F 9A      CLR   $9A,X          ; check counters
  EF88  6F A2      CLR   $A2,X          ; zero them
  EF8A  4F         CLRA                 ; D = 0
  EF8B  5F         CLRB                 ; B = 0
  EF8C  ED 98      STD   $98,X          ; $8098/$8099 = 0
  EF8E  6F 7C      CLR   $7C,X          ; $807C = 0
  EF90  ED ED      STD   $ED,X          ; $80ED/$80EE = 0
  EF92  ED 9B      STD   $9B,X          ; switch check counters
  EF94  ED 9D      STD   $9D,X          ; and G71
  EF96  6F AE      CLR   $AE,X          ; L line counter
  EF98  6B 20 95   TIM   #$20,$95,X     ; is there sync?
  EF9B  26 02      BNE   loc_EF9F       ; yes: leave the cylinder counter alone
  EF9D  6F 96      CLR   $96,X          ; no: cylinder counter to zero

loc_EF9F:
  EF9F  6F 00      CLR   $00,X          ; code byte 1
  EFA1  6F 01      CLR   $01,X          ; code byte 2
  EFA3  6F 02      CLR   $02,X          ; code byte 3
  EFA5  6F 2B      CLR   $2B,X          ; counter of starts without changes

;------------------------------------------------------------------------------
; Once per trip, when engine speed first reaches 32 units
; (≈710-770 rpm): the engine is definitely running, so the sync faults
; (2111, 2112, 2113) set during cranking are cleared.
;------------------------------------------------------------------------------
loc_EFA7:
  EFA7  6B 08 9F   TIM   #$08,$9F,X     ; already done?
  EFAA  26 2D      BNE   loc_EFD9       ; yes: continue
  EFAC  A6 18      LDAA  $18,X          ; engine speed
  EFAE  81 20      CMPA  #$20           ; below 32 units?
  EFB0  25 27      BCS   loc_EFD9       ; yes: wait
  EFB2  62 08 9F   OIM   #$08,$9F,X     ; remember: done
  EFB5  6B 08 03   TIM   #$08,$03,X     ; fault memory restored from internal RAM ($8003.3)?
  EFB8  26 05      BNE   loc_EFBF       ; yes: clear in the copy as well
  EFBA  61 87 00   AIM   #$87,$00,X     ; clear 2111-2113 in code byte 1
  EFBD  20 17      BRA   loc_EFD6       ; continue

loc_EFBF:
  EFBF  0F         SEI                  ; disable interrupts
  EFC0  72 40 14   OIM   #$40,RP5CR     ; enable internal RAM
  EFC3  71 87 41   AIM   #$87,$41       ; clear 2111-2113 in the copy
  EFC6  96 41      LDAA  $41            ; recalculate the checksum of the copy:
  EFC8  9B 42      ADDA  $42            ; $41
  EFCA  9B 43      ADDA  $43            ; + $42
  EFCC  9B 44      ADDA  $44            ; + $43
  EFCE  9B 45      ADDA  $45            ; + $44
  EFD0  97 40      STAA  $40            ; $40 = sum
  EFD2  71 BF 14   AIM   #$BF,RP5CR     ; disable internal RAM
  EFD5  0E         CLI                  ; enable interrupts

loc_EFD6:
  EFD6  61 AA 94   AIM   #$AA,$94,X     ; clear the even sync bits

;------------------------------------------------------------------------------
; Assembling the fault memory. Each byte $8000-$8002 holds 8 codes, bit 7 first.
; The order matches the blink code table $C928. Bits are only added
; (the memory is "sticky"); only clearing removes them. If a byte has changed,
; the counter of starts without changes $802B is reset to zero.
; $8000: 7 is 1111 ECU ($8095 & $C0); 6 is 2111 G28 ($8094.6); 5 is 2112 G4 ($8094.4);
;       4 is 2113 Hall ($8094.2); 3 is 2113 ($8094.0); 2 is 2222 G71 high ($8091.6);
;       1 is 2222 G71 low ($8091.5); 0 is 2221 G71 not moving ($8091 & $12).
; $8001: 7 is 2142 G61 ($80B6.6); 6 is 2144 G66 ($80B6.4); 5 is 2141 ($8051.3);
;       4 is 2143 ($8051.2); 3 is 2123 F81 ($8093.1); 2 is 2121 F60 ($8093.3);
;       1 is 2121 ($8093.2, never set in this calibration); 0 is 2322 G42 ($8092.5).
; $8002: 7 is 2322 G42 ($8092.4); 6 is 2312 G62 ($8092.3); 5 is 2312 ($8092.2);
;       4 is 2342 lambda ($8060.1); 3 is 2214 engine speed ($809F.2);
;       2 is 2224 overboost ($809F.1); 1 is 4444 "no faults"; 0 is end of list.
;------------------------------------------------------------------------------
loc_EFD9:
  EFD9  B6 80 00   LDAA  $8000          ; byte 1, old value
  EFDC  36         PSHA                 ; push for comparison
  EFDD  C6 C0      LDAB  #$C0           ; ECU faults
  EFDF  F5 80 95   BITB  $8095          ; any?
  EFE2  27 02      BEQ   loc_EFE6       ; no
  EFE4  8A 80      ORAA  #$80           ; 1111

loc_EFE6:
  EFE6  F6 80 94   LDAB  $8094          ; sync faults
  EFE9  C5 40      BITB  #$40           ; G28?
  EFEB  27 02      BEQ   loc_EFEF       ; no
  EFED  8A 40      ORAA  #$40           ; 2111

loc_EFEF:
  EFEF  C5 10      BITB  #$10           ; G4?
  EFF1  27 02      BEQ   loc_EFF5       ; no
  EFF3  8A 20      ORAA  #$20           ; 2112

loc_EFF5:
  EFF5  C5 04      BITB  #$04           ; Hall?
  EFF7  27 02      BEQ   loc_EFFB       ; no
  EFF9  8A 10      ORAA  #$10           ; 2113

loc_EFFB:
  EFFB  C5 01      BITB  #$01           ; Hall, second flag?
  EFFD  27 02      BEQ   loc_F001       ; no
  EFFF  8A 08      ORAA  #$08           ; 2113

loc_F001:
  F001  F6 80 91   LDAB  $8091          ; G71 faults
  F004  C5 40      BITB  #$40           ; "high"?
  F006  27 02      BEQ   loc_F00A       ; no
  F008  8A 04      ORAA  #$04           ; 2222

loc_F00A:
  F00A  C5 20      BITB  #$20           ; "low"?
  F00C  27 02      BEQ   loc_F010       ; no
  F00E  8A 02      ORAA  #$02           ; 2222

loc_F010:
  F010  C5 12      BITB  #$12           ; "not moving"?
  F012  27 02      BEQ   loc_F016       ; no
  F014  8A 01      ORAA  #$01           ; 2221

loc_F016:
  F016  B7 80 00   STAA  $8000          ; write byte 1
  F019  32         PULA                 ; old value
  F01A  B1 80 00   CMPA  $8000          ; changed?
  F01D  27 03      BEQ   loc_F022       ; no
  F01F  7F 80 2B   CLR   $802B          ; yes: counter of starts without changes = 0

loc_F022:
  F022  B6 80 01   LDAA  $8001          ; byte 2, old value
  F025  36         PSHA                 ; push
  F026  F6 80 B6   LDAB  $80B6          ; knock sensor faults
  F029  C5 40      BITB  #$40           ; G61?
  F02B  27 02      BEQ   loc_F02F       ; no
  F02D  8A 80      ORAA  #$80           ; 2142

loc_F02F:
  F02F  C5 10      BITB  #$10           ; G66?
  F031  27 02      BEQ   loc_F035       ; no
  F033  8A 40      ORAA  #$40           ; 2144

loc_F035:
  F035  F6 80 51   LDAB  $8051          ; knock control faults
  F038  C5 08      BITB  #$08           ; first flag?
  F03A  27 02      BEQ   loc_F03E       ; no
  F03C  8A 20      ORAA  #$20           ; 2141

loc_F03E:
  F03E  C5 04      BITB  #$04           ; second?
  F040  27 02      BEQ   loc_F044       ; no
  F042  8A 10      ORAA  #$10           ; 2143

loc_F044:
  F044  F6 80 93   LDAB  $8093          ; switch faults
  F047  C5 02      BITB  #$02           ; F81?
  F049  27 02      BEQ   loc_F04D       ; no
  F04B  8A 08      ORAA  #$08           ; 2123

loc_F04D:
  F04D  C5 08      BITB  #$08           ; F60?
  F04F  27 02      BEQ   loc_F053       ; no
  F051  8A 04      ORAA  #$04           ; 2121

loc_F053:
  F053  C5 04      BITB  #$04           ; F60, second flag?
  F055  27 02      BEQ   loc_F059       ; no
  F057  8A 02      ORAA  #$02           ; 2121

loc_F059:
  F059  F6 80 92   LDAB  $8092          ; temperature faults
  F05C  C5 20      BITB  #$20           ; G42, first flag?
  F05E  27 02      BEQ   loc_F062       ; no
  F060  8A 01      ORAA  #$01           ; 2322

loc_F062:
  F062  B7 80 01   STAA  $8001          ; write byte 2
  F065  32         PULA                 ; old value
  F066  B1 80 01   CMPA  $8001          ; changed?
  F069  27 03      BEQ   loc_F06E       ; no
  F06B  7F 80 2B   CLR   $802B          ; yes: counter = 0

loc_F06E:
  F06E  B6 80 02   LDAA  $8002          ; byte 3, old value
  F071  36         PSHA                 ; push
  F072  C5 10      BITB  #$10           ; G42, second flag?
  F074  27 02      BEQ   loc_F078       ; no
  F076  8A 80      ORAA  #$80           ; 2322

loc_F078:
  F078  C5 08      BITB  #$08           ; G62, first?
  F07A  27 02      BEQ   loc_F07E       ; no
  F07C  8A 40      ORAA  #$40           ; 2312

loc_F07E:
  F07E  C5 04      BITB  #$04           ; G62, second?
  F080  27 02      BEQ   loc_F084       ; no
  F082  8A 20      ORAA  #$20           ; 2312

loc_F084:
  F084  F6 80 60   LDAB  $8060          ; lambda flags
  F087  C5 02      BITB  #$02           ; lambda control fault?
  F089  27 02      BEQ   loc_F08D       ; no
  F08B  8A 10      ORAA  #$10           ; 2342

loc_F08D:
  F08D  F6 80 9F   LDAB  $809F          ; flags $809F
  F090  C5 04      BITB  #$04           ; overspeed?
  F092  27 02      BEQ   loc_F096       ; no
  F094  8A 08      ORAA  #$08           ; 2214

loc_F096:
  F096  C5 02      BITB  #$02           ; overboost?
  F098  27 02      BEQ   loc_F09C       ; no
  F09A  8A 04      ORAA  #$04           ; 2224

loc_F09C:
  F09C  8A 01      ORAA  #$01           ; bit 0 is the end of list, always 1
  F09E  B7 80 02   STAA  $8002          ; write byte 3
  F0A1  84 FC      ANDA  #$FC           ; without the service bits 1 and 0
  F0A3  33         PULB                 ; old value
  F0A4  C4 FC      ANDB  #$FC           ; without the service bits
  F0A6  11         CBA                  ; changed?
  F0A7  27 03      BEQ   loc_F0AC       ; no
  F0A9  7F 80 2B   CLR   $802B          ; yes: counter = 0

loc_F0AC:
  F0AC  BA 80 00   ORAA  $8000          ; is there at least one fault in the three bytes?
  F0AF  BA 80 01   ORAA  $8001          ; + byte 2
  F0B2  26 07      BNE   loc_F0BB       ; yes: without 4444
  F0B4  86 03      LDAA  #$03           ; no faults: 4444 and end of list
  F0B6  B7 80 02   STAA  $8002          ; write
  F0B9  20 08      BRA   loc_F0C3       ; continue

loc_F0BB:
  F0BB  86 FD      LDAA  #$FD           ; there are faults: clear 4444
  F0BD  B4 80 02   ANDA  $8002          ; clear
  F0C0  B7 80 02   STAA  $8002          ; write

;------------------------------------------------------------------------------
; Long-lasting faults in $806E: bit 7 is $8092.7 [?], bit 6 is G71 "stuck" ($8091 & $60),
; bit 5 is G71 "not moving" ($8091 & $12). A bit is set if the fault persists
; for 40 calls in a row (4 s) and is cleared immediately. Counters $806F-$8071.
;------------------------------------------------------------------------------
loc_F0C3:
  F0C3  C6 80      LDAB  #$80           ; first mask bit
  F0C5  CE 80 6F   LDX   #$806F         ; first counter
  F0C8  86 80      LDAA  #$80           ; $8092.7 [?]
  F0CA  B5 80 92   BITA  $8092          ; present?
  F0CD  27 04      BEQ   loc_F0D3       ; no: clear
  F0CF  8D 1C      BSR   LONGERR_CNT    ; persists: count
  F0D1  20 02      BRA   loc_F0D5       ; continue

loc_F0D3:
  F0D3  8D 26      BSR   LONGERR_CLR    ; clear

loc_F0D5:
  F0D5  86 60      LDAA  #$60           ; G71 "stuck"?
  F0D7  B5 80 91   BITA  $8091          ; check
  F0DA  27 04      BEQ   loc_F0E0       ; no: clear
  F0DC  8D 0F      BSR   LONGERR_CNT    ; persists: count
  F0DE  20 02      BRA   loc_F0E2       ; continue

loc_F0E0:
  F0E0  8D 19      BSR   LONGERR_CLR    ; clear

loc_F0E2:
  F0E2  86 12      LDAA  #$12           ; G71 "not moving"?
  F0E4  B5 80 91   BITA  $8091          ; check
  F0E7  27 1F      BEQ   loc_F108       ; no: clear
  F0E9  8D 02      BSR   LONGERR_CNT    ; persists: count
  F0EB  20 1D      BRA   loc_F10A       ; continue

;------------------------------------------------------------------------------
; LONGERR_CNT: counter [X] + 1; when it reaches 40, set bit B in $806E.
; Then X moves to the next counter, B to the next bit.
;------------------------------------------------------------------------------
LONGERR_CNT:                            ; called from: TASK3
  F0ED  86 28      LDAA  #$28           ; threshold 40
  F0EF  6C 00      INC   $00,X          ; counter + 1
  F0F1  A0 00      SUBA  $00,X          ; 40 - counter
  F0F3  22 10      BHI   loc_F105       ; not reached yet? yes: do not set the bit
  F0F5  17         TBA                  ; bit
  F0F6  BA 80 6E   ORAA  $806E          ; set
  F0F9  20 07      BRA   loc_F102       ; write

;------------------------------------------------------------------------------
; LONGERR_CLR: counter [X] = 0, clear bit B in $806E.
;------------------------------------------------------------------------------
LONGERR_CLR:                            ; called from: TASK3
  F0FB  6F 00      CLR   $00,X          ; counter = 0
  F0FD  17         TBA                  ; bit
  F0FE  43         COMA                 ; invert
  F0FF  B4 80 6E   ANDA  $806E          ; clear

loc_F102:
  F102  B7 80 6E   STAA  $806E          ; write $806E

loc_F105:
  F105  08         INX                  ; next counter
  F106  54         LSRB                 ; next bit
  F107  39         RTS                  ; return

loc_F108:
  F108  8D F1      BSR   LONGERR_CLR    ; no G71 "not moving": clear

;------------------------------------------------------------------------------
; Rate of pressure change over 100 ms. $806D = pressure on the previous call.
; $8066.7 = 1 means the pressure is rising. $806B = value from table C740 (rising)
; or C748 (falling) over the absolute change. Both tables have axis 3 2 1 0,
; values 3 2 1 0: in effect $806B = 3 for a change of less than 3, otherwise 0 [assumed].
;------------------------------------------------------------------------------
loc_F10A:
  F10A  CE C7 40   LDX   #$C740         ; table for rising
  F10D  B6 80 19   LDAA  $8019          ; pressure now
  F110  F6 80 6D   LDAB  $806D          ; pressure on the previous call
  F113  B7 80 6D   STAA  $806D          ; remember the current one
  F116  10         SBA                  ; change = now - before
  F117  24 0C      BCC   loc_F125       ; rising? yes
  F119  40         NEGA                 ; falling: absolute value
  F11A  CE C7 48   LDX   #$C748         ; table for falling
  F11D  C6 7F      LDAB  #$7F           ; clear the rising flag
  F11F  0F         SEI                  ; disable interrupts
  F120  F4 80 66   ANDB  $8066          ; clear
  F123  20 06      BRA   loc_F12B       ; continue

loc_F125:
  F125  C6 80      LDAB  #$80           ; rising flag
  F127  0F         SEI                  ; disable interrupts
  F128  FA 80 66   ORAB  $8066          ; set

loc_F12B:
  F12B  F7 80 66   STAB  $8066          ; write $8066
  F12E  0E         CLI                  ; enable interrupts
  F12F  C6 04      LDAB  #$04           ; 4 points
  F131  3C         PSHX                 ; table address
  F132  BD CA 5F   JSR   AXIS_UP        ; find interval
  F135  37         PSHB                 ; index
  F136  BD CA 05   JSR   FRAC_UP        ; fraction
  F139  17         TBA                  ; A = fraction
  F13A  33         PULB                 ; B = index
  F13B  38         PULX                 ; table address
  F13C  CB 04      ADDB  #$04           ; values follow the axis (+4)
  F13E  3A         ABX                  ; X -> value
  F13F  16         TAB                  ; B = fraction
  F140  BD CA 41   JSR   INTERP         ; interpolation
  F143  B7 80 6B   STAA  $806B          ; $806B = result

;------------------------------------------------------------------------------
; L line (pin 5, PORT5.6). Pin connected to ground means PORT5.6 = 0 [assumed].
; Holding it closed for 25 calls (2.5 s) starts the output ($80A9.7 = 1).
; While the engine has never turned ($8003.4 = 0) this is the actuator test
; (F24D), otherwise the fault codes are output. In the test, opening the contact sets a request,
; and the step changes on the next closing of ≥ 2.5 s: the step bit in $80AF shifts right
; ($80 J17, $40 N7, $20 N75, $10 N17, $08 N80, $04 N115).
; The same start can come from the tester via the K line ($80F7.3).
;------------------------------------------------------------------------------
  F146  CE 80 00   LDX   #$8000         ; X = $8000
  F149  D6 15      LDAB  PORT5          ; port 5
  F14B  F7 80 14   STAB  $8014          ; port 5 snapshot
  F14E  B6 80 A9   LDAA  $80A9          ; output flags
  F151  6B 08 F7   TIM   #$08,$F7,X     ; start from the tester via the K line ($80F7.3)?
  F154  27 05      BEQ   loc_F15B       ; no: look at pin 5
  F156  61 F7 F7   AIM   #$F7,$F7,X     ; clear the tester request
  F159  20 1B      BRA   loc_F176       ; start the output

loc_F15B:
  F15B  F6 80 03   LDAB  $8003          ; flags $8003
  F15E  C5 10      BITB  #$10           ; has the engine already turned or is the test finished ($8003.4)?
  F160  26 52      BNE   loc_F1B4       ; yes: stop the output
  F162  F6 80 14   LDAB  $8014          ; port 5 snapshot
  F165  C5 40      BITB  #$40           ; pin 5 open (PORT5.6 = 1)?
  F167  26 1A      BNE   loc_F183       ; yes
  F169  F6 80 AE   LDAB  $80AE          ; closing time
  F16C  C1 19      CMPB  #$19           ; already 25 calls (2.5 s)?
  F16E  24 06      BCC   loc_F176       ; yes: start
  F170  5C         INCB                 ; + 1
  F171  F7 80 AE   STAB  $80AE          ; save
  F174  20 43      BRA   loc_F1B9       ; continue

loc_F176:
  F176  85 80      BITA  #$80           ; output already running?
  F178  26 1A      BNE   loc_F194       ; yes: look at the step request
  F17A  8A 80      ORAA  #$80           ; start the output ($80A9.7)
  F17C  C6 80      LDAB  #$80           ; first test step is J17
  F17E  F7 80 AF   STAB  $80AF          ; $80AF = $80
  F181  20 2C      BRA   loc_F1AF       ; write flags

loc_F183:
  F183  5F         CLRB                 ; contact open: closing time = 0
  F184  F7 80 AE   STAB  $80AE          ; save
  F187  85 80      BITA  #$80           ; output running?
  F189  27 04      BEQ   loc_F18F       ; no: exit the test
  F18B  8A 40      ORAA  #$40           ; running: request the next step ($80A9.6)
  F18D  20 20      BRA   loc_F1AF       ; write flags

loc_F18F:
  F18F  BD F7 26   JSR   TEST_EXIT      ; exit the actuator test
  F192  20 25      BRA   loc_F1B9       ; continue

loc_F194:
  F194  85 40      BITA  #$40           ; next step request present?
  F196  27 21      BEQ   loc_F1B9       ; no: continue
  F198  84 BF      ANDA  #$BF           ; clear the request
  F19A  F6 80 AF   LDAB  $80AF          ; current step
  F19D  54         LSRB                 ; next step (bit to the right)
  F19E  C1 04      CMPB  #$04           ; is this still an actuator step (bit $04 or higher)?
  F1A0  24 0A      BCC   loc_F1AC       ; yes: save the step
  F1A2  CE 80 00   LDX   #$8000         ; X = $8000
  F1A5  62 10 F7   OIM   #$10,$F7,X     ; actuators done ($80F7.4)
  F1A8  C5 02      BITB  #$02           ; step $02 (end of list, display 0000)?
  F1AA  27 E3      BEQ   loc_F18F       ; no: test finished

loc_F1AC:
  F1AC  F7 80 AF   STAB  $80AF          ; $80AF = new step

loc_F1AF:
  F1AF  B7 80 A9   STAA  $80A9          ; write output flags
  F1B2  20 05      BRA   loc_F1B9       ; continue

loc_F1B4:
  F1B4  84 7F      ANDA  #$7F           ; stop the output ($80A9.7 = 0)
  F1B6  B7 80 A9   STAA  $80A9          ; write

loc_F1B9:
  F1B9  C6 20      LDAB  #$20           ; is there sync (engine running)?
  F1BB  F5 80 95   BITB  $8095          ; check
  F1BE  26 66      BNE   loc_F226       ; yes: leave the test outputs alone
  F1C0  F6 80 A9   LDAB  $80A9          ; output flags
  F1C3  C5 80      BITB  #$80           ; output running?
  F1C5  26 05      BNE   loc_F1CC       ; yes: test outputs
  F1C7  71 BF 03   AIM   #$BF,PORT2     ; no: N75 (PORT2.6) = 0
  F1CA  20 4D      BRA   loc_F219       ; and N80/N115 at rest

loc_F1CC:
  F1CC  B6 80 AD   LDAA  $80AD          ; test cycle divider (5 calls)
  F1CF  27 08      BEQ   loc_F1D9       ; zero: new cycle
  F1D1  4A         DECA                 ; - 1
  F1D2  27 05      BEQ   loc_F1D9       ; reached zero: new cycle
  F1D4  B7 80 AD   STAA  $80AD          ; save
  F1D7  20 4D      BRA   loc_F226       ; wait

loc_F1D9:
  F1D9  86 05      LDAA  #$05           ; test cycle = 5 calls (0.5 s)
  F1DB  B7 80 AD   STAA  $80AD          ; save
  F1DE  B6 80 AF   LDAA  $80AF          ; test step
  F1E1  85 20      BITA  #$20           ; N75 step?
  F1E3  27 05      BEQ   loc_F1EA       ; no
  F1E5  75 40 03   EIM   #$40,PORT2     ; N75: toggle PORT2.6 every 0.5 s
  F1E8  20 2F      BRA   loc_F219       ; continue

loc_F1EA:
  F1EA  71 BF 03   AIM   #$BF,PORT2     ; N75 = 0
  F1ED  85 0C      BITA  #$0C           ; N80 or N115 step?
  F1EF  27 28      BEQ   loc_F219       ; no: outputs to rest
  F1F1  C8 20      EORB  #$20           ; toggle the phase ($80A9.5)
  F1F3  F7 80 A9   STAB  $80A9          ; save
  F1F6  85 04      BITA  #$04           ; N115 step?
  F1F8  26 11      BNE   loc_F20B       ; yes
  F1FA  C5 20      BITB  #$20           ; phase?
  F1FC  27 04      BEQ   loc_F202       ; 1: N80 off
  F1FE  C6 00      LDAB  #$00           ; reg. $0B = 00
  F200  20 02      BRA   loc_F204       ; continue

loc_F202:
  F202  C6 FF      LDAB  #$FF           ; reg. $0B = FF: N80 on

loc_F204:
  F204  86 0B      LDAA  #$0B           ; chip register $0B (N80)
  F206  FD 01 00   STD   $0100          ; write
  F209  20 14      BRA   loc_F21F       ; N115 at rest

loc_F20B:
  F20B  CE 0B 00   LDX   #$0B00         ; N115: first N80 = 0
  F20E  FF 01 00   STX   $0100          ; write reg. $0B = 00
  F211  C5 20      BITB  #$20           ; phase?
  F213  27 0A      BEQ   loc_F21F       ; 0: N115 off
  F215  C6 04      LDAB  #$04           ; 1: N115 on (bit 2 of reg. $19)
  F217  20 08      BRA   loc_F221       ; write

loc_F219:
  F219  CC 0B 00   LDD   #$0B00         ; N80 = 0
  F21C  FD 01 00   STD   $0100          ; write reg. $0B

loc_F21F:
  F21F  C6 FB      LDAB  #$FB           ; N115 off (bit 2 = 0)

loc_F221:
  F221  86 19      LDAA  #$19           ; chip register $19
  F223  FD 01 00   STD   $0100          ; write

;------------------------------------------------------------------------------
; BLINK CODE STATE MACHINE. Called every 100 ms. The lamp is on when $809F.5 = 1.
; Procedure (VAG): ground pin 5 for ≥ 2.5 s, release it — a code is output:
; a pause, then 4 digits. Digit = N flashes of 0.5 s with 0.5 s gaps,
; 2.5 s dark between digits. The code repeats until the pin is grounded again.
; The next grounding gives the next code. The end of the list is 0000.
; Fault code mode ($80A9.4 = 0): bits $8000-$8002, codes from $C928.
; Actuator test mode ($80A9.4 = 1, engine has not turned): step bit $80AF,
; codes from $C958.
; Cells: $80A0.7 — output in progress; $80A0.6 — code being shown; $80A0.5 — pause
; before the digits has elapsed; $80A0.4 — digits in progress; $80A0 bits 3-0 — which digits
; have been shown; $80A1 — bit mask, $80A2 — code number; $80A3 — flashes left
; in the digit; $80A4 — timer (calls); $80A5/$80A6 — code, shifted by 4 bits;
; $80A7/$80A8 — whole code for repeating; $809F.6 — pin 5 grounded;
; $809F.4 — next code selected; $809F.7 — list finished.
;------------------------------------------------------------------------------
loc_F226:
  F226  B6 80 F6   LDAA  $80F6          ; session with a tester over the K-line ($80F6.3)?
  F229  85 08      BITA  #$08           ; check
  F22B  26 48      BNE   loc_F275       ; yes — switch blink codes off
  F22D  F6 80 14   LDAB  $8014          ; snapshot of port 5
  F230  B6 80 03   LDAA  $8003          ; flags $8003
  F233  85 10      BITA  #$10           ; has the engine turned ($8003.4)?
  F235  27 16      BEQ   loc_F24D       ; no — actuator test
  F237  86 EF      LDAA  #$EF           ; fault code mode ($80A9.4 = 0)
  F239  B4 80 A9   ANDA  $80A9          ; clear
  F23C  B7 80 A9   STAA  $80A9          ; store
  F23F  CE 80 00   LDX   #$8000         ; bit source — $8000
  F242  FF 80 14   STX   $8014          ; save pointer
  F245  CE C9 28   LDX   #$C928         ; fault code table
  F248  FF 80 16   STX   $8016          ; save pointer
  F24B  20 19      BRA   loc_F266       ; continue

loc_F24D:
  F24D  86 10      LDAA  #$10           ; actuator test mode ($80A9.4 = 1)
  F24F  BA 80 A9   ORAA  $80A9          ; set
  F252  B7 80 A9   STAA  $80A9          ; store
  F255  CE 80 AF   LDX   #$80AF         ; source — step bit $80AF
  F258  FF 80 14   STX   $8014          ; save pointer
  F25B  CE C9 58   LDX   #$C958         ; test code table
  F25E  FF 80 16   STX   $8016          ; save pointer
  F261  B6 80 9F   LDAA  $809F          ; flags $809F
  F264  20 25      BRA   loc_F28B       ; to pin 5 without the speed check

loc_F266:
  F266  B6 80 03   LDAA  $8003          ; flags $8003
  F269  85 08      BITA  #$08           ; fault memory restored and not yet confirmed ($8003.3)?
  F26B  26 08      BNE   loc_F275       ; yes — switch blink codes off
  F26D  7E F9 00   JMP   loc_F900       ; factory patch: check engine speed and tester request

loc_F270:
  F270  B1 C7 A7   CMPA  $C7A7          ; engine speed above C7A7 = 80 units (≈1780 rpm)?
  F273  23 0F      BLS   loc_F284       ; no — carry on

loc_F275:
  F275  CE 80 00   LDX   #$8000         ; X = $8000
  F278  61 3F 9F   AIM   #$3F,$9F,X     ; clear "list finished" and "pin grounded"
  F27B  61 FD 03   AIM   #$FD,$03,X     ; clear $8003.1 [?]
  F27E  6F A0      CLR   $A0,X          ; $80A0 = 0: no output
  F280  01         NOP                  ; nothing

loc_F281:
  F281  7E F8 80   JMP   loc_F880       ; to the lamp (via the patch)

loc_F284:
  F284  B6 80 9F   LDAA  $809F          ; flags $809F
  F287  85 80      BITA  #$80           ; list finished?
  F289  26 F6      BNE   loc_F281       ; yes — lamp only

loc_F28B:
  F28B  C5 40      BITB  #$40           ; pin 5 open?
  F28D  26 23      BNE   loc_F2B2       ; yes
  F28F  85 40      BITA  #$40           ; pin grounded; was it also grounded on the previous call?
  F291  27 1A      BEQ   loc_F2AD       ; no — start counting
  F293  F6 80 A4   LDAB  $80A4          ; grounding time
  F296  5C         INCB                 ; + 1
  F297  26 01      BNE   loc_F29A       ; no overflow? yes
  F299  5A         DECB                 ; stay at 255

loc_F29A:
  F29A  F7 80 A4   STAB  $80A4          ; save
  F29D  CE 80 00   LDX   #$8000         ; X = $8000
  F2A0  61 80 A0   AIM   #$80,$A0,X     ; keep only "output in progress"
  F2A3  84 EF      ANDA  #$EF           ; clear "next code selected"
  F2A5  A7 9F      STAA  $9F,X          ; store $809F
  F2A7  61 F7 A9   AIM   #$F7,$A9,X     ; clear the "code being shown" flag in $80A9.3
  F2AA  7E F3 EB   JMP   loc_F3EB       ; the lamp is on while the pin is grounded

loc_F2AD:
  F2AD  8A 40      ORAA  #$40           ; remember: pin grounded
  F2AF  5F         CLRB                 ; grounding time from zero
  F2B0  20 E8      BRA   loc_F29A       ; save

loc_F2B2:
  F2B2  84 BF      ANDA  #$BF           ; pin open: clear the flag
  F2B4  B7 80 9F   STAA  $809F          ; store
  F2B7  F6 80 A0   LDAB  $80A0          ; output state
  F2BA  C5 80      BITB  #$80           ; output already in progress?
  F2BC  26 2D      BNE   loc_F2EB       ; yes
  F2BE  B6 80 A4   LDAA  $80A4          ; grounding time
  F2C1  81 19      CMPA  #$19           ; less than 25 (2.5 s)?
  F2C3  25 BC      BCS   loc_F281       ; yes — do nothing
  F2C5  CA 80      ORAB  #$80           ; start output
  F2C7  F7 80 A0   STAB  $80A0          ; store
  F2CA  5F         CLRB                 ; code number = 0
  F2CB  F7 80 A2   STAB  $80A2          ; store
  F2CE  86 80      LDAA  #$80           ; mask = bit 7
  F2D0  B7 80 A1   STAA  $80A1          ; store
  F2D3  FE 80 14   LDX   $8014          ; pointer to the bits
  F2D6  A6 00      LDAA  $00,X          ; first byte
  F2D8  26 54      BNE   loc_F32E       ; not empty? yes — search for a code
  F2DA  C6 08      LDAB  #$08           ; empty — start from the second byte
  F2DC  F7 80 A2   STAB  $80A2          ; number 8
  F2DF  B6 80 01   LDAA  $8001          ; second byte ($8001)
  F2E2  26 4A      BNE   loc_F32E       ; not empty? yes — search
  F2E4  C6 10      LDAB  #$10           ; start from the third byte
  F2E6  F7 80 A2   STAB  $80A2          ; number 16
  F2E9  20 43      BRA   loc_F32E       ; search for a code

loc_F2EB:
  F2EB  F6 80 A0   LDAB  $80A0          ; output state
  F2EE  C5 40      BITB  #$40           ; code being shown?
  F2F0  27 19      BEQ   loc_F30B       ; no — select a code
  F2F2  C5 20      BITB  #$20           ; pause before the digits elapsed?
  F2F4  27 03      BEQ   loc_F2F9       ; no — count down the pause
  F2F6  7E F3 93   JMP   loc_F393       ; yes — digits

loc_F2F9:
  F2F9  7A 80 A4   DEC   $80A4          ; timer - 1
  F2FC  27 03      BEQ   loc_F301       ; reached zero?
  F2FE  7E F3 91   JMP   loc_F391       ; no — lamp off

loc_F301:
  F301  CA 20      ORAB  #$20           ; pause elapsed
  F303  F7 80 A0   STAB  $80A0          ; store
  F306  86 19      LDAA  #$19           ; timer 25 (2.5 s)
  F308  7E F8 D0   JMP   loc_F8D0       ; via the patch

loc_F30B:
  F30B  F6 80 A2   LDAB  $80A2          ; code number
  F30E  86 10      LDAA  #$10           ; next code selected ($809F.4)?
  F310  B5 80 9F   BITA  $809F          ; check
  F313  26 58      BNE   loc_F36D       ; yes — count down the pause
  F315  7E F8 F0   JMP   loc_F8F0       ; via the patch

loc_F318:
  F318  81 19      CMPA  #$19           ; timer 25 or more?
  F31A  25 44      BCS   loc_F360       ; no — to the pause
  F31C  FE 80 14   LDX   $8014          ; pointer to the bits

loc_F31F:
  F31F  C0 08      SUBB  #$08           ; number / 8 = byte
  F321  25 03      BCS   loc_F326       ; byte found
  F323  08         INX                  ; next byte
  F324  20 F9      BRA   loc_F31F       ; continue

loc_F326:
  F326  F6 80 A2   LDAB  $80A2          ; code number
  F329  B6 80 A1   LDAA  $80A1          ; mask
  F32C  20 14      BRA   loc_F342       ; search from the next bit

loc_F32E:
  F32E  FE 80 14   LDX   $8014          ; pointer to the bits

loc_F331:
  F331  C0 08      SUBB  #$08           ; number / 8 = byte
  F333  25 03      BCS   loc_F338       ; byte found
  F335  08         INX                  ; next byte
  F336  20 F9      BRA   loc_F331       ; continue

loc_F338:
  F338  F6 80 A2   LDAB  $80A2          ; code number
  F33B  B6 80 A1   LDAA  $80A1          ; mask

loc_F33E:
  F33E  A5 00      BITA  $00,X          ; is this bit set?
  F340  26 18      BNE   loc_F35A       ; yes — code found

loc_F342:
  F342  5C         INCB                 ; number + 1
  F343  44         LSRA                 ; mask right
  F344  24 F8      BCC   loc_F33E       ; more bits in the byte? yes
  F346  86 10      LDAA  #$10           ; test mode?
  F348  B5 80 A9   BITA  $80A9          ; check
  F34B  27 03      BEQ   loc_F350       ; no — next byte
  F34D  5F         CLRB                 ; test: number = 0
  F34E  20 06      BRA   loc_F356       ; continue

loc_F350:
  F350  08         INX                  ; next byte
  F351  8C 80 02   CPX   #$8002         ; beyond $8002?
  F354  22 54      BHI   loc_F3AA       ; yes — list finished

loc_F356:
  F356  86 80      LDAA  #$80           ; mask = bit 7
  F358  20 E4      BRA   loc_F33E       ; search

loc_F35A:
  F35A  B7 80 A1   STAA  $80A1          ; remember the mask
  F35D  F7 80 A2   STAB  $80A2          ; remember the number

loc_F360:
  F360  86 10      LDAA  #$10           ; next code selected
  F362  BA 80 9F   ORAA  $809F          ; set
  F365  B7 80 9F   STAA  $809F          ; store
  F368  86 06      LDAA  #$06           ; pause before the code 6 (0.6 s)
  F36A  B7 80 A4   STAA  $80A4          ; store the timer

loc_F36D:
  F36D  7D 80 A4   TST   $80A4          ; timer still running?
  F370  27 05      BEQ   loc_F377       ; no — fetch the code
  F372  7A 80 A4   DEC   $80A4          ; - 1
  F375  20 42      BRA   loc_F3B9       ; lamp off

loc_F377:
  F377  58         ASLB                 ; number * 2
  F378  FE 80 16   LDX   $8016          ; code table
  F37B  3A         ABX                  ; X -> code
  F37C  EE 00      LDX   $00,X          ; code (4 BCD digits)
  F37E  FF 80 A5   STX   $80A5          ; $80A5 = code
  F381  7E F8 A0   JMP   loc_F8A0       ; via the patch: remember the code

loc_F384:
  F384  86 19      LDAA  #$19           ; pause 25 (2.5 s)
  F386  B7 80 A4   STAA  $80A4          ; store the timer
  F389  86 40      LDAA  #$40           ; code being shown
  F38B  BA 80 A0   ORAA  $80A0          ; set
  F38E  B7 80 A0   STAA  $80A0          ; store

loc_F391:
  F391  20 58      BRA   loc_F3EB       ; to the lamp (on)

loc_F393:
  F393  C5 10      BITB  #$10           ; digits in progress?
  F395  26 25      BNE   loc_F3BC       ; yes
  F397  7A 80 A4   DEC   $80A4          ; pause timer - 1
  F39A  26 1D      BNE   loc_F3B9       ; has not reached zero — lamp off
  F39C  FE 80 A7   LDX   $80A7          ; code
  F39F  27 54      BEQ   loc_F3F5       ; code 0000 (end)?
  F3A1  CA 10      ORAB  #$10           ; start the digits
  F3A3  F7 80 A0   STAB  $80A0          ; store
  F3A6  8D 6A      BSR   NEXT_DIGIT     ; first digit into $80A3
  F3A8  20 27      BRA   loc_F3D1       ; continue

loc_F3AA:
  F3AA  86 80      LDAA  #$80           ; list finished
  F3AC  BA 80 9F   ORAA  $809F          ; set
  F3AF  B7 80 9F   STAA  $809F          ; store
  F3B2  4F         CLRA                 ; $80A0 = 0
  F3B3  B7 80 A0   STAA  $80A0          ; store

loc_F3B6:
  F3B6  B7 80 A4   STAA  $80A4          ; timer

loc_F3B9:
  F3B9  7E F4 68   JMP   loc_F468       ; lamp off

loc_F3BC:
  F3BC  C5 08      BITB  #$08           ; all 4 digits shown?
  F3BE  27 0C      BEQ   loc_F3CC       ; no
  F3C0  C5 04      BITB  #$04           ; second?
  F3C2  27 08      BEQ   loc_F3CC       ; no
  F3C4  C5 02      BITB  #$02           ; third?
  F3C6  27 04      BEQ   loc_F3CC       ; no
  F3C8  C5 01      BITB  #$01           ; fourth?
  F3CA  26 0A      BNE   loc_F3D6       ; yes — pause after the code

loc_F3CC:
  F3CC  7A 80 A4   DEC   $80A4          ; timer - 1
  F3CF  26 02      BNE   loc_F3D3       ; has not reached zero — continue

loc_F3D1:
  F3D1  8D 53      BSR   BLINK_STEP     ; next flash phase

loc_F3D3:
  F3D3  7E F4 70   JMP   loc_F470       ; to the lamp

loc_F3D6:
  F3D6  7A 80 A4   DEC   $80A4          ; timer - 1
  F3D9  26 DE      BNE   loc_F3B9       ; has not reached zero — lamp off

loc_F3DB:
  F3DB  86 80      LDAA  #$80           ; keep only "output in progress"
  F3DD  B4 80 A0   ANDA  $80A0          ; clear
  F3E0  B7 80 A0   STAA  $80A0          ; store
  F3E3  FE 80 A7   LDX   $80A7          ; the same code
  F3E6  FF 80 A5   STX   $80A5          ; repeat
  F3E9  20 99      BRA   loc_F384       ; code repeat

loc_F3EB:
  F3EB  86 20      LDAA  #$20           ; lamp on ($809F.5)
  F3ED  BA 80 9F   ORAA  $809F          ; set
  F3F0  B7 80 9F   STAA  $809F          ; store
  F3F3  20 7B      BRA   loc_F470       ; to the lamp

loc_F3F5:
  F3F5  CE 80 00   LDX   #$8000         ; X = $8000
  F3F8  6B 10 A9   TIM   #$10,$A9,X     ; test mode?
  F3FB  26 08      BNE   loc_F405       ; yes
  F3FD  62 80 2C   OIM   #$80,$2C,X     ; fault codes shown to the end ($802C.7)
  F400  62 02 03   OIM   #$02,$03,X     ; $8003.1 [?]
  F403  20 D6      BRA   loc_F3DB       ; repeat 0000

loc_F405:
  F405  6B 80 2C   TIM   #$80,$2C,X     ; test: had the codes before this been shown to the end?
  F408  27 D1      BEQ   loc_F3DB       ; no
  F40A  61 7F 2C   AIM   #$7F,$2C,X     ; clear the flag
  F40D  62 02 92   OIM   #$02,$92,X     ; request to erase the fault memory [assumed]
  F410  20 C9      BRA   loc_F3DB       ; repeat 0000

;------------------------------------------------------------------------------
; NEXT_DIGIT — take the most significant digit of the code: $80A3 = upper 4 bits of $80A5,
; the code is shifted left by 4 bits.
;------------------------------------------------------------------------------
NEXT_DIGIT:                             ; called from: TASK3
  F412  7F 80 A3   CLR   $80A3          ; $80A3 = 0
  F415  FC 80 A5   LDD   $80A5          ; code
  F418  CE 00 04   LDX   #$0004         ; 4 shifts

loc_F41B:
  F41B  05         ASLD                 ; most significant bit of the code
  F41C  79 80 A3   ROL   $80A3          ; into $80A3
  F41F  09         DEX                  ; counter
  F420  26 F9      BNE   loc_F41B       ; more? yes
  F422  FD 80 A5   STD   $80A5          ; code without the digit
  F425  39         RTS                  ; return

;------------------------------------------------------------------------------
; BLINK_STEP — next phase: flash for 5 calls (0.5 s, lamp on),
; gap for 5 calls (lamp off). When the flashes of a digit are used up, mark the
; digit as shown, take the next one and keep the lamp off for 25 calls (2.5 s).
;------------------------------------------------------------------------------
BLINK_STEP:                             ; called from: TASK3
  F426  F6 80 9F   LDAB  $809F          ; flags
  F429  B6 80 A3   LDAA  $80A3          ; flashes left
  F42C  27 09      BEQ   loc_F437       ; zero — digit finished
  F42E  C5 20      BITB  #$20           ; lamp on?
  F430  27 27      BEQ   loc_F459       ; no — switch it on
  F432  7A 80 A3   DEC   $80A3          ; flash finished: - 1
  F435  26 2D      BNE   loc_F464       ; more left — gap

loc_F437:
  F437  86 08      LDAA  #$08           ; first digit not yet shown:

loc_F439:
  F439  B5 80 A0   BITA  $80A0          ; has this one been shown?
  F43C  27 03      BEQ   loc_F441       ; no — it is this one
  F43E  44         LSRA                 ; next
  F43F  20 F8      BRA   loc_F439       ; continue

loc_F441:
  F441  BA 80 A0   ORAA  $80A0          ; mark as shown
  F444  B7 80 A0   STAA  $80A0          ; store
  F447  85 01      BITA  #$01           ; was it the last one (fourth)?
  F449  26 08      BNE   loc_F453       ; yes
  F44B  37         PSHB                 ; save flags
  F44C  8D C4      BSR   NEXT_DIGIT     ; take the next digit
  F44E  33         PULB                 ; restore flags
  F44F  86 19      LDAA  #$19           ; pause 25
  F451  20 02      BRA   loc_F455       ; continue

loc_F453:
  F453  86 19      LDAA  #$19           ; pause 25

loc_F455:
  F455  C4 DF      ANDB  #$DF           ; lamp off
  F457  20 04      BRA   loc_F45D       ; continue

loc_F459:
  F459  86 05      LDAA  #$05           ; switch on for 5 calls
  F45B  CA 20      ORAB  #$20           ; lamp on

loc_F45D:
  F45D  F7 80 9F   STAB  $809F          ; store $809F
  F460  B7 80 A4   STAA  $80A4          ; timer
  F463  39         RTS                  ; return

loc_F464:
  F464  86 05      LDAA  #$05           ; gap of 5 calls
  F466  20 ED      BRA   loc_F455       ; switch off

loc_F468:
  F468  86 DF      LDAA  #$DF           ; lamp off ($809F.5 = 0)
  F46A  B4 80 9F   ANDA  $809F          ; clear
  F46D  B7 80 9F   STAA  $809F          ; store

;------------------------------------------------------------------------------
; LAMP K66 (pin 31, PORT6.4). PORT6.4 = 0 — lamp on, 1 — lamp off.
; On: with the engine stopped (lamp check), while pin 5 is grounded, under
; the blink state machine, and on a warm engine under load if the knock sensor
; or knock control is faulty (F51D).
; Not on for G28/Hall and boost faults at engine speeds above 120 units [?].
; $806E: bit 1 — engine speed above 120 units (C7A5, hysteresis 4); bits 2-4 —
; special lamp modes for the tester [?].
;------------------------------------------------------------------------------
loc_F470:
  F470  CE 80 00   LDX   #$8000         ; X = $8000
  F473  E6 6E      LDAB  $6E,X          ; lamp flags
  F475  C4 FB      ANDB  #$FB           ; clear bit 2 first
  F477  C5 08      BITB  #$08           ; $806E.3?
  F479  26 34      BNE   loc_F4AF       ; set — save
  F47B  7B 40 15   TIM   #$40,PORT5     ; pin 5 grounded?
  F47E  27 2D      BEQ   loc_F4AD       ; yes — clear bit 4
  F480  6B 20 95   TIM   #$20,$95,X     ; synchronisation present?
  F483  27 26      BEQ   loc_F4AB       ; no — bit 3
  F485  6B 80 A0   TIM   #$80,$A0,X     ; blink output in progress?
  F488  26 05      BNE   loc_F48F       ; yes — patch
  F48A  6B 80 9F   TIM   #$80,$9F,X     ; list finished?
  F48D  27 1C      BEQ   loc_F4AB       ; no — bit 3

loc_F48F:
  F48F  7E F8 90   JMP   loc_F890       ; patch: flash counter for the tester [?]

; table $F492, 1 bytes: dead byte (left under the patch)
  F492  db F5

loc_F493:
  F493  81 0C      CMPA  #$0C           ; counter less than 12?
  F495  24 03      BCC   loc_F49A       ; no — from zero
  F497  4C         INCA                 ; + 1
  F498  20 01      BRA   loc_F49B       ; continue

loc_F49A:
  F49A  4F         CLRA                 ; from zero

loc_F49B:
  F49B  A7 F5      STAA  $F5,X          ; $80F5 = counter 0…12
  F49D  A6 F4      LDAA  $F4,X          ; $80F4 [?]
  F49F  80 02      SUBA  #$02           ; - 2
  F4A1  25 0C      BCS   loc_F4AF       ; below zero — without bit 2
  F4A3  A1 F5      CMPA  $F5,X          ; compare with the counter
  F4A5  25 08      BCS   loc_F4AF       ; less — without bit 2
  F4A7  CA 04      ORAB  #$04           ; bit 2
  F4A9  20 04      BRA   loc_F4AF       ; continue

loc_F4AB:
  F4AB  CA 08      ORAB  #$08           ; bit 3

loc_F4AD:
  F4AD  C4 EF      ANDB  #$EF           ; clear bit 4

loc_F4AF:
  F4AF  E7 6E      STAB  $6E,X          ; store the lamp flags
  F4B1  B6 80 6E   LDAA  $806E          ; lamp flags
  F4B4  85 10      BITA  #$10           ; bit 4?
  F4B6  27 07      BEQ   loc_F4BF       ; no — normal lamp
  F4B8  85 04      BITA  #$04           ; bit 2?
  F4BA  27 78      BEQ   loc_F534       ; no — switch off
  F4BC  7E F5 3F   JMP   loc_F53F       ; yes — switch on

loc_F4BF:
  F4BF  86 40      LDAA  #$40           ; pin 5
  F4C1  95 15      BITA  PORT5          ; grounded?
  F4C3  27 7A      BEQ   loc_F53F       ; yes — lamp on
  F4C5  86 80      LDAA  #$80           ; blink output in progress?
  F4C7  B5 80 A0   BITA  $80A0          ; check
  F4CA  26 6C      BNE   loc_F538       ; yes — lamp under the blink state machine
  F4CC  B6 80 18   LDAA  $8018          ; engine speed
  F4CF  F6 C7 A5   LDAB  $C7A5          ; threshold C7A5 = 120 units (≈2700 rpm)
  F4D2  11         CBA                  ; engine speed below?
  F4D3  25 0A      BCS   loc_F4DF       ; yes — do not set bit 1
  F4D5  36         PSHA                 ; save
  F4D6  86 02      LDAA  #$02           ; bit 1
  F4D8  BA 80 6E   ORAA  $806E          ; set
  F4DB  B7 80 6E   STAA  $806E          ; store
  F4DE  32         PULA                 ; restore engine speed

loc_F4DF:
  F4DF  C0 04      SUBB  #$04           ; hysteresis 4
  F4E1  11         CBA                  ; engine speed not below 116?
  F4E2  24 08      BCC   loc_F4EC       ; yes — keep bit 1
  F4E4  86 FD      LDAA  #$FD           ; clear bit 1
  F4E6  B4 80 6E   ANDA  $806E          ; clear
  F4E9  B7 80 6E   STAA  $806E          ; store

loc_F4EC:
  F4EC  F6 80 6E   LDAB  $806E          ; lamp flags
  F4EF  86 80      LDAA  #$80           ; blink output in progress?
  F4F1  B5 80 A0   BITA  $80A0          ; check
  F4F4  26 53      BNE   loc_F549       ; yes — leave the lamp alone
  F4F6  B6 80 18   LDAA  $8018          ; engine speed
  F4F9  81 01      CMPA  #$01           ; less than 1 (engine stopped)?
  F4FB  25 42      BCS   loc_F53F       ; yes — lamp on
  F4FD  86 C0      LDAA  #$C0           ; ECU faults
  F4FF  B5 80 95   BITA  $8095          ; any?
  F502  26 3B      BNE   loc_F53F       ; yes — lamp on
  F504  C5 02      BITB  #$02           ; engine speed above 120 units?
  F506  27 0B      BEQ   loc_F513       ; no
  F508  C5 60      BITB  #$60           ; bits 5, 6?
  F50A  26 33      BNE   loc_F53F       ; set — lamp on
  F50C  86 05      LDAA  #$05           ; G28/Hall faults (bits 0, 2)
  F50E  B5 80 94   BITA  $8094          ; check
  F511  26 2C      BNE   loc_F53F       ; present — lamp on

loc_F513:
  F513  86 01      LDAA  #$01           ; pressure above 128 ($8028.0)?
  F515  B5 80 28   BITA  $8028          ; check
  F518  27 03      BEQ   loc_F51D       ; no
  F51A  5D         TSTB                 ; $806E.7 (long-standing fault $8092.7)?
  F51B  2B 22      BMI   loc_F53F       ; yes — lamp on

loc_F51D:
  F51D  B6 80 50   LDAA  $8050          ; mode $8050: warm and under load (bits 6 and 5)?
  F520  88 60      EORA  #$60           ; invert
  F522  85 60      BITA  #$60           ; both set?
  F524  26 0E      BNE   loc_F534       ; no — switch off
  F526  86 A0      LDAA  #$A0           ; knock sensor faults
  F528  B5 80 B6   BITA  $80B6          ; any?
  F52B  26 12      BNE   loc_F53F       ; yes — lamp on
  F52D  86 10      LDAA  #$10           ; $807A.4 — knock retard limit [assumed]
  F52F  B5 80 7A   BITA  $807A          ; check
  F532  26 0B      BNE   loc_F53F       ; yes — lamp on

loc_F534:
  F534  86 10      LDAA  #$10           ; switch off: PORT6.4 = 1
  F536  20 08      BRA   loc_F540       ; store

loc_F538:
  F538  86 20      LDAA  #$20           ; blink codes: lamp on?
  F53A  B5 80 9F   BITA  $809F          ; check
  F53D  27 F5      BEQ   loc_F534       ; no — switch off

loc_F53F:
  F53F  4F         CLRA                 ; switch on: PORT6.4 = 0

loc_F540:
  F540  C6 EF      LDAB  #$EF           ; mask of bit 4
  F542  0F         SEI                  ; disable interrupts
  F543  D4 17      ANDB  PORT6          ; the other bits of PORT6
  F545  1B         ABA                  ; + lamp bit
  F546  97 17      STAA  PORT6          ; store PORT6
  F548  0E         CLI                  ; enable interrupts

loc_F549:
  F549  7E F8 B0   JMP   loc_F8B0       ; patch: K-line transmitter

;------------------------------------------------------------------------------
; N80_ROW — map row by pressure: $8015 = index, $8017 = fraction.
; Input: X = pressure axis, B = number of points. On a G71 fault — substitute value 192.
;------------------------------------------------------------------------------
N80_ROW:                                ; called from: TASK3
  F54C  37         PSHB                 ; number of points onto the stack
  F54D  B6 80 19   LDAA  $8019          ; pressure
  F550  C6 72      LDAB  #$72           ; G71 faults
  F552  F5 80 91   BITB  $8091          ; check
  F555  27 03      BEQ   loc_F55A       ; no — measured value
  F557  B6 C7 9E   LDAA  $C79E          ; substitute value C79E = 192

loc_F55A:
  F55A  33         PULB                 ; number of points
  F55B  BD CA 6B   JSR   AXIS_DN        ; find the interval (axis descending)
  F55E  F7 80 15   STAB  $8015          ; $8015 = row index
  F561  BD CA 10   JSR   FRAC_DN        ; fraction
  F564  F7 80 17   STAB  $8017          ; $8017 = fraction
  F567  39         RTS                  ; return

;------------------------------------------------------------------------------
; N80_COL — column by engine speed: $8014 = index, $8016 = fraction.
; Output: B = row * 8 + column (cell index).
;------------------------------------------------------------------------------
N80_COL:                                ; called from: TASK3
  F568  B6 80 18   LDAA  $8018          ; engine speed
  F56B  BD CA 5F   JSR   AXIS_UP        ; find the interval
  F56E  F7 80 14   STAB  $8014          ; $8014 = column index
  F571  BD CA 05   JSR   FRAC_UP        ; fraction
  F574  F7 80 16   STAB  $8016          ; $8016 = fraction
  F577  F6 80 15   LDAB  $8015          ; row index
  F57A  58         ASLB                 ; * 8
  F57B  58         ASLB                 ; *
  F57C  58         ASLB                 ; *
  F57D  FB 80 14   ADDB  $8014          ; + column
  F580  39         RTS                  ; return

;------------------------------------------------------------------------------
; MAP8X8 — double interpolation in an 8×8 map: first by engine speed in its own
; row and in the next one, then between the rows by pressure.
; Input: X = map, B = cell index. Output: A.
;------------------------------------------------------------------------------
MAP8X8:                                 ; called from: TASK3
  F581  3A         ABX                  ; X -> cell
  F582  3C         PSHX                 ; save
  F583  F6 80 16   LDAB  $8016          ; engine speed fraction
  F586  BD CA 41   JSR   INTERP         ; value in the row
  F589  B7 80 14   STAA  $8014          ; $8014 = in the row
  F58C  C6 08      LDAB  #$08           ; next row (+8)
  F58E  38         PULX                 ; X -> cell
  F58F  3A         ABX                  ; (address)
  F590  F6 80 16   LDAB  $8016          ; engine speed fraction
  F593  BD CA 41   JSR   INTERP         ; value in the next row
  F596  B7 80 15   STAA  $8015          ; $8015
  F599  CE 80 14   LDX   #$8014         ; two consecutive values
  F59C  F6 80 17   LDAB  $8017          ; pressure fraction
  F59F  BD CA 41   JSR   INTERP         ; between the rows
  F5A2  39         RTS                  ; return

;------------------------------------------------------------------------------
; NMI — triggered when the supply voltage drops (ignition switched off) [assumed].
; The code bytes $8000-$8002 and the counters $802B, $802C are copied into the CPU's
; internal RAM $41-$45, and their sum goes into $40. This RAM is powered from
; permanent positive (pin 33) and keeps the faults with the ignition off.
; At the next switch-on the copy is checked against the sum and restored (D13C).
;------------------------------------------------------------------------------
sub_F5A3:                               ; called from: NMI
  F5A3  7B 40 14   TIM   #$40,RP5CR     ; internal RAM already enabled (copy being worked on)?
  F5A6  27 01      BEQ   loc_F5A9       ; no — save
  F5A8  3B         RTI                  ; yes — exit

loc_F5A9:
  F5A9  72 40 14   OIM   #$40,RP5CR     ; enable internal RAM
  F5AC  4F         CLRA                 ; sum = 0
  F5AD  F6 80 00   LDAB  $8000          ; code byte 1
  F5B0  1B         ABA                  ; into the sum
  F5B1  D7 41      STAB  $41            ; copy
  F5B3  F6 80 01   LDAB  $8001          ; code byte 2
  F5B6  1B         ABA                  ; into the sum
  F5B7  D7 42      STAB  $42            ; copy
  F5B9  F6 80 02   LDAB  $8002          ; code byte 3
  F5BC  1B         ABA                  ; into the sum
  F5BD  D7 43      STAB  $43            ; copy
  F5BF  F6 80 2B   LDAB  $802B          ; counter of starts without changes
  F5C2  1B         ABA                  ; into the sum
  F5C3  D7 44      STAB  $44            ; copy
  F5C5  F6 80 2C   LDAB  $802C          ; $802C (bit 7 — codes shown to the end)
  F5C8  1B         ABA                  ; into the sum
  F5C9  D7 45      STAB  $45            ; copy
  F5CB  97 40      STAA  $40            ; $40 = sum
  F5CD  71 BF 14   AIM   #$BF,RP5CR     ; disable internal RAM (write protection)
  F5D0  72 80 14   OIM   #$80,RP5CR     ; flag "RAM was powered" = 1
  F5D3  86 08      LDAA  #$08           ; copy made ($8003.3)
  F5D5  BA 80 03   ORAA  $8003          ; set
  F5D8  B7 80 03   STAA  $8003          ; store
  F5DB  3B         RTI                  ; return

;------------------------------------------------------------------------------
; OCF - timer 1 compare.
; OC1: PWM for N7 on pin P21 (contact 8). Period 21400 E clocks (1.536 MHz) =
; 71.8 Hz. On for $805D clocks, off for 21400 - $805D; the output level
; toggles by itself (OLVL1).
; OC2: every 7812 clocks (5.09 ms) one step of the slow PWM for N80: 32 steps = 163 ms,
; for the first $8064 steps chip register $0B = FF (N80 open), for the rest 00.
;------------------------------------------------------------------------------
OCF:                                    ; called from: OCF
  F5DC  96 0F      LDAA  TCSR2          ; timer status, part 2
  F5DE  85 20      BITA  #$20           ; compare 2?
  F5E0  26 18      BNE   loc_F5FA       ; yes - N80
  F5E2  96 08      LDAA  TCSR1          ; read (clears the OC1 flag)
  F5E4  FC 80 5D   LDD   $805D          ; "on" time
  F5E7  7B 01 08   TIM   #$01,TCSR1     ; level 1 now?
  F5EA  26 06      BNE   loc_F5F2       ; yes - next edge after "on"
  F5EC  CC 53 98   LDD   #$5398         ; period 21400
  F5EF  B3 80 5D   SUBD  $805D          ; - "on" = "off"

loc_F5F2:
  F5F2  75 01 08   EIM   #$01,TCSR1     ; toggle the level at the next match
  F5F5  D3 0B      ADDD  OCR1H          ; + to the match moment
  F5F7  DD 0B      STD   OCR1H          ; new moment
  F5F9  3B         RTI                  ; exit

loc_F5FA:
  F5FA  DC 09      LDD   FRCH           ; timer counter
  F5FC  C3 1E 84   ADDD  #$1E84         ; + 7812 (5.09 ms)
  F5FF  DD 19      STD   OCR2H          ; next compare 2
  F601  B6 80 65   LDAA  $8065          ; N80 PWM step
  F604  81 20      CMPA  #$20           ; 32?
  F606  27 09      BEQ   loc_F611       ; yes - from the start
  F608  B1 80 64   CMPA  $8064          ; below the duty cycle?
  F60B  25 0A      BCS   loc_F617       ; yes - open

loc_F60D:
  F60D  C6 00      LDAB  #$00           ; closed: 00
  F60F  20 08      BRA   loc_F619       ; continue

loc_F611:
  F611  4F         CLRA                 ; step 0
  F612  F6 80 64   LDAB  $8064          ; duty cycle
  F615  27 F6      BEQ   loc_F60D       ; zero - closed

loc_F617:
  F617  C6 FF      LDAB  #$FF           ; open: FF

loc_F619:
  F619  4C         INCA                 ; step + 1
  F61A  B7 80 65   STAA  $8065          ; store
  F61D  86 20      LDAA  #$20           ; synchronised?
  F61F  B5 80 95   BITA  $8095          ; check
  F622  27 05      BEQ   loc_F629       ; no - leave alone
  F624  86 0B      LDAA  #$0B           ; chip register $0B (N80)
  F626  FD 01 00   STD   $0100          ; store

loc_F629:
  F629  3B         RTI                  ; exit

;------------------------------------------------------------------------------
; CMI - timer 2 match: software PWM for N75 on PORT2.6 (contact 19).
; The "on" phase lasts $8067 timer 2 counts, the "off" phase 255 - $8067.
; 0 means always off, 255 always on. The frequency depends on the timer 2 prescaler
; (TCSR3, E760) [?].
;------------------------------------------------------------------------------
CMI:                                    ; called from: CMI
  F62A  71 7F 1B   AIM   #$7F,TCSR3     ; clear the match flag
  F62D  96 03      LDAA  PORT2          ; port 2
  F62F  85 40      BITA  #$40           ; N75 on now?
  F631  26 12      BNE   loc_F645       ; yes
  F633  F6 80 67   LDAB  $8067          ; duty cycle
  F636  27 1F      BEQ   loc_F657       ; 0 - leave off
  F638  C1 FF      CMPB  #$FF           ; 255?
  F63A  27 1F      BEQ   loc_F65B       ; yes - switch on permanently
  F63C  8A 40      ORAA  #$40           ; switch on
  F63E  97 03      STAA  PORT2          ; store
  F640  F6 80 67   LDAB  $8067          ; "on" time
  F643  20 1A      BRA   loc_F65F       ; to the timer

loc_F645:
  F645  F6 80 67   LDAB  $8067          ; duty cycle
  F648  C1 FF      CMPB  #$FF           ; 255?
  F64A  27 0F      BEQ   loc_F65B       ; yes - leave on
  F64C  84 BF      ANDA  #$BF           ; switch off
  F64E  97 03      STAA  PORT2          ; store
  F650  C6 FF      LDAB  #$FF           ; 255
  F652  F0 80 67   SUBB  $8067          ; - duty cycle = "off"
  F655  20 08      BRA   loc_F65F       ; to the timer

loc_F657:
  F657  84 BF      ANDA  #$BF           ; switch off
  F659  20 02      BRA   loc_F65D       ; store

loc_F65B:
  F65B  8A 40      ORAA  #$40           ; switch on

loc_F65D:
  F65D  97 03      STAA  PORT2          ; store

loc_F65F:
  F65F  D7 1C      STAB  TCONR          ; phase duration to timer 2

;------------------------------------------------------------------------------
; TOF and the empty end of CMI do nothing.
;------------------------------------------------------------------------------
TOF:                                    ; called from: CMI, TOF
  F661  3B         RTI                  ; exit

;------------------------------------------------------------------------------
; IRQ2 - one-shot measurement [?]: disable IRQ2, $80F4 = |chip reg. $00 - 94|.
; IRQ2 is enabled at CDF9 (Hall high and $806E.4). $80F4 is used by the lamp
; in tester mode (F49D).
;------------------------------------------------------------------------------
IRQ2:                                   ; called from: IRQ2
  F662  71 FD 14   AIM   #$FD,RP5CR     ; disable IRQ2
  F665  86 00      LDAA  #$00           ; register $00
  F667  B7 01 00   STAA  $0100          ; select
  F66A  B6 01 01   LDAA  $0101          ; read
  F66D  80 5E      SUBA  #$5E           ; - 94
  F66F  24 01      BCC   loc_F672       ; not below zero
  F671  40         NEGA                 ; absolute value

loc_F672:
  F672  B7 80 F4   STAA  $80F4          ; $80F4
  F675  3B         RTI                  ; exit

;------------------------------------------------------------------------------
; ICF - capture on P20 (input Tin): REFERENCE MARK G4 (once per crankshaft revolution) [assumed from logic].
; $8095.4 - a mark occurred (for the "540 teeth without a mark" check, D352).
; The first 3 marks check G4 ($8095.0). After that, not during start, the Hall signal must
; change from mark to mark (phase $8095.2): 2 times high at the wrong moment gives 2113
; ($8094 bits 3, 2), 3 times low at the wrong moment gives 2113 (bits 1, 0).
; A mark without teeth between marks ($8095.3 not set) 2 times gives 2111 G28 ($8094 bits 7, 6).
;------------------------------------------------------------------------------
ICF:                                    ; called from: ICF
  F676  CE 80 00   LDX   #$8000         ; X = $8000
  F679  62 10 95   OIM   #$10,$95,X     ; mark occurred ($8095.4)
  F67C  6B 01 95   TIM   #$01,$95,X     ; G4 already checked?
  F67F  26 17      BNE   loc_F698       ; yes
  F681  62 40 03   OIM   #$40,$03,X     ; "teeth already occurred"
  F684  BD F7 26   JSR   TEST_EXIT      ; exit the actuator test
  F687  A6 9A      LDAA  $9A,X          ; mark counter
  F689  81 02      CMPA  #$02           ; already 2?
  F68B  24 05      BCC   loc_F692       ; yes - G4 checked
  F68D  4C         INCA                 ; + 1

loc_F68E:
  F68E  A7 9A      STAA  $9A,X          ; store
  F690  20 66      BRA   loc_F6F8       ; exit

loc_F692:
  F692  62 01 95   OIM   #$01,$95,X     ; G4 checked ($8095.0)
  F695  4F         CLRA                 ; 0
  F696  20 F6      BRA   loc_F68E       ; store

loc_F698:
  F698  6B 80 29   TIM   #$80,$29,X     ; start?
  F69B  26 41      BNE   loc_F6DE       ; yes - do not check Hall
  F69D  7B 02 17   TIM   #$02,PORT6     ; Hall high?
  F6A0  27 1F      BEQ   loc_F6C1       ; no
  F6A2  6B 04 95   TIM   #$04,$95,X     ; expected low (phase)?
  F6A5  27 0E      BEQ   loc_F6B5       ; no - phase correct
  F6A7  A6 97      LDAA  $97,X          ; mismatch counter
  F6A9  4C         INCA                 ; + 1
  F6AA  A7 97      STAA  $97,X          ; store
  F6AC  81 02      CMPA  #$02           ; below 2?
  F6AE  25 2E      BCS   loc_F6DE       ; yes
  F6B0  62 0C 94   OIM   #$0C,$94,X     ; Hall fault (2113)
  F6B3  20 29      BRA   loc_F6DE       ; continue

loc_F6B5:
  F6B5  61 F7 94   AIM   #$F7,$94,X     ; clear suspicion
  F6B8  86 01      LDAA  #$01           ; 1
  F6BA  A7 97      STAA  $97,X          ; store
  F6BC  62 06 95   OIM   #$06,$95,X     ; phase: next is low
  F6BF  20 1D      BRA   loc_F6DE       ; continue

loc_F6C1:
  F6C1  6B 04 95   TIM   #$04,$95,X     ; expected high?
  F6C4  26 0E      BNE   loc_F6D4       ; no - phase correct
  F6C6  A6 97      LDAA  $97,X          ; mismatch counter
  F6C8  4C         INCA                 ; + 1
  F6C9  A7 97      STAA  $97,X          ; store
  F6CB  81 03      CMPA  #$03           ; below 3?
  F6CD  25 0F      BCS   loc_F6DE       ; yes
  F6CF  62 03 94   OIM   #$03,$94,X     ; Hall fault (2113)
  F6D2  20 0A      BRA   loc_F6DE       ; continue

loc_F6D4:
  F6D4  61 FD 94   AIM   #$FD,$94,X     ; clear suspicion
  F6D7  86 01      LDAA  #$01           ; 1
  F6D9  A7 97      STAA  $97,X          ; store
  F6DB  61 FB 95   AIM   #$FB,$95,X     ; phase: next is high

loc_F6DE:
  F6DE  6B 08 95   TIM   #$08,$95,X     ; teeth between marks occurred ($8095.3)?
  F6E1  27 08      BEQ   loc_F6EB       ; no
  F6E3  61 7F 94   AIM   #$7F,$94,X     ; clear G28 suspicion
