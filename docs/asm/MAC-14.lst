  F636  27 1F      BEQ   loc_F657       ; 0 — оставить выключенным
  F638  C1 FF      CMPB  #$FF           ; 255?
  F63A  27 1F      BEQ   loc_F65B       ; да — включить насовсем
  F63C  8A 40      ORAA  #$40           ; включить
  F63E  97 03      STAA  PORT2          ; записать
  F640  F6 80 67   LDAB  $8067          ; время «включено»
  F643  20 1A      BRA   loc_F65F       ; в таймер

