;------------------------------------------------------------------------------
; SCI - Empfangsinterrupt der K-Leitung [?]. Ist es Zeit zu senden ($80F7.6), löschen;
; sonst, wenn die Synchronbytes gesendet sind und noch kein Byte wartet, markieren ($80F6.4).
; Dann diesen Interrupt ausschalten und das empfangene Byte verwerfen (das eigene Echo auf
; der Eindraht-K-Leitung [Vermutung]). Der eigentliche Empfang erfolgt per Abfrage in Task 0.
;------------------------------------------------------------------------------
SCI:                                    ; aufgerufen von: SCI
  F6FD  7B 80 11   TIM   #$80,TRCSR1    ; Byte empfangen?
  F700  27 1F      BEQ   loc_F721       ; nein
  F702  B6 80 F7   LDAA  $80F7          ; Kommunikations-Flags
  F705  85 40      BITA  #$40           ; Zeit zu senden?
  F707  26 10      BNE   loc_F719       ; ja
  F709  B6 80 F6   LDAA  $80F6          ; Sitzungszustand
  F70C  2A 13      BPL   loc_F721       ; Synchronbytes nicht gesendet - verwerfen
  F70E  85 10      BITA  #$10           ; Byte wartet schon?
  F710  26 13      BNE   loc_F725       ; ja - verlassen
  F712  8A 10      ORAA  #$10           ; markieren
  F714  B7 80 F6   STAA  $80F6          ; speichern
  F717  20 05      BRA   loc_F71E       ; weiter

loc_F719:
  F719  84 BF      ANDA  #$BF           ; „Zeit zu senden“ löschen
  F71B  B7 80 F7   STAA  $80F7          ; speichern

loc_F71E:
  F71E  71 EF 11   AIM   #$EF,TRCSR1    ; Empfangsinterrupt ausschalten

loc_F721:
  F721  96 11      LDAA  TRCSR1         ; Status lesen
  F723  96 12      LDAA  RDR            ; Byte verwerfen

loc_F725:
  F725  3B         RTI                  ; verlassen

