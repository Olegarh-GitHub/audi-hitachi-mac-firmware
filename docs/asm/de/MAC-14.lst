;------------------------------------------------------------------------------
; ZÜNDUNG: Betriebsartwahl. $8088.2 = Drosselklappe geschlossen (Kopie von F60).
; Start — fester Zündwinkel C6CB (E081). Drosselklappe offen — Kennfeld (DFC6).
; Leerlauf — Zündwinkel nach Höhe und Temperatur ($800F, Tabelle C2D0) + DLS.
;------------------------------------------------------------------------------
loc_DEA8:
  DEA8  BD D2 15   JSR   RD_INPUTS      ; Digitaleingänge
  DEAB  CE 80 00   LDX   #$8000         ; X = $8000
  DEAE  85 20      BITA  #$20           ; F60 geschlossen?
  DEB0  27 05      BEQ   loc_DEB7       ; nein
  DEB2  62 04 88   OIM   #$04,$88,X     ; $8088.2 = 1
  DEB5  20 03      BRA   loc_DEBA       ; weiter

loc_DEB7:
