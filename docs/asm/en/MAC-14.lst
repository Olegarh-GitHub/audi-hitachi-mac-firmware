;------------------------------------------------------------------------------
; Factory patch: $8214 is the multiplier for lambda jumps and steps (/256).
; With rpm below C84A = 120 units and pressure below C84B = 140 it is 255 (full steps);
; otherwise it decreases by 5 (C84D) per call down to 64 (C84C), so steps are 4 times smaller
; at high rpm and load.
;------------------------------------------------------------------------------
loc_FA00:
  FA00  CE 80 00   LDX   #$8000         ; X = $8000
  FA03  86 FF      LDAA  #$FF           ; 255
  FA05  E6 18      LDAB  $18,X          ; rpm
  FA07  F1 C8 4A   CMPB  $C84A          ; 120 and above?
  FA0A  24 0F      BCC   loc_FA1B       ; yes - decrease
  FA0C  E6 19      LDAB  $19,X          ; pressure
  FA0E  6B 72 91   TIM   #$72,$91,X     ; G71 faults?
  FA11  27 03      BEQ   loc_FA16       ; no
  FA13  F6 C7 9E   LDAB  $C79E          ; substitute value

loc_FA16:
  FA16  F1 C8 4B   CMPB  $C84B          ; 140 and above?
  FA19  25 0E      BCS   loc_FA29       ; no - 255

loc_FA1B:
  FA1B  B6 82 14   LDAA  $8214          ; multiplier
  FA1E  B0 C8 4D   SUBA  $C84D          ; - 5
  FA21  B1 C8 4C   CMPA  $C84C          ; not below 64?
  FA24  24 03      BCC   loc_FA29       ; yes
  FA26  B6 C8 4C   LDAA  $C84C          ; 64

loc_FA29:
