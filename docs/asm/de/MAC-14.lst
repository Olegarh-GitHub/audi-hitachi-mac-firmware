  F736  A7 A4      STAA  $A4,X          ; Timer
  F738  E7 AF      STAB  $AF,X          ; Testschritt
  F73A  ED AA      STD   $AA,X          ; N17-Zähler
  F73C  ED AC      STD   $AC,X          ; Phasentimer, Testteiler
  F73E  E7 AE      STAB  $AE,X          ; Schließzeit Kontakt 5

loc_F740:
  F740  38         PULX                 ; X zurückholen
  F741  39         RTS                  ; Rücksprung

