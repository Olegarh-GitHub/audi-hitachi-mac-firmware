;------------------------------------------------------------------------------
; Patch: while a code is being output by blinks ($80A9.3), the SCI transmitter
; is off and P24 (TX, pin 28) is held at 0. Otherwise the transmitter is switched on.
; Apparently the K-line also shows the code at that time [assumed].
;------------------------------------------------------------------------------
loc_F8B0:
  F8B0  6B 08 A9   TIM   #$08,$A9,X     ; code output in progress?
  F8B3  27 08      BEQ   loc_F8BD       ; no
  F8B5  71 FD 11   AIM   #$FD,TRCSR1    ; switch off the SCI transmitter
  F8B8  71 EF 03   AIM   #$EF,PORT2     ; P24 = 0
  F8BB  20 0B      BRA   loc_F8C8       ; continue

loc_F8BD:
