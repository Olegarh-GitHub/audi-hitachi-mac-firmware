; table $C8C0, 80 bytes: knock thresholds f, 5 cylinders × 16
  C8C0  db 90 90 90 90 90 90 A0 98 78 70 62 5A 60 68 60 60
  C8D0  db 90 90 90 90 90 88 88 78 70 64 60 50 60 68 68 68
  C8E0  db 90 90 90 90 90 88 88 70 6A 68 64 60 60 68 6B 6B
  C8F0  db 90 90 90 90 90 88 80 78 70 68 58 50 58 5A 5A 60
  C900  db 90 90 90 90 90 88 80 70 68 64 54 53 50 50 54 60

; table $C910, 5 bytes: knock sensor by cylinder number (0 = G61, FF = G66)
  C910  db 00 FF FF FF 00

; table $C915, 3 bytes: knock: background step (2 bytes), smoothing weight
  C915  db 00 80 80

; table $C918, 8 bytes: voltage axis for coil dwell
  C918  db 50 5A 64 6E 78 8C A0 C8

; table $C920, 8 bytes: coil dwell time T
  C920  db 5A 46 37 2E 28 20 1B 13

; table $C928, 48 bytes: fault BLINK CODES (24 codes, bit order $8000.7 … $8002.0)
  C928  db 11 11 21 11 21 12 21 13 21 13 22 22 22 22 22 21
  C938  db 21 42 21 44 21 41 21 43 21 23 21 21 21 21 23 22
  C948  db 23 22 23 12 23 12 23 42 22 14 22 24 44 44 00 00

; table $C958, 14 bytes: actuator test BLINK CODES: 4433 4441 4442 4443 4343 4331 0000
  C958  db 44 33 44 41 44 42 44 43 43 43 43 31 00 00

; table $C966, 72 bytes: fault codes for the K-line: 24 × (VAG number, flag)
  C966  db FF FF 00 02 01 03 02 02 03 02 03 01 02 03 02 02
  C976  db 07 10 02 07 10 02 07 03 02 0C 03 02 1C 03 02 17
  C986  db 04 02 18 04 02 05 01 02 04 01 02 04 05 02 0B 01
  C996  db 02 0B 02 02 0A 02 02 0A 01 02 0D 03 02 1F 00 02
  C9A6  db 20 08 FF FF 88 02 FF FF

; table $C9AE, 21 bytes: actuator numbers for the K-line: 01259 01261 01262 01263 01247 01241 00767
  C9AE  db 04 EB FF 04 ED FF 04 EE FF 04 EF FF 04 DF FF 04
  C9BE  db D9 FF 02 FF FF

; table $C9C3, 66 bytes: identification (ASCII): "447905383L ", "Motor      ", "PMC AT/CAL.", "PMC AT/BUND", "PMC HS/CAL.", "PMC HS/BUND"
  C9C3  db 34 34 37 39 30 35 33 38 33 4C 20 4D 6F 74 6F 72
  C9D3  db 20 20 20 20 20 20 50 4D 43 20 41 54 2F 43 41 4C
  C9E3  db 2E 50 4D 43 20 41 54 2F 42 55 4E 44 50 4D 43 20
  C9F3  db 48 53 2F 43 41 4C 2E 50 4D 43 20 48 53 2F 42 55
  CA03  db 4E 44

;------------------------------------------------------------------------------
; FRAC_UP: fraction between two points of an ascending axis.
; Input: A = value, X -> left axis point (result of AXIS_UP).
; Output: B = (A - axis[i]) * 256 / (axis[i+1] - axis[i]), i.e. 0...255.
;------------------------------------------------------------------------------
FRAC_UP:                                ; called from: TASK1, TASK2, TASK3
  CA05  5F         CLRB                 ; B = 0 in case of an exact hit
  CA06  A0 00      SUBA  $00,X          ; A = value minus left point
  CA08  27 36      BEQ   loc_CA40       ; exactly on the point? yes: fraction 0
  CA0A  E6 01      LDAB  $01,X          ; B = interval width
  CA0C  E0 00      SUBB  $00,X
  CA0E  20 0B      BRA   DIV8           ; divide

;------------------------------------------------------------------------------
; FRAC_DN: the same for a descending axis (axis[i] > axis[i+1]).
;------------------------------------------------------------------------------
FRAC_DN:                                ; called from: TASK0, TASK1, TASK2, TASK3
  CA10  5F         CLRB                 ; B = 0 in case of an exact hit
  CA11  A0 00      SUBA  $00,X          ; A = left point minus value
  CA13  40         NEGA
  CA14  27 2A      BEQ   loc_CA40       ; exactly on the point? yes: fraction 0
  CA16  E6 01      LDAB  $01,X          ; B = interval width (positive)
  CA18  E0 00      SUBB  $00,X
  CA1A  50         NEGB

;------------------------------------------------------------------------------
; DIV8: fractional division: B = A * 256 / B. Condition: A < B.
; Ordinary long division, 8 steps. Quotient bits are accumulated
; inverted and flipped at the end (COMB).
;------------------------------------------------------------------------------
DIV8:                                   ; called from: TASK0, TASK1, TASK2, TASK3
  CA1B  37         PSHB                 ; push divisor
  CA1C  36         PSHA                 ; push dividend
  CA1D  34         DES                  ; room for the step counter
  CA1E  30         TSX
  CA1F  86 08      LDAA  #$08           ; 8 steps
  CA21  A7 00      STAA  $00,X          ; counter
  CA23  A6 01      LDAA  $01,X          ; A = dividend (remainder)
  CA25  C6 FF      LDAB  #$FF           ; quotient: initial value FF (bits inverted)
  CA27  E7 01      STAB  $01,X          ; save
  CA29  5F         CLRB                 ; B is the high part of the remainder

loc_CA2A:
  CA2A  48         ASLA                 ; shift remainder left
  CA2B  59         ROLB                 ; carry into B
  CA2C  A0 02      SUBA  $02,X          ; subtract divisor
  CA2E  C2 00      SBCB  #$00           ; account for borrow
  CA30  24 04      BCC   loc_CA36       ; not negative? yes: quotient bit 1 (written as 0 here because it is inverted)
  CA32  AB 02      ADDA  $02,X          ; went negative: add the divisor back
  CA34  C9 00      ADCB  #$00           ; carry = 1 (quotient bit 0, written inverted)

loc_CA36:
  CA36  69 01      ROL   $01,X          ; quotient bit into the result
  CA38  6A 00      DEC   $00,X          ; next step
  CA3A  26 EE      BNE   loc_CA2A       ; steps left? yes: repeat
  CA3C  32         PULA                 ; pop counter
  CA3D  33         PULB                 ; B = inverted quotient
  CA3E  31         INS                  ; drop divisor
  CA3F  53         COMB                 ; B = quotient (fraction 0...255)

loc_CA40:
  CA40  39         RTS                  ; return

;------------------------------------------------------------------------------
; INTERP: linear interpolation between two adjacent table values.
; Input: X -> table[i], B = fraction (0...255).
; Output: A = t[i] + (t[i+1] - t[i]) * fraction / 256, rounded.
;------------------------------------------------------------------------------
INTERP:                                 ; called from: TASK0, TASK1, TASK2, TASK3
  CA41  A6 00      LDAA  $00,X          ; t[i]
  CA43  36         PSHA                 ; push
  CA44  A6 01      LDAA  $01,X          ; t[i+1]
  CA46  36         PSHA                 ; push
  CA47  30         TSX                  ; X -> t[i+1] on the stack, followed by t[i]
  CA48  A6 00      LDAA  $00,X          ; A = t[i+1]; the sign will take its place
  CA4A  6F 00      CLR   $00,X          ; sign = 0 (rising)
  CA4C  A0 01      SUBA  $01,X          ; A = t[i+1] - t[i]
  CA4E  24 03      BCC   loc_CA53       ; table rising? yes: the difference is already positive
  CA50  40         NEGA                 ; falling: absolute value of the difference
  CA51  63 00      COM   $00,X          ; sign = FF (falling)

loc_CA53:
  CA53  3D         MUL                  ; difference * fraction
  CA54  58         ASLB                 ; rounding: top bit of the low byte
  CA55  89 00      ADCA  #$00           ; add it
  CA57  33         PULB                 ; B = sign
  CA58  5D         TSTB                 ; table rising?
  CA59  27 01      BEQ   loc_CA5C       ; yes: add
  CA5B  40         NEGA                 ; no: subtract

loc_CA5C:
  CA5C  33         PULB                 ; B = t[i]
  CA5D  1B         ABA                  ; A = t[i] + correction
  CA5E  39         RTS                  ; return

;------------------------------------------------------------------------------
; AXIS_UP: find the interval on an ascending axis.
; Input: A = value, X -> axis, B = number of points.
; Output: X -> left point of the interval, B = its index, A = value.
; Below the first point: index 0 and A = first point (fraction will be 0).
; Above the last: last point and A = its value.
;------------------------------------------------------------------------------
AXIS_UP:                                ; called from: TASK0, TASK1, TASK2, TASK3
  CA5F  36         PSHA                 ; save value
  CA60  37         PSHB                 ; save number of points

loc_CA61:
  CA61  A1 00      CMPA  $00,X          ; value below this point?
  CA63  25 17      BCS   loc_CA7C       ; yes: interval found
  CA65  08         INX                  ; next point
  CA66  5A         DECB                 ; points left?
  CA67  27 0C      BEQ   loc_CA75       ; no: past the end of the axis
  CA69  20 F6      BRA   loc_CA61       ; to the next one

;------------------------------------------------------------------------------
; AXIS_DN: the same for a descending axis (for example, temperature from the ADC:
; the colder, the larger the number).
;------------------------------------------------------------------------------
AXIS_DN:                                ; called from: TASK0, TASK1, TASK2, TASK3
  CA6B  36         PSHA                 ; save value
  CA6C  37         PSHB                 ; save number of points

loc_CA6D:
  CA6D  A1 00      CMPA  $00,X          ; value above this point?
  CA6F  22 0B      BHI   loc_CA7C       ; yes: interval found
  CA71  08         INX                  ; next point
  CA72  5A         DECB                 ; points left?
  CA73  26 F8      BNE   loc_CA6D       ; yes: continue

loc_CA75:
  CA75  33         PULB                 ; past the end: B = number of points
  CA76  32         PULA                 ; A = value
  CA77  5A         DECB                 ; index of the last point
  CA78  09         DEX                  ; X -> last point

loc_CA79:
  CA79  A6 00      LDAA  $00,X          ; A = point value (fraction will be 0)
  CA7B  39         RTS                  ; return

loc_CA7C:
  CA7C  32         PULA                 ; A = number of points
  CA7D  10         SBA                  ; A = index of the point found
  CA7E  16         TAB                  ; into B
  CA7F  27 04      BEQ   loc_CA85       ; is this the first point (value before the start of the axis)?
  CA81  5A         DECB                 ; no: left point = previous one
  CA82  09         DEX                  ; X -> left point
  CA83  32         PULA                 ; A = value
  CA84  39         RTS                  ; return

loc_CA85:
  CA85  32         PULA                 ; pop value; A = first point
  CA86  20 F1      BRA   loc_CA79       ; to the common exit

;------------------------------------------------------------------------------
; RESET. Stack $8290. A full reset checks RAM from $8000; a restart after
; engine stop (D12A) checks from $8005 to keep the codes ($8000-$8002) and
; atmospheric pressure ($8004).
; CPU registers: RMCR = $06 (SCI speed [?]), RP5CR = $C1 (internal RAM,
; IRQ1), TRCSR1 = $1A (receive, transmit, receive interrupt), TCSR1 = $18 (capture
; and compare 1 interrupts [assumed]), TCSR2 = $09 (output OC1 = N7 [assumed]), PORT2 = $20,
; PORT6 = $20 (N17 closed, pump off), P2DDR = $02 (P21-P27 outputs),
; P6DDR = $F9 (P62, P61 are inputs: coding, Hall).
;------------------------------------------------------------------------------
RESET:                                  ; called from: IRQ1, RES, SWI, TRAP
  CA88  8E 82 90   LDS   #$8290         ; stack
  CA8B  CE 80 00   LDX   #$8000         ; RAM check from $8000

loc_CA8E:
  CA8E  86 06      LDAA  #$06           ; RMCR
  CA90  97 10      STAA  RMCR           ; SCI speed
  CA92  86 C1      LDAA  #$C1           ; RP5CR = $C1
  CA94  D6 14      LDAB  RP5CR          ; old value (bit 7 = RAM power was kept)
  CA96  97 14      STAA  RP5CR          ; store
  CA98  86 1A      LDAA  #$1A           ; SCI: receive, transmit, receive interrupt
  CA9A  97 11      STAA  TRCSR1         ; store
  CA9C  86 18      LDAA  #$18           ; timer 1
  CA9E  97 08      STAA  TCSR1          ; store
  CAA0  86 09      LDAA  #$09           ; timer 1, part 2
  CAA2  97 0F      STAA  TCSR2          ; store
  CAA4  86 20      LDAA  #$20           ; PORT2.5 = 1
  CAA6  97 03      STAA  PORT2          ; store
  CAA8  86 20      LDAA  #$20           ; PORT6.5 = 1 (N17 closed), PORT6.6 = 0 (pump off)
  CAAA  97 17      STAA  PORT6          ; store
  CAAC  86 02      LDAA  #$02           ; P21-P27 are outputs
  CAAE  97 01      STAA  P2DDR          ; store
  CAB0  86 F9      LDAA  #$F9           ; P60, P63-P67 are outputs
  CAB2  97 16      STAA  P6DDR          ; store
  CAB4  3C         PSHX                 ; start of RAM check
  CAB5  37         PSHB                 ; old RP5CR
  CAB6  CE CB 91   LDX   #$CB91         ; chip setup table CB91 (number/value pairs)

loc_CAB9:
  CAB9  EC 00      LDD   $00,X          ; pair
  CABB  FD 01 00   STD   $0100          ; write to the chip
  CABE  08         INX                  ; next
  CABF  08         INX                  ; (+2)
  CAC0  8C CB B1   CPX   #$CBB1         ; all 16?
  CAC3  26 F4      BNE   loc_CAB9       ; no
  CAC5  33         PULB                 ; old RP5CR
  CAC6  5D         TSTB                 ; internal RAM power kept?
  CAC7  2A 43      BPL   loc_CB0C       ; no - fault copy is unreliable
  CAC9  CE 00 41   LDX   #$0041         ; fault copy
  CACC  4F         CLRA                 ; checksum = 0

loc_CACD:
  CACD  AB 00      ADDA  $00,X          ; + byte
  CACF  08         INX                  ; next
  CAD0  8C 00 46   CPX   #$0046         ; up to $45
  CAD3  26 F8      BNE   loc_CACD       ; repeat
  CAD5  91 40      CMPA  $40            ; checksum correct?
  CAD7  26 33      BNE   loc_CB0C       ; no
  CAD9  38         PULX                 ; start
  CADA  CC 55 AA   LDD   #$55AA         ; patterns $55 and $AA

loc_CADD:
  CADD  A7 00      STAA  $00,X          ; write $55
  CADF  A1 00      CMPA  $00,X          ; read back?
  CAE1  26 4B      BNE   loc_CB2E       ; no - RAM faulty
  CAE3  E7 00      STAB  $00,X          ; write $AA
  CAE5  E1 00      CMPB  $00,X          ; read back?
  CAE7  26 45      BNE   loc_CB2E       ; no - RAM faulty
  CAE9  6F 00      CLR   $00,X          ; clear
  CAEB  08         INX                  ; next
  CAEC  8C 82 91   CPX   #$8291         ; up to $8290
  CAEF  25 EC      BCS   loc_CADD       ; repeat
  CAF1  96 41      LDAA  $41            ; restore codes from the copy
  CAF3  B7 80 00   STAA  $8000          ; (same)
  CAF6  96 42      LDAA  $42            ; (same)
  CAF8  B7 80 01   STAA  $8001          ; (same)
  CAFB  96 43      LDAA  $43            ; (same)
  CAFD  B7 80 02   STAA  $8002          ; (same)
  CB00  96 44      LDAA  $44            ; start counter
  CB02  B7 80 2B   STAA  $802B          ; (same)
  CB05  96 45      LDAA  $45            ; $802C
  CB07  B7 80 2C   STAA  $802C          ; (same)
  CB0A  20 1D      BRA   loc_CB29       ; check internal RAM

loc_CB0C:
  CB0C  38         PULX                 ; start
  CB0D  CC 55 AA   LDD   #$55AA         ; patterns

loc_CB10:
  CB10  A7 00      STAA  $00,X          ; write $55
  CB12  A1 00      CMPA  $00,X          ; read back?
  CB14  26 18      BNE   loc_CB2E       ; no - faulty
  CB16  E7 00      STAB  $00,X          ; write $AA
  CB18  E1 00      CMPB  $00,X          ; read back?
  CB1A  26 12      BNE   loc_CB2E       ; no - faulty
  CB1C  6F 00      CLR   $00,X          ; clear
  CB1E  08         INX                  ; next
  CB1F  8C 01 00   CPX   #$0100         ; end of internal RAM ($0100)?
  CB22  27 0F      BEQ   loc_CB33       ; yes - done
  CB24  8C 82 91   CPX   #$8291         ; end of external RAM?
  CB27  25 E7      BCS   loc_CB10       ; no

loc_CB29:
  CB29  CE 00 40   LDX   #$0040         ; continue with internal $40-$FF
  CB2C  20 E2      BRA   loc_CB10       ; check

loc_CB2E:
  CB2E  86 80      LDAA  #$80           ; RAM faulty: ECU fault (1111)
  CB30  B7 80 95   STAA  $8095          ; store

loc_CB33:
  CB33  71 BF 14   AIM   #$BF,RP5CR     ; disable internal RAM
  CB36  86 A8      LDAA  #$A8           ; mode: start ($A8)
  CB38  B7 80 29   STAA  $8029          ; store
  CB3B  B6 C6 CB   LDAA  $C6CB          ; start angle 50
  CB3E  C6 C0      LDAB  #$C0           ; × 0.75
  CB40  3D         MUL                  ; (same)
  CB41  58         ASLB                 ; round
  CB42  89 00      ADCA  #$00           ; (same)
  CB44  B7 80 23   STAA  $8023          ; output angle
  CB47  86 FF      LDAA  #$FF           ; K-line timeout not running
  CB49  B7 80 FD   STAA  $80FD          ; store
  CB4C  86 6C      LDAA  #$6C           ; angle limit 108
  CB4E  B7 80 8E   STAA  $808E          ; store
  CB51  86 08      LDAA  #$08           ; gain 8
  CB53  B7 08 00   STAA  $0800          ; amplifier latch
  CB56  CC 5F 00   LDD   #$5F00         ; middle
  CB59  FD 80 59   STD   $8059          ; lambda integrator
  CB5C  CE 01 00   LDX   #$0100         ; chip
  CB5F  86 1F      LDAA  #$1F           ; status register $1F
  CB61  A7 00      STAA  $00,X          ; select

loc_CB63:
  CB63  E6 01      LDAB  $01,X          ; status
  CB65  C5 20      BITB  #$20           ; chip ready (bit 5)?
  CB67  27 FA      BEQ   loc_CB63       ; no - wait
  CB69  CC 1D A0   LDD   #$1DA0         ; event mask: cylinder and tick
  CB6C  F7 80 05   STAB  $8005          ; locally
  CB6F  ED 00      STD   $00,X          ; store
  CB71  CC 1C 25   LDD   #$1C25         ; chip mode $25 (synchronisation search)
  CB74  ED 00      STD   $00,X          ; store
  CB76  CC 1E FF   LDD   #$1EFF         ; clear all events
  CB79  ED 00      STD   $00,X          ; store
  CB7B  0E         CLI                  ; enable interrupts

;------------------------------------------------------------------------------
; BACKGROUND LOOP: all the time not taken by interrupts is spent on the ROM checksum.
; The sum of all bytes $C000-$FFFF (8 bit) must be 0, otherwise ECU fault 1111
; ($8095.6). Any firmware modification must preserve this sum.
;------------------------------------------------------------------------------
BG_LOOP:
  CB7C  CE C0 00   LDX   #$C000         ; start of ROM
  CB7F  4F         CLRA                 ; checksum = 0

loc_CB80:
  CB80  AB 00      ADDA  $00,X          ; + byte
  CB82  08         INX                  ; next
  CB83  26 FB      BNE   loc_CB80       ; up to $FFFF
  CB85  4D         TSTA                 ; checksum 0?
  CB86  27 F4      BEQ   BG_LOOP        ; yes - start over
  CB88  CE 80 00   LDX   #$8000         ; X = $8000
  CB8B  62 40 95   OIM   #$40,$95,X     ; ROM fault (1111)
  CB8E  20 EC      BRA   BG_LOOP        ; start over

; table $CB90, 1 bytes: byte $0A without references, probably balances the ROM checksum to 0 [assumed]
  CB90  db 0A

; table $CB91, 32 bytes: chip setup $0100 (number, value): 00 FF, 01 6C (108 half-teeth = 144°), 02 2D, 03 1B, 05 00, 06 05, 07 06, 08 03, 09 FF, 0A FF, 0B 00, 0C 33, 0D 76, 18 04, 19 00, 1F 00
  CB91  db 00 FF 01 6C 02 2D 03 1B 05 00 06 05 07 06 08 03
  CBA1  db 09 FF 0A FF 0B 00 0C 33 0D 76 18 04 19 00 1F 00

;------------------------------------------------------------------------------
; IRQ1 — INTERRUPT FROM CHIP $0100. Chip register $1E shows which events arrived
; (masked with $8005). Writing a bit back to $1E clears the event.
;  bit 7 — cylinder event (every 144° of crankshaft): synchronisation, spark (CC83);
;  bit 6 — knock window: opening/closing, measurement (CBDB);
;  bit 2 — coil dwell start point (CC74);
;  bit 5 — tick (≈10 ms) -> D0E3 and the task dispatcher.
;  bit 1 (inside the cylinder event) — G4 reference mark.
;------------------------------------------------------------------------------
IRQ1:                                   ; called from: IRQ1
  CBB1  CE 01 00   LDX   #$0100         ; X -> chip
  CBB4  86 1E      LDAA  #$1E           ; event register $1E
  CBB6  A7 00      STAA  $00,X          ; select
  CBB8  E6 01      LDAB  $01,X          ; events
  CBBA  F4 80 05   ANDB  $8005          ; enabled ones only ($8005)
  CBBD  5D         TSTB                 ; cylinder event (bit 7)?
  CBBE  2A 03      BPL   loc_CBC3       ; no
  CBC0  7E CC 83   JMP   loc_CC83       ; yes — cylinder

loc_CBC3:
  CBC3  C5 40      BITB  #$40           ; knock window?
  CBC5  26 14      BNE   loc_CBDB       ; yes
  CBC7  C5 04      BITB  #$04           ; coil dwell?
  CBC9  27 03      BEQ   loc_CBCE       ; no
  CBCB  7E CC 74   JMP   loc_CC74       ; yes

loc_CBCE:
  CBCE  C5 20      BITB  #$20           ; tick?
  CBD0  26 01      BNE   loc_CBD3       ; yes
  CBD2  3B         RTI                  ; nothing — exit

loc_CBD3:
  CBD3  C6 20      LDAB  #$20           ; clear tick event
  CBD5  E7 01      STAB  $01,X          ; write
  CBD7  0E         CLI                  ; allow nested interrupts
  CBD8  7E D0 E3   JMP   loc_D0E3       ; tick handling

;------------------------------------------------------------------------------
; KNOCK WINDOW. Two passes: opening the window ($80B5.7 = 1) and closing it.
; Closing: PORT6.0 = 0, window end = start + $80B8, PORT6.3 = 0 (tachometer pulse,
; pin 7 [assumed]). Opening: start ADC channel 6 (integrator), measurement = $80EC - result
; -> cylinder record +2, new measurement (+0 bit 7), gain of the next cylinder into
; latch $0800 (bit 4 — sensor G66, from table C910). With command $1B the tester can
; set its own latch value ($8205).
;------------------------------------------------------------------------------
loc_CBDB:
  CBDB  C6 40      LDAB  #$40           ; clear event
  CBDD  E7 01      STAB  $01,X          ; write
  CBDF  B6 80 B5   LDAA  $80B5          ; window phase
  CBE2  85 80      BITA  #$80           ; window open?
  CBE4  27 1C      BEQ   loc_CC02       ; no — open it
  CBE6  71 FE 17   AIM   #$FE,PORT6     ; PORT6.0 = 0 (stop integrator [assumed])
  CBE9  84 7F      ANDA  #$7F           ; phase: closed
  CBEB  B7 80 B5   STAA  $80B5          ; write
  CBEE  86 00      LDAA  #$00           ; register $00 — time of the next window event
  CBF0  F6 80 B8   LDAB  $80B8          ; window start
  CBF3  FB 80 B9   ADDB  $80B9          ; + window length
  CBF6  ED 00      STD   $00,X          ; write
  CBF8  B6 80 96   LDAA  $8096          ; cylinder
  CBFB  B7 80 BC   STAA  $80BC          ; remember whose measurement it is
  CBFE  71 F7 17   AIM   #$F7,PORT6     ; PORT6.3 = 0: tachometer (pin 7) [assumed]
  CC01  3B         RTI                  ; exit

loc_CC02:
  CC02  CE 14 06   LDX   #$1406         ; ADC channel 6
  CC05  FF 01 00   STX   $0100          ; start
  CC08  7F 80 2A   CLR   $802A          ; ADC taken by the interrupt (task 0 will repeat its own conversion)
  CC0B  F6 80 BC   LDAB  $80BC          ; measured cylinder
  CC0E  58         ASLB                 ; × 8
  CC0F  58         ASLB                 ; (same)
  CC10  58         ASLB                 ; (same)
  CC11  CE 80 C0   LDX   #$80C0         ; cylinder records
  CC14  3A         ABX                  ; X -> record
  CC15  E6 07      LDAB  $07,X          ; new gain
  CC17  E7 01      STAB  $01,X          ; became current
  CC19  62 80 00   OIM   #$80,$00,X     ; new measurement ready
  CC1C  3C         PSHX                 ; save X
  CC1D  CE 01 00   LDX   #$0100         ; X -> chip
  CC20  86 00      LDAA  #$00           ; register $00
  CC22  F6 80 B7   LDAB  $80B7          ; window start $80B7
  CC25  F7 80 B9   STAB  $80B9          ; remember
  CC28  ED 00      STD   $00,X          ; write
  CC2A  86 14      LDAA  #$14           ; ADC result register
  CC2C  A7 00      STAA  $00,X          ; select
  CC2E  B6 80 EC   LDAA  $80EC          ; reference (measured at cylinder start)
  CC31  B0 01 01   SUBA  $0101          ; - result = measurement
  CC34  72 01 17   OIM   #$01,PORT6     ; PORT6.0 = 1
  CC37  24 01      BCC   loc_CC3A       ; not below zero
  CC39  4F         CLRA                 ; 0

loc_CC3A:
  CC3A  38         PULX                 ; restore X
  CC3B  A7 02      STAA  $02,X          ; +2 = measurement
  CC3D  86 80      LDAA  #$80           ; phase: open
  CC3F  BA 80 B5   ORAA  $80B5          ; set
  CC42  B7 80 B5   STAA  $80B5          ; write
  CC45  F6 80 BC   LDAB  $80BC          ; cylinder
  CC48  5C         INCB                 ; next
  CC49  C1 05      CMPB  #$05           ; 5?
  CC4B  25 01      BCS   loc_CC4E       ; no
  CC4D  5F         CLRB                 ; 0

loc_CC4E:
  CC4E  58         ASLB                 ; × 8
  CC4F  58         ASLB                 ; (same)
  CC50  58         ASLB                 ; (same)
  CC51  CE 80 C0   LDX   #$80C0         ; records
  CC54  3A         ABX                  ; X -> record of next cylinder
  CC55  A6 07      LDAA  $07,X          ; its gain
  CC57  F6 80 F7   LDAB  $80F7          ; tester mode $1B?
  CC5A  C5 01      BITB  #$01           ; check
  CC5C  27 03      BEQ   loc_CC61       ; no
  CC5E  B6 82 05   LDAA  $8205          ; value from tester

loc_CC61:
  CC61  84 EF      ANDA  #$EF           ; clear bit 4
  CC63  CE C9 10   LDX   #$C910         ; sensor table C910
  CC66  F6 80 BC   LDAB  $80BC          ; cylinder
  CC69  3A         ABX                  ; X -> value
  CC6A  E6 00      LDAB  $00,X          ; sensor
  CC6C  27 02      BEQ   loc_CC70       ; G61 — bit 4 = 0
  CC6E  8A 10      ORAA  #$10           ; G66 — bit 4 = 1

loc_CC70:
  CC70  B7 08 00   STAA  $0800          ; amplifier latch $0800
  CC73  3B         RTI                  ; exit

;------------------------------------------------------------------------------
; Coil dwell start: register $03 = $8024 + $8056 (correction for the difference in
; retard between adjacent cylinders, so that the dwell time stays the same).
;------------------------------------------------------------------------------
loc_CC74:
  CC74  C6 04      LDAB  #$04           ; clear event
  CC76  E7 01      STAB  $01,X          ; write
  CC78  86 03      LDAA  #$03           ; register $03
  CC7A  F6 80 24   LDAB  $8024          ; dwell start
  CC7D  FB 80 56   ADDB  $8056          ; + correction
  CC80  ED 00      STD   $00,X          ; write
  CC82  3B         RTI                  ; exit

;------------------------------------------------------------------------------
; CYLINDER EVENT. Before synchronisation — search: G4 mark with Hall signal low
; (PORT6.1 = 0) means the first cylinder is on its compression stroke, synchronisation achieved.
; 11 events without a mark — G4 fault (2112). 4 marks with Hall signal high — Hall
; sender fault (2113). After synchronisation — CD9C.
;------------------------------------------------------------------------------
loc_CC83:
  CC83  C6 80      LDAB  #$80           ; clear event
  CC85  E7 01      STAB  $01,X          ; write
  CC87  96 17      LDAA  PORT6          ; port 6 (Hall — bit 1)
  CC89  C6 20      LDAB  #$20           ; synchronised?
  CC8B  F5 80 95   BITB  $8095          ; check
  CC8E  27 03      BEQ   loc_CC93       ; no
  CC90  7E CD 9C   JMP   loc_CD9C       ; yes

loc_CC93:
  CC93  72 01 17   OIM   #$01,PORT6     ; PORT6.0 = 1
  CC96  C6 02      LDAB  #$02           ; G4 mark?
  CC98  E5 01      BITB  $01,X          ; check
  CC9A  26 1A      BNE   loc_CCB6       ; yes
  CC9C  F6 80 18   LDAB  $8018          ; engine speed
  CC9F  C0 01      SUBB  #$01           ; zero?
  CCA1  25 35      BCS   loc_CCD8       ; yes — exit
  CCA3  7C 80 96   INC   $8096          ; events without mark + 1
  CCA6  F6 80 96   LDAB  $8096          ; value
  CCA9  C0 0B      SUBB  #$0B           ; 11?
  CCAB  25 2B      BCS   loc_CCD8       ; no — exit
  CCAD  86 30      LDAA  #$30           ; G4 fault (2112)
  CCAF  BA 80 94   ORAA  $8094          ; set
  CCB2  B7 80 94   STAA  $8094          ; write
  CCB5  3B         RTI                  ; exit

loc_CCB6:
  CCB6  E7 01      STAB  $01,X          ; clear mark
  CCB8  7F 80 96   CLR   $8096          ; cylinder counter = 0
  CCBB  F6 80 18   LDAB  $8018          ; engine speed
  CCBE  C0 01      SUBB  #$01           ; zero?
  CCC0  25 16      BCS   loc_CCD8       ; yes — exit
  CCC2  85 02      BITA  #$02           ; Hall high?
  CCC4  27 13      BEQ   loc_CCD9       ; no — synchronisation
  CCC6  7C 80 97   INC   $8097          ; marks with Hall high + 1
  CCC9  F6 80 97   LDAB  $8097          ; value
  CCCC  C0 04      SUBB  #$04           ; 4?
  CCCE  25 08      BCS   loc_CCD8       ; no — exit
  CCD0  86 0C      LDAA  #$0C           ; Hall sender fault (2113)
  CCD2  BA 80 94   ORAA  $8094          ; set
  CCD5  B7 80 94   STAA  $8094          ; write

loc_CCD8:
  CCD8  3B         RTI                  ; exit

loc_CCD9:
  CCD9  86 20      LDAA  #$20           ; SYNCHRONISED ($8095.5)
  CCDB  BA 80 95   ORAA  $8095          ; set
  CCDE  B7 80 95   STAA  $8095          ; write
  CCE1  86 57      LDAA  #$57           ; clear synchronisation suspicions
  CCE3  B4 80 94   ANDA  $8094          ; clear
  CCE6  B7 80 94   STAA  $8094          ; write
  CCE9  72 40 17   OIM   #$40,PORT6     ; PORT6.6 = 1: switch on fuel pump relay J17
  CCEC  5F         CLRB                 ; 0
  CCED  F7 80 96   STAB  $8096          ; cylinder 0
  CCF0  F7 80 97   STAB  $8097          ; Hall counter 0
  CCF3  BD F7 26   JSR   TEST_EXIT      ; leave actuator test
  CCF6  CC 1C 27   LDD   #$1C27         ; chip: register $1C = $27 (per-cylinder mode)
  CCF9  ED 00      STD   $00,X          ; write
  CCFB  CC 1D E4   LDD   #$1DE4         ; register $1D = $E4 (event mask)
  CCFE  F7 80 05   STAB  $8005          ; same mask in own copy
  CD01  ED 00      STD   $00,X          ; write
  CD03  CC 06 32   LDD   #$0632         ; register $06 = $32 [?]
  CD06  ED 00      STD   $00,X          ; write
  CD08  CC 14 06   LDD   #$1406         ; ADC channel 6
  CD0B  ED 00      STD   $00,X          ; start
  CD0D  86 00      LDAA  #$00           ; register $00
  CD0F  F6 80 B7   LDAB  $80B7          ; window start
  CD12  F7 80 B9   STAB  $80B9          ; remember
  CD15  ED 00      STD   $00,X          ; write
  CD17  86 80      LDAA  #$80           ; window open
  CD19  BA 80 B5   ORAA  $80B5          ; set
  CD1C  B7 80 B5   STAA  $80B5          ; write
  CD1F  F6 80 96   LDAB  $8096          ; cylinder
  CD22  58         ASLB                 ; × 8
  CD23  58         ASLB                 ; (same)
  CD24  58         ASLB                 ; (same)
  CD25  CE 80 C0   LDX   #$80C0         ; records
  CD28  3A         ABX                  ; X -> record
  CD29  A6 07      LDAA  $07,X          ; gain
  CD2B  84 EF      ANDA  #$EF           ; clear bit 4
  CD2D  CE C9 10   LDX   #$C910         ; sensor table
  CD30  F6 80 96   LDAB  $8096          ; cylinder
  CD33  3A         ABX                  ; X -> value
  CD34  E6 00      LDAB  $00,X          ; sensor
  CD36  27 02      BEQ   loc_CD3A       ; G61
  CD38  8A 10      ORAA  #$10           ; G66

loc_CD3A:
  CD3A  B7 08 00   STAA  $0800          ; amplifier latch
  CD3D  86 14      LDAA  #$14           ; ADC result register
  CD3F  B7 01 00   STAA  $0100          ; select
  CD42  B6 01 01   LDAA  $0101          ; result
  CD45  B7 80 EC   STAA  $80EC          ; measurement reference

;------------------------------------------------------------------------------
; Count of starts without new faults (once per switch-on, at synchronisation).
; 50 starts ($32) without changes in fault memory — automatic erase
; ($8092.1). If the memory was restored from internal RAM, counting is done
; in the copy ($44) with checksum correction ($40).
;------------------------------------------------------------------------------
  CD48  C6 32      LDAB  #$32           ; threshold 50
  CD4A  CE 80 00   LDX   #$8000         ; X = $8000
  CD4D  7B 40 14   TIM   #$40,RP5CR     ; internal RAM enabled?
  CD50  27 03      BEQ   loc_CD55       ; no
  CD52  62 04 03   OIM   #$04,$03,X     ; mark $8003.2

loc_CD55:
  CD55  6B 08 03   TIM   #$08,$03,X     ; memory restored ($8003.3)?
  CD58  26 0E      BNE   loc_CD68       ; yes — count in the copy
  CD5A  61 7F 2C   AIM   #$7F,$2C,X     ; clear "codes shown"
  CD5D  7C 80 2B   INC   $802B          ; starts + 1
  CD60  B6 80 2B   LDAA  $802B          ; value
  CD63  11         CBA                  ; below 50?
  CD64  25 32      BCS   loc_CD98       ; yes
  CD66  20 25      BRA   loc_CD8D       ; 50 — erase

loc_CD68:
  CD68  72 40 14   OIM   #$40,RP5CR     ; enable internal RAM
  CD6B  7B 80 45   TIM   #$80,$45       ; "codes shown" in the copy?
  CD6E  27 09      BEQ   loc_CD79       ; no
  CD70  71 7F 45   AIM   #$7F,$45       ; clear
  CD73  96 40      LDAA  $40            ; checksum
  CD75  80 80      SUBA  #$80           ; - $80
  CD77  97 40      STAA  $40            ; write

loc_CD79:
  CD79  7C 00 44   INC   $0044          ; starts + 1 (in the copy)
  CD7C  7C 00 40   INC   $0040          ; checksum + 1
  CD7F  96 44      LDAA  $44            ; starts
  CD81  11         CBA                  ; below 50?
  CD82  25 0C      BCS   loc_CD90       ; yes
  CD84  CC 00 00   LDD   #$0000         ; 0
  CD87  97 40      STAA  $40            ; checksum = 0
  CD89  DD 41      STD   $41            ; codes = 0
  CD8B  DD 43      STD   $43            ; starts = 0

loc_CD8D:
  CD8D  62 02 92   OIM   #$02,$92,X     ; erase request

loc_CD90:
  CD90  6B 04 03   TIM   #$04,$03,X     ; was RAM already enabled before?
  CD93  26 03      BNE   loc_CD98       ; yes — leave it
  CD95  71 BF 14   AIM   #$BF,RP5CR     ; disable internal RAM

loc_CD98:
  CD98  61 FB 03   AIM   #$FB,$03,X     ; clear $8003.2
  CD9B  3B         RTI                  ; exit

;------------------------------------------------------------------------------
; After synchronisation: cylinder counter $8096 = 0…4 (firing order), reset at
; the G4 mark when Hall is low. During cranking: Hall low 2 times not on cylinder zero —
; Hall sender fault (2113) and chip emergency mode ($1C = $21, without per-cylinder knock control [assumed]).
;------------------------------------------------------------------------------
loc_CD9C:
  CD9C  C6 02      LDAB  #$02           ; G4 mark?
  CD9E  E5 01      BITB  $01,X          ; check
  CDA0  27 06      BEQ   loc_CDA8       ; no
  CDA2  E7 01      STAB  $01,X          ; clear mark
  CDA4  85 02      BITA  #$02           ; Hall high?
  CDA6  27 08      BEQ   loc_CDB0       ; no — cylinder 0

loc_CDA8:
  CDA8  F6 80 96   LDAB  $8096          ; cylinder
  CDAB  5C         INCB                 ; + 1
  CDAC  C1 05      CMPB  #$05           ; 5?
  CDAE  25 01      BCS   loc_CDB1       ; no

loc_CDB0:
  CDB0  5F         CLRB                 ; 0

loc_CDB1:
  CDB1  F7 80 96   STAB  $8096          ; $8096 = cylinder
  CDB4  C6 80      LDAB  #$80           ; cranking?
  CDB6  F5 80 29   BITB  $8029          ; check
  CDB9  27 24      BEQ   loc_CDDF       ; no
  CDBB  F6 80 96   LDAB  $8096          ; cylinder 0?
  CDBE  27 1C      BEQ   loc_CDDC       ; yes — normal
  CDC0  85 02      BITA  #$02           ; Hall high?
  CDC2  26 18      BNE   loc_CDDC       ; yes — normal
  CDC4  7C 80 97   INC   $8097          ; mismatch + 1
  CDC7  F6 80 97   LDAB  $8097          ; value
  CDCA  C1 02      CMPB  #$02           ; 2?
  CDCC  25 11      BCS   loc_CDDF       ; no
  CDCE  86 03      LDAA  #$03           ; Hall sender fault (2113)
  CDD0  BA 80 94   ORAA  $8094          ; set
  CDD3  B7 80 94   STAA  $8094          ; store
  CDD6  CC 1C 21   LDD   #$1C21         ; chip: register $1C = $21 (emergency mode [assumed])
  CDD9  ED 00      STD   $00,X          ; store
  CDDB  3B         RTI                  ; exit

loc_CDDC:
  CDDC  7F 80 97   CLR   $8097          ; mismatches 0

loc_CDDF:
  CDDF  5F         CLRB                 ; register $14, channel 0
  CDE0  86 14      LDAA  #$14           ; (same)
  CDE2  ED 00      STD   $00,X          ; start pressure ADC conversion (sample at start of cylinder)
  CDE4  F7 80 2A   STAB  $802A          ; ADC busy with interrupt
  CDE7  F7 80 25   STAB  $8025          ; stall counter = 0 (engine is turning)
  CDEA  72 08 17   OIM   #$08,PORT6     ; PORT6.3 = 1: tachometer [assumed]
  CDED  7B 02 17   TIM   #$02,PORT6     ; Hall high?
  CDF0  27 0A      BEQ   loc_CDFC       ; no
  CDF2  B6 80 6E   LDAA  $806E          ; $806E.4?
  CDF5  85 10      BITA  #$10           ; check
  CDF7  27 03      BEQ   loc_CDFC       ; no
  CDF9  72 02 14   OIM   #$02,RP5CR     ; enable IRQ2 [?]

;------------------------------------------------------------------------------
; Smooth change of ignition timing. $8023 — timing actually output; $8022 — target.
; Retard — immediately, up to 3 units (C6DA) per cylinder; advance — by 1 unit (C6D9) once every
; $808B + 1 cylinders. During jerk damping — retard $8080 = $808A, limit $808E.
;------------------------------------------------------------------------------
loc_CDFC:
  CDFC  B6 80 88   LDAA  $8088          ; jerk damping mode started?
  CDFF  85 80      BITA  #$80           ; check
  CE01  27 0C      BEQ   loc_CE0F       ; no
  CE03  F6 80 8A   LDAB  $808A          ; retard
  CE06  F7 80 80   STAB  $8080          ; $8080
  CE09  5F         CLRB                 ; 0
  CE0A  F7 80 7F   STAB  $807F          ; step counter
  CE0D  84 7F      ANDA  #$7F           ; clear "started"

loc_CE0F:
  CE0F  F6 80 23   LDAB  $8023          ; timing
  CE12  FB 80 80   ADDB  $8080          ; + retard
  CE15  F1 80 8E   CMPB  $808E          ; later than limit?
  CE18  23 03      BLS   loc_CE1D       ; no
  CE1A  F6 80 8E   LDAB  $808E          ; limit

loc_CE1D:
  CE1D  F7 80 23   STAB  $8023          ; store
  CE20  F1 C6 CE   CMPB  $C6CE          ; earlier than 45?
  CE23  24 08      BCC   loc_CE2D       ; no
  CE25  84 F7      ANDA  #$F7           ; clear $8088.3: damping finished
  CE27  F6 C6 CE   LDAB  $C6CE          ; limit back to 45
  CE2A  F7 80 8E   STAB  $808E          ; store

loc_CE2D:
  CE2D  5F         CLRB                 ; 0
  CE2E  F7 80 80   STAB  $8080          ; retard = 0
  CE31  B7 80 88   STAA  $8088          ; store $8088
  CE34  B6 80 23   LDAA  $8023          ; output timing
  CE37  16         TAB                  ; copy
  CE38  F0 80 22   SUBB  $8022          ; - target
  CE3B  26 05      BNE   loc_CE42       ; equal?
  CE3D  F7 80 8B   STAB  $808B          ; step = 0
  CE40  20 30      BRA   loc_CE72       ; continue

loc_CE42:
  CE42  2B 21      BMI   loc_CE65       ; target is later — retard quickly
  CE44  F6 80 7F   LDAB  $807F          ; step counter
  CE47  F1 80 8B   CMPB  $808B          ; reached?
  CE4A  24 06      BCC   loc_CE52       ; yes
  CE4C  5C         INCB                 ; + 1
  CE4D  F7 80 7F   STAB  $807F          ; store
  CE50  20 20      BRA   loc_CE72       ; continue

loc_CE52:
  CE52  5F         CLRB                 ; 0
  CE53  F7 80 7F   STAB  $807F          ; store
  CE56  B0 C6 D9   SUBA  $C6D9          ; advance by 1
  CE59  23 05      BLS   loc_CE60       ; overshot?
  CE5B  B1 80 22   CMPA  $8022          ; not earlier than target?
  CE5E  22 0F      BHI   loc_CE6F       ; yes

loc_CE60:
  CE60  B6 80 22   LDAA  $8022          ; target
  CE63  20 0A      BRA   loc_CE6F       ; continue

loc_CE65:
  CE65  BB C6 DA   ADDA  $C6DA          ; retard by 3
  CE68  23 F6      BLS   loc_CE60       ; overshot?
  CE6A  B1 80 22   CMPA  $8022          ; not later than target?
  CE6D  24 F1      BCC   loc_CE60       ; yes — target

loc_CE6F:
  CE6F  B7 80 23   STAA  $8023          ; store output timing

loc_CE72:
  CE72  BB 80 80   ADDA  $8080          ; + damping retard
  CE75  B1 80 8E   CMPA  $808E          ; later than limit?
  CE78  23 03      BLS   loc_CE7D       ; no
  CE7A  B6 80 8E   LDAA  $808E          ; limit

loc_CE7D:
  CE7D  7E F8 70   JMP   loc_F870       ; patch: + retard on sudden throttle opening

loc_CE80:
  CE80  86 14      LDAA  #$14           ; ADC result register
  CE82  A7 00      STAA  $00,X          ; select
  CE84  A6 01      LDAA  $01,X          ; pressure at start of cylinder
  CE86  B7 80 19   STAA  $8019          ; $8019 = pressure
  CE89  86 14      LDAA  #$14           ; register $14
  CE8B  C6 06      LDAB  #$06           ; channel 6
  CE8D  ED 00      STD   $00,X          ; start knock ADC conversion
  CE8F  F6 80 96   LDAB  $8096          ; cylinder

;------------------------------------------------------------------------------
; PER-CYLINDER KNOCK CONTROL RETARD. $802F+N — retard of cylinder N (0…6 units,
; 6 units ≈ 8°). For each cylinder: +5 — hold after knock ($804F, table C230
; by rpm, in events), +10 — decay timer ($804E, C240), +15 — time with retard
; above the "floor" (for E29F), +20 — "floor" (learned minimum retard, 0…4).
; Knock: retard + 2 (C6DB), not more than 6. No knock: after the hold, retard steps down by 1
; to the "floor" every $804E events.
; Sensor faulty under load with a warm engine — retard 6 on all cylinders.
; Control disabled ($8050.7 = 0) or switch to map 2 — all retards 0.
; $8052 — cylinder mask, $8054 — knock per cylinder (bit 0 — episode in progress),
; $8053 — cylinder with the largest retard, $802E — pause of 4 events after knock.
;------------------------------------------------------------------------------
  CE92  4F         CLRA                 ; mask = 0
  CE93  0D         SEC                  ; bit

loc_CE94:
  CE94  46         RORA                 ; shift
  CE95  5A         DECB                 ; cylinder - 1
  CE96  2A FC      BPL   loc_CE94       ; repeat
  CE98  B7 80 52   STAA  $8052          ; $8052 = cylinder mask (cylinder 0 — bit 7)
  CE9B  86 A0      LDAA  #$A0           ; knock sensor fault?
  CE9D  B5 80 B6   BITA  $80B6          ; check
  CEA0  27 49      BEQ   loc_CEEB       ; no
  CEA2  F6 C6 DD   LDAB  $C6DD          ; retard 6
  CEA5  B6 80 50   LDAA  $8050          ; mode
  CEA8  88 60      EORA  #$60           ; invert
  CEAA  85 60      BITA  #$60           ; warm and under load?
  CEAC  27 01      BEQ   loc_CEAF       ; yes — 6

loc_CEAE:
  CEAE  5F         CLRB                 ; retard 0

loc_CEAF:
  CEAF  4F         CLRA                 ; A = 0
  CEB0  CE 00 00   LDX   #$0000         ; X = 0
  CEB3  FF 80 3E   STX   $803E          ; counters to zero
  CEB6  FF 80 40   STX   $8040          ; (same)
  CEB9  FF 80 42   STX   $8042          ; (same)
  CEBC  FF 80 44   STX   $8044          ; (same)
  CEBF  FF 80 46   STX   $8046          ; (same)
  CEC2  FF 80 48   STX   $8048          ; (same)
  CEC5  FF 80 4A   STX   $804A          ; (same)
  CEC8  FF 80 4C   STX   $804C          ; (same)
  CECB  B7 80 2F   STAA  $802F          ; all retards = B
  CECE  B7 80 30   STAA  $8030          ; (same)
  CED1  B7 80 31   STAA  $8031          ; (same)
  CED4  B7 80 32   STAA  $8032          ; (same)
  CED7  B7 80 33   STAA  $8033          ; (same)
  CEDA  B7 80 2E   STAA  $802E          ; pause = 0
  CEDD  86 06      LDAA  #$06           ; keep bits 2, 1
  CEDF  B4 80 54   ANDA  $8054          ; clear knock
  CEE2  B7 80 54   STAA  $8054          ; store
  CEE5  B6 80 2E   LDAA  $802E          ; A = 0
  CEE8  7E D0 4A   JMP   loc_D04A       ; to spark

loc_CEEB:
  CEEB  B6 80 51   LDAA  $8051          ; flags
  CEEE  85 20      BITA  #$20           ; switch to map 2 ($8051.5)?
  CEF0  27 0B      BEQ   loc_CEFD       ; no
  CEF2  85 10      BITA  #$10           ; already zeroed?
  CEF4  26 07      BNE   loc_CEFD       ; yes
  CEF6  8A 10      ORAA  #$10           ; mark
  CEF8  B7 80 51   STAA  $8051          ; store
  CEFB  20 B1      BRA   loc_CEAE       ; all retards 0

loc_CEFD:
  CEFD  F6 80 50   LDAB  $8050          ; mode
  CF00  2A AC      BPL   loc_CEAE       ; control disabled — all 0
  CF02  C5 10      BITB  #$10           ; voltage normal?
  CF04  26 19      BNE   loc_CF1F       ; yes
  CF06  CE 80 2F   LDX   #$802F         ; no: do not change retard
  CF09  F6 80 96   LDAB  $8096          ; cylinder
  CF0C  3A         ABX                  ; X -> retard
  CF0D  B6 80 52   LDAA  $8052          ; mask
  CF10  7E D0 1E   JMP   loc_D01E       ; to spark

;------------------------------------------------------------------------------
; KNOCK_PTR — X -> retard of the cylinder given by mask B (bit 7 — cylinder 0).
;------------------------------------------------------------------------------
KNOCK_PTR:                              ; called from: IRQ1
  CF13  CE 80 2F   LDX   #$802F         ; retards

loc_CF16:
  CF16  C5 80      BITB  #$80           ; this bit?
  CF18  26 04      BNE   loc_CF1E       ; yes
  CF1A  08         INX                  ; next cylinder
  CF1B  58         ASLB                 ; next bit
  CF1C  20 F8      BRA   loc_CF16       ; repeat

loc_CF1E:
  CF1E  39         RTS                  ; return

loc_CF1F:
  CF1F  B6 80 54   LDAA  $8054          ; knock per cylinder
  CF22  B5 80 52   BITA  $8052          ; knock in this cylinder?
  CF25  26 11      BNE   loc_CF38       ; yes
  CF27  85 01      BITA  #$01           ; episode in progress?
  CF29  26 03      BNE   loc_CF2E       ; yes
