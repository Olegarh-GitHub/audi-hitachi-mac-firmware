  EF0E  8C 00 96   CPX   #$0096         ; меньше 500 (10 с)?
  EF11  7B 04 17   TIM   #$04,PORT6     ; кодировка: HS? (TIM не меняет C)
  EF14  26 0D      BNE   loc_EF23       ; HS — без коэффициента
  EF16  24 0B      BCC   loc_EF23       ; 10 с прошло — без коэффициента
  EF18  D6 6C      LDAB  $6C            ; коэффициент высоты
