  D793  A7 00      STAA  $00,X          ; f des Zylinders merken
  D795  38         PULX                 ; X zurückholen
  D796  36         PSHA                 ; f auf den Stack
  D797  EC 04      LDD   $04,X          ; Grundgeräusch
  D799  81 40      CMPA  #$40           ; Grundgeräusch 64 oder mehr?
  D79B  24 08      BCC   loc_D7A5       ; ja — Schwelle 255
  D79D  05         ASLD                 ; Grundgeräusch × 4
