  E966  FC 80 10   LDD   $8010          ; Tastverhältnis
  E969  B0 80 12   SUBA  $8012          ; - Absenkung
  E96C  25 09      BCS   loc_E977       ; unter null - 0
  E96E  18         XGDX                 ; D nach X
