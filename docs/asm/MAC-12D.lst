;------------------------------------------------------------------------------
; Отличие от MAC-14: признак «обогащение после роста давления» ($9E.6) сразу
; меняет N7 здесь же, каждый тик. Пока он стоит — N7 = большее из обычного ($87)
; и обогащённого ($89) [Пр]; при $8A биты 6/5 [?] — сразу $89. Когда признак
; снимается — N7 возвращается к $87. Выдача — через F016 в регистр $08 чипа.
;------------------------------------------------------------------------------
loc_EFB5:
  EFB5  7B 40 9E   TIM   #$40,$9E       ; обогащение ($9E.6) было?
  EFB8  27 25      BEQ   loc_EFDF       ; нет — дальше
  EFBA  71 BF 9E   AIM   #$BF,$9E       ; снять
  EFBD  7F 00 9B   CLR   $009B          ; счётчик = 0
  EFC0  DC 87      LDD   $87            ; обычное N7 ($87)
  EFC2  20 16      BRA   loc_EFDA       ; выдать

loc_EFC4:
  EFC4  72 40 9E   OIM   #$40,$9E       ; обогащение ($9E.6)
  EFC7  96 8A      LDAA  $8A            ; флаги $8A [?]
  EFC9  85 40      BITA  #$40           ; бит 6?
  EFCB  27 04      BEQ   loc_EFD1       ; нет
  EFCD  85 20      BITA  #$20           ; бит 5?
  EFCF  27 06      BEQ   loc_EFD7       ; нет — сразу обогащённое

loc_EFD1:
  EFD1  96 87      LDAA  $87            ; обычное N7
  EFD3  91 89      CMPA  $89            ; не меньше обогащённого?
  EFD5  24 08      BCC   loc_EFDF       ; да — не менять

loc_EFD7:
  EFD7  96 89      LDAA  $89            ; обогащённое N7 ($89)
  EFD9  5F         CLRB                 ; доли 0

loc_EFDA:
  EFDA  CE 00 4C   LDX   #$004C         ; временная ячейка
  EFDD  8D 37      BSR   N7_OUT         ; выдать N7 (F016)

;------------------------------------------------------------------------------
; Столбец порогов детонации $A9 = (номер точки оборотов по оси E4E0, 11 точек
; 40 60 … 240) × 3 + (номер точки давления по оси E4EB = 90 128 154).
; $8A.0 — обороты между точками 1 и 7 (≈60…180 ед.): по нему окно детонации
; в IRQ1 ставится по-разному (E80A).
;------------------------------------------------------------------------------
loc_EFDF:
  EFDF  CE E4 E0   LDX   #$E4E0         ; ось оборотов E4E0
  EFE2  C6 0B      LDAB  #$0B           ; 11 точек
  EFE4  96 59      LDAA  $59            ; обороты
  EFE6  BD E6 2D   JSR   AXIS_UP        ; номер точки
  EFE9  C1 01      CMPB  #$01           ; ниже точки 1?
  EFEB  25 09      BCS   loc_EFF6       ; да
  EFED  C1 08      CMPB  #$08           ; точка 8 и выше?
  EFEF  24 05      BCC   loc_EFF6       ; да
  EFF1  72 01 8A   OIM   #$01,$8A       ; $8A.0 = 1
  EFF4  20 03      BRA   loc_EFF9       ; дальше

loc_EFF6:
  EFF6  71 FE 8A   AIM   #$FE,$8A       ; $8A.0 = 0

loc_EFF9:
  EFF9  17         TBA                  ; номер
  EFFA  58         ASLB                 ; × 2
  EFFB  1B         ABA                  ; × 3
  EFFC  36         PSHA                 ; в стек
  EFFD  CE E4 EB   LDX   #$E4EB         ; ось давления E4EB = 90 128 154
  F000  C6 03      LDAB  #$03           ; 3 точки
  F002  96 5A      LDAA  $5A            ; давление
  F004  7B 72 B8   TIM   #$72,$B8       ; ошибки G71?
  F007  27 03      BEQ   loc_F00C       ; нет
  F009  B6 E4 4D   LDAA  $E44D          ; подстановка E44D

loc_F00C:
  F00C  BD E6 2D   JSR   AXIS_UP        ; номер точки
  F00F  32         PULA                 ; × 3
  F010  1B         ABA                  ; + номер давления
  F011  97 A9      STAA  $A9            ; $A9 = столбец порогов
  F013  7E EB 3C   JMP   loc_EB3C       ; конец задачи 0

;------------------------------------------------------------------------------
; N7_OUT — выдать N7: D = A:B (A — проценты, B — доли), в регистр $08 чипа
; пишется round(D × 571 / 65536) = проценты × 2,23 (100 % ≈ 223) [Пр масштаб].
; Значение в процентах сохраняется в ячейке по X (16 бит, × 59).
; В MAC-14 N7 выдаёт таймер процессора (OC1), здесь — внешний чип.
;------------------------------------------------------------------------------
N7_OUT:                                 ; вызов из: TASK0, TASK2
  F016  37         PSHB                 ; доли в стек
  F017  36         PSHA                 ; проценты в стек
  F018  86 3B      LDAA  #$3B           ; 59
  F01A  3D         MUL                  ; доли × 59
  F01B  A7 00      STAA  $00,X          ; временно
  F01D  86 3B      LDAA  #$3B           ; 59
  F01F  33         PULB                 ; B = проценты
  F020  37         PSHB                 ; снова в стек
  F021  3D         MUL                  ; проценты × 59
  F022  EB 00      ADDB  $00,X          ; + доли
  F024  89 00      ADCA  #$00           ; перенос
  F026  ED 00      STD   $00,X          ; [X] = проценты × 59
  F028  32         PULA                 ; проценты
  F029  33         PULB                 ; доли
  F02A  05         ASLD                 ; × 2 (D = проценты × 512)
  F02B  E3 00      ADDD  $00,X          ; + проценты × 59 = × 571
  F02D  58         ASLB                 ; округлить
  F02E  89 00      ADCA  #$00           ; (округлить)
  F030  16         TAB                  ; B = значение
  F031  86 08      LDAA  #$08           ; регистр $08 чипа (N7)
  F033  FD 01 00   STD   $0100          ; записать
  F036  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; ЗАДАЧА 1. Режимные биты $7F (как $8050 у MAC-14):
;  5 — прогрет: G62 ниже E3AB = 39 (снимается от 42);
;  6 — нагрузка: давление выше E3AC = 90 (снимается ниже 87);
;  4 — напряжение в норме: ставится при 97…153, снимается ниже 92 или от 159
;      (у MAC-14 95…149 / 90 / 155);
;  7 — регулирование детонации включено: прогрет, нагрузка, не пуск, дроссель
;      не закрыт, не идёт выдача блинков ($C7.7 / $C8.7).
;------------------------------------------------------------------------------
TASK1:                                  ; вызов из: TASK1
  F037  B6 E3 AB   LDAA  $E3AB          ; порог прогрева 39
  F03A  D6 5C      LDAB  $5C            ; G62
  F03C  11         CBA                  ; теплее?
  F03D  23 03      BLS   loc_F042       ; нет
  F03F  72 20 7F   OIM   #$20,$7F       ; бит 5 — прогрет

loc_F042:
  F042  8B 03      ADDA  #$03           ; гистерезис 3
  F044  11         CBA                  ; холоднее 42?
  F045  22 03      BHI   loc_F04A       ; нет
  F047  71 DF 7F   AIM   #$DF,$7F       ; снять бит 5

loc_F04A:
  F04A  D6 5A      LDAB  $5A            ; давление
  F04C  BD EB 66   JSR   MAP_BAD_LOAD   ; G71 неисправен под нагрузкой?
  F04F  24 03      BCC   loc_F054       ; нет
  F051  F6 E4 4D   LDAB  $E44D          ; подстановка E44D = 211

loc_F054:
  F054  B6 E3 AC   LDAA  $E3AC          ; порог нагрузки 90
  F057  11         CBA                  ; давление выше?
  F058  24 03      BCC   loc_F05D       ; нет
  F05A  72 40 7F   OIM   #$40,$7F       ; бит 6 — нагрузка

loc_F05D:
  F05D  80 03      SUBA  #$03           ; гистерезис 3
  F05F  11         CBA                  ; выше 87?
  F060  25 03      BCS   loc_F065       ; да
  F062  71 BF 7F   AIM   #$BF,$7F       ; снять бит 6

loc_F065:
  F065  D6 5B      LDAB  $5B            ; напряжение
  F067  C1 5C      CMPB  #$5C           ; ниже 92?
  F069  25 0C      BCS   loc_F077       ; да — снять
  F06B  C1 61      CMPB  #$61           ; ниже 97?
  F06D  25 10      BCS   loc_F07F       ; да — не менять
  F06F  C1 9A      CMPB  #$9A           ; ниже 154?
  F071  25 09      BCS   loc_F07C       ; да — поставить
  F073  C1 9F      CMPB  #$9F           ; ниже 159?
  F075  25 08      BCS   loc_F07F       ; да — не менять

loc_F077:
  F077  71 EF 7F   AIM   #$EF,$7F       ; бит 4 снять
  F07A  20 03      BRA   loc_F07F       ; дальше

loc_F07C:
  F07C  72 10 7F   OIM   #$10,$7F       ; бит 4: напряжение в норме

loc_F07F:
  F07F  7B 80 C7   TIM   #$80,$C7       ; список блинков закончен ($C7.7)?
  F082  26 05      BNE   loc_F089       ; да — решать по режиму
  F084  7B 80 C8   TIM   #$80,$C8       ; выдача блинков идёт ($C8.7)?
  F087  26 16      BNE   loc_F09F       ; да — не регулировать

loc_F089:
  F089  D6 68      LDAB  $68            ; режимные флаги
  F08B  2B 12      BMI   loc_F09F       ; пуск — не регулировать
  F08D  BD EB 50   JSR   IS_IDLE        ; дроссель закрыт?
  F090  25 0D      BCS   loc_F09F       ; да — не регулировать
  F092  D6 7F      LDAB  $7F            ; режим
  F094  C8 60      EORB  #$60           ; инвертировать биты 6, 5
  F096  C5 60      BITB  #$60           ; прогрет и нагрузка?
  F098  26 05      BNE   loc_F09F       ; нет
  F09A  72 80 7F   OIM   #$80,$7F       ; бит 7: регулирование детонации включено
  F09D  20 03      BRA   loc_F0A2       ; дальше

loc_F09F:
  F09F  71 7F 7F   AIM   #$7F,$7F       ; бит 7 снять

loc_F0A2:
  F0A2  BD EB 7A   JSR   RD_INPUTS      ; дискретные входы
  F0A5  85 20      BITA  #$20           ; F60 замкнут?
  F0A7  27 05      BEQ   loc_F0AE       ; нет
  F0A9  72 04 AF   OIM   #$04,$AF       ; $AF.2 = 1: дроссель закрыт
  F0AC  20 03      BRA   loc_F0B1       ; дальше

loc_F0AE:
  F0AE  71 FB AF   AIM   #$FB,$AF       ; $AF.2 = 0

;------------------------------------------------------------------------------
; ЗАЖИГАНИЕ. Пуск — E398 = 47. Холостой ход: поправка $51 только по G62
; (ось E260 = 220 … 158, значения E268 = 60 … 60 минус 60 — сейчас 0);
; по высоте поправки нет (у MAC-14 есть). Выше 40 ед. — угол ХХ по оборотам
; (ось E210, значения E220 = 45 45 42 40 35 30 …). Ниже — DLS: пороги AT E39D =
; 20 28 30, HS E3A0 = 20 31 33 (у MC одинаковые 16 28 30): ниже первого — 47,
; от третьего — E3A5 = 48, между — по таблице E3A3 = 36 42 48 (если мотор
; завёлся), иначе 45 (E39A) / 47 (E399).
;------------------------------------------------------------------------------
loc_F0B1:
  F0B1  B6 E3 98   LDAA  $E398          ; угол пуска 47
  F0B4  D6 68      LDAB  $68            ; режимные флаги
  F0B6  2A 03      BPL   loc_F0BB       ; не пуск
  F0B8  7E F1 C5   JMP   loc_F1C5       ; пуск — угол 47

loc_F0BB:
  F0BB  BD EB 50   JSR   IS_IDLE        ; дроссель закрыт?
  F0BE  25 03      BCS   loc_F0C3       ; да — холостой ход
  F0C0  7E F1 8E   JMP   loc_F18E       ; нет — карта

loc_F0C3:
  F0C3  CE E2 60   LDX   #$E260         ; ось G62 E260
  F0C6  96 5C      LDAA  $5C            ; G62
  F0C8  C6 08      LDAB  #$08           ; 8 точек
  F0CA  BD E6 39   JSR   AXIS_DN        ; найти интервал
  F0CD  37         PSHB                 ; номер
  F0CE  BD E5 DE   JSR   FRAC_DN        ; доля
  F0D1  17         TBA                  ; A = доля
  F0D2  33         PULB                 ; B = номер
  F0D3  CE E2 68   LDX   #$E268         ; таблица E268
  F0D6  3A         ABX                  ; X -> значение
  F0D7  16         TAB                  ; B = доля
  F0D8  BD E6 0F   JSR   INTERP         ; значение
  F0DB  80 3C      SUBA  #$3C           ; - 60
  F0DD  97 51      STAA  $51            ; $51 = поправка ХХ (сейчас 0)
  F0DF  96 59      LDAA  $59            ; обороты
  F0E1  B1 E2 10   CMPA  $E210          ; ниже 40 ед.?
