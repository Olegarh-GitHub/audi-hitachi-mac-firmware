  DCB2  20 F2      BRA   loc_DCA6       ; Quittung

;------------------------------------------------------------------------------
; Befehl $1B (Werk): Parameter $8186 = 9 löscht $80F7.0;
; 0, 1, 2, 4, 8 setzen $8205 = Parameter und $80F7.0 = 1 (verwendet in IRQ1, CC5E) [?].
;------------------------------------------------------------------------------
KW_CMD1B:                               ; aufgerufen von: KW_CMD1B
  DCB4  CE 80 00   LDX   #$8000         ; X = $8000
