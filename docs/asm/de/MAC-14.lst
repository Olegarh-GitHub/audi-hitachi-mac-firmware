;------------------------------------------------------------------------------
; AUFGABE 3, Anfang. Momentaufnahme der Ansauglufttemperatur $8206.
; $8206 = G42 ($8020), wird aber nur aktualisiert, wenn der Motor 2 s ununterbrochen
; im Leerlauf läuft (Drosselklappe geschlossen, Drehzahl unter 40 Einh.).
; Während der Fahrt bleibt der Wert eingefroren, die Erwärmung der Ansaugung während der Fahrt wirkt sich nicht aus [Vermutung].
; Die Momentaufnahme dient zur Wahl der Schwelle für N115 (EAE1). Beim ersten Mal wird sie sofort genommen.
;------------------------------------------------------------------------------
TASK3:                                  ; aufgerufen von: TASK3
  EA2C  7D 82 06   TST   $8206          ; noch nie eine Momentaufnahme genommen?
  EA2F  27 1F      BEQ   loc_EA50       ; ja: jetzt nehmen
  EA31  BD D1 E5   JSR   IS_IDLE        ; Drosselklappe geschlossen?
  EA34  24 08      BCC   loc_EA3E       ; nein: Leerlaufzähler auf null
  EA36  B6 80 18   LDAA  $8018          ; Drehzahl
  EA39  B1 C2 10   CMPA  $C210          ; unter 40 Einh. (≈890 U/min)?
  EA3C  25 05      BCS   loc_EA43       ; ja: Leerlaufzeit zählen

loc_EA3E:
  EA3E  7F 82 07   CLR   $8207          ; kein Leerlauf: Zähler = 0
  EA41  20 13      BRA   loc_EA56       ; Momentaufnahme nicht anfassen

loc_EA43:
  EA43  B6 82 07   LDAA  $8207          ; Leerlaufzeit
  EA46  81 14      CMPA  #$14           ; schon 20 Aufrufe (2 s)?
  EA48  24 06      BCC   loc_EA50       ; ja: Momentaufnahme aktualisieren
  EA4A  4C         INCA                 ; + 1
  EA4B  B7 82 07   STAA  $8207          ; speichern
  EA4E  20 06      BRA   loc_EA56       ; Momentaufnahme vorerst nicht anfassen

loc_EA50:
  EA50  B6 80 20   LDAA  $8020          ; Ansauglufttemperatur G42
  EA53  B7 82 06   STAA  $8206          ; $8206 = Momentaufnahme

loc_EA56:
  EA56  86 20      LDAA  #$20           ; Synchronisation vorhanden ($8095.5)?
  EA58  B5 80 95   BITA  $8095          ; prüfen
  EA5B  26 03      BNE   loc_EA60       ; ja: N80 und N115
  EA5D  7E EA FC   JMP   loc_EAFC       ; nein: beide überspringen

;------------------------------------------------------------------------------
; N80: Spülung des Aktivkohlebehälters. Tastverhältnis $8064 = 0…31 von 32 Schritten
; einer langsamen PWM (Schritt 5,09 ms, Periode 163 ms, Ausgabe im OCF-Interrupt, F5FA).
; Die ersten 255 Aufrufe (25,5 s) nach der Synchronisation wird nicht gespült (C795).
; Danach ein 8×8-Kennfeld: Zeilen nach Druck (Achse C7B0 = 116 103 90 77 71 64 58 51),
; Spalten nach Drehzahl (Achse C7B8 = 40 53 67 80 93 107 120 160).
; Kennfeld C7C0 ist das normale, C800 gilt bei gesetztem $8066.1 [?]. Im Leerlauf
; ein fester Wert C7AE = 8 (oder C845 = 4 bei gesetztem $8066.1).
;------------------------------------------------------------------------------
loc_EA60:
  EA60  B6 80 63   LDAA  $8063          ; Zeitzähler seit der Synchronisation
  EA63  B1 C7 95   CMPA  $C795          ; C795 = 255 (25,5 s) erreicht?
  EA66  24 07      BCC   loc_EA6F       ; ja: Spülung nach Kennfeld
  EA68  4C         INCA                 ; + 1
  EA69  B7 80 63   STAA  $8063          ; speichern
  EA6C  5F         CLRB                 ; Tastverhältnis N80 = 0
  EA6D  20 33      BRA   loc_EAA2       ; schreiben

loc_EA6F:
  EA6F  CE C7 B0   LDX   #$C7B0         ; Druckachse C7B0
  EA72  C6 08      LDAB  #$08           ; 8 Punkte
  EA74  BD F5 4C   JSR   N80_ROW        ; Zeile und Anteil nach Druck
  EA77  CE C7 B8   LDX   #$C7B8         ; Drehzahlachse C7B8
  EA7A  C6 08      LDAB  #$08           ; 8 Punkte
  EA7C  BD F5 68   JSR   N80_COL        ; Spalte und Anteil nach Drehzahl; B = Zellennummer
  EA7F  CE C7 C0   LDX   #$C7C0         ; Kennfeld C7C0
  EA82  B6 80 66   LDAA  $8066          ; Lambdaflags [?]
  EA85  85 02      BITA  #$02           ; $8066.1?
  EA87  27 03      BEQ   loc_EA8C       ; nein: normales Kennfeld
  EA89  CE C8 00   LDX   #$C800         ; ja: Kennfeld C800

loc_EA8C:
  EA8C  BD F5 81   JSR   MAP8X8         ; Interpolation im Kennfeld
  EA8F  16         TAB                  ; B = Tastverhältnis
  EA90  BD D1 E5   JSR   IS_IDLE        ; Drosselklappe geschlossen?
  EA93  24 0D      BCC   loc_EAA2       ; nein: nach Kennfeld
  EA95  F6 C7 AE   LDAB  $C7AE          ; Leerlauf: C7AE = 8
  EA98  B6 80 66   LDAA  $8066          ; Lambdaflags
  EA9B  85 02      BITA  #$02           ; $8066.1?
  EA9D  27 03      BEQ   loc_EAA2       ; nein: 8
  EA9F  F6 C8 45   LDAB  $C845          ; ja: C845 = 4

loc_EAA2:
  EAA2  F7 80 64   STAB  $8064          ; $8064 = Tastverhältnis N80

;------------------------------------------------------------------------------
; N115: Absperrventil für Kraftstoffdämpfe aus dem Tank (Chip-Reg. $19 Bit 2).
; Freigegeben 50 Aufrufe (5 s) nach der Synchronisation (C844).
; Eingeschaltet:  Druck über 102 (96 + 6, ≈0,8 bar abs. [Vermutung])  oder
;                Drehzahl über Schwelle + 4.
; Ausgeschaltet:  im Leerlauf, oder Druck unter 96 und Drehzahl unter der Schwelle.
; Drehzahlschwelle (C840…C843): 48 Einh. (≈1070 U/min), wenn die G42-Momentaufnahme ≥ 128 ist
; (kalte Luft), sonst 58 Einh. (≈1290 U/min). Für AT und HS gleich.
;------------------------------------------------------------------------------
  EAA5  CE 80 00   LDX   #$8000         ; X = $8000
  EAA8  A6 63      LDAA  $63,X          ; Zeit seit der Synchronisation
  EAAA  B1 C8 44   CMPA  $C844          ; weniger als C844 = 50 (5 s)?
  EAAD  25 46      BCS   loc_EAF5       ; ja: N115 ausschalten
  EAAF  E6 19      LDAB  $19,X          ; Druck
  EAB1  BD D1 FE   JSR   MAP_BAD_LOAD   ; G71 defekt unter Last?
  EAB4  24 03      BCC   loc_EAB9       ; nein: Messwert
  EAB6  F6 C7 9E   LDAB  $C79E          ; ja: Ersatzwert 192

loc_EAB9:
  EAB9  F0 C7 98   SUBB  $C798          ; Druck - C798 (96)
  EABC  25 09      BCS   loc_EAC7       ; unter 96? ja: Kennzeichen löschen
  EABE  C0 06      SUBB  #$06           ; nochmals - 6
  EAC0  25 08      BCS   loc_EACA       ; zwischen 96 und 102? ja: Kennzeichen nicht ändern
  EAC2  62 01 9F   OIM   #$01,$9F,X     ; über 102: $809F.0 = 1
  EAC5  20 03      BRA   loc_EACA       ; weiter

loc_EAC7:
  EAC7  61 FE 9F   AIM   #$FE,$9F,X     ; unter 96: $809F.0 = 0

loc_EACA:
  EACA  BD D1 E5   JSR   IS_IDLE        ; Drosselklappe geschlossen?
  EACD  25 26      BCS   loc_EAF5       ; ja: N115 ausschalten
  EACF  6B 01 9F   TIM   #$01,$9F,X     ; Druck über 102?
  EAD2  26 1D      BNE   loc_EAF1       ; ja: N115 einschalten
  EAD4  A6 18      LDAA  $18,X          ; Drehzahl
  EAD6  CE C8 40   LDX   #$C840         ; Schwellen Schaltgetriebe C840/C841
  EAD9  7B 04 17   TIM   #$04,PORT6     ; Codierung: PORT6.2 = 1 bedeutet HS
  EADC  26 03      BNE   loc_EAE1       ; HS? ja: belassen
  EADE  CE C8 42   LDX   #$C842         ; AT: C842/C843

loc_EAE1:
  EAE1  F6 82 06   LDAB  $8206          ; G42-Momentaufnahme
  EAE4  C1 80      CMPB  #$80           ; 128 und darüber (kalt)?
  EAE6  24 01      BCC   loc_EAE9       ; ja: Schwelle 48
  EAE8  08         INX                  ; nein: Schwelle 58

loc_EAE9:
  EAE9  A0 00      SUBA  $00,X          ; Drehzahl - Schwelle
  EAEB  25 08      BCS   loc_EAF5       ; unter der Schwelle? ja: ausschalten
  EAED  81 04      CMPA  #$04           ; um weniger als 4 darüber?
  EAEF  25 0B      BCS   loc_EAFC       ; ja: Zustand nicht ändern

loc_EAF1:
  EAF1  C6 04      LDAB  #$04           ; Bit 2 = 1: N115 ein
  EAF3  20 02      BRA   loc_EAF7       ; schreiben

loc_EAF5:
  EAF5  C6 FB      LDAB  #$FB           ; Bit 2 = 0: N115 aus

loc_EAF7:
  EAF7  86 19      LDAA  #$19           ; Chipregister $19
  EAF9  FD 01 00   STD   $0100          ; Ausgang schreiben

;------------------------------------------------------------------------------
; Prüfung der Drehzahlgeber bei (aus Sicht des Steuergeräts) stehendem Motor.
; Solange der Chip noch nie Zähne gezählt hat ($8003.6 = 0, gesetzt von D341),
; aber der Saugrohrdruck vom Luftdruck (beim Einschalten erfasst)
; um 5 oder mehr 10 Aufrufe hintereinander (1 s) abweicht, dreht sich der Motor offensichtlich,
; es fehlt aber das Drehzahlsignal. Dann: Fehler G28 und G4 ($8094 |= $F0), $8003.6 = 1
; (die Prüfung läuft nicht mehr) und Ausstieg aus der Stellglieddiagnose (F726).
;------------------------------------------------------------------------------
loc_EAFC:
  EAFC  CE 80 00   LDX   #$8000         ; X = $8000
  EAFF  6B 40 03   TIM   #$40,$03,X     ; schon Zähne erkannt ($8003.6)?
