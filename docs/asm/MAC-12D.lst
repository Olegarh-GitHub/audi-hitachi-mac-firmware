  EB0B  8C 00 4A   CPX   #$004A         ; все четыре?
  EB0E  26 E1      BNE   loc_EAF1       ; нет
  EB10  38         PULX                 ; убрать указатель

loc_EB11:
  EB11  5F         CLRB                 ; номер задачи 0
  EB12  CE 00 46   LDX   #$0046         ; счётчик задачи 0

loc_EB15:
  EB15  A6 00      LDAA  $00,X          ; счётчик
  EB17  2B 0B      BMI   loc_EB24       ; идёт? — выйти
  EB19  85 40      BITA  #$40           ; готова?
  EB1B  26 08      BNE   loc_EB25       ; да — запустить
  EB1D  5C         INCB                 ; номер + 1
  EB1E  08         INX                  ; следующий
  EB1F  8C 00 4A   CPX   #$004A         ; все?
  EB22  26 F1      BNE   loc_EB15       ; нет

