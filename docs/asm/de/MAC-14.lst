  E911  33         PULB                 ; B = Index
  E912  CE C7 5C   LDX   #$C75C         ; Tabelle C75C
  E915  3A         ABX                  ; X -> Wert
  E916  16         TAB                  ; B = Anteil
  E917  BD CA 41   JSR   INTERP         ; Absenkung nach Luft
  E91A  B7 80 12   STAA  $8012          ; $8012
  E91D  B6 80 1B   LDAA  $801B          ; G62
  E920  CE C7 60   LDX   #$C760         ; Achse C760
  E923  C6 20      LDAB  #$20           ; Motor heiß ($8066.5)?
  E925  F5 80 66   BITB  $8066          ; prüfen
  E928  27 07      BEQ   loc_E931       ; nein
  E92A  B6 80 B1   LDAA  $80B1          ; Zeit mit heißem Motor
  E92D  43         COMA                 ; invertieren
  E92E  CE C7 70   LDX   #$C770         ; Achse C770

loc_E931:
  E931  C6 08      LDAB  #$08           ; 8 Punkte
  E933  BD CA 6B   JSR   AXIS_DN        ; Intervall suchen
  E936  37         PSHB                 ; Index
  E937  BD CA 10   JSR   FRAC_DN        ; Anteil
  E93A  17         TBA                  ; A = Anteil
  E93B  CE C7 68   LDX   #$C768         ; Tabelle C768
  E93E  C6 20      LDAB  #$20           ; heiß?
  E940  F5 80 66   BITB  $8066          ; prüfen
  E943  27 03      BEQ   loc_E948       ; nein
  E945  CE C7 78   LDX   #$C778         ; Tabelle C778

loc_E948:
  E948  33         PULB                 ; Index
  E949  3A         ABX                  ; X -> Wert
  E94A  16         TAB                  ; B = Anteil
  E94B  BD CA 41   JSR   INTERP         ; Absenkung nach Motor
  E94E  BB 80 12   ADDA  $8012          ; + nach Luft
  E951  24 02      BCC   loc_E955       ; kein Überlauf
  E953  86 FF      LDAA  #$FF           ; 255

loc_E955:
  E955  B7 80 12   STAA  $8012          ; $8012 = Absenkung
  E958  B6 80 69   LDAA  $8069          ; Integrator
  E95B  B1 80 12   CMPA  $8012          ; nicht unter der Absenkung?
  E95E  24 03      BCC   loc_E963       ; ja
