  F46D  B7 80 9F   STAA  $809F          ; schreiben

;------------------------------------------------------------------------------
; LAMPE K66 (Kontakt 31, PORT6.4). PORT6.4 = 0 — Lampe an, 1 — Lampe aus.
; An: bei stehendem Motor (Lampenprüfung), solange Kontakt 5 an Masse liegt, durch
; die Blinkcode-Ablaufsteuerung, und bei warmem Motor unter Last bei Fehler des
; Klopfsensors oder der Klopfregelung (F51D).
; Nicht an bei Fehlern von G28/Hallgeber und Ladedruck bei Drehzahlen über 120 Einh. [?].
; $806E: Bit 1 — Drehzahl über 120 Einh. (C7A5, Hysterese 4); Bits 2-4 —
; besondere Lampenmodi für den Tester [?].
;------------------------------------------------------------------------------
loc_F470:
  F470  CE 80 00   LDX   #$8000         ; X = $8000
  F473  E6 6E      LDAB  $6E,X          ; Lampenflags
  F475  C4 FB      ANDB  #$FB           ; zuerst Bit 2 löschen
  F477  C5 08      BITB  #$08           ; $806E.3?
  F479  26 34      BNE   loc_F4AF       ; gesetzt — speichern
  F47B  7B 40 15   TIM   #$40,PORT5     ; Kontakt 5 an Masse?
  F47E  27 2D      BEQ   loc_F4AD       ; ja — Bit 4 löschen
  F480  6B 20 95   TIM   #$20,$95,X     ; Synchronisation vorhanden?
  F483  27 26      BEQ   loc_F4AB       ; nein — Bit 3
  F485  6B 80 A0   TIM   #$80,$A0,X     ; Blinkcodeausgabe läuft?
  F488  26 05      BNE   loc_F48F       ; ja — Patch
  F48A  6B 80 9F   TIM   #$80,$9F,X     ; Liste zu Ende?
  F48D  27 1C      BEQ   loc_F4AB       ; nein — Bit 3

loc_F48F:
  F48F  7E F8 90   JMP   loc_F890       ; Patch: Blinkzähler für den Tester [?]

; Tabelle $F492, 1 Bytes: totes Byte (unter dem Patch übrig geblieben)
  F492  db F5

loc_F493:
  F493  81 0C      CMPA  #$0C           ; Zähler kleiner als 12?
  F495  24 03      BCC   loc_F49A       ; nein — ab null
  F497  4C         INCA                 ; + 1
  F498  20 01      BRA   loc_F49B       ; weiter

loc_F49A:
  F49A  4F         CLRA                 ; ab null

loc_F49B:
  F49B  A7 F5      STAA  $F5,X          ; $80F5 = Zähler 0…12
  F49D  A6 F4      LDAA  $F4,X          ; $80F4 [?]
  F49F  80 02      SUBA  #$02           ; - 2
  F4A1  25 0C      BCS   loc_F4AF       ; kleiner als null — ohne Bit 2
  F4A3  A1 F5      CMPA  $F5,X          ; mit dem Zähler vergleichen
  F4A5  25 08      BCS   loc_F4AF       ; kleiner — ohne Bit 2
  F4A7  CA 04      ORAB  #$04           ; Bit 2
  F4A9  20 04      BRA   loc_F4AF       ; weiter

loc_F4AB:
  F4AB  CA 08      ORAB  #$08           ; Bit 3

loc_F4AD:
  F4AD  C4 EF      ANDB  #$EF           ; Bit 4 löschen

loc_F4AF:
  F4AF  E7 6E      STAB  $6E,X          ; Lampenflags schreiben
  F4B1  B6 80 6E   LDAA  $806E          ; Lampenflags
  F4B4  85 10      BITA  #$10           ; Bit 4?
  F4B6  27 07      BEQ   loc_F4BF       ; nein — normale Lampe
  F4B8  85 04      BITA  #$04           ; Bit 2?
  F4BA  27 78      BEQ   loc_F534       ; nein — ausschalten
  F4BC  7E F5 3F   JMP   loc_F53F       ; ja — einschalten

loc_F4BF:
  F4BF  86 40      LDAA  #$40           ; Kontakt 5
  F4C1  95 15      BITA  PORT5          ; an Masse?
  F4C3  27 7A      BEQ   loc_F53F       ; ja — Lampe an
  F4C5  86 80      LDAA  #$80           ; Blinkcodeausgabe läuft?
  F4C7  B5 80 A0   BITA  $80A0          ; prüfen
  F4CA  26 6C      BNE   loc_F538       ; ja — Lampe durch die Blinkcode-Ablaufsteuerung
  F4CC  B6 80 18   LDAA  $8018          ; Drehzahl
  F4CF  F6 C7 A5   LDAB  $C7A5          ; Schwelle C7A5 = 120 Einh. (≈2700 U/min)
  F4D2  11         CBA                  ; Drehzahl darunter?
  F4D3  25 0A      BCS   loc_F4DF       ; ja — Bit 1 nicht setzen
  F4D5  36         PSHA                 ; speichern
  F4D6  86 02      LDAA  #$02           ; Bit 1
  F4D8  BA 80 6E   ORAA  $806E          ; setzen
  F4DB  B7 80 6E   STAA  $806E          ; schreiben
  F4DE  32         PULA                 ; Drehzahl zurückholen

loc_F4DF:
  F4DF  C0 04      SUBB  #$04           ; Hysterese 4
  F4E1  11         CBA                  ; Drehzahl nicht unter 116?
  F4E2  24 08      BCC   loc_F4EC       ; ja — Bit 1 behalten
  F4E4  86 FD      LDAA  #$FD           ; Bit 1 löschen
  F4E6  B4 80 6E   ANDA  $806E          ; löschen
  F4E9  B7 80 6E   STAA  $806E          ; schreiben

loc_F4EC:
  F4EC  F6 80 6E   LDAB  $806E          ; Lampenflags
  F4EF  86 80      LDAA  #$80           ; Blinkcodeausgabe läuft?
  F4F1  B5 80 A0   BITA  $80A0          ; prüfen
  F4F4  26 53      BNE   loc_F549       ; ja — Lampe nicht verändern
  F4F6  B6 80 18   LDAA  $8018          ; Drehzahl
  F4F9  81 01      CMPA  #$01           ; kleiner als 1 (Motor steht)?
  F4FB  25 42      BCS   loc_F53F       ; ja — Lampe an
  F4FD  86 C0      LDAA  #$C0           ; Steuergerätefehler
  F4FF  B5 80 95   BITA  $8095          ; vorhanden?
  F502  26 3B      BNE   loc_F53F       ; ja — Lampe an
  F504  C5 02      BITB  #$02           ; Drehzahl über 120 Einh.?
  F506  27 0B      BEQ   loc_F513       ; nein
  F508  C5 60      BITB  #$60           ; Bits 5, 6?
  F50A  26 33      BNE   loc_F53F       ; gesetzt — Lampe an
  F50C  86 05      LDAA  #$05           ; Fehler G28/Hallgeber (Bits 0, 2)
  F50E  B5 80 94   BITA  $8094          ; prüfen
  F511  26 2C      BNE   loc_F53F       ; vorhanden — Lampe an

loc_F513:
  F513  86 01      LDAA  #$01           ; Druck über 128 ($8028.0)?
  F515  B5 80 28   BITA  $8028          ; prüfen
  F518  27 03      BEQ   loc_F51D       ; nein
  F51A  5D         TSTB                 ; $806E.7 (lang anstehender Fehler $8092.7)?
  F51B  2B 22      BMI   loc_F53F       ; ja — Lampe an

loc_F51D:
  F51D  B6 80 50   LDAA  $8050          ; Modus $8050: warm und unter Last (Bits 6 und 5)?
  F520  88 60      EORA  #$60           ; invertieren
  F522  85 60      BITA  #$60           ; beide gesetzt?
  F524  26 0E      BNE   loc_F534       ; nein — ausschalten
  F526  86 A0      LDAA  #$A0           ; Fehler der Klopfsensoren
  F528  B5 80 B6   BITA  $80B6          ; vorhanden?
  F52B  26 12      BNE   loc_F53F       ; ja — Lampe an
  F52D  86 10      LDAA  #$10           ; $807A.4 — Grenze der Spätverstellung durch Klopfregelung [Vermutung]
  F52F  B5 80 7A   BITA  $807A          ; prüfen
  F532  26 0B      BNE   loc_F53F       ; ja — Lampe an

loc_F534:
  F534  86 10      LDAA  #$10           ; ausschalten: PORT6.4 = 1
  F536  20 08      BRA   loc_F540       ; schreiben

loc_F538:
  F538  86 20      LDAA  #$20           ; Blinkcodes: Lampe an?
  F53A  B5 80 9F   BITA  $809F          ; prüfen
  F53D  27 F5      BEQ   loc_F534       ; nein — ausschalten

loc_F53F:
  F53F  4F         CLRA                 ; einschalten: PORT6.4 = 0

loc_F540:
  F540  C6 EF      LDAB  #$EF           ; Maske von Bit 4
  F542  0F         SEI                  ; Interrupts sperren
  F543  D4 17      ANDB  PORT6          ; die übrigen Bits von PORT6
  F545  1B         ABA                  ; + Lampenbit
  F546  97 17      STAA  PORT6          ; PORT6 schreiben
  F548  0E         CLI                  ; Interrupts freigeben

loc_F549:
  F549  7E F8 B0   JMP   loc_F8B0       ; Patch: Sender der K-Leitung

;------------------------------------------------------------------------------
; N80_ROW — Kennfeldzeile nach Druck: $8015 = Index, $8017 = Anteil.
; Eingang: X = Druckachse, B = Anzahl der Stützstellen. Bei Fehler G71 — Ersatzwert 192.
;------------------------------------------------------------------------------
N80_ROW:                                ; aufgerufen von: TASK3
  F54C  37         PSHB                 ; Anzahl der Stützstellen auf den Stack
  F54D  B6 80 19   LDAA  $8019          ; Druck
  F550  C6 72      LDAB  #$72           ; Fehler G71
  F552  F5 80 91   BITB  $8091          ; prüfen
  F555  27 03      BEQ   loc_F55A       ; nein — Messwert
  F557  B6 C7 9E   LDAA  $C79E          ; Ersatzwert C79E = 192

loc_F55A:
  F55A  33         PULB                 ; Anzahl der Stützstellen
  F55B  BD CA 6B   JSR   AXIS_DN        ; Intervall suchen (Achse fallend)
  F55E  F7 80 15   STAB  $8015          ; $8015 = Zeilenindex
  F561  BD CA 10   JSR   FRAC_DN        ; Anteil
  F564  F7 80 17   STAB  $8017          ; $8017 = Anteil
  F567  39         RTS                  ; Rücksprung

;------------------------------------------------------------------------------
; N80_COL — Spalte nach Drehzahl: $8014 = Index, $8016 = Anteil.
; Ausgang: B = Zeile * 8 + Spalte (Zellenindex).
;------------------------------------------------------------------------------
N80_COL:                                ; aufgerufen von: TASK3
  F568  B6 80 18   LDAA  $8018          ; Drehzahl
  F56B  BD CA 5F   JSR   AXIS_UP        ; Intervall suchen
  F56E  F7 80 14   STAB  $8014          ; $8014 = Spaltenindex
  F571  BD CA 05   JSR   FRAC_UP        ; Anteil
  F574  F7 80 16   STAB  $8016          ; $8016 = Anteil
  F577  F6 80 15   LDAB  $8015          ; Zeilenindex
  F57A  58         ASLB                 ; * 8
  F57B  58         ASLB                 ; *
  F57C  58         ASLB                 ; *
  F57D  FB 80 14   ADDB  $8014          ; + Spalte
  F580  39         RTS                  ; Rücksprung

;------------------------------------------------------------------------------
; MAP8X8 — doppelte Interpolation im 8×8-Kennfeld: zuerst nach Drehzahl in der eigenen
; Zeile und in der nächsten, dann zwischen den Zeilen nach Druck.
; Eingang: X = Kennfeld, B = Zellenindex. Ausgang: A.
;------------------------------------------------------------------------------
MAP8X8:                                 ; aufgerufen von: TASK3
  F581  3A         ABX                  ; X -> Zelle
  F582  3C         PSHX                 ; speichern
  F583  F6 80 16   LDAB  $8016          ; Drehzahlanteil
  F586  BD CA 41   JSR   INTERP         ; Wert in der Zeile
  F589  B7 80 14   STAA  $8014          ; $8014 = in der Zeile
  F58C  C6 08      LDAB  #$08           ; nächste Zeile (+8)
  F58E  38         PULX                 ; X -> Zelle
  F58F  3A         ABX                  ; (Adresse)
  F590  F6 80 16   LDAB  $8016          ; Drehzahlanteil
  F593  BD CA 41   JSR   INTERP         ; Wert in der nächsten Zeile
  F596  B7 80 15   STAA  $8015          ; $8015
  F599  CE 80 14   LDX   #$8014         ; zwei aufeinanderfolgende Werte
  F59C  F6 80 17   LDAB  $8017          ; Druckanteil
  F59F  BD CA 41   JSR   INTERP         ; zwischen den Zeilen
  F5A2  39         RTS                  ; Rücksprung

;------------------------------------------------------------------------------
; NMI — löst aus, wenn die Versorgungsspannung abfällt (Zündung aus) [Vermutung].
; Die Codebytes $8000-$8002 und die Zähler $802B, $802C werden in das interne
; RAM des Prozessors $41-$45 kopiert, nach $40 kommt ihre Summe. Dieses RAM wird aus
; Dauerplus (Kontakt 33) versorgt und behält die Fehler bei ausgeschalteter Zündung.
; Beim nächsten Einschalten wird die Kopie über die Summe geprüft und zurückgeholt (D13C).
;------------------------------------------------------------------------------
sub_F5A3:                               ; aufgerufen von: NMI
  F5A3  7B 40 14   TIM   #$40,RP5CR     ; internes RAM bereits eingeschaltet (Arbeit mit der Kopie läuft)?
  F5A6  27 01      BEQ   loc_F5A9       ; nein — sichern
  F5A8  3B         RTI                  ; ja — verlassen

loc_F5A9:
  F5A9  72 40 14   OIM   #$40,RP5CR     ; internes RAM einschalten
  F5AC  4F         CLRA                 ; Summe = 0
  F5AD  F6 80 00   LDAB  $8000          ; Codebyte 1
  F5B0  1B         ABA                  ; zur Summe
  F5B1  D7 41      STAB  $41            ; Kopie
  F5B3  F6 80 01   LDAB  $8001          ; Codebyte 2
  F5B6  1B         ABA                  ; zur Summe
  F5B7  D7 42      STAB  $42            ; Kopie
  F5B9  F6 80 02   LDAB  $8002          ; Codebyte 3
  F5BC  1B         ABA                  ; zur Summe
  F5BD  D7 43      STAB  $43            ; Kopie
  F5BF  F6 80 2B   LDAB  $802B          ; Zähler der Starts ohne Änderungen
  F5C2  1B         ABA                  ; zur Summe
  F5C3  D7 44      STAB  $44            ; Kopie
  F5C5  F6 80 2C   LDAB  $802C          ; $802C (Bit 7 — Codes bis zum Ende ausgegeben)
  F5C8  1B         ABA                  ; zur Summe
  F5C9  D7 45      STAB  $45            ; Kopie
  F5CB  97 40      STAA  $40            ; $40 = Summe
  F5CD  71 BF 14   AIM   #$BF,RP5CR     ; internes RAM abschalten (Schreibschutz)
  F5D0  72 80 14   OIM   #$80,RP5CR     ; Merker „RAM war versorgt“ = 1
  F5D3  86 08      LDAA  #$08           ; Kopie erstellt ($8003.3)
  F5D5  BA 80 03   ORAA  $8003          ; setzen
  F5D8  B7 80 03   STAA  $8003          ; schreiben
  F5DB  3B         RTI                  ; Rücksprung

;------------------------------------------------------------------------------
; OCF - Compare von Timer 1.
; OC1: PWM für N7 an Pin P21 (Kontakt 8). Periode 21400 E-Takte (1,536 MHz) =
; 71,8 Hz. Ein für $805D Takte, aus für 21400 - $805D; der Ausgangspegel
; schaltet selbst um (OLVL1).
; OC2: alle 7812 Takte (5,09 ms) ein Schritt der langsamen PWM für N80: 32 Schritte = 163 ms,
; in den ersten $8064 Schritten ist Chipregister $0B = FF (N80 offen), in den übrigen 00.
;------------------------------------------------------------------------------
OCF:                                    ; aufgerufen von: OCF
  F5DC  96 0F      LDAA  TCSR2          ; Timerstatus, Teil 2
  F5DE  85 20      BITA  #$20           ; Compare 2?
  F5E0  26 18      BNE   loc_F5FA       ; ja - N80
  F5E2  96 08      LDAA  TCSR1          ; lesen (löscht das OC1-Flag)
  F5E4  FC 80 5D   LDD   $805D          ; „Ein“-Zeit
  F5E7  7B 01 08   TIM   #$01,TCSR1     ; jetzt Pegel 1?
  F5EA  26 06      BNE   loc_F5F2       ; ja - nächste Flanke nach „Ein“
  F5EC  CC 53 98   LDD   #$5398         ; Periode 21400
  F5EF  B3 80 5D   SUBD  $805D          ; - „Ein“ = „Aus“

loc_F5F2:
  F5F2  75 01 08   EIM   #$01,TCSR1     ; Pegel beim nächsten Vergleich umschalten
  F5F5  D3 0B      ADDD  OCR1H          ; + zum Vergleichszeitpunkt
  F5F7  DD 0B      STD   OCR1H          ; neuer Zeitpunkt
  F5F9  3B         RTI                  ; verlassen

loc_F5FA:
  F5FA  DC 09      LDD   FRCH           ; Timerzähler
  F5FC  C3 1E 84   ADDD  #$1E84         ; + 7812 (5,09 ms)
  F5FF  DD 19      STD   OCR2H          ; nächster Compare 2
  F601  B6 80 65   LDAA  $8065          ; PWM-Schritt N80
  F604  81 20      CMPA  #$20           ; 32?
  F606  27 09      BEQ   loc_F611       ; ja - von vorn
  F608  B1 80 64   CMPA  $8064          ; unter dem Tastverhältnis?
  F60B  25 0A      BCS   loc_F617       ; ja - offen

loc_F60D:
  F60D  C6 00      LDAB  #$00           ; geschlossen: 00
  F60F  20 08      BRA   loc_F619       ; weiter

loc_F611:
  F611  4F         CLRA                 ; Schritt 0
  F612  F6 80 64   LDAB  $8064          ; Tastverhältnis
  F615  27 F6      BEQ   loc_F60D       ; null - geschlossen

loc_F617:
  F617  C6 FF      LDAB  #$FF           ; offen: FF

loc_F619:
  F619  4C         INCA                 ; Schritt + 1
  F61A  B7 80 65   STAA  $8065          ; speichern
  F61D  86 20      LDAA  #$20           ; synchronisiert?
  F61F  B5 80 95   BITA  $8095          ; prüfen
  F622  27 05      BEQ   loc_F629       ; nein - nicht ändern
  F624  86 0B      LDAA  #$0B           ; Chipregister $0B (N80)
  F626  FD 01 00   STD   $0100          ; speichern

loc_F629:
  F629  3B         RTI                  ; verlassen

;------------------------------------------------------------------------------
; CMI - Vergleich von Timer 2: Software-PWM für N75 an PORT2.6 (Kontakt 19).
; Die „Ein“-Phase dauert $8067 Zählschritte von Timer 2, die „Aus“-Phase 255 - $8067.
; 0 bedeutet immer aus, 255 immer ein. Die Frequenz hängt vom Vorteiler von Timer 2 ab
; (TCSR3, E760) [?].
;------------------------------------------------------------------------------
CMI:                                    ; aufgerufen von: CMI
  F62A  71 7F 1B   AIM   #$7F,TCSR3     ; Vergleichsflag löschen
  F62D  96 03      LDAA  PORT2          ; Port 2
  F62F  85 40      BITA  #$40           ; N75 jetzt ein?
  F631  26 12      BNE   loc_F645       ; ja
  F633  F6 80 67   LDAB  $8067          ; Tastverhältnis
  F636  27 1F      BEQ   loc_F657       ; 0 - aus lassen
  F638  C1 FF      CMPB  #$FF           ; 255?
  F63A  27 1F      BEQ   loc_F65B       ; ja - dauerhaft einschalten
  F63C  8A 40      ORAA  #$40           ; einschalten
  F63E  97 03      STAA  PORT2          ; speichern
  F640  F6 80 67   LDAB  $8067          ; „Ein“-Zeit
  F643  20 1A      BRA   loc_F65F       ; in den Timer

loc_F645:
  F645  F6 80 67   LDAB  $8067          ; Tastverhältnis
  F648  C1 FF      CMPB  #$FF           ; 255?
  F64A  27 0F      BEQ   loc_F65B       ; ja - ein lassen
  F64C  84 BF      ANDA  #$BF           ; ausschalten
  F64E  97 03      STAA  PORT2          ; speichern
  F650  C6 FF      LDAB  #$FF           ; 255
  F652  F0 80 67   SUBB  $8067          ; - Tastverhältnis = „Aus“
  F655  20 08      BRA   loc_F65F       ; in den Timer

loc_F657:
  F657  84 BF      ANDA  #$BF           ; ausschalten
  F659  20 02      BRA   loc_F65D       ; speichern

loc_F65B:
  F65B  8A 40      ORAA  #$40           ; einschalten

loc_F65D:
  F65D  97 03      STAA  PORT2          ; speichern

loc_F65F:
  F65F  D7 1C      STAB  TCONR          ; Phasendauer in Timer 2

;------------------------------------------------------------------------------
; TOF und das leere Ende von CMI tun nichts.
;------------------------------------------------------------------------------
TOF:                                    ; aufgerufen von: CMI, TOF
  F661  3B         RTI                  ; verlassen

;------------------------------------------------------------------------------
; IRQ2 - einmalige Messung [?]: IRQ2 ausschalten, $80F4 = |Chip-Reg. $00 - 94|.
; IRQ2 wird bei CDF9 freigegeben (Hall hoch und $806E.4). $80F4 wird von der Lampe
; im Testermodus verwendet (F49D).
;------------------------------------------------------------------------------
IRQ2:                                   ; aufgerufen von: IRQ2
  F662  71 FD 14   AIM   #$FD,RP5CR     ; IRQ2 ausschalten
  F665  86 00      LDAA  #$00           ; Register $00
  F667  B7 01 00   STAA  $0100          ; auswählen
  F66A  B6 01 01   LDAA  $0101          ; lesen
  F66D  80 5E      SUBA  #$5E           ; - 94
  F66F  24 01      BCC   loc_F672       ; nicht unter null
  F671  40         NEGA                 ; Betrag

loc_F672:
  F672  B7 80 F4   STAA  $80F4          ; $80F4
  F675  3B         RTI                  ; verlassen

;------------------------------------------------------------------------------
; ICF - Capture an P20 (Eingang Tin): BEZUGSMARKE G4 (einmal pro Kurbelwellenumdrehung) [Vermutung nach Logik].
; $8095.4 - Marke kam (für die Prüfung „540 Zähne ohne Marke“, D352).
; Die ersten 3 Marken prüfen G4 ($8095.0). Danach, nicht im Start, muss das Hallsignal
; von Marke zu Marke wechseln (Phase $8095.2): 2-mal zur falschen Zeit hoch ergibt 2113
; ($8094 Bits 3, 2), 3-mal zur falschen Zeit niedrig ergibt 2113 (Bits 1, 0).
; Eine Marke ohne Zähne zwischen den Marken ($8095.3 nicht gesetzt) 2-mal ergibt 2111 G28 ($8094 Bits 7, 6).
;------------------------------------------------------------------------------
ICF:                                    ; aufgerufen von: ICF
  F676  CE 80 00   LDX   #$8000         ; X = $8000
  F679  62 10 95   OIM   #$10,$95,X     ; Marke kam ($8095.4)
  F67C  6B 01 95   TIM   #$01,$95,X     ; G4 schon geprüft?
  F67F  26 17      BNE   loc_F698       ; ja
  F681  62 40 03   OIM   #$40,$03,X     ; „Zähne schon gekommen“
  F684  BD F7 26   JSR   TEST_EXIT      ; Stellglieddiagnose verlassen
  F687  A6 9A      LDAA  $9A,X          ; Markenzähler
  F689  81 02      CMPA  #$02           ; schon 2?
  F68B  24 05      BCC   loc_F692       ; ja - G4 geprüft
  F68D  4C         INCA                 ; + 1

