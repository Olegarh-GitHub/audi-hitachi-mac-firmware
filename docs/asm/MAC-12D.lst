;------------------------------------------------------------------------------
; OCF — программный ШИМ N75 на P21 (контакт 19 [Пр]): период $FF00 тактов
; (≈42,5 мс, ≈23,5 Гц), «включено» = $8E, «выключено» = $FF00 - $8E.
; 0 — всегда выключен, $FF00 — всегда включён. У MC N75 — на P26 через таймер 2.
;------------------------------------------------------------------------------
OCF:                                    ; вызов из: OCF
  FE39  96 08      LDAA  TCSR1          ; снять флаг (чтение TCSR1)
  FE3B  96 03      LDAA  PORT2          ; порт 2
  FE3D  85 02      BITA  #$02           ; N75 сейчас включён (P21)?
  FE3F  26 11      BNE   loc_FE52       ; да
  FE41  DE 8E      LDX   $8E            ; скважность
  FE43  27 1F      BEQ   loc_FE64       ; 0 — оставить выключенным
  FE45  8C FF 00   CPX   #$FF00         ; 100 %?
  FE48  27 1E      BEQ   loc_FE68       ; да — включить насовсем
  FE4A  8A 02      ORAA  #$02           ; включить
  FE4C  97 03      STAA  PORT2          ; записать
  FE4E  DC 8E      LDD   $8E            ; «включено» = скважность
  FE50  20 1D      BRA   loc_FE6F       ; в таймер

loc_FE52:
  FE52  DE 8E      LDX   $8E            ; скважность
  FE54  8C FF 00   CPX   #$FF00         ; 100 %?
  FE57  27 0F      BEQ   loc_FE68       ; да — оставить включённым
  FE59  84 FD      ANDA  #$FD           ; выключить
  FE5B  97 03      STAA  PORT2          ; записать
  FE5D  CC FF 00   LDD   #$FF00         ; период
  FE60  93 8E      SUBD  $8E            ; - скважность = «выключено»
  FE62  20 0B      BRA   loc_FE6F       ; в таймер

loc_FE64:
  FE64  84 FD      ANDA  #$FD           ; выключить
  FE66  20 02      BRA   loc_FE6A       ; записать

loc_FE68:
  FE68  8A 02      ORAA  #$02           ; включить

loc_FE6A:
  FE6A  97 03      STAA  PORT2          ; записать
  FE6C  CC FF 00   LDD   #$FF00         ; полный период

loc_FE6F:
  FE6F  D3 0B      ADDD  OCR1H          ; + к моменту совпадения OC1
  FE71  DD 0B      STD   OCR1H          ; новый момент

;------------------------------------------------------------------------------
; IRQ2, CMI, SCI, TOF — не используются (сразу выход). У 1B нет K-линии.
;------------------------------------------------------------------------------
EMPTY_IRQ:                              ; вызов из: CMI, IRQ2, OCF, SCI, TOF
  FE73  3B         RTI                  ; выйти

