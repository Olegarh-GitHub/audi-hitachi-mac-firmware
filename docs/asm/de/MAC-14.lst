  E9C8  BD CA 10   JSR   FRAC_DN        ; Anteil
  E9CB  17         TBA                  ; A = Anteil
  E9CC  33         PULB                 ; B = Index
  E9CD  38         PULX                 ; X
  E9CE  CB 04      ADDB  #$04           ; Werte nach der Achse
  E9D0  3A         ABX                  ; X -> Wert
  E9D1  16         TAB                  ; B = Anteil
  E9D2  BD CA 41   JSR   INTERP         ; Interpolation
  E9D5  39         RTS                  ; Rücksprung

