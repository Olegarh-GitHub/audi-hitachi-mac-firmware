;------------------------------------------------------------------------------
; Factory patch: timing retard on a rapid pressure rise with a warm engine
; (G62 ≤ 63, throttle not closed, mode E0B8 not active). Pressure rise over 40 ms
; ($8073) on axis F7E0 = 0 4 11 15 30 43 56 68 -> F7E8 = 0 0 0 6 6 6 6 6:
; a rise of 15 or more gives a retard of 6 units. The largest is stored ($8213), then
; the retard $8211 = (25 - n) × 10 × $8213 / 256 decays over 25 calls (0.5 s).
; $8211 is added to the timing in the interrupt (F870).
;------------------------------------------------------------------------------
loc_F800:
  F800  B6 80 1B   LDAA  $801B          ; G62
  F803  B1 F7 F0   CMPA  $F7F0          ; colder than 63?
  F806  22 57      BHI   loc_F85F       ; yes — reset
  F808  BD D1 E5   JSR   IS_IDLE        ; throttle closed?
  F80B  25 52      BCS   loc_F85F       ; yes — reset
  F80D  86 FF      LDAA  #$FF           ; mode E0B8 active ($808B)?
  F80F  B5 80 8B   BITA  $808B          ; test
  F812  26 4B      BNE   loc_F85F       ; yes — reset
  F814  B6 80 73   LDAA  $8073          ; pressure increase
  F817  27 23      BEQ   loc_F83C       ; zero — decrease only
  F819  C6 08      LDAB  #$08           ; 8 points
  F81B  CE F7 E0   LDX   #$F7E0         ; axis F7E0
  F81E  BD CA 5F   JSR   AXIS_UP        ; find interval
  F821  37         PSHB                 ; index
  F822  BD CA 05   JSR   FRAC_UP        ; fraction
  F825  17         TBA                  ; A = fraction
  F826  33         PULB                 ; B = index
  F827  CE F7 E8   LDX   #$F7E8         ; table F7E8
  F82A  3A         ABX                  ; X -> value
  F82B  16         TAB                  ; B = fraction
  F82C  BD CA 41   JSR   INTERP         ; retard
  F82F  4D         TSTA                 ; zero?
  F830  27 0A      BEQ   loc_F83C       ; yes — decreasing
  F832  B1 82 13   CMPA  $8213          ; greater than stored value?
  F835  25 0A      BCS   loc_F841       ; no
  F837  B7 82 13   STAA  $8213          ; store
  F83A  20 05      BRA   loc_F841       ; continue

loc_F83C:
  F83C  7D 82 12   TST   $8212          ; decreasing in progress?
  F83F  27 1E      BEQ   loc_F85F       ; no — reset

loc_F841:
  F841  B6 82 12   LDAA  $8212          ; counter n
  F844  4C         INCA                 ; + 1
  F845  B7 82 12   STAA  $8212          ; write
  F848  B0 F7 F1   SUBA  $F7F1          ; n - 25
  F84B  24 12      BCC   loc_F85F       ; expired — reset
  F84D  40         NEGA                 ; 25 - n
  F84E  F6 F7 F2   LDAB  $F7F2          ; B = 10 (F7F2)
  F851  3D         MUL                  ; (25 - n) × 10
  F852  B6 82 13   LDAA  $8213          ; stored retard
  F855  3D         MUL                  ; × retard; high byte = / 256
  F856  5D         TSTB                 ; low byte ≥ 128?
  F857  2A 01      BPL   loc_F85A       ; no — no rounding
  F859  4C         INCA                 ; + 1

loc_F85A:
  F85A  B7 82 11   STAA  $8211          ; $8211 = retard
  F85D  20 0A      BRA   loc_F869       ; continue

loc_F85F:
  F85F  7F 82 11   CLR   $8211          ; retard = 0
  F862  7F 82 13   CLR   $8213          ; stored value = 0
  F865  4F         CLRA                 ; A = 0
  F866  B7 82 12   STAA  $8212          ; n = 0

loc_F869:
  F869  B6 80 18   LDAA  $8018          ; engine speed
  F86C  7E E1 79   JMP   loc_E179       ; return

; table $F86F, 1 bytes: empty
  F86F  db FF

