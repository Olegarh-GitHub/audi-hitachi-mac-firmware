;------------------------------------------------------------------------------
; Druckanstieg in 40 ms ($8073, 0 bei Abfall oder G71-Fehler), für N17 und Patch F800.
; $8208-$820B - Momentwerte von PORT2, PORT5, PORT6 und der Chip-Eingänge: werden im Programm nicht gelesen,
; offenbar für den Tester (RAM-Auslesen) [Vermutung].
;------------------------------------------------------------------------------
loc_E98F:
  E98F  86 72      LDAA  #$72           ; G71-Fehler
  E991  B5 80 91   BITA  $8091          ; prüfen
  E994  26 0C      BNE   loc_E9A2       ; vorhanden - 0
  E996  B6 80 19   LDAA  $8019          ; Druck
  E999  F6 80 72   LDAB  $8072          ; Druck des vorigen Aufrufs
  E99C  B7 80 72   STAA  $8072          ; merken
