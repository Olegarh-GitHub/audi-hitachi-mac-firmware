;------------------------------------------------------------------------------
; N115 — отсечной клапан паров из бака (рег. $19 бит 2 чипа).
; Разрешается через 50 вызовов (5 с) после синхронизации (C844).
; Включается:  давление выше 102 (96 + 6, ≈0,8 бар абс. [Пр])  или
;             обороты выше порога + 4.
; Выключается: на холостом ходу, или давление ниже 96 и обороты ниже порога.
; Порог по оборотам (C840…C843): 48 ед. (≈1070 об/мин), если снимок G42 ≥ 128
; (холодный воздух), иначе 58 ед. (≈1290 об/мин). Для AT и HS одинаковы.
;------------------------------------------------------------------------------
  EAA5  CE 80 00   LDX   #$8000         ; X = $8000
  EAA8  A6 63      LDAA  $63,X          ; время после синхронизации
  EAAA  B1 C8 44   CMPA  $C844          ; меньше C844 = 50 (5 с)?
  EAAD  25 46      BCS   loc_EAF5       ; да — N115 выключить
  EAAF  E6 19      LDAB  $19,X          ; давление
  EAB1  BD D1 FE   JSR   MAP_BAD_LOAD   ; G71 неисправен под нагрузкой?
  EAB4  24 03      BCC   loc_EAB9       ; нет — замер
  EAB6  F6 C7 9E   LDAB  $C79E          ; да — подстановка 192

loc_EAB9:
  EAB9  F0 C7 98   SUBB  $C798          ; давление - C798 (96)
  EABC  25 09      BCS   loc_EAC7       ; ниже 96? да — снять признак
  EABE  C0 06      SUBB  #$06           ; ещё - 6
  EAC0  25 08      BCS   loc_EACA       ; между 96 и 102? да — признак не менять
  EAC2  62 01 9F   OIM   #$01,$9F,X     ; выше 102: $809F.0 = 1
  EAC5  20 03      BRA   loc_EACA       ; дальше

loc_EAC7:
  EAC7  61 FE 9F   AIM   #$FE,$9F,X     ; ниже 96: $809F.0 = 0

loc_EACA:
  EACA  BD D1 E5   JSR   IS_IDLE        ; дроссель закрыт?
  EACD  25 26      BCS   loc_EAF5       ; да — N115 выключить
  EACF  6B 01 9F   TIM   #$01,$9F,X     ; давление выше 102?
  EAD2  26 1D      BNE   loc_EAF1       ; да — N115 включить
  EAD4  A6 18      LDAA  $18,X          ; обороты
  EAD6  CE C8 40   LDX   #$C840         ; пороги механики C840/C841
  EAD9  7B 04 17   TIM   #$04,PORT6     ; кодировка: PORT6.2 = 1 — HS
  EADC  26 03      BNE   loc_EAE1       ; HS? да — оставить
  EADE  CE C8 42   LDX   #$C842         ; AT: C842/C843

loc_EAE1:
  EAE1  F6 82 06   LDAB  $8206          ; снимок G42
  EAE4  C1 80      CMPB  #$80           ; 128 и выше (холодно)?
  EAE6  24 01      BCC   loc_EAE9       ; да — порог 48
  EAE8  08         INX                  ; нет — порог 58

loc_EAE9:
