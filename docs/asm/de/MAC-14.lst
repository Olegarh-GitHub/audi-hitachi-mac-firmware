  D96B  22 03      BHI   loc_D970       ; ja — Synchronbytes neu beginnen

loc_D96D:
  D96D  7E DC E6   JMP   loc_DCE6       ; Austausch zurücksetzen — Sitzung geschlossen (DCE6)

loc_D970:
  D970  CE 80 00   LDX   #$8000         ; X = $8000
  D973  61 0F F6   AIM   #$0F,$F6,X     ; Phase der Synchronbytes auf null (die Sitzung bleibt bestehen)
  D976  6A FD      DEC   $FD,X          ; Timeout = $FF
  D978  20 6C      BRA   loc_D9E6       ; weiter

loc_D97A:
