ROW_DN:                                 ; вызов из: TASK1, TASK2
  DF7D  BD CA 6B   JSR   AXIS_DN        ; найти интервал
  DF80  F7 80 0D   STAB  $800D          ; $800D = строка
  DF83  BD CA 10   JSR   FRAC_DN        ; доля
  DF86  F7 80 0F   STAB  $800F          ; $800F = доля
  DF89  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; RPM_COL — столбец по оборотам (ось X): $800C = номер, $800E = доля.
; Выход: B = строка × 16 + столбец.
;------------------------------------------------------------------------------
RPM_COL:                                ; вызов из: TASK1, TASK2
  DF8A  B6 80 18   LDAA  $8018          ; обороты
  DF8D  BD CA 5F   JSR   AXIS_UP        ; найти интервал
  DF90  F7 80 0C   STAB  $800C          ; $800C
  DF93  BD CA 05   JSR   FRAC_UP        ; доля
  DF96  F7 80 0E   STAB  $800E          ; $800E
  DF99  F6 80 0D   LDAB  $800D          ; строка
  DF9C  58         ASLB                 ; × 16
  DF9D  58         ASLB                 ; (× 16)
  DF9E  58         ASLB                 ; (× 16)
  DF9F  58         ASLB                 ; (× 16)
  DFA0  FB 80 0C   ADDB  $800C          ; + столбец
  DFA3  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; MAP16 — двойная интерполяция по карте 16×16 (X = карта, B = ячейка).
;------------------------------------------------------------------------------
MAP16:                                  ; вызов из: TASK1, TASK2
  DFA4  3A         ABX                  ; X -> ячейка
  DFA5  3C         PSHX                 ; сохранить
  DFA6  F6 80 0E   LDAB  $800E          ; доля по оборотам
  DFA9  BD CA 41   JSR   INTERP         ; в своей строке
  DFAC  B7 80 0C   STAA  $800C          ; $800C
  DFAF  C6 10      LDAB  #$10           ; следующая строка (+16)
  DFB1  38         PULX                 ; X
  DFB2  3A         ABX                  ; X -> ячейка
  DFB3  F6 80 0E   LDAB  $800E          ; доля по оборотам
  DFB6  BD CA 41   JSR   INTERP         ; в следующей строке
  DFB9  B7 80 0D   STAA  $800D          ; $800D
  DFBC  CE 80 0C   LDX   #$800C         ; два значения
  DFBF  F6 80 0F   LDAB  $800F          ; доля по давлению
  DFC2  BD CA 41   JSR   INTERP         ; между строками
  DFC5  39         RTS                  ; возврат

;------------------------------------------------------------------------------
; ОСНОВНАЯ КАРТА ЗАЖИГАНИЯ 16×16: строки — давление (ось C200 = 192 … 51),
; столбцы — обороты (ось C210). Карта C000 (карта 1, для Super) — на прогретом
; моторе ($8050.5); C100 (карта 2) — на холодном или при признаке $807A.7
; (частая детонация, тогда ещё $8051.5) [Пр по SSP: карта 2 для низкого октана].
;------------------------------------------------------------------------------
loc_DFC6:
  DFC6  CE C2 00   LDX   #$C200         ; ось давления C200
  DFC9  C6 10      LDAB  #$10           ; 16 точек
  DFCB  8D A1      BSR   MAP_ROW        ; строка
  DFCD  CE C2 10   LDX   #$C210         ; ось оборотов C210
  DFD0  C6 10      LDAB  #$10           ; 16 точек
  DFD2  8D B6      BSR   RPM_COL        ; столбец, B = ячейка
  DFD4  86 20      LDAA  #$20           ; прогрет?
  DFD6  B5 80 50   BITA  $8050          ; проверить
  DFD9  27 10      BEQ   loc_DFEB       ; нет — карта 2
  DFDB  CE C0 00   LDX   #$C000         ; карта 1 (C000)
  DFDE  86 80      LDAA  #$80           ; $807A.7?
  DFE0  B5 80 7A   BITA  $807A          ; проверить
  DFE3  27 09      BEQ   loc_DFEE       ; нет — карта 1
  DFE5  CE 80 00   LDX   #$8000         ; X = $8000
  DFE8  62 20 51   OIM   #$20,$51,X     ; отметить $8051.5 и взять карту 2

loc_DFEB:
  DFEB  CE C1 00   LDX   #$C100         ; карта 2 (C100)

loc_DFEE:
  DFEE  8D B4      BSR   MAP16          ; угол по карте
  DFF0  B7 80 0C   STAA  $800C          ; $800C = угол

;------------------------------------------------------------------------------
; Поправка угла по времени работы мотора (таблица C2C4 = 10 8 8 0 по оси C2C0 =
; 24 28 35 47 в единицах 5,12 с, то есть ≈ 123…241 с). Решение принимается один раз, когда
; появляется $8060.0 [?]: если это случилось на 10-20 с или 41-56 с после пуска —
; поправка работает ($807A.2), иначе — никогда ($807A.1). Только при оборотах
; ниже 120 ед. и давлении ниже 128. Смысл — [?].
;------------------------------------------------------------------------------
  DFF3  CE 80 00   LDX   #$8000         ; X = $8000
  DFF6  6B 01 60   TIM   #$01,$60,X     ; $8060.0?
  DFF9  27 57      BEQ   loc_E052       ; нет — без поправки
  DFFB  E6 7A      LDAB  $7A,X          ; флаги $807A
  DFFD  C5 02      BITB  #$02           ; решено «никогда»?
  DFFF  26 51      BNE   loc_E052       ; да
  E001  C5 04      BITB  #$04           ; решено «работает»?
  E003  26 1D      BNE   loc_E022       ; да
  E005  B6 80 8C   LDAA  $808C          ; время работы, старший байт (по 5,12 с)
  E008  27 48      BEQ   loc_E052       ; ноль — ещё рано
  E00A  81 02      CMPA  #$02           ; меньше 2?
  E00C  25 0C      BCS   loc_E01A       ; да — никогда
  E00E  81 04      CMPA  #$04           ; меньше 4?
  E010  25 0D      BCS   loc_E01F       ; да — работает
  E012  81 08      CMPA  #$08           ; меньше 8?
  E014  25 04      BCS   loc_E01A       ; да — никогда
  E016  81 0B      CMPA  #$0B           ; меньше 11?
  E018  25 05      BCS   loc_E01F       ; да — работает

loc_E01A:
  E01A  62 02 7A   OIM   #$02,$7A,X     ; никогда ($807A.1)
  E01D  20 33      BRA   loc_E052       ; дальше

loc_E01F:
  E01F  62 04 7A   OIM   #$04,$7A,X     ; работает ($807A.2)

loc_E022:
  E022  E6 18      LDAB  $18,X          ; обороты
  E024  F1 C5 54   CMPB  $C554          ; не ниже C554 = 120?
  E027  24 29      BCC   loc_E052       ; да — без поправки
  E029  E6 19      LDAB  $19,X          ; давление
  E02B  6B 72 91   TIM   #$72,$91,X     ; ошибки G71?
  E02E  27 03      BEQ   loc_E033       ; нет
  E030  F6 C7 9E   LDAB  $C79E          ; подстановка

loc_E033:
  E033  F1 C5 55   CMPB  $C555          ; не ниже C555 = 128?
  E036  24 1A      BCC   loc_E052       ; да — без поправки
  E038  A6 8C      LDAA  $8C,X          ; время работы
  E03A  C6 04      LDAB  #$04           ; 4 точки
  E03C  CE C2 C0   LDX   #$C2C0         ; ось C2C0
  E03F  BD CA 5F   JSR   AXIS_UP        ; найти интервал
  E042  37         PSHB                 ; номер
  E043  BD CA 05   JSR   FRAC_UP        ; доля
  E046  17         TBA                  ; A = доля
  E047  33         PULB                 ; B = номер
  E048  CE C2 C4   LDX   #$C2C4         ; таблица C2C4
  E04B  3A         ABX                  ; X -> значение
  E04C  16         TAB                  ; B = доля
  E04D  BD CA 41   JSR   INTERP         ; поправка
  E050  20 01      BRA   loc_E053       ; дальше

loc_E052:
  E052  4F         CLRA                 ; поправка 0

loc_E053:
  E053  BB 80 0C   ADDA  $800C          ; + угол
  E056  C6 04      LDAB  #$04           ; ошибка Холла ($8094.2)?
  E058  F5 80 94   BITB  $8094          ; проверить
  E05B  27 03      BEQ   loc_E060       ; нет
  E05D  BB C5 57   ADDA  $C557          ; + C557 = 4 (позже)

loc_E060:
  E060  B7 80 0C   STAA  $800C          ; $800C
  E063  F6 80 19   LDAB  $8019          ; давление
  E066  C1 66      CMPB  #$66           ; ниже 102 (≈0,8 бар абс.)?
  E068  25 17      BCS   loc_E081       ; да — без поправки по воздуху
  E06A  CE C6 9C   LDX   #$C69C         ; ось G42 C69C = 204 156 128 109
  E06D  B6 80 20   LDAA  $8020          ; температура воздуха
  E070  C6 04      LDAB  #$04           ; 4 точки
  E072  BD CA 6B   JSR   AXIS_DN        ; точка (без интерполяции)
  E075  CE C6 A0   LDX   #$C6A0         ; таблица C6A0 = 60 60 61 62
  E078  3A         ABX                  ; X -> значение
  E079  A6 00      LDAA  $00,X          ; значение
  E07B  80 3C      SUBA  #$3C           ; - 60: поправка 0…+2 (теплее — позже)
  E07D  F6 80 0C   LDAB  $800C          ; угол
  E080  1B         ABA                  ; + поправка

;------------------------------------------------------------------------------
; Пересчёт угла в полузубья: $8022 = (угол + 40) × 192 / 256 - 30.
; $800C = на сколько угол стал раньше по сравнению с прошлым (для плавности).
; На пуске копия в $8023, на холостом ходу — в $808F.
;------------------------------------------------------------------------------
loc_E081:
  E081  8B 28      ADDA  #$28           ; + 40
  E083  C6 C0      LDAB  #$C0           ; × 0,75
  E085  3D         MUL                  ; (× 0,75)
  E086  58         ASLB                 ; округлить
  E087  89 00      ADCA  #$00           ; (округлить)
  E089  80 1E      SUBA  #$1E           ; - 30
  E08B  16         TAB                  ; B = новый угол
  E08C  B6 80 22   LDAA  $8022          ; старый угол
  E08F  F7 80 22   STAB  $8022          ; $8022 = новый угол (полузубья)
  E092  10         SBA                  ; старый - новый
  E093  24 01      BCC   loc_E096       ; не меньше нуля
  E095  4F         CLRA                 ; 0

loc_E096:
  E096  B7 80 0C   STAA  $800C          ; $800C = скачок раньше
  E099  B6 80 29   LDAA  $8029          ; пуск?
  E09C  2A 03      BPL   loc_E0A1       ; нет
  E09E  F7 80 23   STAB  $8023          ; $8023 = угол пуска

loc_E0A1:
  E0A1  86 04      LDAA  #$04           ; дроссель закрыт ($8088.2)?
  E0A3  B5 80 88   BITA  $8088          ; проверить
  E0A6  27 07      BEQ   loc_E0AF       ; нет
  E0A8  F7 80 8F   STAB  $808F          ; $808F = угол холостого хода
  E0AB  4F         CLRA                 ; скачок = 0
  E0AC  B7 80 0C   STAA  $800C          ; записать

loc_E0AF:
  E0AF  B6 80 89   LDAA  $8089          ; счётчик $8089
  E0B2  27 01      BEQ   loc_E0B5       ; ноль
  E0B4  4A         DECA                 ; - 1

loc_E0B5:
  E0B5  B7 80 89   STAA  $8089          ; записать

;------------------------------------------------------------------------------
; Смягчение рывка при открытии дросселя после холостого хода — только механика (HS) [Пр].
; Условия: прогрет ($8088.4: G62 ≤ 39, снимается выше 42), концевик F60 исправен,
; мотор работает дольше 30 с ($8029.2). Дроссель был закрыт ≥ 25 вызовов (0,5 с) —
; «взведено» ($8088.5). При открытии: сила k = (время закрытия - 25) × 5 (до 255),
; по оборотам (ось C270): $8089 = C280 × k / 256 — добавка к N7 (убывает по 1 за
; вызов), $808A = C290 × k / 256 — отвод угла, $808B = C2A0 — шаг возврата угла
; (отрабатывает прерывание, CE03). $8088.7 — режим идёт.
;------------------------------------------------------------------------------
  E0B8  CE 80 00   LDX   #$8000         ; X = $8000
  E0BB  7B 04 17   TIM   #$04,PORT6     ; кодировка: HS?
  E0BE  27 5C      BEQ   loc_E11C       ; AT — не нужно
  E0C0  F6 80 1B   LDAB  $801B          ; G62
  E0C3  C1 2A      CMPB  #$2A           ; холоднее 42?
  E0C5  22 09      BHI   loc_E0D0       ; да — снять «прогрет»
  E0C7  C1 27      CMPB  #$27           ; холоднее 39?
  E0C9  22 08      BHI   loc_E0D3       ; да — не менять
  E0CB  62 10 88   OIM   #$10,$88,X     ; $8088.4: прогрет
  E0CE  20 03      BRA   loc_E0D3       ; дальше

loc_E0D0:
  E0D0  61 EF 88   AIM   #$EF,$88,X     ; $8088.4 снять

loc_E0D3:
  E0D3  F6 80 93   LDAB  $8093          ; ошибки F60
  E0D6  C5 0C      BITB  #$0C           ; есть?
  E0D8  26 42      BNE   loc_E11C       ; да — не работать
  E0DA  6B 10 88   TIM   #$10,$88,X     ; прогрет?
  E0DD  27 3D      BEQ   loc_E11C       ; нет — не работать
  E0DF  F6 80 29   LDAB  $8029          ; мотор работает дольше 30 с?
  E0E2  C5 04      BITB  #$04           ; проверить
  E0E4  27 36      BEQ   loc_E11C       ; нет — не работать
  E0E6  F6 80 7E   LDAB  $807E          ; время закрытого дросселя
  E0E9  6B 04 88   TIM   #$04,$88,X     ; дроссель закрыт?
  E0EC  27 10      BEQ   loc_E0FE       ; нет — открыли
  E0EE  5C         INCB                 ; + 1
  E0EF  26 01      BNE   loc_E0F2       ; не переполнилось
  E0F1  5A         DECB                 ; 255

loc_E0F2:
  E0F2  F7 80 7E   STAB  $807E          ; записать
  E0F5  C1 19      CMPB  #$19           ; меньше 25 (0,5 с)?
  E0F7  25 26      BCS   loc_E11F       ; да — ждать
  E0F9  62 20 88   OIM   #$20,$88,X     ; взведено ($8088.5)
  E0FC  20 21      BRA   loc_E11F       ; дальше

loc_E0FE:
  E0FE  7F 80 7E   CLR   $807E          ; время = 0
  E101  6B 20 88   TIM   #$20,$88,X     ; было взведено?
  E104  27 54      BEQ   loc_E15A       ; нет
  E106  86 80      LDAA  #$80           ; выдача блинков?
  E108  B5 80 A0   BITA  $80A0          ; проверить
  E10B  26 4D      BNE   loc_E15A       ; да — не работать
  E10D  C0 19      SUBB  #$19           ; время - 25
  E10F  86 05      LDAA  #$05           ; × 5
  E111  3D         MUL                  ; (× 5)
  E112  4D         TSTA                 ; больше 255?
  E113  27 02      BEQ   loc_E117       ; нет
  E115  C6 FF      LDAB  #$FF           ; 255

loc_E117:
  E117  F7 80 0D   STAB  $800D          ; $800D = сила k
  E11A  20 08      BRA   loc_E124       ; рассчитать

loc_E11C:
  E11C  61 DF 88   AIM   #$DF,$88,X     ; снять «взведено»

loc_E11F:
  E11F  61 7F 88   AIM   #$7F,$88,X     ; снять «режим идёт»
  E122  20 52      BRA   loc_E176       ; дальше

loc_E124:
  E124  B6 80 18   LDAA  $8018          ; обороты
  E127  C6 10      LDAB  #$10           ; 16 точек
  E129  CE C2 70   LDX   #$C270         ; ось C270
  E12C  BD CA 5F   JSR   AXIS_UP        ; найти точку
  E12F  CE C2 80   LDX   #$C280         ; таблица C280 (добавка N7)
  E132  3A         ABX                  ; X -> значение
  E133  A6 00      LDAA  $00,X          ; значение
  E135  F6 80 0D   LDAB  $800D          ; × k
  E138  3D         MUL                  ; (× k)
  E139  58         ASLB                 ; округлить
  E13A  89 00      ADCA  #$00           ; (округлить)
  E13C  B7 80 89   STAA  $8089          ; $8089 = добавка к N7
  E13F  A6 10      LDAA  $10,X          ; C290 (отвод угла)
  E141  F6 80 0D   LDAB  $800D          ; × k
  E144  3D         MUL                  ; (× k)
  E145  58         ASLB                 ; округлить
  E146  89 00      ADCA  #$00           ; (округлить)
  E148  B7 80 8A   STAA  $808A          ; $808A = отвод
  E14B  E6 20      LDAB  $20,X          ; C2A0 (шаг возврата)
  E14D  F7 80 8B   STAB  $808B          ; $808B
  E150  CE 80 00   LDX   #$8000         ; X = $8000
  E153  61 DF 88   AIM   #$DF,$88,X     ; снять «взведено»
  E156  0F         SEI                  ; запрет прерываний
  E157  62 88 88   OIM   #$88,$88,X     ; режим идёт ($8088.7, .3)

loc_E15A:
  E15A  6B 80 88   TIM   #$80,$88,X     ; режим идёт?
  E15D  0E         CLI                  ; разрешить прерывания
  E15E  27 16      BEQ   loc_E176       ; нет
  E160  F6 80 22   LDAB  $8022          ; угол
  E163  FB 80 0C   ADDB  $800C          ; + скачок
  E166  F1 80 8F   CMPB  $808F          ; не раньше угла холостого хода?
  E169  24 03      BCC   loc_E16E       ; да
  E16B  F6 80 8F   LDAB  $808F          ; угол холостого хода

loc_E16E:
  E16E  FB 80 8A   ADDB  $808A          ; + отвод
  E171  CB 00      ADDB  #$00           ; (+0)
  E173  F7 80 8E   STAB  $808E          ; $808E = начальный отведённый угол

loc_E176:
  E176  7E F8 00   JMP   loc_F800       ; заплатка: отвод при резком нажатии

;------------------------------------------------------------------------------
; $8021 = обороты × 256 / 255 (≈ обороты) — для поправки на задержку искры [?].
; НАКОПЛЕНИЕ КАТУШКИ (dwell). Ниже 16 ед. оборотов (или ниже 12 до первого
; выхода на 16, $8092.0) — постоянное $8024 = 88. Иначе время накопления T по
; напряжению: ось C918 = 80 90 100 110 120 140 160 200 (≈8…20 В [Пр]) ->
; C920 = 90 70 55 46 40 32 27 19. Угол накопления = T × обороты / 69 полузубьев;
; $8024 = 108 - угол (момент начала накопления от метки цилиндра), не меньше 27.
; 108 полузубьев = 144° = расстояние между цилиндрами. По масштабу оборотов
; T ≈ 7 × время в мс [Пр]: при 14 В (T = 32) ≈ 4,6 мс.
;------------------------------------------------------------------------------
loc_E179:
  E179  C6 FF      LDAB  #$FF           ; 255
  E17B  BD CA 1B   JSR   DIV8           ; A × 256 / 255
  E17E  86 01      LDAA  #$01           ; × 1
  E180  3D         MUL                  ; округлить
  E181  58         ASLB                 ; (округлить)
  E182  89 00      ADCA  #$00           ; (округлить)
  E184  B7 80 21   STAA  $8021          ; $8021
  E187  F6 80 92   LDAB  $8092          ; флаги температур
  E18A  B6 80 18   LDAA  $8018          ; обороты
  E18D  81 10      CMPA  #$10           ; 16 и выше?
  E18F  24 13      BCC   loc_E1A4       ; да — по напряжению
  E191  81 0C      CMPA  #$0C           ; ниже 12?
  E193  25 04      BCS   loc_E199       ; да — постоянное
  E195  C5 01      BITB  #$01           ; уже выходили на 16?
  E197  26 0B      BNE   loc_E1A4       ; да — по напряжению

loc_E199:
  E199  0F         SEI                  ; запрет прерываний
  E19A  C4 FE      ANDB  #$FE           ; снять «выходили»
  E19C  F7 80 92   STAB  $8092          ; записать
  E19F  0E         CLI                  ; разрешить прерывания
  E1A0  86 58      LDAA  #$58           ; постоянное 88
  E1A2  20 4F      BRA   loc_E1F3       ; записать

loc_E1A4:
  E1A4  0F         SEI                  ; запрет прерываний
  E1A5  CA 01      ORAB  #$01           ; «выходили на 16» ($8092.0)
  E1A7  F7 80 92   STAB  $8092          ; записать
  E1AA  0E         CLI                  ; разрешить прерывания
  E1AB  CE C9 18   LDX   #$C918         ; ось напряжения C918
  E1AE  B6 80 1A   LDAA  $801A          ; напряжение
  E1B1  C6 08      LDAB  #$08           ; 8 точек
  E1B3  BD DF 53   JSR   TAB16_RPM      ; T по таблице C920
  E1B6  C6 45      LDAB  #$45           ; делитель 69
  E1B8  7F 80 0D   CLR   $800D          ; целая часть = 0

loc_E1BB:
  E1BB  10         SBA                  ; - 69
  E1BC  25 05      BCS   loc_E1C3       ; меньше нуля — хватит
  E1BE  7C 80 0D   INC   $800D          ; целая + 1
  E1C1  20 F8      BRA   loc_E1BB       ; повторить

loc_E1C3:
  E1C3  1B         ABA                  ; остаток
  E1C4  BD CA 1B   JSR   DIV8           ; остаток × 256 / 69
  E1C7  B7 80 0E   STAA  $800E          ; $800E = дробная часть T / 69
